# Kettle Linux's own Vulkan layers. Sources live next to this PKGBUILD.
# NOT in the image yet: lsfg_noubwc must sit below lsfg-vk, but the loader (and pressure-vessel)
# order implicit layers by directory listing order, not name. Loaded above lsfg-vk it only sees
# lsfg-vk's own side of the shared images, the game-side import keeps UBWC and fails with a size
# mismatch (VK_ERROR_INVALID_EXTERNAL_HANDLE), and lsfg-vk retries every frame, leaking GPU
# memory until the OOM killer ends the game.
#   lsfg_noubwc  per game with frame generation: no UBWC on the images lsfg-vk shares
#                between the game's device and its own (fixes blocky generated frames
#                without TU_DEBUG=noubwc turning UBWC off for the whole game)
pkgname=kettle-vk-layers
pkgver=1.0.0
pkgrel=1
pkgdesc='Kettle Linux Vulkan layers'
arch=(aarch64)
license=(BSD-3-Clause)
depends=(glibc vulkan-icd-loader)
makedepends=(clang vulkan-headers)

build() {
  clang $CFLAGS -std=c11 -Wall -Wextra -Werror -fPIC -shared -fvisibility=hidden \
    $LDFLAGS -o libVkLayer_kettle_lsfg_noubwc.so "$startdir/lsfg_noubwc.c" -lpthread
}

package() {
  install -Dm755 libVkLayer_kettle_lsfg_noubwc.so -t "$pkgdir/usr/lib"
  # sorts after VkLayer_LSFGVK_*.json: the loader (and pressure-vessel) order implicit
  # layers by manifest name, and this one must sit below lsfg-vk
  install -Dm644 "$startdir/VkLayer_kettle_lsfg_noubwc.json" -t "$pkgdir/usr/share/vulkan/implicit_layer.d"
  install -Dm644 "$startdir/LICENSE" -t "$pkgdir/usr/share/licenses/$pkgname"
}
