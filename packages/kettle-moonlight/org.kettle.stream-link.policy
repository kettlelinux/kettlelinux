<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Kettle Linux</vendor>
  <action id="org.kettle.stream-link">
    <description>Tune the device for a game stream</description>
    <message>Tuning the device for a game stream needs your password</message>
    <icon_name>network-wireless</icon_name>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/kettle/kettle-stream-link</annotate>
  </action>
</policyconfig>
