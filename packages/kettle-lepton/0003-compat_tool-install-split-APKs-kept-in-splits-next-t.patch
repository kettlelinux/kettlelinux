From 94397ebb562db4d7d413fbfcf3e3ff98af615b79 Mon Sep 17 00:00:00 2001
From: gennro <gennro2004@gmail.com>
Date: Mon, 28 Sep 2026 18:01:30 -0500
Subject: [PATCH] compat_tool: install split APKs kept in splits/ next to the
 game's APK


Rebased onto Lepton v3.0.10: its Steam-launch shortcut (pm install of the
APK in the container's mounted folder) gets the splits too, as pm
install's PATH [SPLIT...].
---
 compat_tool/liblepton/liblepton.sh | 10 +++++++++-
 1 file changed, 9 insertions(+), 1 deletion(-)

diff --git a/compat_tool/liblepton/liblepton.sh b/compat_tool/liblepton/liblepton.sh
index 50895b6..0145e07 100755
--- a/compat_tool/liblepton/liblepton.sh
+++ b/compat_tool/liblepton/liblepton.sh
@@ -540,14 +540,27 @@ function install_app()
                 fi
             fi
         fi
+        # A game Google Play delivers as an app bundle comes as a base APK plus split APKs
+        # (native code, screen density, language, install-time assets), kept in splits/ next
+        # to the base APK: install them together.
+        local -a SPLIT_PATHS; mapfile -t SPLIT_PATHS < <(compgen -G "$(dirname "${APK_PATH}")/splits/*.apk")
         local INSTALL_RET=0
         if is_steamlaunch; then
             # If it's a steamlaunch we can use a shortcut:
             # Since we mount the apk folder into the container,
             # there is no streaming via adb needed.
-            timeout "${INSTALL_TIMEOUT}" "$ADB" -P "${TEMP_PORT}" -s localhost:"${ADB_PORT}" shell pm install "\"${APK_PATH}\"" || INSTALL_RET=$?
+            # (pm install takes the splits after the base APK: PATH [SPLIT...])
+            local PM_PATHS="\"${APK_PATH}\"" SPLIT_PATH
+            for SPLIT_PATH in "${SPLIT_PATHS[@]}"; do
+                PM_PATHS+=" \"${SPLIT_PATH}\""
+            done
+            timeout "${INSTALL_TIMEOUT}" "$ADB" -P "${TEMP_PORT}" -s localhost:"${ADB_PORT}" shell pm install "${PM_PATHS}" || INSTALL_RET=$?
         else
-            timeout "${INSTALL_TIMEOUT}" "$ADB" -P "${TEMP_PORT}" -s localhost:"${ADB_PORT}" install -g "${APK_PATH}" || INSTALL_RET=$?
+            local INSTALL_CMD=(install -g "${APK_PATH}")
+            if (( ${#SPLIT_PATHS[@]} > 0 )); then
+                INSTALL_CMD=(install-multiple -g "${APK_PATH}" "${SPLIT_PATHS[@]}")
+            fi
+            timeout "${INSTALL_TIMEOUT}" "$ADB" -P "${TEMP_PORT}" -s localhost:"${ADB_PORT}" "${INSTALL_CMD[@]}" || INSTALL_RET=$?
         fi
         if [[ "${INSTALL_RET}" != "0" ]]; then
             if [[ "${INSTALL_RET}" == "124" ]]; then
