class Refused(Exception):
    pass


# ---------------------------------------------------------------- Android binary XML / resources

def _string_pool(data, off):
    _, header_size, _, count, _, flags, strings_start, _ = struct.unpack_from("<HHIIIIII", data, off)
    utf8 = flags & 0x100
    offsets = struct.unpack_from("<%dI" % count, data, off + header_size)
    base = off + strings_start
    out = []
    for o in offsets:
        p = base + o
        if utf8:
            n = data[p]; p += 2 if n & 0x80 else 1          # length in characters (unused)
            n = data[p]
            if n & 0x80:
                n = ((n & 0x7F) << 8) | data[p + 1]; p += 2
            else:
                p += 1
            out.append(data[p:p + n].decode("utf-8", "replace"))
        else:
            n = struct.unpack_from("<H", data, p)[0]; p += 2
            if n & 0x8000:
                n = ((n & 0x7FFF) << 16) | struct.unpack_from("<H", data, p)[0]; p += 2
            out.append(data[p:p + 2 * n].decode("utf-16-le", "replace"))
    return out


# android: attribute resource ids
ATTR_LABEL, ATTR_ICON, ATTR_NAME, ATTR_VALUE = 0x01010001, 0x01010002, 0x01010003, 0x01010024
ATTR_VERSION_NAME = 0x0101021c


def parse_axml(data):
    """Elements of a binary XML file as (name, {attr: (type, data, string)}) in document order."""
    strings, resmap, elements = [], [], []
    off = struct.unpack_from("<H", data, 2)[0]
    while off + 8 <= len(data):
        ctype, _, size = struct.unpack_from("<HHI", data, off)
        if size == 0:
            break
        if ctype == 0x0001:
            strings = _string_pool(data, off)
        elif ctype == 0x0180:
            resmap = list(struct.unpack_from("<%dI" % ((size - 8) // 4), data, off + 8))
        elif ctype == 0x0102:
            ext = off + 16
            _, name, astart, asize, acount = struct.unpack_from("<IIHHH", data, ext)
            attrs = {}
            for i in range(acount):
                a = ext + astart + i * asize
                _, aname, raw, _, _, dtype, value = struct.unpack_from("<IIIHBBI", data, a)
                key = resmap[aname] if aname < len(resmap) and resmap[aname] else strings[aname]
                text = strings[raw] if raw != 0xFFFFFFFF else (strings[value] if dtype == 0x03 else None)
                attrs[key] = (dtype, value, text)
            elements.append((strings[name], attrs))
        off += size
    return elements


def parse_arsc(data):
    """resources.arsc as {resource id: [(language, density, (type, data))]} for all configs."""
    table = {}
    _, header_size, _ = struct.unpack_from("<HHI", data, 0)
    off = header_size
    global_strings = []
    while off + 8 <= len(data):
        ctype, hsize, size = struct.unpack_from("<HHI", data, off)
        if ctype == 0x0001:
            global_strings = _string_pool(data, off)
        elif ctype == 0x0200:
            pkg_id = struct.unpack_from("<I", data, off + 8)[0]
            p = off + hsize
            end = off + size
            while p + 8 <= end:
                t, th, ts = struct.unpack_from("<HHI", data, p)
                if t == 0x0201:
                    type_id, flags = data[p + 8], data[p + 9]
                    count, entries_start = struct.unpack_from("<II", data, p + 12)
                    cfg = p + 20
                    lang = data[cfg + 8:cfg + 10].rstrip(b"\0").decode("ascii", "replace")
                    density = struct.unpack_from("<H", data, cfg + 14)[0]
                    idx_base = p + th
                    if flags & 0x01:      # sparse: (entry index, offset / 4) pairs
                        pairs = [struct.unpack_from("<HH", data, idx_base + 4 * i) for i in range(count)]
                        slots = [(e, o * 4) for e, o in pairs]
                    elif flags & 0x02:    # 16-bit offsets / 4
                        raw = struct.unpack_from("<%dH" % count, data, idx_base)
                        slots = [(i, o * 4) for i, o in enumerate(raw) if o != 0xFFFF]
                    else:
                        raw = struct.unpack_from("<%dI" % count, data, idx_base)
                        slots = [(i, o) for i, o in enumerate(raw) if o != 0xFFFFFFFF]
                    for index, o in slots:
                        e = p + entries_start + o
                        esize, eflags = struct.unpack_from("<HH", data, e)
                        if eflags & 0x0008:   # compact entry: type in the flags, data follows
                            value = (eflags >> 8, struct.unpack_from("<I", data, e + 4)[0])
                        elif eflags & 0x0001:  # complex (bag): not a plain value
                            continue
                        else:
                            _, _, dtype, vdata = struct.unpack_from("<HBBI", data, e + esize)
                            value = (dtype, vdata)
                        rid = (pkg_id << 24) | (type_id << 16) | index
                        table.setdefault(rid, []).append((lang, density, value))
                p += ts
        off += size
    return table, global_strings


def resolve_string(table, strings, rid, depth=0):
    configs = table.get(rid, [])
    for want in ("", "en"):
        for lang, _, (dtype, value) in configs:
            if lang == want:
                if dtype == 0x03:
                    return strings[value]
                if dtype == 0x01 and depth < 5:
                    return resolve_string(table, strings, value, depth + 1)
    return None


def resolve_icon_paths(table, strings, rid, depth=0):
    """Files (res/...) a drawable/mipmap id points to, highest density first."""
    out = []
    for _, density, (dtype, value) in table.get(rid, []):
        if dtype == 0x03:
            out.append((density if density < 0xFFF0 else 0, strings[value]))
        elif dtype == 0x01 and depth < 5:
            out += [(0, p) for p in resolve_icon_paths(table, strings, value, depth + 1)]
    return [p for _, p in sorted(out, key=lambda x: -x[0])]


# ---------------------------------------------------------------- APK inspection

def _zip_names(path):
    with zipfile.ZipFile(path) as z:
        return set(z.namelist())


def inspect_apk(path, splits=()):
    try:
        with zipfile.ZipFile(path) as z:
            names = set(z.namelist())
            if "AndroidManifest.xml" not in names:
                raise Refused("Not an Android app: it has no AndroidManifest.xml.")
            manifest_data = z.read("AndroidManifest.xml")
            arsc = z.read("resources.arsc") if "resources.arsc" in names else None
    except (zipfile.BadZipFile, OSError) as e:
        raise Refused("Not an Android app file (%s)." % e)
    elements = parse_axml(manifest_data)
    manifest = next((a for n, a in elements if n == "manifest"), {})
    app = next((a for n, a in elements if n == "application"), {})
    package = (manifest.get("package") or (None, None, None))[2]
    split_name = (manifest.get("split") or (None, None, None))[2]
    version = (manifest.get(ATTR_VERSION_NAME) or (None, None, None))[2]
    meta = {}
    for n, a in elements:
        if n == "meta-data" and ATTR_NAME in a:
            meta[a[ATTR_NAME][2]] = a.get(ATTR_VALUE)
    split_required = "com.android.vending.splits.required" in meta
    uses_gms = any(k and k.startswith("com.google.android.gms") for k in meta)

    abis = sorted({n.split("/")[1] for n in names if n.startswith("lib/") and n.count("/") >= 2})
    arm64 = not abis or "arm64-v8a" in abis

    label, icon = None, None
    table, strings = ({}, [])
    if arsc is not None:
        try:
            table, strings = parse_arsc(arsc)
        except (struct.error, IndexError):
            pass
    lab = app.get(ATTR_LABEL)
    if lab:
        label = lab[2] if lab[0] == 0x03 else resolve_string(table, strings, lab[1]) if lab[0] == 0x01 else None
    ic = app.get(ATTR_ICON)
    if ic and ic[0] == 0x01:
        # an app bundle keeps its icons in the screen density splits
        where = [(path, names)] + [(sp, _zip_names(sp)) for sp in splits]
        for p in resolve_icon_paths(table, strings, ic[1]):
            found = next((f for f, n in where if p in n), None) if p.endswith(".png") else None
            if found:
                icon = (found, p)
                break
    return {
        "package": package,
        "name": label or package,
        "version": version,
        "abis": abis,
        "arm64": arm64,
        "split": split_required,
        "split_name": split_name,
        "google_services": uses_gms,
        "icon": icon,
    }


def check_runnable(info, splits=()):
    if not info["package"]:
        raise Refused("The app has no package name.")
    if not PLAY_PACKAGE.match(info["package"]):
        # it names the game's folder: no "..", "/" or other surprises
        raise Refused("The app's package name (%r) isn't a valid one." % info["package"][:100])
    if info["split_name"]:
        raise Refused("This is one part (%s) of a game split into several APK files, not the game "
                      "itself." % info["split_name"])
    if not info["arm64"]:
        raise Refused("%s has no 64-bit ARM (arm64-v8a) code, only %s, so it can't run on this device."
                      % (info["name"], ", ".join(info["abis"])))
    if info["split"] and not splits:
        raise Refused("%s is split into several APK files (an app bundle) and this is only its base. "
                      "Add the .xapk or .apks file that holds all of them, or a universal APK."
                      % info["name"])
    if splits:
        abis = {n.split("/")[1] for sp in splits for n in _zip_names(sp)
                if n.startswith("lib/") and n.count("/") >= 2}
        if abis and "arm64-v8a" not in abis:
            raise Refused("%s has no 64-bit ARM (arm64-v8a) code, only %s, so it can't run on this "
                          "device." % (info["name"], ", ".join(sorted(abis))))


def split_apk_set(apks):
    """(base, [splits]) of an app bundle's APK files: the base is the one that isn't a split."""
    base = [a for a in apks if not inspect_apk(a)["split_name"]]
    if len(base) != 1:
        raise Refused("Couldn't tell which APK file is the game (%d candidates)." % len(base))
    return base[0], [a for a in apks if a != base[0]]


def unpack_bundle(path, workdir):
    """An .xapk or .apks file: extract its APKs and OBB files. Returns (apk, [splits], [obbs])."""
    apks, obbs = [], []
    try:
        with zipfile.ZipFile(path) as z:
            wanted = [i for i in z.infolist() if not i.is_dir() and (
                i.filename.lower().endswith(".apk") and "/" not in i.filename
                or i.filename.lower().endswith(".obb"))]
            for i in wanted:
                parts = i.filename.replace("\\", "/").split("/")
                if i.filename.startswith("/") or ".." in parts or ":" in i.filename:
                    raise Refused("This file has an entry with an unsafe path (%s)." % i.filename[:100])
            # zipfile stops each file at its declared size, so the sum is a real bound
            if sum(i.file_size for i in wanted) > BUNDLE_MAX:
                raise Refused("This file unpacks to more than %d GiB." % (BUNDLE_MAX >> 30))
            for i in wanted:
                (apks if i.filename.lower().endswith(".apk") else obbs).append(z.extract(i, workdir))
    except (zipfile.BadZipFile, OSError) as e:
        raise Refused("Not an XAPK or APKS file (%s)." % e)
    if not apks:
        raise Refused("This file holds no APK.")
    apk, splits = split_apk_set(apks)
    return apk, splits, obbs


# ---------------------------------------------------------------- Steam (CEF remote debugging)

def cef_eval(expression):
    try:
        targets = json.load(urllib.request.urlopen("http://%s:%d/json" % CEF, timeout=5))
    except OSError:
        raise Refused("Steam isn't running. Start Steam, then try again.")
    url = next((t["webSocketDebuggerUrl"] for t in targets if t.get("title") == "SharedJSContext"), None)
    if not url:
        raise Refused("Steam hasn't finished starting. Try again in a moment.")
    path = url.split("%s:%d" % CEF, 1)[-1] if "%s:%d" % CEF in url else "/" + url.split("/", 3)[3]
    s = socket.create_connection(CEF, timeout=30)
    key = base64.b64encode(os.urandom(16)).decode()
    s.sendall(("GET %s HTTP/1.1\r\nHost: %s:%d\r\nUpgrade: websocket\r\nConnection: Upgrade\r\n"
               "Sec-WebSocket-Key: %s\r\nSec-WebSocket-Version: 13\r\n\r\n" % (path, CEF[0], CEF[1], key)).encode())
    buf = b""
    while b"\r\n\r\n" not in buf:
        chunk = s.recv(4096)
        if not chunk:
            raise Refused("Steam refused the connection.")
        buf += chunk
    rest = [buf.split(b"\r\n\r\n", 1)[1]]

    def recvn(n):
        while len(rest[0]) < n:
            chunk = s.recv(65536)
            if not chunk:
                raise Refused("Steam closed the connection.")
            rest[0] += chunk
        out, rest[0] = rest[0][:n], rest[0][n:]
        return out

    msg = json.dumps({"id": 1, "method": "Runtime.evaluate",
                      "params": {"expression": expression, "awaitPromise": True, "returnByValue": True}}).encode()
    n = len(msg)
    hdr = bytes([0x81]) + (bytes([0x80 | n]) if n < 126 else bytes([0x80 | 126]) + struct.pack(">H", n)
                           if n < 65536 else bytes([0x80 | 127]) + struct.pack(">Q", n))
    mask = os.urandom(4)
    s.sendall(hdr + mask + bytes(b ^ mask[i % 4] for i, b in enumerate(msg)))
    while True:
        payload = b""
        while True:
            b0, b1 = recvn(2)
            n = b1 & 0x7F
            if n == 126:
                n = struct.unpack(">H", recvn(2))[0]
            elif n == 127:
                n = struct.unpack(">Q", recvn(8))[0]
            payload += recvn(n)
            if b0 & 0x80:
                break
        reply = json.loads(payload)
        if reply.get("id") == 1:
            s.close()
            result = reply.get("result", {})
            if "exceptionDetails" in result:
                raise Refused("Steam couldn't add the game: %s"
                              % result["exceptionDetails"].get("exception", {}).get("description", "error"))
            return result.get("result", {}).get("value")


def add_steam_shortcut(name, apk, start_dir, icon, known_appid):
    js = """(async () => {
  const name = %s, exe = %s, dir = %s, icon = %s, known = %s, tool = %s;
  let id = 0;
  if (known && typeof appStore !== "undefined" && appStore.GetAppOverviewByAppID(known))
    id = known;
  if (!id)
    id = await SteamClient.Apps.AddShortcut(name, exe, dir, "");
  SteamClient.Apps.SetShortcutName(id, name);
  SteamClient.Apps.SetShortcutExe(id, '"' + exe + '"');
  SteamClient.Apps.SetShortcutStartDir(id, dir);
  SteamClient.Apps.SetShortcutLaunchOptions(id, "");
  if (icon && SteamClient.Apps.SetShortcutIcon)
    SteamClient.Apps.SetShortcutIcon(id, icon);
  SteamClient.Apps.SpecifyCompatTool(id, tool);
  return id;
})()""" % tuple(json.dumps(v) for v in (name, apk, start_dir, icon, known_appid or 0, TOOL))
    appid = cef_eval(js)
    if not appid:
        raise Refused("Steam didn't create the shortcut.")
    return appid


# ---------------------------------------------------------------- commands

def cmd_inspect(path):
    return inspect_apk(path)


def cmd_add(path, notify=False):
    path = os.path.abspath(path)
    if not path.lower().endswith((".xapk", ".apks")):
        return add_game(path, [], [], notify)
    with work_dir() as tmp:
        apk, splits, obbs = unpack_bundle(path, tmp)
        return add_game(apk, splits, obbs, notify, move=True)


def work_dir():
    """A temporary folder on the games' drive: games can be gigabytes, too big for /tmp."""
    os.makedirs(GAMES_DIR, exist_ok=True)
    return tempfile.TemporaryDirectory(dir=GAMES_DIR, prefix=".work-")


def _copy(src, dst, move=False):
    if os.path.abspath(src) == dst:
        return
    if move:
        os.replace(src, dst)
    else:
        shutil.copyfile(src, dst + ".part")
        os.replace(dst + ".part", dst)


def _game_folder(package):
    """~/Games/Android/<package>, made sure to stay inside ~/Games/Android."""
    games = os.path.realpath(GAMES_DIR)
    folder = os.path.join(GAMES_DIR, package)
    if os.path.dirname(os.path.realpath(folder)) != games:
        raise Refused("%s isn't a folder in Games/Android." % package)
    return folder


def add_game(apk, splits, obbs, notify=False, move=False, name=None):
    """Put the game in ~/Games/Android/<package>/ (APK, splits/, obb/) and add it to Steam, as
    name if given (else the app's own label)."""
    info = inspect_apk(apk)
    if not PLAY_PACKAGE.match(info["package"] or ""):
        check_runnable(info)  # refuses it, with the reason
    folder = _game_folder(info["package"])
    target = os.path.join(folder, "%s.apk" % info["package"])
    split_dir = os.path.join(folder, "splits")
    in_place = os.path.abspath(apk) == target
    if in_place and not splits and os.path.isdir(split_dir):
        # re-adding a game from its own folder keeps its splits
        splits = sorted(os.path.join(split_dir, n) for n in os.listdir(split_dir) if n.endswith(".apk"))
    info = inspect_apk(apk, splits)
    check_runnable(info, splits)
    if name:
        info["name"] = name

    icon = None
    if info["icon"]:
        src, info["icon"] = info["icon"]
        with zipfile.ZipFile(src) as z:
            icon = z.read(info["icon"])

    os.makedirs(folder, exist_ok=True)
    _copy(apk, target, move)
    if not (in_place and splits and all(os.path.dirname(sp) == split_dir for sp in splits)):
        # an update replaces all the splits; Lepton installs whatever is in splits/
        shutil.rmtree(split_dir, ignore_errors=True)
        if splits:
            os.makedirs(split_dir)
            for sp in splits:
                _copy(sp, os.path.join(split_dir, os.path.basename(sp)), move)
    if obbs:
        obb_dir = os.path.join(folder, "obb")
        os.makedirs(obb_dir, exist_ok=True)
        for o in obbs:
            _copy(o, os.path.join(obb_dir, os.path.basename(o)), move)

    icon_path = None
    if icon:
        icon_path = os.path.join(folder, "icon.png")
        with open(icon_path, "wb") as f:
            f.write(icon)

    appid_file = os.path.join(folder, ".steam-appid")
    known = None
    try:
        known = int(open(appid_file).read().strip())
    except (OSError, ValueError):
        pass
    appid = add_steam_shortcut(info["name"], target, folder, icon_path, known)
    with open(appid_file, "w") as f:
        f.write("%d\n" % appid)
    with open(os.path.join(folder, ".name"), "w") as f:
        f.write(info["name"] + "\n")

    result = dict(info, apk=target, appid=appid)
    if notify:
        body = "%s is in your Steam library, set to run with Lepton (Kettle)." % info["name"]
        if info["google_services"]:
            body += " It uses Google Play services, which aren't available, so it may not start."
        send_notification("Android game added", body, icon_path or "steam")
    return result


def _du(path):
    total = 0
    for dp, _, files in os.walk(path):
        for f in files:
            try:
                total += os.lstat(os.path.join(dp, f)).st_size
            except OSError:
                pass
    return total


def _game_appid(folder):
    try:
        return int(open(os.path.join(folder, ".steam-appid")).read().strip())
    except (OSError, ValueError):
        return None


def cmd_list(_=None):
    """The games in ~/Games/Android: name, icon, size (with Lepton's data for it), and whether
    Steam still has its shortcut (None when Steam isn't running)."""
    try:
        packages = sorted(n for n in os.listdir(GAMES_DIR) if not n.startswith(".")
                          and os.path.isfile(os.path.join(GAMES_DIR, n, n + ".apk")))
    except FileNotFoundError:
        packages = []
    appids = {pk: _game_appid(os.path.join(GAMES_DIR, pk)) for pk in packages}
    try:  # the shortcuts Steam still has, by the names they have there now
        known = cef_eval("JSON.stringify(Object.fromEntries(%s.map(a => [a, appStore.GetAppOverviewByAppID(a)])"
                         ".filter(e => e[1]).map(e => [e[0], e[1].display_name])))"
                         % json.dumps([a for a in appids.values() if a]))
        in_steam = {int(a): n for a, n in json.loads(known or "{}").items()}
    except Refused:
        in_steam = None
    games = []
    for pk in packages:
        folder = os.path.join(GAMES_DIR, pk)
        try:
            name = open(os.path.join(folder, ".name")).read().strip()
        except OSError:
            try:
                name = inspect_apk(os.path.join(folder, pk + ".apk"))["name"]
            except Refused:
                name = pk
        appid = appids[pk]
        if in_steam and in_steam.get(appid):
            name = in_steam[appid]
        size = _du(folder)
        if appid:
            size += _du(os.path.join(STEAMAPPS, "compatdata", str(appid)))
            size += _du(os.path.join(STEAMAPPS, "shadercache", str(appid)))
        icon = os.path.join(folder, "icon.png")
        games.append({"package": pk, "name": name or pk, "appid": appid or 0, "size": size,
                      "icon": icon if os.path.isfile(icon) else "",
                      "in_steam": None if in_steam is None else appid in in_steam})
    return {"games": games}


def cmd_remove(package):
    """Remove a game: its Steam shortcut, Lepton's container, its data and saves (compatdata),
    shader cache and files."""
    if not PLAY_PACKAGE.match(package):
        raise Refused("That isn't a package name.")
    folder = _game_folder(package)
    if not os.path.isdir(folder):
        raise Refused("%s isn't in Games/Android." % package)
    appid = _game_appid(folder)
    try:
        name = open(os.path.join(folder, ".name")).read().strip() or package
    except OSError:
        name = package
    if appid:
        container = "lepton-steamlaunch-%d" % appid
        running = subprocess.run(["podman", "ps", "-q", "--filter", "name=^%s$" % container],
                                 capture_output=True, text=True).stdout.strip()
        if running:
            raise Refused("%s is running. Quit it first." % name)
        try:
            cef_eval("(() => { if (appStore.GetAppOverviewByAppID(%d)) SteamClient.Apps.RemoveShortcut(%d); "
                     "return true; })()" % (appid, appid))
        except Refused:
            pass  # Steam isn't running: the shortcut goes the next time, or from Steam by hand
        subprocess.run(["podman", "rm", "-fi", container], capture_output=True)
    freed = _du(folder)
    shutil.rmtree(folder, ignore_errors=True)
    if appid:
        for sub in ("compatdata", "shadercache"):
            path = os.path.join(STEAMAPPS, sub, str(appid))
            freed += _du(path)
            shutil.rmtree(path, ignore_errors=True)
    return {"package": package, "name": name, "freed": freed}


def send_notification(title, body, icon):
    """A desktop notification, without waiting: Game Mode has no notification service."""
    try:
        subprocess.Popen(["notify-send", "--app-name=Steam", "--icon=" + icon, title, body],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    except OSError:
        pass


_last_progress = [0.0]


def report_progress(done, total, force=False):
    """A "PROGRESS done total" line on stderr, at most a few a second."""
    now = time.monotonic()
    if force or now - _last_progress[0] >= 0.25:
        _last_progress[0] = now
        print("PROGRESS %d %d" % (done, total), file=sys.stderr, flush=True)


def download(url, path, timeout=60):
    """Download url to path, reporting progress. A cut-short download is an error."""
    req = urllib.request.Request(url, headers={"User-Agent": USER_AGENT})
    with urllib.request.urlopen(req, timeout=timeout) as r, open(path, "wb") as f:
        total = int(r.headers.get("Content-Length") or 0)
        done = 0
        while True:
            chunk = r.read(1 << 16)
            if not chunk:
                break
            f.write(chunk)
            done += len(chunk)
            if total:
                report_progress(done, total)
        if total and done != total:
            raise OSError("the download stopped at %d of %d bytes" % (done, total))
        if total:
            report_progress(total, total, force=True)


def _get_json(url):
    req = urllib.request.Request(url, headers={"User-Agent": USER_AGENT})
    with urllib.request.urlopen(req, timeout=30) as r:
        return json.load(r)


def cmd_fdroid_search(text):
    try:
        found = _get_json(FDROID_SEARCH + urllib.parse.quote(text)).get("apps", [])
    except OSError as e:
        raise Refused("Couldn't reach F-Droid (%s)." % getattr(e, "reason", e))
    apps = []
    for a in found:
        package = a.get("url", "").rstrip("/").rsplit("/", 1)[-1]
        if package:
            apps.append({"package": package, "name": a.get("name") or package,
                         "summary": a.get("summary", ""), "icon": a.get("icon", "")})
    return {"apps": apps}


def cmd_fdroid_add(package):
    try:
        meta = _get_json("%s/api/v1/packages/%s" % (FDROID, urllib.parse.quote(package)))
    except OSError as e:
        raise Refused("F-Droid doesn't have %s (%s)." % (package, getattr(e, "reason", e)))
    builds = meta.get("packages", [])
    if not builds:
        raise Refused("F-Droid has no downloads for %s." % package)
    suggested = meta.get("suggestedVersionCode")
    newest = next((b["versionName"] for b in builds if b["versionCode"] == suggested), builds[0]["versionName"])
    # the newest version's builds first (F-Droid publishes one per processor type for some apps)
    candidates = [b["versionCode"] for b in builds if b["versionName"] == newest]
    candidates.sort(key=lambda c: c != suggested)
    last_error = None
    with work_dir() as tmp:
        for code in candidates[:4]:
            apk = os.path.join(tmp, "%s_%d.apk" % (package, code))
            try:
                download("%s/repo/%s_%d.apk" % (FDROID, package, code), apk)
            except OSError as e:
                last_error = Refused("Couldn't download %s (%s)." % (package, getattr(e, "reason", e)))
                continue
            try:
                check_runnable(inspect_apk(apk))
            except Refused as e:
                last_error = e
                continue
            return add_game(apk, [], [], move=True)
    raise last_error or Refused("No build of %s can run on this device." % package)


