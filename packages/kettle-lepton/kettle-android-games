#!/usr/bin/env python3
# SPDX-License-Identifier: BSD-3-Clause
"""Add Android games (.apk) to Steam, set to run with Lepton (Kettle).

  kettle-android-games inspect FILE          what the APK is and whether it can run here
  kettle-android-games add [--notify] FILE   copy it to ~/Games/Android/<package>/ and add a
                                             Steam shortcut using "Lepton (Kettle)"
  kettle-android-games fdroid-search TEXT    search F-Droid
  kettle-android-games fdroid-add PACKAGE    download an F-Droid app and add it

Every command prints one JSON object ({"ok": true, ...} or {"ok": false, "error": ...}) and
exits 0 or 1. Shortcuts are added through the running Steam client (its CEF remote debugging
port, which Kettle enables for Decky), so Steam must be running.

.xapk files are unpacked when they hold a single APK (plus OBB data). Split APKs (base plus
config APKs) can't be installed by Lepton and are refused.
"""
import base64
import json
import os
import shutil
import socket
import struct
import subprocess
import sys
import tempfile
import urllib.parse
import urllib.request
import zipfile

TOOL = "lepton-kettle"
GAMES_DIR = os.path.join(os.path.expanduser("~"), "Games", "Android")
CEF = ("127.0.0.1", 8080)
FDROID = "https://f-droid.org"
FDROID_SEARCH = "https://search.f-droid.org/api/search_apps?q="
USER_AGENT = "kettle-android-games"


class Refused(Exception):
    pass


# ---------------------------------------------------------------- Android binary XML / resources

def _string_pool(data, off):
    _, header_size, _, count, _, flags, strings_start, _ = struct.unpack_from("<HHIIIIII", data, off)
    utf8 = flags & 0x100
    offsets = struct.unpack_from("<%dI" % count, data, off + header_size)
    base = off + strings_start
    out = []
    for o in offsets:
        p = base + o
        if utf8:
            n = data[p]; p += 2 if n & 0x80 else 1          # length in characters (unused)
            n = data[p]
            if n & 0x80:
                n = ((n & 0x7F) << 8) | data[p + 1]; p += 2
            else:
                p += 1
            out.append(data[p:p + n].decode("utf-8", "replace"))
        else:
            n = struct.unpack_from("<H", data, p)[0]; p += 2
            if n & 0x8000:
                n = ((n & 0x7FFF) << 16) | struct.unpack_from("<H", data, p)[0]; p += 2
            out.append(data[p:p + 2 * n].decode("utf-16-le", "replace"))
    return out


# android: attribute resource ids
ATTR_LABEL, ATTR_ICON, ATTR_NAME, ATTR_VALUE = 0x01010001, 0x01010002, 0x01010003, 0x01010024
ATTR_VERSION_NAME = 0x0101021c


def parse_axml(data):
    """Elements of a binary XML file as (name, {attr: (type, data, string)}) in document order."""
    strings, resmap, elements = [], [], []
    off = struct.unpack_from("<H", data, 2)[0]
    while off + 8 <= len(data):
        ctype, _, size = struct.unpack_from("<HHI", data, off)
        if size == 0:
            break
        if ctype == 0x0001:
            strings = _string_pool(data, off)
        elif ctype == 0x0180:
            resmap = list(struct.unpack_from("<%dI" % ((size - 8) // 4), data, off + 8))
        elif ctype == 0x0102:
            ext = off + 16
            _, name, astart, asize, acount = struct.unpack_from("<IIHHH", data, ext)
            attrs = {}
            for i in range(acount):
                a = ext + astart + i * asize
                _, aname, raw, _, _, dtype, value = struct.unpack_from("<IIIHBBI", data, a)
                key = resmap[aname] if aname < len(resmap) and resmap[aname] else strings[aname]
                text = strings[raw] if raw != 0xFFFFFFFF else (strings[value] if dtype == 0x03 else None)
                attrs[key] = (dtype, value, text)
            elements.append((strings[name], attrs))
        off += size
    return elements


def parse_arsc(data):
    """resources.arsc as {resource id: [(language, density, (type, data))]} for all configs."""
    table = {}
    _, header_size, _ = struct.unpack_from("<HHI", data, 0)
    off = header_size
    global_strings = []
    while off + 8 <= len(data):
        ctype, hsize, size = struct.unpack_from("<HHI", data, off)
        if ctype == 0x0001:
            global_strings = _string_pool(data, off)
        elif ctype == 0x0200:
            pkg_id = struct.unpack_from("<I", data, off + 8)[0]
            p = off + hsize
            end = off + size
            while p + 8 <= end:
                t, th, ts = struct.unpack_from("<HHI", data, p)
                if t == 0x0201:
                    type_id, flags = data[p + 8], data[p + 9]
                    count, entries_start = struct.unpack_from("<II", data, p + 12)
                    cfg = p + 20
                    lang = data[cfg + 8:cfg + 10].rstrip(b"\0").decode("ascii", "replace")
                    density = struct.unpack_from("<H", data, cfg + 14)[0]
                    idx_base = p + th
                    if flags & 0x01:      # sparse: (entry index, offset / 4) pairs
                        pairs = [struct.unpack_from("<HH", data, idx_base + 4 * i) for i in range(count)]
                        slots = [(e, o * 4) for e, o in pairs]
                    elif flags & 0x02:    # 16-bit offsets / 4
                        raw = struct.unpack_from("<%dH" % count, data, idx_base)
                        slots = [(i, o * 4) for i, o in enumerate(raw) if o != 0xFFFF]
                    else:
                        raw = struct.unpack_from("<%dI" % count, data, idx_base)
                        slots = [(i, o) for i, o in enumerate(raw) if o != 0xFFFFFFFF]
                    for index, o in slots:
                        e = p + entries_start + o
                        esize, eflags = struct.unpack_from("<HH", data, e)
                        if eflags & 0x0008:   # compact entry: type in the flags, data follows
                            value = (eflags >> 8, struct.unpack_from("<I", data, e + 4)[0])
                        elif eflags & 0x0001:  # complex (bag): not a plain value
                            continue
                        else:
                            _, _, dtype, vdata = struct.unpack_from("<HBBI", data, e + esize)
                            value = (dtype, vdata)
                        rid = (pkg_id << 24) | (type_id << 16) | index
                        table.setdefault(rid, []).append((lang, density, value))
                p += ts
        off += size
    return table, global_strings


def resolve_string(table, strings, rid, depth=0):
    configs = table.get(rid, [])
    for want in ("", "en"):
        for lang, _, (dtype, value) in configs:
            if lang == want:
                if dtype == 0x03:
                    return strings[value]
                if dtype == 0x01 and depth < 5:
                    return resolve_string(table, strings, value, depth + 1)
    return None


def resolve_icon_paths(table, strings, rid, depth=0):
    """Files (res/...) a drawable/mipmap id points to, highest density first."""
    out = []
    for _, density, (dtype, value) in table.get(rid, []):
        if dtype == 0x03:
            out.append((density if density < 0xFFF0 else 0, strings[value]))
        elif dtype == 0x01 and depth < 5:
            out += [(0, p) for p in resolve_icon_paths(table, strings, value, depth + 1)]
    return [p for _, p in sorted(out, key=lambda x: -x[0])]


# ---------------------------------------------------------------- APK inspection

def inspect_apk(path):
    try:
        z = zipfile.ZipFile(path)
    except (zipfile.BadZipFile, OSError) as e:
        raise Refused("Not an Android app file (%s)." % e)
    names = set(z.namelist())
    if "AndroidManifest.xml" not in names:
        raise Refused("Not an Android app: it has no AndroidManifest.xml.")
    elements = parse_axml(z.read("AndroidManifest.xml"))
    manifest = next((a for n, a in elements if n == "manifest"), {})
    app = next((a for n, a in elements if n == "application"), {})
    package = (manifest.get("package") or (None, None, None))[2]
    version = (manifest.get(ATTR_VERSION_NAME) or (None, None, None))[2]
    meta = {}
    for n, a in elements:
        if n == "meta-data" and ATTR_NAME in a:
            meta[a[ATTR_NAME][2]] = a.get(ATTR_VALUE)
    split_required = "com.android.vending.splits.required" in meta
    uses_gms = any(k and k.startswith("com.google.android.gms") for k in meta)

    abis = sorted({n.split("/")[1] for n in names if n.startswith("lib/") and n.count("/") >= 2})
    arm64 = not abis or "arm64-v8a" in abis

    label, icon = None, None
    table, strings = ({}, [])
    if "resources.arsc" in names:
        try:
            table, strings = parse_arsc(z.read("resources.arsc"))
        except (struct.error, IndexError):
            pass
    lab = app.get(ATTR_LABEL)
    if lab:
        label = lab[2] if lab[0] == 0x03 else resolve_string(table, strings, lab[1]) if lab[0] == 0x01 else None
    ic = app.get(ATTR_ICON)
    if ic and ic[0] == 0x01:
        for p in resolve_icon_paths(table, strings, ic[1]):
            if p.endswith(".png") and p in names:
                icon = p
                break
    return {
        "package": package,
        "name": label or package,
        "version": version,
        "abis": abis,
        "arm64": arm64,
        "split": split_required,
        "google_services": uses_gms,
        "icon": icon,
    }


def check_runnable(info):
    if not info["package"]:
        raise Refused("The app has no package name.")
    if not info["arm64"]:
        raise Refused("%s has no 64-bit ARM (arm64-v8a) code, only %s, so it can't run on this device."
                      % (info["name"], ", ".join(info["abis"])))
    if info["split"]:
        raise Refused("%s is split into several APK files (an app bundle). Lepton installs single APKs "
                      "only; look for a universal APK of it." % info["name"])


def unpack_xapk(path, workdir):
    """A single-APK .xapk: extract the APK and its OBB files. Returns (apk path, [obb paths])."""
    try:
        z = zipfile.ZipFile(path)
    except (zipfile.BadZipFile, OSError) as e:
        raise Refused("Not an XAPK file (%s)." % e)
    apks = [n for n in z.namelist() if n.endswith(".apk") and "/" not in n]
    if len(apks) != 1:
        raise Refused("This XAPK holds %d APK files (a split app). Lepton installs single APKs only."
                      % len(apks))
    z.extract(apks[0], workdir)
    obbs = []
    for n in z.namelist():
        if n.lower().endswith(".obb"):
            z.extract(n, workdir)
            obbs.append(os.path.join(workdir, n))
    return os.path.join(workdir, apks[0]), obbs


# ---------------------------------------------------------------- Steam (CEF remote debugging)

def cef_eval(expression):
    try:
        targets = json.load(urllib.request.urlopen("http://%s:%d/json" % CEF, timeout=5))
    except OSError:
        raise Refused("Steam isn't running. Start Steam, then try again.")
    url = next((t["webSocketDebuggerUrl"] for t in targets if t.get("title") == "SharedJSContext"), None)
    if not url:
        raise Refused("Steam hasn't finished starting. Try again in a moment.")
    path = url.split("%s:%d" % CEF, 1)[-1] if "%s:%d" % CEF in url else "/" + url.split("/", 3)[3]
    s = socket.create_connection(CEF, timeout=30)
    key = base64.b64encode(os.urandom(16)).decode()
    s.sendall(("GET %s HTTP/1.1\r\nHost: %s:%d\r\nUpgrade: websocket\r\nConnection: Upgrade\r\n"
               "Sec-WebSocket-Key: %s\r\nSec-WebSocket-Version: 13\r\n\r\n" % (path, CEF[0], CEF[1], key)).encode())
    buf = b""
    while b"\r\n\r\n" not in buf:
        chunk = s.recv(4096)
        if not chunk:
            raise Refused("Steam refused the connection.")
        buf += chunk
    rest = [buf.split(b"\r\n\r\n", 1)[1]]

    def recvn(n):
        while len(rest[0]) < n:
            chunk = s.recv(65536)
            if not chunk:
                raise Refused("Steam closed the connection.")
            rest[0] += chunk
        out, rest[0] = rest[0][:n], rest[0][n:]
        return out

    msg = json.dumps({"id": 1, "method": "Runtime.evaluate",
                      "params": {"expression": expression, "awaitPromise": True, "returnByValue": True}}).encode()
    n = len(msg)
    hdr = bytes([0x81]) + (bytes([0x80 | n]) if n < 126 else bytes([0x80 | 126]) + struct.pack(">H", n)
                           if n < 65536 else bytes([0x80 | 127]) + struct.pack(">Q", n))
    mask = os.urandom(4)
    s.sendall(hdr + mask + bytes(b ^ mask[i % 4] for i, b in enumerate(msg)))
    while True:
        payload = b""
        while True:
            b0, b1 = recvn(2)
            n = b1 & 0x7F
            if n == 126:
                n = struct.unpack(">H", recvn(2))[0]
            elif n == 127:
                n = struct.unpack(">Q", recvn(8))[0]
            payload += recvn(n)
            if b0 & 0x80:
                break
        reply = json.loads(payload)
        if reply.get("id") == 1:
            s.close()
            result = reply.get("result", {})
            if "exceptionDetails" in result:
                raise Refused("Steam couldn't add the game: %s"
                              % result["exceptionDetails"].get("exception", {}).get("description", "error"))
            return result.get("result", {}).get("value")


def add_steam_shortcut(name, apk, start_dir, icon, known_appid):
    js = """(async () => {
  const name = %s, exe = %s, dir = %s, icon = %s, known = %s, tool = %s;
  let id = 0;
  if (known && typeof appStore !== "undefined" && appStore.GetAppOverviewByAppID(known))
    id = known;
  if (!id)
    id = await SteamClient.Apps.AddShortcut(name, exe, dir, "");
  SteamClient.Apps.SetShortcutName(id, name);
  SteamClient.Apps.SetShortcutExe(id, '"' + exe + '"');
  SteamClient.Apps.SetShortcutStartDir(id, dir);
  SteamClient.Apps.SetShortcutLaunchOptions(id, "");
  if (icon && SteamClient.Apps.SetShortcutIcon)
    SteamClient.Apps.SetShortcutIcon(id, icon);
  SteamClient.Apps.SpecifyCompatTool(id, tool);
  return id;
})()""" % tuple(json.dumps(v) for v in (name, apk, start_dir, icon, known_appid or 0, TOOL))
    appid = cef_eval(js)
    if not appid:
        raise Refused("Steam didn't create the shortcut.")
    return appid


# ---------------------------------------------------------------- commands

def cmd_inspect(path):
    return inspect_apk(path)


def cmd_add(path, notify=False):
    path = os.path.abspath(path)
    with tempfile.TemporaryDirectory() as tmp:
        obbs = []
        apk = path
        if path.lower().endswith(".xapk"):
            apk, obbs = unpack_xapk(path, tmp)
        info = inspect_apk(apk)
        check_runnable(info)

        folder = os.path.join(GAMES_DIR, info["package"])
        os.makedirs(folder, exist_ok=True)
        target = os.path.join(folder, info["package"] + ".apk")
        if os.path.abspath(apk) != target:
            shutil.copyfile(apk, target + ".part")
            os.replace(target + ".part", target)
        if obbs:
            obb_dir = os.path.join(folder, "obb")
            os.makedirs(obb_dir, exist_ok=True)
            for o in obbs:
                shutil.copyfile(o, os.path.join(obb_dir, os.path.basename(o)))

        icon_path = None
        if info["icon"]:
            icon_path = os.path.join(folder, "icon.png")
            with zipfile.ZipFile(target) as z, open(icon_path, "wb") as f:
                f.write(z.read(info["icon"]))

    appid_file = os.path.join(folder, ".steam-appid")
    known = None
    try:
        known = int(open(appid_file).read().strip())
    except (OSError, ValueError):
        pass
    appid = add_steam_shortcut(info["name"], target, folder, icon_path, known)
    with open(appid_file, "w") as f:
        f.write("%d\n" % appid)

    result = dict(info, apk=target, appid=appid)
    if notify:
        body = "%s is in your Steam library, set to run with Lepton (Kettle)." % info["name"]
        if info["google_services"]:
            body += " It uses Google Play services, which aren't available, so it may not start."
        send_notification("Android game added", body, icon_path or "steam")
    return result


def send_notification(title, body, icon):
    """A desktop notification, without waiting: Game Mode has no notification service."""
    try:
        subprocess.Popen(["notify-send", "--app-name=Steam", "--icon=" + icon, title, body],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    except OSError:
        pass


def _get_json(url):
    req = urllib.request.Request(url, headers={"User-Agent": USER_AGENT})
    with urllib.request.urlopen(req, timeout=30) as r:
        return json.load(r)


def cmd_fdroid_search(text):
    try:
        found = _get_json(FDROID_SEARCH + urllib.parse.quote(text)).get("apps", [])
    except OSError as e:
        raise Refused("Couldn't reach F-Droid (%s)." % getattr(e, "reason", e))
    apps = []
    for a in found:
        package = a.get("url", "").rstrip("/").rsplit("/", 1)[-1]
        if package:
            apps.append({"package": package, "name": a.get("name") or package,
                         "summary": a.get("summary", ""), "icon": a.get("icon", "")})
    return {"apps": apps}


def cmd_fdroid_add(package):
    try:
        meta = _get_json("%s/api/v1/packages/%s" % (FDROID, urllib.parse.quote(package)))
    except OSError as e:
        raise Refused("F-Droid doesn't have %s (%s)." % (package, getattr(e, "reason", e)))
    builds = meta.get("packages", [])
    if not builds:
        raise Refused("F-Droid has no downloads for %s." % package)
    suggested = meta.get("suggestedVersionCode")
    newest = next((b["versionName"] for b in builds if b["versionCode"] == suggested), builds[0]["versionName"])
    # the newest version's builds first (F-Droid publishes one per processor type for some apps)
    candidates = [b["versionCode"] for b in builds if b["versionName"] == newest]
    candidates.sort(key=lambda c: c != suggested)
    last_error = None
    with tempfile.TemporaryDirectory() as tmp:
        for code in candidates[:4]:
            apk = os.path.join(tmp, "%s_%d.apk" % (package, code))
            try:
                req = urllib.request.Request("%s/repo/%s_%d.apk" % (FDROID, package, code),
                                             headers={"User-Agent": USER_AGENT})
                with urllib.request.urlopen(req, timeout=60) as r, open(apk, "wb") as f:
                    shutil.copyfileobj(r, f)
            except OSError as e:
                last_error = Refused("Couldn't download %s (%s)." % (package, getattr(e, "reason", e)))
                continue
            try:
                check_runnable(inspect_apk(apk))
            except Refused as e:
                last_error = e
                continue
            return cmd_add(apk)
    raise last_error or Refused("No build of %s can run on this device." % package)


def main(argv):
    notify = "--notify" in argv
    args = [a for a in argv if a != "--notify"]
    commands = {"inspect": cmd_inspect, "add": lambda p: cmd_add(p, notify),
                "fdroid-search": cmd_fdroid_search, "fdroid-add": cmd_fdroid_add}
    if len(args) != 2 or args[0] not in commands:
        print(__doc__.strip(), file=sys.stderr)
        return 2
    try:
        result = commands[args[0]](args[1])
        print(json.dumps(dict(ok=True, **result)))
        return 0
    except Refused as e:
        print(json.dumps({"ok": False, "error": str(e)}))
        if notify:
            send_notification("Couldn't add the Android game", str(e), "dialog-error")
        return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
