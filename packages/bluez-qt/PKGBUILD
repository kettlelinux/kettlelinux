# BluezQt at deckard's KF6 version (6.14), which deckard doesn't ship: Plasma Mobile's shell
# (the Thor's bottom screen) imports its QML module, and without it none of the shell's own
# QML types load (home screen, panels). Arch's PKGBUILD, without the API docs.
pkgname=bluez-qt
pkgver=6.14.0
pkgrel=1
pkgdesc='Qt wrapper for Bluez 5 DBus API'
arch=(aarch64)
url='https://community.kde.org/Frameworks'
license=(LGPL-2.0-only LGPL-3.0-only)
depends=(bluez gcc-libs glibc qt6-base qt6-declarative)
makedepends=(cmake ninja extra-cmake-modules qt6-tools)
source=(https://download.kde.org/stable/frameworks/${pkgver%.*}/$pkgname-$pkgver.tar.xz)
sha256sums=('ea845f930ecc7c4f259c478ae6680c79395dcb2598ee3f5b45bced6df277f9d5')

build() {
  cmake -B build -S $pkgname-$pkgver -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DBUILD_TESTING=OFF
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
