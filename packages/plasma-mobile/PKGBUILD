# Plasma Mobile's shell, at the base's Plasma version (6.6.2): the touch shell on the Thor's
# bottom screen in Game Mode (device/thor: bottom-shell). It only runs there, so it is no login
# session, and its kded modules go: kded loads them in the desktop too, where they'd run the
# mobile first-start wizard and plasma-mobile-envmanager (which rewrites kwinrc/kdeglobals;
# bottom-shell runs it itself, on the bottom screen's own config). bluez-qt is a hard
# dependency: the shell's QML module imports it, and without it none of the shell's own types
# load. The rest of what the shell uses (plasma-nm, plasma-pa, milou, kscreenlocker) is part of
# the desktop already.
# 0001 (ours): the volume OSD's audio applet only while the OSD shows (its meters kept the
# speaker, the mic and the audio DSP running). 6.6 hides the action drawer's window while it is
# closed, which is what our earlier ActionDrawer patch did for its contents.
pkgname=plasma-mobile
pkgver=6.6.2
pkgrel=1
pkgdesc='Phone shell for Plasma'
arch=(aarch64)
url='https://invent.kde.org/plasma/plasma-mobile'
license=(GPL-2.0-or-later LGPL-2.0-or-later)
depends=(bluez-qt gcc-libs glibc kauth kcmutils kconfig kcoreaddons kdbusaddons kglobalaccel ki18n kio
         kirigami kirigami-addons kitemmodels kjobwidgets knotifications kpackage kpipewire
         kscreenlocker kservice ksvg kwayland kwin layer-shell-qt libepoxy libkscreen libplasma
         libxcb milou modemmanager-qt networkmanager-qt plasma-activities plasma-nano plasma-nm
         plasma-pa plasma-workspace qcoro qt6-base qt6-declarative qt6-sensors qt6-wayland
         systemd-libs)
makedepends=(cmake ninja extra-cmake-modules plasma-wayland-protocols qt6-tools)
source=(https://download.kde.org/stable/plasma/$pkgver/$pkgname-$pkgver.tar.xz
        0001-volumeosd-keep-the-audio-applet-s-volume-meters-off-.patch)
sha256sums=('ed499ed91fdf02f2ba18ad5671e5794af73ac70f72fcb458f9c87acc3f713a2b'
            '32233025d8c3e1cc4a06b2b142501a25064ec01aa16db92dbfec46c1e2793c77')

prepare() {
  local p
  for p in 0*.patch; do
    patch -d $pkgname-$pkgver -p1 --fuzz=0 <"$p"
  done
}

build() {
  cmake -B build -S $pkgname-$pkgver -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_INSTALL_LIBEXECDIR=lib \
    -DBUILD_TESTING=OFF
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  rm -r "$pkgdir"/usr/share/wayland-sessions
  rm "$pkgdir"/usr/lib/qt6/plugins/kf6/kded/kded_plasma_mobile_{start,autodetect_apn}.so
}
