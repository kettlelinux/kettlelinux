# Plasma Mobile's shell, at deckard's Plasma version (6.2.5): the touch shell on the Thor's
# bottom screen in Game Mode (device/thor: bottom-shell). It only runs there, so it is no login
# session, and its kded modules go: kded loads them in the desktop too, where they'd run the
# mobile first-start wizard and plasma-mobile-envmanager (which rewrites kwinrc/kdeglobals;
# bottom-shell runs it itself, on the bottom screen's own config). bluez-qt (packages/bluez-qt;
# deckard lacks it) is a hard dependency: the shell's QML module imports it, and without it none
# of the shell's own types load. The rest of what the shell uses (plasma-nm, plasma-pa, milou,
# kscreenlocker) is part of the desktop already.
pkgname=plasma-mobile
pkgver=6.2.5
pkgrel=3
pkgdesc='Phone shell for Plasma'
arch=(aarch64)
url='https://invent.kde.org/plasma/plasma-mobile'
license=(GPL-2.0-or-later LGPL-2.0-or-later)
depends=(bluez-qt gcc-libs glibc kcmutils kconfig kcoreaddons kdbusaddons kglobalaccel ki18n kio
         kirigami kirigami-addons kitemmodels kjobwidgets knotifications kpackage kpipewire
         kscreenlocker kservice ksvg kwayland kwin layer-shell-qt libepoxy libkscreen libplasma
         libxcb milou modemmanager-qt networkmanager-qt plasma-activities plasma-nano plasma-nm
         plasma-pa plasma-workspace qcoro qt6-base qt6-declarative qt6-sensors qt6-wayland
         systemd-libs)
makedepends=(cmake ninja extra-cmake-modules plasma-wayland-protocols qt6-tools)
source=(https://download.kde.org/stable/plasma/$pkgver/$pkgname-$pkgver.tar.xz
        0001-actiondrawer-hide-the-closed-drawer-s-contents-not-o.patch)
sha256sums=('aeceb9bab392fc3d9fdea5913c202a11078c4060794927722581bd88ec6518d2'
            'e0cdba658709f4fda274d8a345fe4fe609872b527875dab092955b1199b745f9')

prepare() {
  local p
  for p in 0*.patch; do
    patch -d $pkgname-$pkgver -p1 --fuzz=0 <"$p"
  done
}

build() {
  cmake -B build -S $pkgname-$pkgver -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_INSTALL_LIBEXECDIR=lib \
    -DBUILD_TESTING=OFF
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  rm -r "$pkgdir"/usr/share/wayland-sessions
  rm "$pkgdir"/usr/lib/qt6/plugins/kf6/kded/kded_plasma_mobile_{start,autodetect_apn}.so
}
