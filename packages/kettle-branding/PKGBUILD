# Kettle Linux branding, all built from the SVG art in art/ (our own, BSD-3-Clause):
#   kettle-plymouth-theme  the boot splash (Plymouth script theme); plymouth defaults to it.
#                          The wordmark is plain strokes: neither build nor boot needs a font.
#   kettle-steam-startup   the Steam startup movie: the splash's picture building up again with
#                          a boil and a chime, rendered frame by frame (render-startup.py) and
#                          encoded like Valve's own movies (VP9 + Opus, 1920x1080 at 60 fps).
#                          run-steam puts it where Steam looks for overrides.
#   kettle-plasma-splash   the Plasma (KSplash) splash screen: the boot splash's picture again,
#                          as a QML scene (plasma/), so the desktop's startup matches the boot.
#   kettle-wallpaper       the default Plasma wallpaper (desktop and lock screen): the kettle as
#                          a faint ghost on black (render-wallpaper.sh), so OLED screens keep
#                          their pixels off and a desktop left open doesn't burn the logo in.
pkgbase=kettle-branding
pkgname=(kettle-plymouth-theme kettle-steam-startup kettle-plasma-splash kettle-wallpaper)
pkgver=1.0.0
pkgrel=4
arch=(any)
license=(BSD-3-Clause)
makedepends=(librsvg ffmpeg python)

build() {
  # splash art sized for a 1920x1080 screen (the Portal); kettle.script scales for others
  rsvg-convert -w 320 "$startdir/art/kettle.svg" -o kettle.png
  rsvg-convert -w 60 "$startdir/art/steam.svg" -o steam.png
  rsvg-convert "$startdir/art/wordmark.svg" -o wordmark.png
  rsvg-convert "$startdir/art/progress-track.svg" -o progress-track.png
  rsvg-convert "$startdir/art/progress-fill.svg" -o progress-fill.png

  # Plasma splash art at twice its 1920x1080 size: the desktop runs at scale 1.5 on the Portal
  mkdir -p plasma
  rsvg-convert -w 640 "$startdir/art/kettle.svg" -o plasma/kettle.png
  rsvg-convert -w 120 "$startdir/art/steam.svg" -o plasma/steam.png
  rsvg-convert -z 2 "$startdir/art/wordmark.svg" -o plasma/wordmark.png
  rsvg-convert "$startdir/art/glow.svg" -o plasma/glow.png

  # wallpaper at the devices' screens (1920x1080; the Thor's bottom screen 1240x1080), and
  # common others for external displays: Plasma picks the closest to each screen
  mkdir -p wallpaper
  local size
  for size in 1240x1080 1280x720 1280x800 1920x1080 1920x1200 2560x1440 3840x2160 1080x1920; do
    sh "$startdir/render-wallpaper.sh" "$startdir/art/kettle.svg" "${size%x*}" "${size#*x}" \
      "wallpaper/$size.png"
  done

  python "$startdir/render-startup.py" "$startdir/art" startup.webm
}

package_kettle-plymouth-theme() {
  pkgdesc='Kettle Linux boot splash'
  depends=(plymouth)
  local dir="$pkgdir/usr/share/plymouth/themes/kettle"
  install -Dm644 "$startdir/kettle.plymouth" "$startdir/kettle.script" -t "$dir"
  install -Dm644 kettle.png steam.png wordmark.png progress-track.png progress-fill.png -t "$dir"
  install -Dm644 "$startdir/LICENSE" -t "$pkgdir/usr/share/licenses/$pkgname"
}

package_kettle-steam-startup() {
  pkgdesc='Kettle Linux Steam startup movie'
  install -Dm644 startup.webm "$pkgdir/usr/share/kettle/steam/startup.webm"
  install -Dm644 "$startdir/LICENSE" -t "$pkgdir/usr/share/licenses/$pkgname"
}

package_kettle-plasma-splash() {
  pkgdesc='Kettle Linux Plasma splash screen'
  depends=(plasma-workspace qt6-declarative)
  local dir="$pkgdir/usr/share/plasma/look-and-feel/org.kettle.splash"
  install -Dm644 "$startdir/plasma/metadata.json" -t "$dir"
  install -Dm644 "$startdir/plasma/contents/splash/Splash.qml" -t "$dir/contents/splash"
  install -Dm644 plasma/kettle.png plasma/steam.png plasma/wordmark.png plasma/glow.png \
    -t "$dir/contents/splash/images"
  # the default for every user, set in their ksplashrc at session start (see the script)
  install -Dm644 "$startdir/plasma/kettle-splash.sh" -t "$pkgdir/etc/xdg/plasma-workspace/env"
  # os-release LOGO=kettle: the distribution logo, and the new user's picture (holo-create-homedir)
  install -Dm644 plasma/kettle.png "$pkgdir/usr/share/pixmaps/kettle.png"
  install -Dm644 "$startdir/LICENSE" -t "$pkgdir/usr/share/licenses/$pkgname"
}

package_kettle-wallpaper() {
  pkgdesc='Kettle Linux default wallpaper'
  depends=(plasma-workspace)
  local dir="$pkgdir/usr/share/wallpapers/Kettle"
  install -Dm644 "$startdir/wallpaper/metadata.json" -t "$dir"
  install -Dm644 wallpaper/*.png -t "$dir/contents/images"
  install -Dm644 wallpaper/1920x1080.png "$dir/contents/screenshot.png"
  install -Dm644 "$startdir/wallpaper/plasmarc" -t "$pkgdir/etc/xdg"
  install -Dm644 "$startdir/LICENSE" -t "$pkgdir/usr/share/licenses/$pkgname"
}
