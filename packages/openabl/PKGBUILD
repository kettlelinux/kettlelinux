# OpenABL (github.com/OpenHandheldCollective/OpenABL): Qualcomm's Android bootloader (ABL) with a
# graphical boot menu and standard Linux boot, which starts Kettle's steamcl (\EFI\BOOT\BOOTAA64.EFI)
# from the internal storage or the SD card, so updates keep their A/B fallback. This package only
# ships upstream's release images and the catalogue for the SoCs Kettle runs on: nothing is built
# here, a new release is a new _tag and hash. kettle-abl-update (packages/rocknix-abl) installs it
# over the stock bootloader (saving that first) or a ROCKNIX ABL, keeps it up to date and puts the
# stock one back (--abl openabl), and Device Settings' System tab offers that (behind both volume
# keys).
#
# Upstream's Start tries a drive's Boot Loader Spec entries before its extlinux labels and both
# before its default file. Kettle's drives keep an extlinux.conf for U-Boot, so Kettle writes a
# BLS entry for steamcl next to it (loader/entries/kettle.conf, `efi /EFI/BOOT/BOOTAA64.EFI`;
# kettle-boot-legacy), which OpenABL then picks first. That replaces the boot order change of
# Kettle's fork (1.0-kettle.1), which is no longer used.
# releases.tsv: each image's size and SHA-256, from the release tarballs, for every SoC they build.
pkgname=openabl
pkgver=1.2
_tag=v$pkgver
pkgrel=1
pkgdesc='OpenABL: Qualcomm ABL with a boot menu and standard Linux boot, for kettle-abl-update to install'
arch=(any)
url='https://github.com/OpenHandheldCollective/OpenABL'
license=(GPL-3.0-or-later)
depends=(rocknix-abl)  # kettle-abl-update
options=(!strip)
source=("openabl-$_tag.tar.gz::$url/releases/download/$_tag/openabl-$_tag.tar.gz"
        releases.tsv)
sha256sums=('28cb97d1b387f28ddba28ed57fdc7d8b1c2ac2cdcd26af9c672620d41abddd4f'
            'ad5ff374e8a33f6fa05bce46f6828ebe292949cbf420c8a0dd6fdfb8aafbda28')
_socs=(SM8250 SM8550 SM8750)   # the SoCs Kettle's devices have (device.conf ABL_SOC)

package() {
  local d="$pkgdir/usr/share/kettle/openabl" s f
  install -d "$d"
  for s in "${_socs[@]}"; do
    f="$srcdir/openabl-$_tag/$s/abl_signed-$s.elf"
    # the tarball's own checksum, and the catalogue's, must agree
    (cd "${f%/*}" && sha256sum -c --quiet "${f##*/}.sha256")
    grep -qP "^[^\t]+\t$s\t$(stat -c %s "$f")\t$(sha256sum "$f" | cut -d' ' -f1)$" releases.tsv
    install -m644 "$f" "$d/"
  done
  install -m644 releases.tsv "$d/"
  install -Dm644 "$srcdir/openabl-$_tag/LICENSE" "$srcdir/openabl-$_tag/LICENSES.md" -t "$pkgdir/usr/share/licenses/$pkgname"
  cp -r "$srcdir/openabl-$_tag/LICENSES" "$pkgdir/usr/share/licenses/$pkgname/"
}
