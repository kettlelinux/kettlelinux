# Plymouth boot splash, which no deckard snapshot ships. Based on Arch's PKGBUILD; no new
# dependencies or meson options since 24.004.60.
# plymouthd starts from the initramfs (Kettle's own mkinitcpio hook, "plymouth" in HOOKS), so
# the splash comes up as soon as the display driver is; it quits before SDDM starts Game Mode
# (sddm.service is After=plymouth-quit.service), keeping its last frame on screen until the
# next one (Kettle's plymouth-quit drop-in: --retain-splash). The DRM
# renderer follows the panel's "panel orientation" property, so the Portal's 270 degree
# panel shows the splash in landscape. Default theme: kettle (packages/kettle-plymouth-theme).
pkgname=plymouth
pkgver=26.134.222
pkgrel=1
pkgdesc='Graphical boot splash screen'
arch=(aarch64)
url='https://www.freedesktop.org/wiki/Software/Plymouth/'
license=(GPL-2.0-or-later)
depends=(bash cairo fontconfig freetype2 glibc libdrm libevdev libpng libxkbcommon pango
         systemd-libs xkeyboard-config)
makedepends=(meson)
backup=(etc/plymouth/plymouthd.conf)
source=(https://www.freedesktop.org/software/plymouth/releases/$pkgname-$pkgver.tar.xz
        0001-drm-leave-gamma-alone.patch
        plymouth.initcpio_install
        plymouth.initcpio_hook)
sha256sums=('6ee1068216c5047923fabf0f6aa583e9d77cab383077358df3fc22f2ee398bb0'
            '04324314314c1816044f63c63463059b4e3cefd7aab4e3952d5faee7f2430ff6'
            '54cd3ebc316ccf25b0ee8d7ca6e75691d8ec79e083f0a2b6a66bcba218896910'
            '95e78c198427846702c657cb2283d6fb31d7edee571211c1af3ca5939912777e')

prepare() {
  cd $pkgname-$pkgver
  # the gamma table plymouth loads outlives it on the msm DPU and stalls KWin's page flips
  patch -Np1 -i ../0001-drm-leave-gamma-alone.patch
  sed -i 's/^Theme=spinner$/Theme=kettle/' src/plymouthd.defaults
  grep -qx 'Theme=kettle' src/plymouthd.defaults
}

build() {
  # no GTK (X11 preview renderer) and no man pages; black behind the fallback themes too
  arch-meson $pkgname-$pkgver build \
    -D gtk=disabled \
    -D docs=false \
    -D udev=enabled \
    -D release-file=/etc/os-release \
    -D background-color=0x000000 \
    -D background-start-color-stop=0x000000 \
    -D background-end-color-stop=0x000000
  meson compile -C build
}

package() {
  meson install -C build --destdir "$pkgdir"
  rm -r "$pkgdir/run"
  install -Dm644 plymouth.initcpio_install "$pkgdir/usr/lib/initcpio/install/plymouth"
  install -Dm644 plymouth.initcpio_hook "$pkgdir/usr/lib/initcpio/hooks/plymouth"
}
