From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: gennro <gennro2004@gmail.com>
Date: Tue, 6 Oct 2026 06:55:59 -0500
Subject: [PATCH] steamcompmgr: add refresh_hz, a fixed refresh rate

Steam picks the refresh rate from its frame rate slider, and ui_refresh_hz
picks another while no game is open, so the rate changes as games open
and close and as Steam's own windows take focus. Each change waits for a
repaint 600 ms after the rate last matched, so a still screen can stay at
the old rate.

Add a refresh_hz ConVar (also settable as gamescope_refresh_hz in the
environment or with gamescopectl): when it names one of the display's
valid refresh rates, the display always runs at that rate, whatever Steam
or ui_refresh_hz ask for. Setting it repaints, and the switch skips the
delay (a fixed rate can't flicker), so it takes effect at once. The
default, 0, leaves the refresh rate to Steam and ui_refresh_hz.
---
 src/steamcompmgr.cpp | 15 ++++++++++++++-
 1 file changed, 14 insertions(+), 1 deletion(-)

diff --git a/src/steamcompmgr.cpp b/src/steamcompmgr.cpp
index f3350de2..ce1834c1 100644
--- a/src/steamcompmgr.cpp
+++ b/src/steamcompmgr.cpp
@@ -1129,6 +1129,13 @@ static gamescope::ConCommand cc_debug_force_repaint( "debug_force_repaint", "For
 	hasRepaint = true;
 });
 
+// A rate set here holds on every screen state: the rate only changes on a repaint, so ask for one
+static gamescope::ConVar<int> cv_refresh_hz( "refresh_hz", 0, "Refresh rate (Hz) to always run the display at, if the display supports it, whatever Steam asks for. 0 lets the refresh rate follow Steam (and ui_refresh_hz).",
+[]( gamescope::ConVar<int> & )
+{
+	hasRepaint = true;
+});
+
 // The main loop dumps this on the steamcompmgr thread, which owns the
 // focus state and the X connections.
 static std::atomic<bool> g_bPendingFocusInfo = { false };
@@ -3480,6 +3487,12 @@ paint_all( global_focus_t *pFocus, bool async )
 		else if ( cv_ui_refresh_hz > 0 && !steamcompmgr_user_has_any_game_open() &&
 		          std::find( rates.begin(), rates.end(), uint32_t( cv_ui_refresh_hz ) ) != rates.end() )
 			nTargetRefreshHz = cv_ui_refresh_hz;
+		// refresh_hz overrides both, and switches at once: a fixed rate can't flicker back and forth,
+		// and a still screen may not repaint again after the delay
+		const bool bFixedRefresh = cv_refresh_hz > 0 &&
+			std::find( rates.begin(), rates.end(), uint32_t( cv_refresh_hz ) ) != rates.end();
+		if ( bFixedRefresh )
+			nTargetRefreshHz = cv_refresh_hz;
 
 		uint64_t now = get_time_in_nanos();
 
@@ -3495,7 +3508,7 @@ paint_all( global_focus_t *pFocus, bool async )
 		{
 			g_uDynamicRefreshEqualityTime = now;
 		}
-		else if ( g_uDynamicRefreshEqualityTime + g_uDynamicRefreshDelay < now )
+		else if ( bFixedRefresh || g_uDynamicRefreshEqualityTime + g_uDynamicRefreshDelay < now )
 		{
 			GetBackend()->HackTemporarySetDynamicRefresh( nTargetRefreshHz );
 		}
