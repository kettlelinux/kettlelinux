            '3311f3353848d99c11c9cd83aa75d1429f952864c4361d27b33e47cbdd2fdb71'
            '56b541730fb5d6d7f8cf033a321a5af83f228696dff52d631b28fdd0f2d83e98'
            'ada2309bea24c4034e5c09cb252bc5f85d1af31f9fd1d483fcd65d5ef10baa34')

prepare() {
  cd gamescope
  # submodules (wlroots, libliftoff, vkroots, libdisplay-info, openvr, reshade,
  # SPIRV-Headers) at the commits ad2763da pins
  git submodule update --init --recursive
  for p in "$srcdir"/0*.patch; do
    patch -p1 --fuzz=0 <"$p"
  done
  # glm and stb wraps, at the revisions their .wrap files pin (arch-meson disables downloads)
  meson subprojects download glm stb
}

build() {
  # gamescope requires libliftoff and vkroots bundled; wlroots and libdisplay-info are
  # bundled too, as in Valve's binary. Tests need catch2, which deckard doesn't have.
  # The version string comes out as 3.16.30+ ("+" = patched tree).
  arch-meson gamescope build \
    --buildtype release \
    --force-fallback-for=libliftoff,vkroots,wlroots,libdisplay-info \
    -Denable_tests=false \
    -Dbenchmark=disabled
  meson compile -C build
}

package() {
  meson install -C build --destdir "$pkgdir" --skip-subprojects
  # deckard's package ships neither the handheld display scripts nor the looks LUTs
  rm -r "$pkgdir"/usr/share/gamescope/{scripts,looks}
  install -Dm755 steamos-session-shell -t "$pkgdir/usr/bin"

  install -d "$pkgdir/usr/share/gamescope/reshade"
  cp -r GamescopeShaders/* "$pkgdir/usr/share/gamescope/reshade/"
  chmod -R u=rwX,go=rX "$pkgdir/usr/share/gamescope"

  install -Dm644 gamescope/LICENSE -t "$pkgdir/usr/share/licenses/$pkgname"
  # Qualcomm's BSD-3-Clause notice, also kept at the top of src/shaders/sgsr1.h
  sed -n '/^Copyright (c) 2023, 2025, Qualcomm/,/^SPDX-License-Identifier/p' \
    gamescope/src/shaders/sgsr1.h >"$pkgdir/usr/share/licenses/$pkgname/LICENSE.sgsr"
}
