From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: gennro <gennro2004@gmail.com>
Date: Sun, 27 Sep 2026 19:10:29 -0500
Subject: [PATCH] steamcompmgr: report mapped xdg-shell windows to Steam as
 focusable

Steam brings a game to the front once one of its windows shows up in
GAMESCOPE_FOCUSABLE_WINDOWS, and only Xwayland windows were reported
there. A native Wayland game (Lepton's Android window, launched by
Steam and in the game's app-steam-app scope) got its app ID from the
cgroup but Steam never saw it, so Game Mode stayed on the launch
spinner.

Report mapped xdg-shell toplevels in GAMESCOPE_FOCUSABLE_APPS and
GAMESCOPE_FOCUSABLE_WINDOWS. They have no X window id, so they are
listed with the top bit set on their xdg id (X ids fit in 29 bits),
and a GAMESCOPECTRL_BASELAYER_WINDOW naming that id focuses them. The
client's pid is recorded for the window triplet.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/steamcompmgr.cpp | 30 ++++++++++++++++++++++++------
 src/wlserver.cpp     |  1 +
 2 files changed, 25 insertions(+), 6 deletions(-)

diff --git a/src/steamcompmgr.cpp b/src/steamcompmgr.cpp
index 651ec9d0..5e7a0d23 100644
--- a/src/steamcompmgr.cpp
+++ b/src/steamcompmgr.cpp
@@ -4352,6 +4352,18 @@ static bool win_treat_as_per_window( steamcompmgr_win_t *w, gamescope::VirtualCo
 static void
 handle_desktop_window(steamcompmgr_win_t *w);
 
+// The window id Steam sees for a focusable window. X window ids fit in 29 bits, so xdg-shell
+// windows (which have none) are reported with the top bit set on their xdg id.
+static constexpr uint32_t k_unXdgSteamWindowBit = 0x80000000u;
+
+static uint32_t
+steam_window_id( steamcompmgr_win_t *w )
+{
+	if ( w->type == steamcompmgr_win_type_t::XDG )
+		return k_unXdgSteamWindowBit | w->xdg().id;
+	return w->xwayland().id;
+}
+
 static bool
 pick_primary_focus_and_override(
 	focus_t *out,
@@ -4374,10 +4386,11 @@ pick_primary_focus_and_override(
 			{
 				for ( steamcompmgr_win_t *focusable_window : vecPossibleFocusWindows )
 				{
-					if ( focusable_window->type != steamcompmgr_win_type_t::XWAYLAND )
+					if ( focusable_window->type != steamcompmgr_win_type_t::XWAYLAND &&
+						focusable_window->type != steamcompmgr_win_type_t::XDG )
 						continue;
 
-					if ( focusable_window->xwayland().id == focusControlWindow )
+					if ( steam_window_id( focusable_window ) == focusControlWindow )
 					{
 						focus = focusable_window;
 						localGameFocused = true;
@@ -5160,14 +5173,19 @@ determine_and_apply_focus( global_focus_t *pFocus )
 
 	for ( steamcompmgr_win_t *focusable_window : vecPossibleFocusWindows )
 	{
-		if ( focusable_window->type != steamcompmgr_win_type_t::XWAYLAND )
+		// Mapped xdg-shell toplevels (native Wayland games, e.g. Lepton's Android window) are
+		// reported too, so Steam brings them to the front instead of waiting on an X11 window.
+		bool bXdgApp = focusable_window->type == steamcompmgr_win_type_t::XDG &&
+			focusable_window->xdg().surface.mapped;
+
+		if ( focusable_window->type != steamcompmgr_win_type_t::XWAYLAND && !bXdgApp )
 			continue;
 
 		// Exclude windows that are useless (1x1), skip taskbar + pager or override redirect windows
 		// from the reported focusable windows to Steam.
-		if ( win_is_useless( focusable_window ) ||
+		if ( !bXdgApp && ( win_is_useless( focusable_window ) ||
 			win_skip_and_not_fullscreen( focusable_window ) ||
-			focusable_window->xwayland().a.override_redirect )
+			focusable_window->xwayland().a.override_redirect ) )
 			continue;
 
 		unsigned int unAppID = focusable_window->appID;
@@ -5188,7 +5206,7 @@ determine_and_apply_focus( global_focus_t *pFocus )
 		}
 
 		// list of [window, appid, pid] triplets
-		focusable_windows.push_back( focusable_window->xwayland().id );
+		focusable_windows.push_back( steam_window_id( focusable_window ) );
 		focusable_windows.push_back( focusable_window->appID );
 		focusable_windows.push_back( focusable_window->pid );
 	}
diff --git a/src/wlserver.cpp b/src/wlserver.cpp
index 3d7d123c..18f9e706 100644
--- a/src/wlserver.cpp
+++ b/src/wlserver.cpp
@@ -2020,6 +2020,7 @@ wlserver_xdg_surface_info* waylandy_type_surface_new(struct wl_client *client, s
 	{
 		pid_t nPid = 0;
 		wl_client_get_credentials( client, &nPid, nullptr, nullptr );
+		window->pid = nPid;
 		window->appID = gamescope::Process::GetAppIdFromPid( nPid );
 	}
 	window->_window_types.emplace<steamcompmgr_xdg_win_t>();
-- 
