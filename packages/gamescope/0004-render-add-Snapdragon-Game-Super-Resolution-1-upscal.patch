+				mediump vec4 r = textureGather(tex,rightCoord, 2);
+				mediump vec4 ud;
+				ud.xy = textureGather(tex,upCoord, 2).wz;
+				ud.zw = textureGather(tex,downCoord, 2).yx;
+				color.b = sgsrChannel(w, ud, l, r, invSum);
+			}
+		}
+	}
+
+	return color;
+}
