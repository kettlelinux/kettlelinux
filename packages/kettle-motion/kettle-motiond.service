[Unit]
Description=Motion sensors for Steam Input
# The ADSP's sensors, as kettle-hexagonrpcd.service: none on SM8250-era devices (the RP5 has no
# fastrpc-adsp, and its sensors are on the SLPI, fastrpc-sdsp)
ConditionPathExists=/dev/fastrpc-adsp
ConditionPathExists=!/dev/fastrpc-sdsp
Requires=kettle-hexagonrpcd.service
After=kettle-hexagonrpcd.service

[Service]
Type=dbus
BusName=org.kettlelinux.Motion1
ExecStart=/usr/lib/kettle-motion/kettle-motiond
Restart=on-failure
RestartSec=3
StateDirectory=kettle-motion
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
DevicePolicy=closed
DeviceAllow=/dev/uinput rw
RestrictAddressFamilies=AF_UNIX AF_QIPCRTR
