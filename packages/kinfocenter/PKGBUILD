# Info Center at deckard's Plasma version (6.2.5). deckard ships 6.0.4 (from Arch's 2024
# snapshot), which crashes in deckard's systemsettings 6.2.5 it runs in. Built without its
# handbook: deckard has no kdoctools.
pkgname=kinfocenter
pkgver=6.2.5
pkgrel=1
pkgdesc='A utility that provides information about a computer system'
arch=(aarch64)
url='https://kde.org/plasma-desktop/'
license=(LGPL-2.0-or-later)
depends=(aha clinfo dmidecode gcc-libs glibc glu iproute2 kauth kcmutils kconfig kcoreaddons
         kdeclarative ki18n kio kirigami kservice libpulse libusb mesa-utils qt6-base
         qt6-declarative sh solid systemsettings vulkan-tools wayland-utils xorg-xdpyinfo)
makedepends=(cmake ninja extra-cmake-modules qt6-tools)
source=(https://download.kde.org/stable/plasma/$pkgver/$pkgname-$pkgver.tar.xz)
sha256sums=('9ed87edb3a24256189f8dc79c821b8f45589aab7032d8dde78d5d94cf0639ff9')

prepare() {
  sed -i -e '/^    DocTools$/d' -e 's/^ecm_optional_add_subdirectory( doc )$//' \
    -e 's/^kdoctools_install(po)$//' $pkgname-$pkgver/CMakeLists.txt
}

build() {
  cmake -B build -S $pkgname-$pkgver -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_INSTALL_LIBEXECDIR=lib \
    -DBUILD_TESTING=OFF
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
