# The libretro cores Kettle's emulation ships in the image, one package each, all in
# /usr/lib/libretro (RetroArch's libretro_directory, packages/retroarch). Game Mode's Emulation
# plugin runs them through /usr/lib/kettle/emu-run. Only cores under free licenses are here;
# cores with non-commercial terms (Genesis Plus GX, PicoDrive, FBNeo, MAME 2003, Snes9x) are a
# per-user, opt-in download from libretro's buildbot, and blueMSX is left out (its V9938 command
# engine may be used "in MSX emulators" only, which GPL code can't be combined with).
# flycast and mupen64plus_next are packages/libretro-cores-heavy, so a bump here doesn't rebuild
# them.
#
#   pcsx_rearmed      PlayStation (fast, dynarec)            GPL-2.0-or-later
#   swanstation       PlayStation (DuckStation before its relicense) GPL-3.0-or-later
#   mednafen_psx_hw   PlayStation (Beetle PSX HW, Vulkan)    GPL-2.0-or-later
#   mgba              Game Boy Advance                       MPL-2.0
#   gambatte          Game Boy / Color                       GPL-2.0-only
#   bsnes             Super Nintendo                         GPL-3.0-only
#   nestopia          NES / Famicom Disk System              GPL-2.0-or-later
#   fceumm            NES                                    GPL-2.0-or-later
#   mednafen_pce_fast PC Engine / TurboGrafx (CD)            GPL-2.0-or-later
#   stella            Atari 2600                             GPL-2.0-or-later
#   mednafen_ngp      Neo Geo Pocket / Color                 GPL-2.0-or-later
#   mednafen_wswan    WonderSwan / Color                     GPL-2.0-or-later
#   mednafen_vb       Virtual Boy                            GPL-2.0-or-later
#   handy             Atari Lynx                             Zlib
#   dosbox_pure       MS-DOS                                 GPL-2.0-or-later
#   gearsystem        Master System / Game Gear / SG-1000    GPL-3.0-or-later
#   clownmdemu        Mega Drive / Genesis, Mega CD          AGPL-3.0-or-later
#   melondsds         Nintendo DS (melonDS DS)               GPL-3.0-or-later
# Each core is pinned (a release tag where the core has them, else a commit) and built with its
# own build system; melonDS DS's CMake would fetch its dependencies, so they're sources here too,
# at the commits its FetchDependencies.cmake names.
pkgbase=libretro-cores
pkgname=(libretro-pcsx-rearmed libretro-swanstation libretro-beetle-psx-hw libretro-mgba
         libretro-gambatte libretro-bsnes libretro-nestopia libretro-fceumm
         libretro-beetle-pce-fast libretro-stella libretro-beetle-ngp libretro-beetle-wswan
         libretro-beetle-vb libretro-handy libretro-dosbox-pure libretro-gearsystem
         libretro-clownmdemu libretro-melondsds)
pkgver=20261018
pkgrel=1
pkgdesc='libretro emulator cores'
arch=(aarch64)
url='https://www.libretro.com'
license=(GPL-2.0-or-later GPL-2.0-only GPL-3.0-or-later GPL-3.0-only MPL-2.0 Zlib
         AGPL-3.0-or-later MIT BSD-3-Clause BSL-1.0)
makedepends=(git cmake ninja python libglvnd mesa vulkan-headers zlib libpng)
options=(!lto)  # GCC 15 LTO hits an internal compiler error in melonDS (DMA.cpp)
source=("git+https://github.com/libretro/pcsx_rearmed.git#commit=c8816799b50388e61cfe237fe2cdbb7d8175f20a"
        "git+https://github.com/libretro/swanstation.git#commit=e436e9b85374def58d211df7f78880f0f4a917b4"
        "git+https://github.com/libretro/beetle-psx-libretro.git#commit=5a3c6b41e413674e33f51c54f0d7e6b0b6f1858f"
        "git+https://github.com/libretro/mgba.git#commit=7a12d6d4b9acb14c0ae62c9166b6a2f3d08007f6"
        "git+https://github.com/libretro/gambatte-libretro.git#commit=d9d6cd06382d1ced30de34d56d3609452323dab1"
        "git+https://github.com/libretro/bsnes.git#commit=63ee22f7af8f5d1ada295c2c98fd7bf261fa62a7"
        "git+https://github.com/libretro/nestopia.git#commit=06a8949e0b3cf60e3a38a374b1426bf40fccb9a0"
        "git+https://github.com/libretro/libretro-fceumm.git#commit=ac0d00a7fc01166f84c7bac01d1084ebfd2b865e"
        "git+https://github.com/libretro/beetle-pce-fast-libretro.git#commit=3f946f277aef3aa99a95551618bbcd1dd2bda0d9"
        "git+https://github.com/stella-emu/stella.git#tag=7.0c"
        "git+https://github.com/libretro/beetle-ngp-libretro.git#commit=a50d5ac288a81f2104ddf43195a4efdd15c72227"
        "git+https://github.com/libretro/beetle-wswan-libretro.git#commit=4b01295838ea89e3f1355bbe4cb5cf98aa6108cd"
        "git+https://github.com/libretro/beetle-vb-libretro.git#commit=d5ae54c8e23b573a3b34e888b2d48a588027e92c"
        "git+https://github.com/libretro/libretro-handy.git#commit=bc55d462f0b2d6b073ea93dc552ebd73cec60fd1"
        "git+https://codeberg.org/schelling/dosbox-pure.git#tag=1.0-preview7"
        "git+https://github.com/drhelius/Gearsystem.git#tag=gearsystem-3.4.1"
        "git+https://github.com/Clownacy/clownmdemu-libretro.git#commit=d43c2708b0a31c285ce16724b6c4a2e92af07346"
        "git+https://github.com/JesseTG/melonds-ds.git#tag=v1.4.0"
        # melonDS DS's dependencies (cmake/FetchDependencies.cmake at v1.4.0; melonDS is a branch
        # there, jtg/fix-uninitialized-opengl, pinned at its head)
        "mds-melonds::git+https://github.com/JesseTG/melonDS.git#commit=16f127dbb587a73371827ce79689c5d237c4b59b"
        "mds-libretro-common::git+https://github.com/libretro/libretro-common.git#commit=fa8a1b572a444fcb552007019f8caf68281108aa"
        "mds-embed-binaries::git+https://github.com/andoalon/embed-binaries.git#commit=078b62beba97e8192c99bfb16d5e17220cfc7598"
        "mds-glm::git+https://github.com/g-truc/glm.git#commit=6f14f4792a0cde5d0cf2c910506724d61cb95834"
        "mds-libslirp::git+https://github.com/JesseTG/libslirp-mirror.git#commit=e61dbd459c8c06607b3a84694489427e8ec60f17"
        "mds-pntr::git+https://github.com/robloach/pntr.git#commit=a47fe167703b0ac3bfad00785b20b0dce6712509"
        "mds-fmt::git+https://github.com/fmtlib/fmt.git#tag=12.2.0"
        "mds-yamc::git+https://github.com/yohhoy/yamc.git#commit=4e015a7e8eb0d61c34e6928676c8c78881a72d73"
        "mds-span-lite::git+https://github.com/martinmoene/span-lite.git#commit=f63fe2974943b5f555b928b10d910e457fbb93d4"
        "mds-date::git+https://github.com/HowardHinnant/date.git#tag=v3.0.5"
        "mds-zlib::git+https://github.com/madler/zlib.git#tag=v1.3.2")
sha256sums=(SKIP SKIP SKIP SKIP SKIP SKIP SKIP SKIP SKIP SKIP SKIP SKIP SKIP SKIP SKIP SKIP SKIP SKIP
            SKIP SKIP SKIP SKIP SKIP SKIP SKIP SKIP SKIP SKIP SKIP)

prepare() {
  git -C pcsx_rearmed submodule update --init
  git -C clownmdemu-libretro submodule update --init --recursive
}

build() {
  # the Makefile cores, each in its own tree
  make -C pcsx_rearmed -f Makefile.libretro
  make -C beetle-psx-libretro HAVE_HW=1
  make -C gambatte-libretro -f Makefile.libretro
  make -C bsnes
  make -C nestopia/libretro
  make -C libretro-fceumm -f Makefile.libretro
  make -C beetle-pce-fast-libretro
  make -C stella/src/os/libretro
  make -C beetle-ngp-libretro
  make -C beetle-wswan-libretro
  make -C beetle-vb-libretro
  make -C libretro-handy
  make -C dosbox-pure
  make -C Gearsystem/platforms/libretro
  make -C clownmdemu-libretro

  cmake -S swanstation -B build-swanstation -G Ninja -DCMAKE_BUILD_TYPE=Release
  cmake --build build-swanstation

  cmake -S mgba -B build-mgba -G Ninja -DCMAKE_BUILD_TYPE=Release -DBUILD_LIBRETRO=ON \
    -DBUILD_QT=OFF -DBUILD_SDL=OFF -DSKIP_LIBRARY=ON -DUSE_DISCORD_RPC=OFF -DUSE_FFMPEG=OFF \
    -DUSE_EDITLINE=OFF -DUSE_ELF=OFF -DUSE_LUA=OFF -DUSE_SQLITE3=OFF -DUSE_MINIZIP=OFF \
    -DUSE_LIBZIP=OFF -DUSE_PNG=OFF -DUSE_ZLIB=OFF -DUSE_LZMA=OFF -DBUILD_GL=OFF \
    -DBUILD_GLES2=OFF -DBUILD_GLES3=OFF
  cmake --build build-mgba

  # melonDS DS's dependencies where FetchContent would have put them (<name>-src), used as they
  # are (FULLY_DISCONNECTED): its CMake looks for melonDS's and embed-binaries' modules there
  local d
  for d in melonds libretro-common embed-binaries glm libslirp pntr fmt yamc span-lite date zlib; do
    rm -rf "build-melondsds/_deps/$d-src"; mkdir -p build-melondsds/_deps
    cp -a "mds-$d" "build-melondsds/_deps/$d-src"
  done
  cmake -S melonds-ds -B build-melondsds -G Ninja -DCMAKE_BUILD_TYPE=Release \
    -DFETCHCONTENT_FULLY_DISCONNECTED=ON -DENABLE_LTO_RELEASE=OFF -DENABLE_LTO=OFF
  cmake --build build-melondsds
}

# _core <.so> <license file...>
_core() {
  local so=$1; shift
  install -Dm644 "$so" "$pkgdir/usr/lib/libretro/$(basename "$so")"
  local f
  for f in "$@"; do
    install -Dm644 "$f" "$pkgdir/usr/share/licenses/$pkgname/$(basename "$f")"
  done
}

package_libretro-pcsx-rearmed() {
  pkgdesc='libretro core: PlayStation (PCSX ReARMed)'; license=(GPL-2.0-or-later)
  _core pcsx_rearmed/pcsx_rearmed_libretro.so pcsx_rearmed/COPYING
}
