# The ROCKNIX ABL (github.com/ROCKNIX/abl), for devices whose stock bootloader can't start U-Boot
# (no Loader choice in fastboot mode). It starts Kettle's steamcl (\EFI\BOOT\BOOTAA64.EFI, so A/B
# fallback works), else \KERNEL. kettle-abl-update installs it (--install: over the stock
# bootloader, which it saves first, or over the slot an Android update put the stock one back in),
# keeps it up to date (replacing a recognised, older ROCKNIX ABL in abl_a/abl_b with this release)
# and puts the saved stock bootloader back (--restore-stock). Device Settings' System tab
# (kettle-decky-plugins) runs it too, through pkexec: org.kettle.abl-update, allowed for Decky's
# plugin backends by 50-kettle-abl-update.rules.
#
# ROCKNIX publishes only signed binaries, built from its private LinuxLoader fork (Qualcomm's
# BSD-3-Clause LinuxLoader). The repo states no licence; ROCKNIX's developers agreed to Kettle
# redistributing it (2026-10-09). ROCKNIX deletes older releases' files, so the tarball is kept in cache/src
# (scripts/build-packages.sh) and pinned by hash. releases.tsv identifies installed releases.
pkgname=rocknix-abl
pkgver=1.2
pkgrel=5
pkgdesc='ROCKNIX ABL builds, and kettle-abl-update to install, update or remove an open ABL (ROCKNIX, OpenABL)'
arch=(any)
url='https://github.com/ROCKNIX/abl'
license=(LicenseRef-ROCKNIX-ABL)
depends=(util-linux coreutils polkit)
options=(!strip)
source=("rocknix-abl-v$pkgver.tar.gz::https://github.com/ROCKNIX/abl/releases/download/v$pkgver/rocknix-abl-v$pkgver.tar.gz"
        releases.tsv
        kettle-abl-update
        org.kettle.abl-update.policy
        50-kettle-abl-update.rules
        LICENSE)
sha256sums=('64034fb076ea0bb858beaa2f29dbef635e97d29f3e3d32c13bce61bd4af4cff7'
            '3d72c8ac7ef9076135f7ad84b48c29a6b6380acf95481b06f6016d2592c6ebde'
            '0c286c51c3fe09ba7fc8acd8bda7a1e5e4937283b5b9382e97aec19a314ca2fe'
            '8277e689549581a09bdca85e4606bba6921efcf2b7ae427e3836585699dd12fc'
            '9eae899bf27ece7348b075c1fd133d0f7f16f2ed8cca8f169a057594066cc3de'
            '85c4d9a67a22b9658ac18fd375d2e1e42d41364776c694c955b2b252756df5cc')

package() {
  local d="$pkgdir/usr/share/kettle/rocknix-abl" f
  install -d "$d"
  for f in "$srcdir"/rocknix-abl-v$pkgver/abl_signed-*.elf; do
    # the tarball's own checksum files must agree
    (cd "${f%/*}" && sha256sum -c --quiet "${f##*/}.sha256")
    install -m644 "$f" "$d/"
  done
  install -m644 releases.tsv "$d/"
  install -Dm755 kettle-abl-update "$pkgdir/usr/bin/kettle-abl-update"
  install -Dm644 org.kettle.abl-update.policy -t "$pkgdir/usr/share/polkit-1/actions"
  install -Dm644 50-kettle-abl-update.rules -t "$pkgdir/usr/share/polkit-1/rules.d"
  install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname"
}
