# Kettle's U-Boot environment: mainline's board/qualcomm/qcom-phone.env with Kettle's boot order.
# The stock bootloader (ABL) starts this U-Boot from the loader partition; it boots
# \EFI\BOOT\BOOTAA64.EFI (steamcl, which picks the A/B slot) from the SD card if there is one,
# else from the internal storage, in that fixed order (standard boot, EFI only: no extlinux).

bootdelay=0
bootretry=1
stdin=serial,button-kbd
stdout=serial,vidconsole
stderr=serial,vidconsole

# Fastboot is keen to use the address from kconfig, but we
# allocate its buffer at runtime.
fastboot=fastboot -l $fastboot_addr_r usb 0

# Always probe for UFS storage, though it should be done by board code.
preboot=scsi scan

bootmeths=efi
boot_sd=bootflow scan -b mmc
# bootflow only looks at partitions flagged bootable (the card's KETTLE partition is), or at the
# first one when none is; internal installs made before kettle-install-internal set the flag on
# kettle-esp are found by the EFI boot manager instead (any EFI system partition)
boot_internal=bootflow scan -b scsi; bootefi bootmgr

# bootretry will run this command over and over, if we fail once
# then bail out to the boot menu instead (with a pause to read
# the error message)
bootcmd=run boot_sd; run boot_internal; pause; run menucmd

# When entering the menu (either from button press or failed boot)
# remap bootcmd so it will re-open the menu and we won't get stuck
# at the console with no way to type
menucmd=setenv bootcmd run menucmd; bootmenu -1

# Pause is used so the output can be read on the display
bootmenu_0=Boot (SD card, else internal storage)=run boot_sd; run boot_internal; pause
bootmenu_1=Boot the SD card=run boot_sd; pause
bootmenu_2=Boot the internal storage=run boot_internal; pause
bootmenu_3=Internal storage as USB drive=echo "Press any key to exit UMS mode"; ums 0 scsi 0
bootmenu_4=Fastboot mode=run fastboot
bootmenu_5=Enable serial console gadget=run serial_gadget
# Disabling bootretry means we'll just drop the shell
bootmenu_6=Drop to shell=setenv bootretry -1
bootmenu_7=Reset device=reset

# Shortcut to enable USB serial gadget and disable bootretry
serial_gadget=setenv stdin serial,button-kbd,usbacm; \
	setenv stdout serial,vidconsole,usbacm; \
	setenv stderr serial,vidconsole,usbacm; \
	setenv bootretry -1; \
	echo Enabled U-Boot console serial gadget

# Allow holding the volume down button while U-Boot loads to enter
# the boot menu
button_cmd_0_name=Volume Down
button_cmd_0=run menucmd
