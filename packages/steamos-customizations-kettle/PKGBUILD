# RAUC_COMPATIBLE and ATOMUPD_VARIANTS_LIST are the Portal's: the image build sets each device's
# in /etc/rauc/system.conf and client.conf (device/<device>/device.conf)
_make() {
  make prefix=/usr sbindir=/usr/bin libexecdir=/usr/lib \
    GRUB_BINARY_RELPATH=EFI/steamos/grubaa64.efi \
    REMOVABLE_EFI_RELPATH=efi/boot/bootaa64.efi \
    STEAMOS_N_PARTITIONS=8 \
    STEAMOS_ALL_PARTLABELS='esp efi-A efi-B rootfs-A rootfs-B var-A var-B home' \
    RAUC_COMPATIBLE=kettle-aarch64 \
    ATOMUPD_META_URL=$_update_url/meta \
    ATOMUPD_IMAGES_URL=$_update_url/images \
    ATOMUPD_VARIANTS_LIST=odin2portal \
    ATOMUPD_BRANCHES_LIST='stable;beta;main' \
    ATOMUPD_DEV_BRANCHES_LIST=main \
    STEAMCL_INSTALL_ARGS='--no-efi --flags restricted --force-extra-removable' \
    "$@"
}

prepare() {
  rm -rf src-tree
  git clone -q "$srcdir/steamos-customizations-jupiter/steamos-customizations-jupiter" src-tree
  git -C src-tree checkout -q "$_srctag"
  local p
  for p in "$srcdir"/0*.patch; do git -C src-tree apply "$p"; done
}

package() {
  cd src-tree
  local d
  for d in atomic-update chainloader grub misc offload mkinitcpio; do
    _make DESTDIR="$pkgdir" -C $d install
  done

  cd "$pkgdir"
  rm -f etc/rauc/trusted_keys/* \
        usr/share/X11/xorg.conf.d/10-holo-virtualdisplaysize.conf \
        usr/lib/systemd/sleep.conf.d/steamos-suspend-then-hibernate.conf \
        usr/lib/systemd/system-sleep/hibernate-post.sh \
        usr/lib/systemd/system-sleep/modules-reload.sh \
        etc/systemd/system/systemd-logind.service.d/homedir-override.conf \
        usr/lib/udev/rules.d/90-steam-inputplumber.rules \
        usr/lib/udev/rules.d/80-vlv-wobt.rules \
        usr/lib/udev/hwdb.d/60-steam-inputplumber.hwdb \
        usr/bin/steamos-firmware-update \
        usr/lib/initcpio/install/steam-deck \
        etc/mkinitcpio.conf.d/20-steamdeck.conf
  # (with the links that enable them)
  find . \( -name 'holo-cfs-debugfs*' -o -name 'holo-finish-oobe-migration*' \) -exec rm -f {} +
  find . -type d -empty -delete

  # Valve's grub-install/grub-mkimage (holo-grub-*) stand in for GRUB's, as in Valve's package
  ln -sf /usr/lib/holo/holo-grub-install usr/bin/grub-install
  ln -sf /usr/lib/holo/holo-grub-mkimage usr/bin/grub-mkimage
  # steamdeck-kde-presets' kcm-about-distrorc still runs steamos-partition (renamed holo-partition)
  # for Info Center's A/B line; kinfocenter crashes on About this System when the script is missing
  ln -sf holo-partition usr/bin/steamos-partition

  install -Dm755 "$srcdir/update-grub" usr/bin/update-grub
  install -Dm755 "$srcdir/kettle-boot-legacy" usr/bin/kettle-boot-legacy
  install -d usr/lib/rauc/post-install.d
  ln -s /usr/bin/kettle-boot-legacy usr/lib/rauc/post-install.d/50-kettle-boot-legacy
  install -Dm644 "$srcdir/mkbootimg.py" usr/lib/kettle/mkbootimg.py
  install -Dm644 "$srcdir/20-kettle.conf" etc/mkinitcpio.conf.d/20-kettle.conf
  install -Dm644 "$srcdir/desync-config.json" etc/desync/config.json
  install -Dm644 "$srcdir/kettle-readonly-root.service" -t usr/lib/systemd/system
  ln -s ../kettle-readonly-root.service usr/lib/systemd/system/sysinit.target.wants/
  # Valve's home.mount has no [Install]: SteamOS pulls it in elsewhere
  install -d usr/lib/systemd/system/local-fs.target.wants
  ln -s ../home.mount usr/lib/systemd/system/local-fs.target.wants/
  install -Dm644 "$srcdir/home-after-repart.conf" usr/lib/systemd/system/home.mount.d/kettle-repart.conf
  install -Dm644 "$srcdir/kettle-atomupd.tmpfiles" usr/lib/tmpfiles.d/kettle-atomupd.conf
  # Valve's steamos-atomupd-client (release-0.4 hotfixes) is built for Python 3.12; the image's
  # Python is 3.11 (the pinned snapshot's). Its code runs on 3.11 as is (checked by compiling
  # and importing it there), so it is made visible to 3.11.
  install -d usr/lib/python3.11/site-packages
  ln -s ../../python3.12/site-packages/steamosatomupd usr/lib/python3.11/site-packages/steamosatomupd
  install -Dm644 "$srcdir/src-tree/COPYING.LGPL-2.1" -t usr/share/licenses/$pkgname
}
