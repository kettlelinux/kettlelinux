# SteamOS's atomic A/B system (Valve's steamos-customizations, the Steam Deck variant), built for
# Kettle Linux on arm64: the initramfs hook that finds the booted slot's partitions and mounts
# /var and the /etc overlay, each slot's GRUB, steamcl's registration, the RAUC update hooks,
# holo-readonly and the /home offload mounts. See docs/UPDATES.md.
#
# 0001-0009 are Kettle's changes to Valve's code (arm64, RAUC compatible and no verity slots,
# image-build UUIDs, post-install.d hooks, steamcl-install arguments, holo-chroot without EFI,
# factory reset by partset link, GRUB modules for update-grub, both slots' partsets on the
# other efi). Kettle's own files:
#   update-grub         writes a slot's grub.cfg (kernel, initramfs, devicetree) without grub-probe
#   kettle-boot-legacy  points the ABL's \KERNEL and U-Boot's extlinux at the newest slot
#   mkbootimg.py        builds \KERNEL (Android boot.img v0)
#   20-kettle.conf      initramfs hooks
#   kettle-readonly-root.service  grows a slot's root to the slot and sets the btrfs read-only flag
#                                 on its first boot
#   home-after-repart.conf        mounts /home after systemd-repart creates or grows it
#   kettle-atomupd.tmpfiles       the running slot's data next to its update chunk index
# Left out of Valve's package: Steam Deck hardware and hibernation (swap, sleep, Xorg,
# steamos-firmware-update, the steam-deck initramfs hook, CFS tunings, OOBE migration), the
# rules that start InputPlumber at boot (Kettle runs it with Game Mode only), Valve's signing
# certificate (images trust Kettle's, installed by the image build).
pkgname=steamos-customizations-kettle
_srctag=jupiter-20260914.1
pkgver=${_srctag#jupiter-}
pkgrel=10
pkgdesc='SteamOS atomic A/B system (Valve steamos-customizations) for Kettle Linux'
arch=(aarch64)
url='https://gitlab.steamos.cloud/holo/steamos-customizations'
license=(LGPL-2.1-or-later BSD-3-Clause)
depends=(e2fsprogs gptfdisk rsync util-linux mkinitcpio btrfs-progs dosfstools exfatprogs jq python
         grub steamos-efi rauc desync steamos-atomupd-client atomupd-daemon plymouth)
makedepends=(git systemd)
backup=(etc/mkinitcpio.conf.d/20-kettle.conf)
_update_url=https://updates.kettle.invalid  # no update server yet: the image build sets the real one
source=("https://steamdeck-packages.steamos.cloud/archlinux-mirror/sources/jupiter-main/steamos-customizations-jupiter-20260914.1-2.src.tar.gz"
        0001-Support-arm64-aarch64-as-well-as-x86_64.patch
        0002-rauc-configurable-compatible-string-no-verity-slots.patch
        0003-holo-grub-mkearlyconfig-take-the-filesystem-UUIDs-fr.patch
        0004-rauc-post-install-run-the-hooks-in-post-install.d.patch
        0005-steamcl-install-configurable-arguments-STEAMCL_INSTA.patch
        0006-holo-chroot-bind-mount-efivars-only-if-the-system-ha.patch
        0007-factory-reset-format-the-partitions-through-their-pa.patch
        0008-holo-grub-mkimage-regexp-and-probe-in-the-arm64-imag.patch
        0009-rauc-post-install-give-the-other-efi-both-slots-part.patch
        update-grub
        kettle-boot-legacy
        mkbootimg.py
        20-kettle.conf
        desync-config.json
        kettle-readonly-root.service
        home-after-repart.conf
        kettle-atomupd.tmpfiles)
