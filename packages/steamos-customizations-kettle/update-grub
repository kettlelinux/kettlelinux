#!/bin/bash
# Kettle Linux: write this slot's GRUB config, /efi/EFI/steamos/grub.cfg. Replaces SteamOS's
# update-grub (grub-mkconfig), which needs grub-probe on the real disk and has no devicetree
# support; this works the same in an image build (HOLO_ROOT_UUID, HOLO_ROOT_PARTUUID,
# HOLO_ROOT_PARTNUM, HOLO_EFI_PARTUUID, EFI) as on the device (holo-finalize-install, run in
# the new slot by the RAUC post-install hook).
#
# The kernel, its initramfs and devicetree are this slot's /boot/{Image,initramfs-linux.img,dtbs}
# on its root filesystem. GRUB takes that from the disk it was loaded from, by partition number
# and partition UUID: an SD card and an internal install that were updated to the same build
# carry root filesystems with the same filesystem UUID. Only if that fails does it search by
# filesystem UUID (all disks).
set -euo pipefail

. /usr/lib/kettle/boot.conf
if [ -r /etc/kettle/boot.conf ]; then . /etc/kettle/boot.conf; fi

EFI=${EFI:-/efi}
if [ -n "${HOLO_ROOT_UUID:-}" ]; then   # for a root filesystem that isn't /
  root_uuid=$HOLO_ROOT_UUID root_partuuid=${HOLO_ROOT_PARTUUID:-} root_partnum=${HOLO_ROOT_PARTNUM:-}
else
  root_dev=$(findmnt -no SOURCE /); root_dev=${root_dev%%\[*}
  root_uuid=$(findmnt -no UUID /)
  root_partuuid=$(findmnt -no PARTUUID / 2>/dev/null || true)
  root_partnum=$(cat "/sys/class/block/${root_dev##*/}/partition" 2>/dev/null || true)
fi
efi_partuuid=${HOLO_EFI_PARTUUID:-$(findmnt -no PARTUUID "$EFI")}
[ -n "$root_uuid" ] || { echo "update-grub: no root filesystem UUID" >&2; exit 1; }
[ -n "$efi_partuuid" ] || { echo "update-grub: no efi partition under $EFI" >&2; exit 1; }
root_partuuid=${root_partuuid,,}
[[ $root_partnum =~ ^[0-9]+$ ]] && [[ $root_partuuid =~ ^[0-9a-f-]{36}$ ]] || {
  echo "update-grub: warning: root partition unknown; GRUB searches all disks for it" >&2
  root_partnum= root_partuuid=
}

. /etc/os-release
title=${PRETTY_NAME:-Kettle Linux}
out=$EFI/EFI/steamos/grub.cfg
mkdir -p "${out%/*}"

find_root() {
  if [ -n "$root_partnum" ]; then
    cat <<CFG
    set root=
    if regexp --set=1:kdisk '^\\(([^,)]+),' "\$cmdpath"; then
        if probe --set=kpart --part-uuid "(\$kdisk,gpt$root_partnum)"; then
            if [ "\$kpart" = "$root_partuuid" ]; then set root="\$kdisk,gpt$root_partnum"; fi
        fi
    fi
    if [ -z "\$root" ]; then search --no-floppy --fs-uuid --set=root $root_uuid; fi
CFG
  else
    echo "    search --no-floppy --fs-uuid --set=root $root_uuid"
  fi
}

# the devicetree: DTB, or a DTB_ALT whose marker file (NAME or NAME.txt) is in the top folder of
# partition 1 (the KETTLE esp) of the disk GRUB was loaded from
dtb_select() {
  echo "set dtb=/boot/dtbs/$DTB"
  [ -n "${DTB_ALT:-}" ] || return 0
  echo "if regexp --set=1:edisk '^\\(([^,)]+),' \"\$cmdpath\"; then"
  local alt
  for alt in $DTB_ALT; do
    echo "    if [ -f \"(\$edisk,gpt1)/${alt%%:*}\" ]; then set dtb=/boot/dtbs/${alt#*:}; fi"
    echo "    if [ -f \"(\$edisk,gpt1)/${alt%%:*}.txt\" ]; then set dtb=/boot/dtbs/${alt#*:}; fi"
  done
  echo "fi"
}

entry() {  # name, extra cmdline
  echo "menuentry '$1' {"
  find_root
  cat <<CFG
    devicetree \$dtb
    linux /boot/Image $CMDLINE $2 steamos.efi=PARTUUID=$efi_partuuid
    initrd /boot/initramfs-linux.img
}
CFG
}

{
  echo "# Written by update-grub (Kettle Linux). Slot selection and the boot menu are steamcl's."
  echo "set timeout=0"
  echo "set default=0"
  dtb_select
  entry "$title" "$SPLASH"
  entry "$title (verbose boot)" "$VERBOSE"
} >"$out.new"
mv "$out.new" "$out"
echo "update-grub: wrote $out (root $root_uuid${root_partnum:+ on partition $root_partnum $root_partuuid}, efi $efi_partuuid)"
