#!/bin/bash
# Kettle Linux: point the bootloaders that can't choose a slot at one slot's kernel. The ROCKNIX
# ABL boots \KERNEL (an Android boot.img v0) and U-Boot's standard boot reads
# \extlinux\extlinux.conf, both from the esp; steamcl (\EFI\BOOT\BOOTAA64.EFI) does A/B itself.
# These follow the newest installed slot, without fallback. See docs/UPDATES.md.
#
#   kettle-boot-legacy SLOT
#       after an update (the RAUC post-install hook, as .../post-install.d/50-kettle-boot-legacy):
#       the kernel from SLOT's root filesystem, onto the mounted esp
#   kettle-boot-legacy --root DIR --esp DIR --efi-partuuid UUID
#       building an image: the kernel from DIR/boot, onto the esp tree DIR
set -euo pipefail

root= esp=/esp efi_partuuid= slot= tmpmnt=
while [ $# -gt 0 ]; do
  case "$1" in
    --root) root=$2; shift 2 ;;
    --esp) esp=$2; shift 2 ;;
    --efi-partuuid) efi_partuuid=$2; shift 2 ;;
    -*) echo "usage: $0 SLOT | --root DIR --esp DIR --efi-partuuid UUID" >&2; exit 2 ;;
    *) slot=$1; shift ;;
  esac
done

cleanup() { [ -n "$tmpmnt" ] && { umount "$tmpmnt" 2>/dev/null || true; rmdir "$tmpmnt"; }; rm -rf "${stage:-}"; }
trap cleanup EXIT

if [ -n "$slot" ]; then
  parts=/dev/disk/by-partsets/$slot
  [ -b "$parts/rootfs" ] || { echo "no partitions for slot $slot" >&2; exit 1; }
  efi_partuuid=$(blkid -s PARTUUID -o value "$parts/efi")
  tmpmnt=$(mktemp -d)
  mount -o ro "$parts/rootfs" "$tmpmnt"
  root=$tmpmnt
  ls "$esp" >/dev/null  # esp.mount is an automount
  # only where these bootloaders are in use (the SD card image); an internal install boots
  # through EFI alone
  if [ ! -e "$esp/KERNEL" ] && [ ! -e "$esp/extlinux/extlinux.conf" ]; then
    echo "kettle-boot-legacy: no \\KERNEL or extlinux on $esp; nothing to do"
    exit 0
  fi
fi
[ -n "$root" ] && [ -n "$efi_partuuid" ] || { echo "missing --root/--efi-partuuid" >&2; exit 2; }

# the slot's own boot settings (its image's /usr/lib/kettle/boot.conf), then local changes
. "$root/usr/lib/kettle/boot.conf"
if [ -r /etc/kettle/boot.conf ]; then . /etc/kettle/boot.conf; fi
cmdline="$CMDLINE $SPLASH steamos.efi=PARTUUID=$efi_partuuid"
verbose="$CMDLINE $VERBOSE steamos.efi=PARTUUID=$efi_partuuid"
kver=$(ls "$root/usr/lib/modules" | sort -V | tail -1)
boot=$root/boot

# build it all next to the old files, then swap them in: the esp is never left half-written
stage=$(mktemp -d "$esp/.kettle-boot.XXXXXX")
cp "$boot/Image" "$boot/initramfs-linux.img" "$stage/"
mkdir -p "$stage/dtbs" && cp -r "$boot/dtbs/." "$stage/dtbs/"

# \KERNEL for the ROCKNIX ABL: gzip(Image) with every SM8550 dtb appended (the ABL picks one by
# its Device model setting), the initramfs, the splash command line
gzip -9n -c "$boot/Image" >"$stage/kernel.gz"
cat "$boot"/dtbs/qcom/*.dtb >>"$stage/kernel.gz"
python3 /usr/lib/kettle/mkbootimg.py --kernel "$stage/kernel.gz" \
  --ramdisk "$boot/initramfs-linux.img" --cmdline "$cmdline" \
  --os_patch_level "$(date +%Y-%m)" -o "$stage/KERNEL"
rm "$stage/kernel.gz"
printf '%s  KERNEL\n' "$(md5sum "$stage/KERNEL" | cut -d' ' -f1)" >"$stage/KERNEL.md5"

mkdir -p "$stage/extlinux"
cat >"$stage/extlinux/extlinux.conf" <<CFG
default kettle
timeout 3
menu title Kettle Linux

label kettle
    menu label Kettle Linux ($kver${slot:+, slot $slot})
    linux /Image
    initrd /initramfs-linux.img
    fdt /dtbs/$DTB
    append $cmdline

label kettle-verbose
    menu label Kettle Linux (verbose boot)
    linux /Image
    initrd /initramfs-linux.img
    fdt /dtbs/$DTB
    append $verbose
CFG

# swap in: kernel files first, the files that name them last
for f in Image initramfs-linux.img; do mv -f "$stage/$f" "$esp/$f"; done
rm -rf "$esp/dtbs.old"; [ -d "$esp/dtbs" ] && mv "$esp/dtbs" "$esp/dtbs.old"
mv "$stage/dtbs" "$esp/dtbs"; rm -rf "$esp/dtbs.old"
mkdir -p "$esp/extlinux"
mv -f "$stage/extlinux/extlinux.conf" "$esp/extlinux/extlinux.conf"
mv -f "$stage/KERNEL" "$esp/KERNEL"
mv -f "$stage/KERNEL.md5" "$esp/KERNEL.md5"
sync -f "$esp/KERNEL" 2>/dev/null || sync
echo "kettle-boot-legacy: \\KERNEL and extlinux now boot ${slot:-this image} ($kver)"
