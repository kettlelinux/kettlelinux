# Kettle Linux's own Decky plugins, preinstalled (decky-loader-start links them into
# ~/homebrew/plugins):
#   framegen   per-game frame generation (our kettle-framegen layer)
#   upscaling  per-game gamescope FSR 1 (render resolution + Sharp filter) and SGSR 2 / Arm ASR / FSR 2.2
#              through OptiScaler (ARM64EC build, optiscaler-arm64ec)
#   power      per-game fan curve / fixed speed and CPU core parking and caps, a live power and
#              temperature readout, the battery charge limit (all through kettle-powerd); and
#              Steam's power sliders following what the Performance app sets (steamSync.ts)
#   welcome    opens once on first boot: Game Mode's counterpart of the desktop's Kettle Welcome.
#              A tour, the start-up mode, Gaming Extras (the controller-friendly Flathub apps
#              through kettle-welcome's welcome-flatpak, added to Steam as shortcuts; GE-Proton /
#              Proton-CachyOS through its welcome-proton; Battle.net, through its welcome-battlenet;
#              optional components, components.json,
#              downloaded from their upstream source), Android games from F-Droid or an APK file
#              (kettle-lepton's kettle-android-games), and the SSH server (started and stopped
#              only: 50-kettle-ssh.rules); also applies game fixes (welcome/src/fixes.ts): launch
#              options a game needs to run at all; and adds the desktop in Game Mode to the
#              library once (welcome/src/desktop.ts: its artwork, kettle-desktop-art, and the
#              desktop's controls as its controller layout)
#   crash      the crash reports kettle-crashd keeps (packages/kettle-crash): a list, each report's
#              page, and a toast when a game, Game Mode or the GPU crashes; nothing is sent anywhere
#   game-settings  per-game compatibility profiles: FEX, DXVK, vkd3d, Turnip and Proton options
#              (shared/game-options.json) in the launch options, the Proton version, presets,
#              saved profiles, the welcome game fixes, the engine the game is built on
#              (shared/gameengine.py); and the game database (server/game-db): known good
#              settings players share once they've played with them
#   screens    the AYN Thor's bottom screen from Game Mode: on/off and its own brightness
#              (installed on the Thor only: device/thor/packages.txt)
#   lights     the RGB rings around the sticks: off, a color (both sticks or each its own), the
#              battery level, breathe or rainbow, and their brightness (through kettle-ledd,
#              packages/kettle-leds, which sets them as root and keeps them dark while asleep)
#   stores     Game Stores: Epic Games, GOG and Amazon Games in Game Mode, through Heroic's store
#              tools (legendary, gogdl, nile; packages/heroic-games-launcher) and its config, so
#              desktop Heroic shares the sign-ins and installs: signing in in Steam's own browser,
#              the libraries, installs and updates (a user unit, kettle-stores-job), and each game
#              added to Steam as a Proton shortcut started through kettle-store-run (/usr/bin),
#              which adds the store's launch arguments (Epic's login) to the command
# Sources live next to this PKGBUILD; shared/ holds code both frontends use.
pkgbase=kettle-decky-plugins
pkgname=(kettle-decky-framegen kettle-decky-upscaling kettle-decky-welcome kettle-decky-power
         kettle-decky-screens kettle-decky-crash kettle-decky-game-settings kettle-decky-lights
         kettle-decky-stores)
pkgver=1.12.0
pkgrel=22
pkgdesc='Kettle Linux Decky plugins'
arch=(any)
license=(BSD-3-Clause)
makedepends=(nodejs npm)

prepare() {
  rm -rf src-tree; mkdir src-tree
  cp -r "$startdir"/{package.json,pnpm-lock.yaml,shared,framegen,upscaling,welcome,power,screens,crash,game-settings,lights,stores} src-tree/
  rm -rf src-tree/{framegen,upscaling,welcome,power,screens,crash,game-settings,lights,stores}/dist
}

build() {
  cd src-tree
  npx --yes pnpm@10 install --frozen-lockfile
  npx --yes pnpm@10 run typecheck
  npx --yes pnpm@10 run build
}

_install_plugin() {
  local d="$pkgdir/usr/share/decky/plugins/$1"
  install -Dm644 "src-tree/$2"/{plugin.json,package.json,main.py} -t "$d"
  install -Dm644 "src-tree/$2/dist/index.js" -t "$d/dist"
  if [ -d "src-tree/$2/py_modules" ]; then
    install -Dm644 "src-tree/$2"/py_modules/*.py -t "$d/py_modules"   # symlinks to shared/
  fi
  install -Dm644 "$startdir/LICENSE" -t "$d"
  install -Dm644 "$startdir/LICENSE" -t "$pkgdir/usr/share/licenses/$pkgname"
}

package_kettle-decky-framegen() {
  pkgdesc='Frame Generation Decky plugin (kettle-framegen per game)'
  depends=(decky-loader kettle-framegen)
  _install_plugin kettle-framegen framegen
}

package_kettle-decky-upscaling() {
  pkgdesc='Upscaling Decky plugin (per-game gamescope FSR 1; SGSR 2, Arm ASR, FSR 2.2 via OptiScaler)'
  depends=(decky-loader optiscaler-arm64ec)
  _install_plugin kettle-upscaling upscaling
}

package_kettle-decky-welcome() {
  pkgdesc='Welcome Decky plugin (first-boot tour, Gaming Extras, Android games, remote access)'
  depends=(decky-loader kettle-welcome)  # welcome-flatpak, welcome-proton, welcome-battlenet
  optdepends=('kettle-lepton: Android games'
              'kettle-desktop-art: the Desktop entry'"'"'s library artwork')
  _install_plugin kettle-welcome welcome
  install -Dm644 src-tree/welcome/components.json -t "$pkgdir/usr/share/decky/plugins/kettle-welcome"
}

package_kettle-decky-power() {
  pkgdesc='Power Decky plugin (per-game fan and CPU settings, power readout, charge limit)'
  depends=(decky-loader kettle-power python-gobject)
  _install_plugin kettle-power power
}

package_kettle-decky-screens() {
  pkgdesc='Screens Decky plugin (the AYN Thor bottom screen: on/off and brightness)'
  depends=(decky-loader)
  _install_plugin kettle-screens screens
}

package_kettle-decky-crash() {
  pkgdesc='Crash Reports Decky plugin (the crash reports kettle-crashd keeps on the device)'
  depends=(decky-loader kettle-crash)
  _install_plugin kettle-crash crash
}

package_kettle-decky-game-settings() {
  pkgdesc='Game Settings Decky plugin (per-game FEX, graphics and Proton settings, game database)'
  depends=(decky-loader)
  _install_plugin kettle-game-settings game-settings
  install -Dm644 src-tree/shared/game-options.json -t "$pkgdir/usr/share/decky/plugins/kettle-game-settings"
}

package_kettle-decky-lights() {
  pkgdesc='Lights Decky plugin (the RGB stick lights: color, battery level, effects, brightness)'
  depends=(decky-loader kettle-leds python-gobject)
  _install_plugin kettle-lights lights
}

package_kettle-decky-stores() {
  pkgdesc='Game Stores Decky plugin (Epic Games, GOG and Amazon Games in Game Mode)'
  depends=(decky-loader heroic-games-launcher python)  # legendary, gogdl, nile
  _install_plugin kettle-stores stores
  install -Dm755 src-tree/stores/kettle-store-run -t "$pkgdir/usr/bin"
}
