#!/usr/bin/env python3
# kettle-store-run: starts a game from Epic, GOG or Amazon that the Game Stores plugin added to
# Steam. The shortcut points at the game's .exe with Proton, and its launch options are
#   kettle-store-run <epic|gog|amazon> <id> %command%
# so Steam runs this with its whole command (reaper, the runtime, Proton, the .exe); this adds
# what the store needs after it and runs it:
#   epic    legendary's launch arguments: the Epic login (a new one-time code each time) and the
#           game's own; offline, the game starts without them
#   gog     the primary play task's arguments (goggame-<id>.info)
#   amazon  nile's: fuel.json's arguments and the Amazon Games SDK variables
# Cloud saves (Epic and GOG; Amazon games keep their own): newer saves are downloaded into the
# shortcut's Proton prefix before the game starts and new ones uploaded after it exits, unless
# the plugin's Cloud saves setting is off. A prefix that doesn't exist yet is fine: Proton keeps
# files already there when it creates one. Save folders are the store's (Epic's CloudSaveFolder,
# GOG's cloud storage locations), with the Windows folders resolved in the prefix.
# GOG games' setup: on a prefix's first start (and after the game updates), the game's install
# script (GOG's script interpreter, ISI: registry entries and the like) and the redistributables
# its manifest lists (DirectX, Visual C++...) are run in the prefix first, as Heroic does, through
# the same Steam command with cmd.exe and a batch file in place of the game. .NET installers are
# left out: Proton has wine-mono in .NET's place, and Microsoft's don't install under Wine.
# Logins, installs, GOG's sync times and redistributables are Heroic's (~/.config/heroic), as in
# the plugin.
# A log of the last starts: ~/.local/state/kettle-stores/run.log (Epic's code left out).
import json, os, re, shlex, signal, subprocess, sys, time, urllib.request

HOME = os.path.expanduser("~")
HEROIC = os.path.join(HOME, ".config", "heroic")
LEGENDARY = os.path.join(HEROIC, "legendaryConfig", "legendary")
GOGDL = os.path.join(HEROIC, "gogdlConfig")
GOG_AUTH = os.path.join(HEROIC, "gog_store", "auth.json")
GOG_SYNC = os.path.join(HEROIC, "gog_store", "saveTimestamps.json")  # Heroic's: {id: {location: ts}}
GOG_INSTALLED = os.path.join(HEROIC, "gog_store", "installed.json")
REDIST = os.path.join(HEROIC, "tools", "redist", "gog")  # Heroic's: GOG's redistributables
SKIP_DEPS = re.compile(r"^dotNet", re.I)
LANGUAGES = {"en": "English", "de": "German", "fr": "French", "es": "Spanish", "it": "Italian", "pl": "Polish",
             "ru": "Russian", "pt": "Portuguese", "ja": "Japanese", "ko": "Korean", "zh": "Chinese",
             "nl": "Dutch", "cs": "Czech", "hu": "Hungarian", "tr": "Turkish"}
os.environ.setdefault("LEGENDARY_CONFIG_PATH", LEGENDARY)
os.environ.setdefault("NILE_CONFIG_PATH", os.path.join(HEROIC, "nile_config"))
os.environ.setdefault("GOGDL_CONFIG_PATH", GOGDL)
PLUGIN_STATE = os.path.join(HOME, "homebrew", "settings", "kettle-stores", "stores.json")
STATE = os.path.join(os.environ.get("XDG_STATE_HOME") or os.path.join(HOME, ".local", "state"), "kettle-stores")
SYNC_TIMEOUT = 120


def log(*a):
    try:
        os.makedirs(STATE, exist_ok=True)
        path = os.path.join(STATE, "run.log")
        if os.path.exists(path) and os.path.getsize(path) > 256 << 10:
            os.replace(path, path + ".old")
        with open(path, "a") as f:
            print(time.strftime("%F %T"), *a, file=f)
    except OSError:
        pass


def read_json(path, default):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return default


def masked(args):
    return [a.split("=", 1)[0] + "=…" if a.startswith("-AUTH_PASSWORD=") else a for a in args]


def run(cmd, timeout=SYNC_TIMEOUT):
    """A sync command: its result, or None when it failed or took too long (logged)."""
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
    except (subprocess.TimeoutExpired, OSError) as e:
        log(cmd[0], cmd[1], "failed:", e)
        return None
    if r.returncode != 0:
        log(cmd[0], cmd[1], "failed:", r.stderr.strip()[-400:])
        return None
    return r


# --- the Windows folders in the shortcut's Proton prefix ------------------------------------------

def user_dir() -> str | None:
    data = os.environ.get("STEAM_COMPAT_DATA_PATH")
    return os.path.join(data, "pfx", "drive_c", "users", "steamuser") if data else None


def windows_folders() -> dict:
    u = user_dir()
    return {"USERPROFILE": u, "LOCALAPPDATA": f"{u}/AppData/Local", "APPDATA": f"{u}/AppData/Roaming",
            "DOCUMENTS": f"{u}/Documents", "SAVED_GAMES": f"{u}/Saved Games"}


def resolve(path: str) -> str:
    """%VAR% Windows variables in a path, in the prefix; backslashes and .. tidied."""
    w = windows_folders()
    path = re.sub(r"%(\w+)%", lambda m: w.get(m.group(1).upper(), m.group(0)), path)
    return os.path.normpath(path.replace("\\", "/"))


# --- the stores ---------------------------------------------------------------------------------

def game_dir(gid: str) -> str:
    """The GOG game's folder: where goggame-<id>.info is, the start dir or above it."""
    path = os.getcwd()
    while not os.path.exists(os.path.join(path, f"goggame-{gid}.info")) and os.path.dirname(path) != path:
        path = os.path.dirname(path)
    return path


def epic(gid):
    for extra in ([], ["--offline"]):
        try:
            r = subprocess.run(["legendary", "launch", gid, "--json", *extra], capture_output=True, text=True, timeout=60)
        except subprocess.TimeoutExpired:
            log("legendary launch timed out", extra)
            continue
        if r.returncode == 0:
            try:
                d = json.loads(r.stdout)
                return d.get("egl_parameters", []) + d.get("game_parameters", []) + d.get("user_parameters", []), {}
            except (ValueError, AttributeError, TypeError) as e:  # not legendary's JSON: try offline, then none
                log("legendary launch", *extra, "printed no launch JSON:", e)
                continue
        log("legendary launch", *extra, "failed:", r.stderr.strip()[-400:])
    return [], {}


def gog(gid):
    info = read_json(os.path.join(game_dir(gid), f"goggame-{gid}.info"), None)
    if info is None:
        log("no goggame info for", gid)
        return [], {}
    task = next((t for t in info.get("playTasks", []) if t.get("isPrimary")), {})
    return shlex.split(task.get("arguments") or "", posix=False), {}


def amazon(gid):
    try:
        r = subprocess.run(["nile", "launch", gid, "--json"], capture_output=True, text=True, timeout=60)
        d = json.loads(r.stdout.strip().splitlines()[-1])
    except (subprocess.TimeoutExpired, ValueError, IndexError) as e:
        log("nile launch failed:", e)
        return [], {}
    return (d.get("command") or {}).get("arguments") or [], d.get("env") or {}


# --- cloud saves --------------------------------------------------------------------------------

def epic_save_path(gid: str) -> str | None:
    """Epic's CloudSaveFolder for the game, in the prefix (None: no cloud saves)."""
    meta = read_json(os.path.join(LEGENDARY, "metadata", f"{gid}.json"), {}).get("metadata") or {}
    folder = ((meta.get("customAttributes") or {}).get("CloudSaveFolder") or {}).get("value")
    game = read_json(os.path.join(LEGENDARY, "installed.json"), {}).get(gid)
    if not folder or not game or not user_dir():
        return None
    w = windows_folders()
    known = {"installdir": game["install_path"],
             "epicid": read_json(os.path.join(LEGENDARY, "user.json"), {}).get("account_id", ""),
             "appdata": w["LOCALAPPDATA"], "userdir": w["DOCUMENTS"], "userprofile": w["USERPROFILE"],
             "usersavedgames": w["SAVED_GAMES"]}
    path = re.sub(r"\{(\w+)\}", lambda m: known.get(m.group(1).lower(), m.group(0)), folder)
    return resolve(path)


def epic_sync(gid: str, direction: str):
    path = epic_save_path(gid)
    if not path:
        return
    os.makedirs(path, exist_ok=True)
    skip = "--skip-upload" if direction == "down" else "--skip-download"
    if run(["legendary", "-y", "sync-saves", gid, "--save-path", path, skip]):
        log("epic saves", direction, gid, "ok")


GOG_VARS = {"INSTALL": None, "SAVED_GAMES": "%SAVED_GAMES%", "APPLICATION_DATA_LOCAL": "%LOCALAPPDATA%",
            "APPLICATION_DATA_LOCAL_LOW": "%APPDATA%\\..\\LocalLow", "APPLICATION_DATA_ROAMING": "%APPDATA%",
            "DOCUMENTS": "%DOCUMENTS%"}


def gog_locations(gid: str) -> list[dict]:
    """The game's cloud save locations, {"name", "path"} in the prefix (as Heroic resolves them)."""
    if not user_dir():
        return []
    root = game_dir(gid)
    client = (read_json(os.path.join(GOGDL, "heroic_gogdl", "manifests", gid), {}).get("clientId")
              or read_json(os.path.join(root, f"goggame-{gid}.info"), {}).get("clientId"))
    if not client:
        return []
    try:
        with urllib.request.urlopen(f"https://remote-config.gog.com/components/galaxy_client/clients/{client}"
                                    "?component_version=2.0.45", timeout=15) as r:
            storage = json.load(r)["content"]["Windows"]["cloudStorage"]
    except Exception as e:
        log("gog cloud storage config:", e)
        return []
    if not storage.get("enabled"):
        return []
    locations = storage.get("locations") or [
        {"name": "__default", "location": f"%LOCALAPPDATA%/GOG.com/Galaxy/Applications/{client}/Storage/Shared/Files"}]
    out = []
    for loc in locations:
        path = re.sub(r"<\?(\w+)\?>", lambda m: root if m.group(1) == "INSTALL" else GOG_VARS.get(m.group(1), m.group(0)),
                      loc["location"])
        if "<?" in path:  # a folder variable Heroic doesn't know either: leave that location out
            log("gog save location with an unknown folder:", loc["location"])
            continue
        out.append({"name": loc["name"], "path": resolve(path)})
    return out


def gog_sync(gid: str, direction: str, locations: list[dict]):
    times = read_json(GOG_SYNC, {})
    for loc in locations:
        os.makedirs(loc["path"], exist_ok=True)
        ts = str((times.get(gid) or {}).get(loc["name"], "0"))
        r = run(["gogdl", "--auth-config-path", GOG_AUTH, "save-sync", loc["path"], gid, "--os", "windows",
                 "--ts", ts, "--name", loc["name"], "--skip-upload" if direction == "down" else "--skip-download"])
        if r and r.stdout.strip():
            times = read_json(GOG_SYNC, {})
            times.setdefault(gid, {})[loc["name"]] = r.stdout.strip().splitlines()[-1]
            try:
                with open(GOG_SYNC + ".tmp", "w") as f:
                    json.dump(times, f)
                os.replace(GOG_SYNC + ".tmp", GOG_SYNC)
            except OSError as e:
                log("gog sync times:", e)
            log("gog saves", direction, gid, loc["name"], "ok")


# --- GOG setup ----------------------------------------------------------------------------------

def win(path: str) -> str:
    """A Linux path as the prefix sees it (Z: is /)."""
    return "Z:" + path.replace("/", "\\")


def bat_arg(a: str) -> str:
    a = a.replace("%", "%%")
    return f'"{a}"' if " " in a else a


def proton_at(cmd: list[str]) -> int | None:
    """Where Proton is in Steam's command: cmd[i] is proton, cmd[i + 1] its verb, then the game."""
    for i, c in enumerate(cmd[:-2]):
        if os.path.basename(c) == "proton" and cmd[i + 1] in ("waitforexitandrun", "run"):
            return i
    return None


def gog_needs(gid: str) -> tuple[dict, list[str], bool]:
    """The game's manifest, the redistributables it needs (.NET left out) and whether it has an
    install script."""
    manifest = read_json(os.path.join(GOGDL, "heroic_gogdl", "manifests", gid), {})
    if manifest.get("version") != 2:
        return manifest, [], False
    return (manifest, [d for d in manifest.get("dependencies") or [] if not SKIP_DEPS.match(d)],
            bool(manifest.get("scriptInterpreter")))


def redist_available() -> dict:
    """The redistributables downloaded so far, by id (GOG's manifest lists them all)."""
    depots = read_json(os.path.join(REDIST, ".gogdl-redist-manifest"), {}).get("depots") or []
    return {d["dependencyId"]: d for d in depots
            if (d.get("executable") or {}).get("path") and os.path.exists(os.path.join(REDIST, d["executable"]["path"]))}


def redist_fetch(need: list[str]) -> dict:
    have = redist_available()
    if any(d not in have for d in need):
        log("gog redistributables: downloading", need)
        os.makedirs(REDIST, exist_ok=True)
        run(["gogdl", "--auth-config-path", GOG_AUTH, "redist", "--ids", ",".join(need), "--path", REDIST], timeout=3600)
        have = redist_available()
    return have


def gog_setup(gid: str, cmd: list[str]):
    data = os.environ.get("STEAM_COMPAT_DATA_PATH")
    i = proton_at(cmd)
    manifest, deps, isi = gog_needs(gid)
    if not data or i is None or (not deps and not isi):
        return
    marker = os.path.join(data, "kettle-gog-setup.json")
    done = read_json(marker, {})
    key = f"{manifest.get('buildId')}:{','.join(sorted(deps))}:{isi}"
    if done.get(gid) == key:
        return
    need = (["ISI"] if isi else []) + deps
    have = redist_fetch(need)  # the install job fetched them; a game installed elsewhere may not have

    game = next((g for g in read_json(GOG_INSTALLED, {}).get("installed", []) if g.get("appName") == gid), {})
    root = game_dir(gid)
    code = game.get("language") or "en-US"
    lang = LANGUAGES.get(code.split("-")[0], "English")
    support = os.path.join(GOGDL, "heroic_gogdl", "gog-support", gid)
    lines = ["@echo off"]
    if isi and "ISI" in have:
        isi_exe = win(os.path.join(REDIST, have["ISI"]["executable"]["path"]))
        for p in manifest.get("products") or []:
            if p.get("productId") != gid and p.get("productId") not in (game.get("installedDLCs") or []):
                continue
            args = ["/VERYSILENT", f"/DIR={win(root)}", f"/Language={lang}", f"/LANG={lang}",
                    f"/ProductId={p['productId']}", "/galaxyclient", f"/buildId={game.get('buildId', '')}",
                    f"/versionName={game.get('version', '')}", f"/lang-code={code}", f"/supportDir={win(support)}",
                    "/nodesktopshorctut", "/nodesktopshortcut"]  # (GOG's own typo, and the right spelling)
            lines.append(f'start "" /wait {bat_arg(isi_exe)} ' + " ".join(bat_arg(a) for a in args))
    for d in deps:
        if d not in have:
            log("gog setup: no redistributable", d)
            continue
        exe = win(os.path.join(REDIST, have[d]["executable"]["path"]))
        args = (have[d]["executable"].get("arguments") or "").replace("%", "%%")
        if d == "PHYSXLEGACY":  # an .msi: hands-free as Heroic does it
            lines.append(f'start "" /wait msiexec /i {bat_arg(exe)} {args} /qb')
        else:
            lines.append(f'start "" /wait {bat_arg(exe)} {args}')
    bat = os.path.join(data, "kettle-gog-setup.bat")
    os.makedirs(data, exist_ok=True)
    with open(bat, "w", newline="\r\n") as f:
        f.write("\n".join(lines) + "\n")
    log("gog setup:", gid, need)
    try:
        r = subprocess.run(cmd[:i + 2] + ["C:\\windows\\system32\\cmd.exe", "/c", win(bat)], timeout=1800)
        log("gog setup: done", r.returncode)
    except subprocess.TimeoutExpired:
        log("gog setup: timed out")
    done[gid] = key  # once per build either way: a redistributable that won't install shouldn't hold up every start
    try:
        with open(marker, "w") as f:
            json.dump(done, f)
    except OSError as e:
        log("gog setup marker:", e)


def cloud_saves_on() -> bool:
    return read_json(PLUGIN_STATE, {}).get("cloud_saves", True) is not False


# --- the game -----------------------------------------------------------------------------------

def main():
    if sys.argv[1:2] == ["gog-redist"] and len(sys.argv) == 3:
        # the plugin's install job, after gogdl download: the redistributables the game needs
        _m, deps, isi = gog_needs(sys.argv[2])
        if deps or isi:
            have = redist_fetch((["ISI"] if isi else []) + deps)
            print("redistributables:", ", ".join(sorted(have)))
        return
    if len(sys.argv) < 4:
        sys.exit("usage: kettle-store-run <epic|gog|amazon> <id> <command...>")
    store, gid, cmd = sys.argv[1], sys.argv[2], sys.argv[3:]
    sync = cloud_saves_on() and store in ("epic", "gog")
    gog_locs = gog_locations(gid) if sync and store == "gog" else []
    if sync:
        epic_sync(gid, "down") if store == "epic" else gog_sync(gid, "down", gog_locs)
    if store == "gog":
        gog_setup(gid, cmd)
    extra, env = {"epic": epic, "gog": gog, "amazon": amazon}.get(store, lambda _: ([], {}))(gid)
    log("start", store, gid, "args:", masked(extra), "env:", sorted(env))
    os.environ.update(env)
    if not sync:
        os.execvp(cmd[0], cmd + extra)
    # run the game and wait, to upload its saves after; Steam's stop reaches the game through this
    game = subprocess.Popen(cmd + extra)
    for sig in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
        signal.signal(sig, lambda s, _f: game.send_signal(s))
    code = game.wait()
    log("exit", store, gid, code)
    epic_sync(gid, "up") if store == "epic" else gog_sync(gid, "up", gog_locs)
    sys.exit(code if code >= 0 else 128 - code)


main()
