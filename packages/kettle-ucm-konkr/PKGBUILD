# ALSA UCM profile for KONKR's SM8750 handheld: card "SM8750-KONKR" (the AW88261 speakers on MI2S,
# the WCD9395 headphone jack with its HPH path in PCM mode, kernel 22-sm8750/0072-0074, and
# DisplayPort over USB-C, the dts's DP link). Armada's version (armada-os/armada @ 2e0874d8,
# system_files/usr/share/alsa/ucm2/KONKR) of ROCKNIX's devices/SM8750 profile: it adds the
# DisplayPort device, disable sequences, and keeps the amps at unity gain (PipeWire sets the
# volume). Only new files: Valve's alsa-ucm-conf stays untouched.
pkgname=kettle-ucm-pocketfitelite
pkgver=1.0.0
pkgrel=2
pkgdesc='ALSA UCM profile for the KONKR Pocket FIT Elite'
arch=(any)
license=(BSD-3-Clause)
depends=(alsa-ucm-conf)
source=(KONKR-PocketFitElite.conf HiFi.conf)
sha256sums=('3d07af20c1d5a833c156db031baa8b7a73b958c73aceaa29ba6bae7960797e12'
            'b8a267e13d30d3f6ab17740b055bccb545b6bf6f39e4b0069b2994b264e6c3f2')

package() {
  local ucm="$pkgdir/usr/share/alsa/ucm2"
  install -Dm644 -t "$ucm/KONKR/PocketFitElite" KONKR-PocketFitElite.conf HiFi.conf
  # alsa-lib looks up conf.d/<driver>/<card name>.conf; booted by the ABL there is no SMBIOS,
  # so the card name is the devicetree's sound model
  install -d "$ucm/conf.d/sm8750"
  ln -s ../../KONKR/PocketFitElite/KONKR-PocketFitElite.conf "$ucm/conf.d/sm8750/SM8750-KONKR.conf"
}
