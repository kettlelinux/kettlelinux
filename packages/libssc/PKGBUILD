# libssc: reads the sensors the Qualcomm Sensor Core (on the ADSP) manages, over QMI/QRTR,
# once hexagonrpcd has started the sensors process. ssccli prints accelerometer and gyroscope
# readings (--rate picks the sample rate), for checking a device's motion sensors.
pkgname=libssc
pkgver=0.4.4
pkgrel=2
pkgdesc='Library to expose Qualcomm Sensor Core sensors'
arch=(aarch64)
url='https://codeberg.org/DylanVanAssche/libssc'
license=(GPL-3.0-or-later)
depends=(glib2 libqmi protobuf-c)
makedepends=(meson protobuf gobject-introspection)  # protobuf-c: packages/protobuf-c
source=("$pkgname-$pkgver.tar.gz::https://codeberg.org/DylanVanAssche/libssc/archive/v$pkgver.tar.gz"
        0001-sensor-let-clients-choose-the-sample-rate.patch)
sha256sums=('716d6bd6b34d2d753060c6b54c9a87e34fae75b724c763bf9ef487efa3621587'
            SKIP)

prepare() {
  # the QMI mock server and its tests are for libssc development, and the mock server's meson
  # needs a newer meson than the snapshot's 1.4
  sed -i "/^subdir('mocking')/d; /^subdir('tests')/d" $pkgname/meson.build
  patch -d $pkgname -Np1 -i ../0001-sensor-let-clients-choose-the-sample-rate.patch
}

build() {
  arch-meson $pkgname build
  meson compile -C build
}

package() {
  meson install -C build --destdir "$pkgdir"
}
