new file mode 100644
index 0000000..8c507c6
--- /dev/null
+++ b/src/deckard_temp.cpp
@@ -0,0 +1,59 @@
+#include "deckard_temp.h"
+
+#include <vector>
+#include <algorithm>
+#include <filesystem>
+#include <fstream>
+#include <iostream>
+
+#ifndef MAX_TEST
+#include <filesystem.h>
+namespace fs = ghc::filesystem;
+#else
+namespace fs = std::filesystem;
+#endif
+
+DeckardTemp::DeckardTemp() {
+	/* find relevant hwmon path for metric */
+	for (auto const& dir_entry : fs::directory_iterator("/sys/class/thermal/")) {
+		auto name_path = dir_entry.path().string() + "/type";
+		try {
+			std::ifstream name_if(name_path);
+			std::string name;
+			name_if >> name;
+			if (name.substr(0, 3) != "cpu" || 
+				(name.substr(4, name.size()) != "-thermal" && 
+				 name.substr(4, name.size()) != "-top-thermal"))
+				continue;
+			paths.push_back(dir_entry.path().string());
+		} catch (std::exception &e) {
+			continue;
+		}
+	}
+}
+
+float DeckardTemp::get_temp() {
+	float avg = 0.0;
+	int count = 0;
+	for (auto const& path: paths) {
+		auto name_path = path + "/temp";
+		try {
+			std::ifstream temp_if(name_path);
+			int temp;
+			temp_if >> temp;
+			avg += (float)temp / 1000.0f;
+			count++;
+		} catch (std::exception &e) {
+			continue;
+		}
+	}
+
+	return avg / (float)count;
+}
+
+#ifdef MAX_TEST
+int main() {
+	DeckardTemp test;
+	std::cout << test.get_temp() << std::endl;
+}
+#endif
