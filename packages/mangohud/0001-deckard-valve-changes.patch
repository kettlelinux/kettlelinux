@@ -0,0 +1,43 @@
+#include "deckard_power.h"
+
+#include <fstream>
+#include <string>
+
+static std::string power_path(const char* name) {
+	return std::string("/run/power-monitor/power/") + name;
+}
+
+bool DeckardPower::available() {
+	std::ifstream f(power_path(cpu_cores));
+	return f.is_open();
+}
+
+bool DeckardPower::read(const char* name, float& watts) {
+	std::ifstream f(power_path(name));
+	if (!f.is_open())
+		return false;
+
+	float value;
+	if (!(f >> value))
+		return false;
+
+	watts = value;
+	return true;
+}
+
+/*
+ * To compile as standalone tool run:
+ *  g++ -o deckard_power -D MAX_TEST=1 src/deckard_power.cpp */
+
+#ifdef MAX_TEST
+
+#include <cstdio>
+
+int main() {
+	float cpu = 0, gpu = 0;
+	bool have_cpu = DeckardPower::read(DeckardPower::cpu_cores, cpu);
+	bool have_gpu = DeckardPower::read(DeckardPower::gfx, gpu);
+	printf("available=%d cpu=%d:%f gfx=%d:%f\n", DeckardPower::available(), have_cpu, cpu, have_gpu, gpu);
+}
+
+#endif
