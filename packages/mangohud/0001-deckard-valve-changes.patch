diff --git a/src/msm.cpp b/src/msm.cpp
new file mode 100644
index 0000000..1ab858d
--- /dev/null
+++ b/src/msm.cpp
@@ -0,0 +1,195 @@
+#include <cstdio>
+#include <cstring>
+#include <filesystem.h>
+#include <mesa/util/os_time.h>
+#include <inttypes.h>
+
+#include <string>
+#include <iostream>
+#include <sstream>
+#include <fstream>
+#include <thread>
+#include <chrono>
+#include <atomic>
+
+#include "msm.h"
+#include "deckard_power.h"
+#include "file_utils.h"
+#include "logging.h"
+#include <spdlog/spdlog.h>
+
+namespace fs = ghc::filesystem;
+
+unsigned gpu_bytes_memory();
+void perf_read_thread();
+double read_value(std::string path);
+double read_value_s(std::string path);
+
+unsigned gpu_bytes_memory()
+{
+    unsigned long long bytes = ftrace_gpumem_get();
+    SPDLOG_DEBUG("ftrace_gpumem_get() bytes: %llu\n", bytes);
+    return (unsigned)bytes;
+}
+
+static std::atomic<double> gpu_usage;
+void perf_read_thread()
+{
+    while (true) {
+        gpu_usage = 0.0;
+
+        {
+            std::ifstream perf_now("/sys/kernel/debug/dri/0/perf_now");
+            if (perf_now.is_open()) {
+                std::string line; 
+                std::getline(perf_now, line);
+
+                try {
+                    gpu_usage = std::stod(line);
+                } catch (...) {}
+            }
+        }
+
+        std::this_thread::sleep_for(std::chrono::milliseconds(100));
+	//printf("usage=%f\n",gpu_usage.load());
+    }
+}
+
+double read_value(std::string path)
+{
+    std::ifstream file(path, std::ios::binary);
+    double output = 0;
+
+    if (file.is_open()) {
+        file >> output;
+        return output;
+    }
+
+    return output;
+}
+
+static std::string find_hwmon(const std::string& name)
+{
+    for (auto const& entry : fs::directory_iterator("/sys/class/hwmon/")) {
+        auto path = entry.path().string();
+        if (read_line(path + "/name") == name)
+            return path;
+    }
+    return "";
+}
+
+double read_value_s(std::string path)
+{
+    std::ifstream file(path);
+    double output = 0;
+
+    if (file.is_open()) {
+        file >> output;
+        return output;
+    }
+
+    return output;
+}
+
+uint64_t MSM::getQcomGpuInfo(){
+    static std::thread perf_thread(perf_read_thread);
+    //printf("gpu_bytes_memory()=%d\n",gpu_bytes_memory());
+    gpu_info_msm.load = gpu_usage;
+    gpu_info_msm.temp = read_value("/sys/class/thermal/thermal_zone28/temp") / 1000.0; //gpuss-2-thermal
+    gpu_info_msm.junction_temp = read_value("/sys/class/thermal/thermal_zone26/temp") / 1000.0; //gpuss-0-thermal
+    gpu_info_msm.memory_temp = read_value("/sys/class/thermal/thermal_zone22/temp") / 1000.0; //ddr-thermal
+    // slg4ax46073v fan controller reports twice the actual rpm
+    static const std::string fan_hwmon = find_hwmon("slg4ax46073v");
+    gpu_info_msm.fan_speed = read_value(fan_hwmon + "/fan1_input") / 2;
+    gpu_info_msm.fan_rpm = true;
+    gpu_info_msm.sys_vram_used = float(gpu_bytes_memory()) / (1024 * 1024 * 1024);
+    gpu_info_msm.proc_vram_used = gpu_info_msm.sys_vram_used;
+    gpu_info_msm.CoreClock = read_value_s("/sys/devices/platform/soc@0/3d00000.gpu/devfreq/3d00000.gpu/cur_freq") / 1000000.0;
+    gpu_info_msm.MemClock = 4200; //MHz
+    gpu_info_msm.memoryTotal = 16000; 
+    return 0;
+}
+
+uint64_t MSM::get_gpu_time() {
+    char line[256];
+    uint64_t total_val = 0;
+    for (auto fd : fdinfo) {
+        rewind(fd);
+        fflush(fd);
+        uint64_t val = 0;
+        while (fgets(line, sizeof(line), fd)){
+            if (sscanf(line, "drm-engine-gpu: %" SCNu64 " ns", &val) == 1) {
+                total_val += val;
+                break;
+            }
+        }
+    }
+
+    return total_val;
+}
+
+void MSM::find_fd() {
+    DIR* dir = opendir("/proc/self/fdinfo");
+    if (!dir) {
+        perror("Failed to open directory");
+    }
+
+    for (const auto& entry : fs::directory_iterator("/proc/self/fdinfo")){
+        FILE* file = fopen(entry.path().string().c_str(), "r");
+
+        if (!file) continue;
+
+        char line[256];
+        bool found_driver = false;
+        while (fgets(line, sizeof(line), file)) {
+            if (strstr(line, "msm") != NULL)
+                found_driver = true;
+
+            if (found_driver) {
+                if(strstr(line, "drm-engine-gpu")) {
+                    fdinfo.push_back(file);
+                    break;
+                }
+            }
+        }
+
+        if (!found_driver)
+            fclose(file);
+    }
+
+    closedir(dir);
+}
+
+void MSM::get_fdinfo() {
+    static uint64_t previous_gpu_time, previous_time, now, gpu_time_now;
+    gpu_time_now = get_gpu_time();
+    now = os_time_get_nano();
+
+    if (previous_time && previous_gpu_time && gpu_time_now > previous_gpu_time){
+        float time_since_last = now - previous_time;
+        float gpu_since_last = gpu_time_now - previous_gpu_time;
+        auto result = int((gpu_since_last / time_since_last) * 100);
+        if (result > 100)
+            result = 100;
+
+        gpu_info_msm.load = result;
+        previous_gpu_time = gpu_time_now;
+        previous_time = now;
+    } else {
+        previous_gpu_time = gpu_time_now;
+        previous_time = now;
+    }
+}
+
+void MSM::update_power() {
+    while (true) {
+        // gfx rail from deckard_power_monitor, the equivalent of Steam Deck's GPU power
+        float gpupower = 0;
+        DeckardPower::read(DeckardPower::gfx, gpupower);
+        {
+            std::lock_guard<std::mutex> lock(metrics_mutex);
+            gpu_info_msm.powerUsage = gpupower;
+        }
+        usleep(100000);
+    }
+}
diff --git a/src/msm.h b/src/msm.h
new file mode 100644
index 0000000..cc58ae4
--- /dev/null
+++ b/src/msm.h
@@ -0,0 +1,63 @@
+#include <cstdio>
+#include <memory>
+#include <mutex>
+#include <thread>
+#include <unistd.h>
+#include <vector>
+
+#include "gpu_metrics_util.h"
+
+#include "ftrace_gpumem.h"
+
+class MSM {
+    private:
+        struct gpu_metrics gpu_info_msm {};
+        std::vector<FILE*> fdinfo;
+        std::mutex metrics_mutex;
+        void find_fd();
+        uint64_t get_gpu_time();
+        void get_fdinfo();
+        uint64_t getQcomGpuInfo();
+
+        void update() {
+            while (1) {
+                usleep(100000);
+
+                std::lock_guard<std::mutex> lock(metrics_mutex);
+#ifdef GPU_FDINFO
+                if (!fdinfo.empty())
+                    get_fdinfo();
+#endif                    
+                getQcomGpuInfo();
+            }
+        }
+
+        void update_power();
+
+    public:
+        MSM() {
+            find_fd();
+
+            std::thread thread(&MSM::update, this);
+            thread.detach();
+            std::thread p_thread(&MSM::update_power, this);
+            p_thread.detach();
+
+	    ftrace_gpumem_init();
+        }
+
+        ~MSM() {
+            for (size_t i = 0; i < fdinfo.size(); i++) {
+                fclose(fdinfo[i]);
+            }
+            fdinfo.clear();
+
+	    ftrace_gpumem_fini();
+        }
+
+        gpu_metrics copy_metrics() {
+            std::lock_guard<std::mutex> lock(metrics_mutex);
+
+            return gpu_info_msm;
+        };
+};
