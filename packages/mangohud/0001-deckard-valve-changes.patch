diff --git a/src/ftrace_gpumem.c b/src/ftrace_gpumem.c
new file mode 100644
index 0000000..76fd5c7
--- /dev/null
+++ b/src/ftrace_gpumem.c
@@ -0,0 +1,91 @@
+#include <stdlib.h>
+#include <ctype.h>
+#include <tracefs.h>
+#include <errno.h>
+#include <string.h>
+#include "ftrace_gpumem.h"
+
+static struct tep_handle *tep;
+static struct tracefs_instance *inst;
+static unsigned long long mem = 0;
+
+static int records_walk(struct tep_event *_tep, struct tep_record *record, int cpu, void *context)
+{
+	struct tep_event *event = tep_find_event_by_record(tep, record);
+	if (!event)
+		return 0;
+	else {
+		struct tep_format_field *format;
+		format = event->format.fields;
+		for ( ; format; format = format->next )
+		{
+		    if ( !strcmp( format->name, "pid" ) ) {
+			unsigned long long val = tep_read_number( tep,
+				( char * )record->data + format->offset, format->size );
+			// pid = 0 -> total mem
+			if (val != 0)
+				return 0;
+		    } else if ( !strcmp( format->name, "size" ) ) {
+			unsigned long long val = tep_read_number( tep,
+				( char * )record->data + format->offset, format->size );
+			mem = val;
+		    }
+		}
+	}
+	/* Got recorded event on cpu */
+	return 0;
+}
+
+void ftrace_gpumem_init(void)
+{
+	int ret;
+	char * dir;
+
+	inst = tracefs_instance_create("mangohud");
+	if (!inst) {
+		/* Error creating a new trace instance */
+		printf("failed to create instance");
+		abort();
+	}
+
+	dir = tracefs_instance_get_dir(inst);
+	if (!dir) {
+		perror("tracefs_instance_get_dir");
+		exit(EXIT_FAILURE);
+	}
+
+	tep = tracefs_local_events(dir);
+	tracefs_put_tracing_file(dir);   /* frees dir */
+
+	if (!tep) {
+		perror("Reading trace event formats");
+		exit(EXIT_FAILURE);
+	}
+
+	/* Disable all events */
+	tracefs_event_disable(inst, NULL, NULL);
+	errno = 0;
+	ret = tracefs_event_enable(inst, "gpu_mem", "gpu_mem_total");
+	if (ret < 0 && !errno)
+		printf("Could not find 'sched' events\n");
+
+	printf("Successfully enabled ftrace instance and events\n");
+}
+
+unsigned long long ftrace_gpumem_get(void)
+{
+	tracefs_iterate_raw_events(tep, inst, NULL, 0, records_walk, NULL);
+
+	return mem;
+}
+
+void ftrace_gpumem_fini(void)
+{
+	/* Disable all events */
+	tracefs_event_disable(NULL, NULL, NULL);
+	tep_free(tep);
+
+	if (tracefs_instance_is_new(inst))
+		tracefs_instance_destroy(inst);
+	tracefs_instance_free(inst);
+}
