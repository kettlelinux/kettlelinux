+#include "file_utils.h"
 
 namespace fs = ghc::filesystem;
 using namespace std;
@@ -15,7 +16,11 @@ void BatteryStats::numBattery() {
         for (const auto& p : fs::directory_iterator(dir)) {
             string fileName = p.path().filename();
 
-            if ( (fileName.find("BAT") != std::string::npos) && (batteryCount < BATTERY_COUNT_MAX) ) {
+            bool is_battery = fileName.find("BAT") != std::string::npos ||
+                              read_line((p.path() / "type").string()) == "Battery";
+            // controllers and other peripherals' batteries aren't the system's
+            is_battery = is_battery && read_line((p.path() / "scope").string()) != "Device";
+            if (is_battery && (batteryCount < BATTERY_COUNT_MAX) ) {
                 battPath[batteryCount++] = p.path();
             }
         }
