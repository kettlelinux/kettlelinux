+// Thermal zone numbering differs between SoCs and device trees, so look zones up by type.
+static std::vector<std::string> find_thermal_zones(const std::string& prefix)
+{
+    std::vector<std::string> zones;
+    std::error_code ec;
+    for (auto const& entry : fs::directory_iterator("/sys/class/thermal/", ec)) {
+        auto path = entry.path().string();
+        if (read_line(path + "/type").rfind(prefix, 0) == 0)
+            zones.push_back(path + "/temp");
+    }
+    return zones;
+}
+
+static std::string find_thermal_zone(std::initializer_list<const char*> types)
+{
+    std::error_code ec;
+    for (auto type : types) {
+        for (auto const& entry : fs::directory_iterator("/sys/class/thermal/", ec)) {
+            auto path = entry.path().string();
+            if (read_line(path + "/type") == type)
+                return path + "/temp";
+        }
+    }
+    return "";
+}
+
+static std::string find_gpu_devfreq()
+{
+    std::error_code ec;
+    for (auto const& entry : fs::directory_iterator("/sys/class/devfreq/", ec)) {
+        auto name = entry.path().filename().string();
+        if (name.size() > 4 && name.compare(name.size() - 4, 4, ".gpu") == 0)
+            return entry.path().string() + "/cur_freq";
+    }
+    return "";
+}
+
+static float mem_total_gib()
+{
+    std::ifstream meminfo("/proc/meminfo");
+    std::string key;
+    unsigned long long kib = 0;
+    while (meminfo >> key >> kib) {
+        if (key == "MemTotal:")
+            return float(kib) / (1024 * 1024);
+        meminfo.ignore(64, '\n');
+    }
+    return 0;
+}
