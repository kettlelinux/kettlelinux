+// Kettle Linux: export the focused app's displayed frame rate for the Frame Generation
+// plugin, which derives each game's real (pre frame generation) rate and picks its frame cap
+// from it. $XDG_RUNTIME_DIR/kettle-fps, rewritten about once a second while frames arrive.
+static void kettle_export_fps(uint32_t pid, uint64_t frametime_ns, uint16_t refresh, bool steam_focused){
+    static uint32_t cur_pid = 0;
+    static uint64_t sum_ns = 0, frames = 0;
+    static auto last = std::chrono::steady_clock::now();
+    if (pid != cur_pid) {
+        cur_pid = pid;
+        sum_ns = frames = 0;
+    }
+    if (frametime_ns != ~(0lu) && frametime_ns > 0 && frametime_ns < 1000000000ull) {
+        sum_ns += frametime_ns;
+        frames++;
+    }
+    auto now = std::chrono::steady_clock::now();
+    if (now - last < std::chrono::seconds(1))
+        return;
+    last = now;
+    const char *dir = getenv("XDG_RUNTIME_DIR");
+    if (!dir)
+        return;
+    std::string path = std::string(dir) + "/kettle-fps", tmp = path + ".tmp";
+    if (FILE *f = fopen(tmp.c_str(), "w")) {
+        fprintf(f, "pid=%u\nfps=%.2f\nrefresh=%u\nsteam_focused=%d\ntime=%lld\n", pid,
+                sum_ns ? frames * 1e9 / sum_ns : 0.0, refresh, steam_focused ? 1 : 0, (long long) time(nullptr));
+        fclose(f);
+        rename(tmp.c_str(), path.c_str());
+    }
+    sum_ns = frames = 0;
+}
