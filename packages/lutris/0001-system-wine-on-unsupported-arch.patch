+def is_foreign_wine_version(version: str) -> bool:
+    """True for a Wine version an installer asks for that this system can't run or download:
+    on an architecture Lutris has no Wine builds for (aarch64), GE-Proton (Latest) and any
+    version that isn't installed already."""
+    if linux.LINUX_SYSTEM.arch is not None:
+        return False
+    return version == GE_PROTON_LATEST or version not in get_installed_wine_versions()
