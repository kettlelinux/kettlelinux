# KDE's Welcome Center, built for Valve's deckard Plasma 6.2.5 stack. The deckard base only has
# 6.0.4, whose runCommand gives pages no result and whose update page announces "Plasma 6.0".
# It opens on a user's first desktop login (its kded module); kettle-welcome adds our pages.
#   0001  hide "Learn more about <NAME from os-release>" when the distro has its own intro
#         text: os-release says SteamOS, and the link would point at Steam support
pkgname=plasma-welcome
pkgver=6.2.5
pkgrel=1
pkgdesc='A friendly onboarding wizard for Plasma'
arch=(aarch64)
url='https://kde.org/plasma-desktop/'
license=(GPL-2.0-or-later)
depends=(gcc-libs glibc kcmutils kconfig kconfigwidgets kcoreaddons kdbusaddons ki18n kio
         kirigami kirigami-addons kjobwidgets knewstuff kservice ksvg kwindowsystem libplasma
         milou plasma-nm plasma5support qt6-5compat qt6-base qt6-declarative qt6-svg)
makedepends=(cmake ninja extra-cmake-modules)
source=(https://download.kde.org/stable/plasma/$pkgver/$pkgname-$pkgver.tar.xz
        0001-hide-distro-link-with-custom-intro.patch)
sha256sums=('e9a2ae0cad82ef9feae7471f625628d7df7098255ea8ee71fab78ed48539261a'
            'c03ab28b57c57730fec41faa76b4863a2580b7536c4f9c577c02ed2d978d4dca')

prepare() {
  cd $pkgname-$pkgver
  patch -Np1 -i ../0001-hide-distro-link-with-custom-intro.patch
}

build() {
  cmake -B build -S $pkgname-$pkgver -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_INSTALL_LIBEXECDIR=lib \
    -DBUILD_TESTING=OFF
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
