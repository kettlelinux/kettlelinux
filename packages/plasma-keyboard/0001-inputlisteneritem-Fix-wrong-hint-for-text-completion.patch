From 44bd82ed345b4d6ac037d3ae55b2d3ec2237bd7f Mon Sep 17 00:00:00 2001
From: Devin Lin <espidev@gmail.com>
Date: Wed, 1 Apr 2026 22:52:14 -0400
Subject: [PATCH] inputlisteneritem: Fix wrong hint for text completion

The text completion and correction hints should affect the "no
predictive text"  flag to Qt, not the auto capitalization flag.

Ported to plasma-keyboard 6.6.7. The Plasma/6.6 branch never took this
commit, and its cherry-pick of "Always disable predictive text" (59b27fc)
left the auto-uppercase check without its "== 0", so Qt's auto-uppercase
was turned off exactly when the client asked for capitalization. This puts
the comparison back (6.6 has no auto capitalization setting).

Backported from upstream commit 05cb6f14e33d4a68721bfc4ab561988ca3f567c6
---
 src/inputlisteneritem.cpp | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/src/inputlisteneritem.cpp b/src/inputlisteneritem.cpp
index ff7fad4..bf3f704 100644
--- a/src/inputlisteneritem.cpp
+++ b/src/inputlisteneritem.cpp
@@ -176,7 +176,7 @@ QVariant InputListenerItem::inputMethodQuery(Qt::InputMethodQuery query) const
         if (imHints & InputPlugin::content_hint_password) {
             qtHints |= Qt::ImhSensitiveData;
         }
-        if ((imHints & InputPlugin::content_hint_auto_capitalization)) {
+        if ((imHints & InputPlugin::content_hint_auto_capitalization) == 0) {
             qtHints |= Qt::ImhNoAutoUppercase;
         }
         // if (imHints & InputPlugin::content_hint_titlecase) { }
