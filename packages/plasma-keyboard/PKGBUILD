# On-screen keyboard for the Plasma desktop: KDE's Qt6 Virtual Keyboard based input method,
# started by KWin (etc/skel/.config/kwinrc). No deckard snapshot ships an on-screen keyboard.
# 6.6.7, the Plasma/6.6 branch's latest release: it builds against the base's Qt 6.10 / KF 6.23
# (master needs Qt 6.11) and has the upstream fixes we used to backport onto 0.1.0. 0001 is
# the one it lacks (05cb6f1, the auto-uppercase hint inverted on that branch).
# maliit-keyboard is no alternative: deckard's Qt5 is half-updated and Qt aborts on the mix.
pkgname=plasma-keyboard
pkgver=6.6.7
pkgrel=1
pkgdesc='Virtual keyboard for Plasma, based on Qt Virtual Keyboard'
arch=(aarch64)
url='https://invent.kde.org/plasma/plasma-keyboard'
license=(GPL-2.0-only GPL-3.0-only LGPL-2.1-only LGPL-3.0-only)
depends=(gcc-libs glibc kcmutils kconfig kcoreaddons kcrash ki18n qt6-base qt6-declarative
         qt6-virtualkeyboard qt6-wayland wayland)
makedepends=(cmake ninja extra-cmake-modules qt6-tools wayland-protocols)
source=(https://download.kde.org/stable/plasma/$pkgver/$pkgname-$pkgver.tar.xz
        0001-inputlisteneritem-Fix-wrong-hint-for-text-completion.patch)
sha256sums=('5e536ad0622ca741555071fe4a53b727eafbc64b0652b48971920d0f407ab1f2'
            '0f033e8f8668a9abfa17700e607ecb29625aeecc565c9b5204286104576bc2cc')

prepare() {
  local p
  for p in 0*.patch; do
    patch -d $pkgname-$pkgver -p1 --fuzz=0 <"$p"
  done
}

build() {
  cmake -B build -S $pkgname-$pkgver -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_INSTALL_LIBEXECDIR=lib \
    -DBUILD_TESTING=OFF
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
