# FEX's Windows emulator DLLs for Kettle's ARM64EC Wine (packages/wine): x86-64 code in
# ARM64EC processes (libarm64ecfex.dll) and 32-bit x86 under WoW64 (libwow64fex.dll), plus
# their small Unix side (VMA naming, SHM stats). This is how Proton ARM64 runs x86 games, and
# it needs no x86 root file system. Installed as Wine builtins, so every prefix finds them.
#
# Config.json: FEX's global defaults (/usr/share/fex-emu), Proton ARM64's FEX_Config.json.
# Users override them in ~/.config/fex-emu/Config.json, or per game in
# ~/.config/fex-emu/AppConfig/<Game.exe>.json, or with FEX_* variables.
#
# The DLLs are built with llvm-mingw's aarch64 Linux build (build-packages.sh runs makepkg in
# the aarch64 chroot), with only the submodules the Windows build uses.
pkgname=fex-emu-wine
pkgver=2609.1
pkgrel=1
_llvm_mingw=20260908
pkgdesc='FEX x86 and x86-64 emulation for ARM64EC Wine'
arch=(aarch64)
url='https://fex-emu.com'
license=(MIT)
depends=(glibc gcc-libs)
makedepends=(git cmake ninja python)
options=(!strip !buildflags !lto)  # the DLLs are PE (stripped with llvm-mingw's strip below)
_llvm="llvm-mingw-$_llvm_mingw-ucrt-ubuntu-22.04-aarch64"
_submodules=(External/fmt External/range-v3 External/rpmalloc External/unordered_dense
             External/xxhash Source/Common/cpp-optparse External/Vulkan-Headers External/drm-headers)
source=("FEX::git+https://github.com/FEX-Emu/FEX.git#tag=FEX-$pkgver"
        "fmt::git+https://github.com/fmtlib/fmt.git#commit=c07e2aa4b130b4fd359a1c6455a5201b17af01fa"
        "range-v3::git+https://github.com/ericniebler/range-v3.git#commit=ca1388fb9da8e69314dda222dc7b139ca84e092f"
        "rpmalloc::git+https://github.com/FEX-Emu/rpmalloc.git#commit=09142d726429416bfa7b459151515fe3ab7622dd"
        "unordered_dense::git+https://github.com/martinus/unordered_dense.git#commit=3234af2c03549bc85656bfd3a86993bf1cd8aef1"
        "xxhash::git+https://github.com/Cyan4973/xxHash.git#commit=e626a72bc2321cd320e953a0ccf1584cad60f363"
        "cpp-optparse::git+https://github.com/Sonicadvance1/cpp-optparse#commit=9f94388a339fcbb0bc95c17768eb786c85988f6e"
        "Vulkan-Headers::git+https://github.com/KhronosGroup/Vulkan-Headers.git#commit=450bd2232225d6c7728a4108055ac2e37cef6475"
        "drm-headers::git+https://github.com/FEX-Emu/drm-headers.git#commit=3e49836995c1dcb3df709440ad2f270b569c6a5f"
        "https://github.com/mstorsjo/llvm-mingw/releases/download/$_llvm_mingw/$_llvm.tar.xz"
        Config.json)
sha256sums=('SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP'
            'c907dd2302a292b663add18752a55ce9d544ca0fd19cf33c086ca242d5994ea6'
            'SKIP')

prepare() {
  cd FEX
  git submodule init "${_submodules[@]}"
  local s
  for s in "${_submodules[@]}"; do
    git config "submodule.$s.url" "$srcdir/${s##*/}"
  done
  git -c protocol.file.allow=always submodule update "${_submodules[@]}"
}

build() {
  # the Unix side: host compiler, before llvm-mingw goes on PATH (it has its own ar etc.)
  cmake -S FEX/Source/Windows/UnixLib -B build_unixlib -G Ninja \
    -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr
  ninja -C build_unixlib

  export PATH="$srcdir/$_llvm/bin:$PATH"
  # TUNE_CPU=none: the default (native) would tune for whatever CPU qemu reports
  local common=(-G Ninja -DCMAKE_BUILD_TYPE=Release
    -DCMAKE_TOOLCHAIN_FILE=Data/CMake/toolchain_mingw.cmake -DCMAKE_INSTALL_PREFIX=/usr
    -DENABLE_LTO=False -DENABLE_ASSERTIONS=False -DENABLE_JEMALLOC_GLIBC_ALLOC=False
    -DBUILD_TESTING=False -DTUNE_ARCH=generic -DTUNE_CPU=none -DRANGES_NATIVE=OFF
    -DENABLE_CCACHE=False)
  (cd FEX && cmake -S . -B "$srcdir/build_ec" "${common[@]}" -DMINGW_TRIPLE=arm64ec-w64-mingw32)
  ninja -C build_ec arm64ecfex
  (cd FEX && cmake -S . -B "$srcdir/build_wow" "${common[@]}" -DMINGW_TRIPLE=aarch64-w64-mingw32)
  ninja -C build_wow wow64fex
  arm64ec-w64-mingw32-strip --strip-unneeded build_ec/Bin/libarm64ecfex.dll
  aarch64-w64-mingw32-strip --strip-unneeded build_wow/Bin/libwow64fex.dll
}

package() {
  install -Dm644 build_ec/Bin/libarm64ecfex.dll build_wow/Bin/libwow64fex.dll \
    -t "$pkgdir/usr/lib/wine/aarch64-windows"
  install -Dm755 build_unixlib/libarm64ecfex.so build_unixlib/libwow64fex.so \
    -t "$pkgdir/usr/lib/wine/aarch64-unix"
  strip --strip-unneeded "$pkgdir"/usr/lib/wine/aarch64-unix/*.so
  install -Dm644 Config.json -t "$pkgdir/usr/share/fex-emu"
  install -Dm644 FEX/LICENSE -t "$pkgdir/usr/share/licenses/$pkgname"
}
