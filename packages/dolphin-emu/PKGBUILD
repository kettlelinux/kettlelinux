# Dolphin: the GameCube and Wii emulator Kettle's emulation runs those games in (Game Mode's
# Emulation plugin adds them to the library as shortcuts through /usr/lib/kettle/emu-run, which
# starts `dolphin-emu -b -e <game>`). Named dolphin-emu, as upstream installs it: KDE's file manager
# is dolphin. Qt 6 frontend plus dolphin-emu-nogui and dolphin-tool; Vulkan (Turnip) and OpenGL.
# kettle-emulation seeds each user's Dolphin.ini, Hotkeys.ini and GCPadNew.ini (hotkeys, pad,
# folders); nothing here changes Dolphin's defaults.
#
# Off: the auto-updater, analytics, Discord, UPnP, LLVM disassembly, frame-dump encoding (FFmpeg)
# and the tests. Dolphin's own copies (Externals, git submodules) stand in for what the repos lack
# or have too old: SDL 3, SFML 3, mbedTLS, ENet, minizip-ng, libspng, cubeb, fmt, glslang, mGBA.
pkgname=dolphin-emu
pkgver=2609a
pkgrel=1
pkgdesc='GameCube and Wii emulator (Qt 6)'
arch=(aarch64)
url='https://dolphin-emu.org'
# Dolphin GPL 2 or later; its Externals as listed in Externals/licenses.md (MIT, BSD, zlib,
# Apache 2.0, LGPL 2.1 and MPL 2.0 among them)
license=(GPL-2.0-or-later MIT BSD-3-Clause Zlib Apache-2.0 LGPL-2.1-or-later MPL-2.0)
depends=(alsa-lib bluez-libs curl hidapi libevdev libglvnd libpulse libudev.so libusb libx11
         libxi libxrandr lz4 lzo pugixml qt6-base qt6-svg vulkan-icd-loader xxhash xz
         zlib zstd)
makedepends=(git cmake ninja python vulkan-headers)
options=(!lto)
source=("git+https://github.com/dolphin-emu/dolphin.git#tag=$pkgver")
sha256sums=('SKIP')

prepare() {
  cd dolphin
  # every Externals submodule a Linux build can use; not the Windows Qt and FFmpeg builds, WIL,
  # MoltenVK, Android's adrenotools or gtest
  local m
  m=$(git config -f .gitmodules --get-regexp '^submodule\..*\.path$' | awk '{print $2}' |
      grep -vxE 'Externals/(Qt|FFmpeg-bin|wil|libadrenotools|gtest|MoltenVK/.*)')
  git submodule update --init --recursive --depth 1 -- $m
}

build() {
  cmake -S dolphin -B build -G Ninja -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr \
    -DDISTRIBUTOR=kettlelinux.org \
    -DENABLE_AUTOUPDATE=OFF -DENABLE_ANALYTICS=OFF -DUSE_DISCORD_PRESENCE=OFF -DUSE_UPNP=OFF \
    -DENABLE_LLVM=OFF -DENCODE_FRAMEDUMPS=OFF -DENABLE_TESTS=OFF -DENABLE_NOGUI=ON \
    -DENABLE_LTO=OFF -DENABLE_CCACHE=OFF
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  local l="$pkgdir/usr/share/licenses/$pkgname"
  install -Dm644 dolphin/COPYING "$l/COPYING"
  install -Dm644 dolphin/Externals/licenses.md "$l/Externals-licenses.md"
}
