From bec52dc9f90f503801da4cab9c73e6f83a3e3b29 Mon Sep 17 00:00:00 2001
From: Kettle <kettle@localhost>
Date: Sat, 26 Sep 2026 14:29:11 -0500
Subject: [PATCH] chainloader: arm64 stage-2 loader path and PE machine type

On aarch64 the stage-2 GRUB is \EFI\steamos\grubaa64.efi (grubx64.efi on
x86_64), and valid_efi_binary() must accept PE images for the machine the
chainloader itself runs on (0xAA64), not x86_64 (0x8664): otherwise no
slot is found and steamcl stops with "Boot failed".
---
 chainloader/bootload.c | 6 +++++-
 chainloader/util.h     | 6 ++++++
 2 files changed, 11 insertions(+), 1 deletion(-)

diff --git a/chainloader/bootload.c b/chainloader/bootload.c
index 1e81b17..7304971 100644
--- a/chainloader/bootload.c
+++ b/chainloader/bootload.c
@@ -48,8 +48,12 @@
 // this converts micro-seconds to event timeout in 10ns
 #define EFI_TIMER_PERIOD_MICROSECONDS(s) (s * 10)
 
-// this is x86_64 specific
+// the PE machine type of the loaders we chain to: this chainloader's own
+#if defined(__aarch64__)
+#define EFI_STUB_ARCH 0xAA64
+#else
 #define EFI_STUB_ARCH 0x8664
+#endif
 
 static MENU_REASON display_menu = MENU_REASON_NONE;
 static BOOLEAN verbose_boot = FALSE;
diff --git a/chainloader/util.h b/chainloader/util.h
index 0e831f2..4f1c168 100644
--- a/chainloader/util.h
+++ b/chainloader/util.h
@@ -58,9 +58,15 @@
 #define NEWCONFPATH  L"\\SteamOS\\conf"
 #define EFIDIR       L"\\EFI"
 
+#if defined(__aarch64__)
+#define GRUBLDR     EFIDIR L"\\steamos\\grubaa64.efi"
+#define SYSTEMDLDR  EFIDIR L"\\SYSTEMD\\SYSTEMD-BOOTAA64.EFI"
+#define DEFAULTLDR  EFIDIR L"\\Boot\\bootaa64.efi"
+#else
 #define GRUBLDR     EFIDIR L"\\steamos\\grubx64.efi"
 #define SYSTEMDLDR  EFIDIR L"\\SYSTEMD\\SYSTEMD-BOOTX64.EFI"
 #define DEFAULTLDR  EFIDIR L"\\Boot\\bootx64.efi"
+#endif
 #define STEAMOSLDR  GRUBLDR
 #define CHAINLDR    EFIDIR L"\\Shell\\steamcl.efi"
 
-- 
2.55.0

