# OptiScaler (x86_64 Windows DLLs, run inside Proton games via FEX), repackaged for the
# Steam Portal Upscaling plugin, which copies it into a game's folder on request.
#
# Only the redistributable parts of the upstream release are shipped:
#   OptiScaler.dll/.ini   GPL-3.0 (source: $url/tree/v$pkgver, see SOURCE)
#   amd_fidelityfx_*.dll  AMD FidelityFX SDK licenses (binary redistribution with notice)
#   libxess*/libxell.dll  Intel Simplified Software License (unmodified, with notice)
#   fakenvapi.dll/.ini    MIT (license text isn't in the release; fetched from its tag)
# Left out: dlssg_to_fsr3_amd_is_better.dll (binary is "All rights reserved"),
# D3D12_Optiscaler/D3D12Core.dll (Microsoft Agility SDK, app-only redistribution; vkd3d-proton
# provides d3d12core), setup scripts. No NVIDIA binaries are in the release.
pkgname=optiscaler
pkgver=0.9.4
pkgrel=1
_build=0.9.4-final.20260718._MM
_fakenvapi=1.4.1
pkgdesc='Upscaler/frame generation replacement for DX11/DX12/Vulkan Windows games (Proton)'
arch=(any)
url='https://github.com/optiscaler/OptiScaler'
license=(GPL-3.0-only MIT LicenseRef-AMD-FidelityFX LicenseRef-Intel-XeSS)
makedepends=(7zip)
source=("$url/releases/download/v$pkgver/Optiscaler_$_build.7z"
        "fakenvapi-LICENSE-$_fakenvapi::https://raw.githubusercontent.com/optiscaler/fakenvapi/v$_fakenvapi/LICENSE")
noextract=("Optiscaler_$_build.7z")
sha256sums=('575cb4df866116093df75af607e37fd70e10f5163e0f23fd5c804142e80ef0ad'
            'd88550cb05d1606394928d0e4dad1a322e6e25f8258627c46f290c76bbf4ff93')

_files=(OptiScaler.dll OptiScaler.ini fakenvapi.dll fakenvapi.ini
        amd_fidelityfx_dx12.dll amd_fidelityfx_framegeneration_dx12.dll
        amd_fidelityfx_upscaler_dx12.dll amd_fidelityfx_vk.dll
        libxess.dll libxess_dx11.dll libxess_fg.dll libxell.dll)

prepare() {
  rm -rf dist; mkdir dist
  7z x -y -odist "Optiscaler_$_build.7z" >/dev/null
}

package() {
  local d="$pkgdir/usr/share/optiscaler"
  for f in "${_files[@]}"; do
    install -Dm644 "dist/$f" "$d/$f"
  done
  echo "$pkgver" >"$d/VERSION"
  printf 'OptiScaler %s is free software under the GPL-3.0.\nCorresponding source: %s/tree/v%s (tag v%s, commit 7534ad00bf9e590eedb99e8dd9fd8c89dae3654f)\n' \
    "$pkgver" "$url" "$pkgver" "$pkgver" >"$d/SOURCE"
  local l="$pkgdir/usr/share/licenses/$pkgname"
  install -Dm644 dist/Licenses/FidelityFX_v1_LICENSE.md dist/Licenses/FidelityFX_v2_LICENSE.md \
    dist/Licenses/XeSS_LICENSE.txt -t "$l"
  install -Dm644 "fakenvapi-LICENSE-$_fakenvapi" "$l/fakenvapi_LICENSE.txt"
}
