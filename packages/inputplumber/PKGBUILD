# InputPlumber: presents the AYN gamepad (rsinput, "AYN Odin2 Gamepad") to Steam as a Steam
# Deck controller in Game Mode: Deck button glyphs and layouts, Steam Input, and the button below
# the right stick as Quick Access. Upstream's Odin 2, Thor and Retroid Pocket 5 configs give them
# an Xbox Elite controller; 40-kettle-{odin2portal,thor,rp5}.yaml sort first and claim the pad
# for the Deck target (the Thor's with its AYN key as Quick Access too). The KONKR Pocket FIT
# Elite's 40-kettle-pocketfitelite.yaml joins its MCU's two input devices into one Deck pad.
# The Retroid Pocket Nova (the same rsinput MCU, Nintendo-labelled like the Thor) gets
# 40-kettle-rpnova.yaml with its own map, in place of upstream's 50-retroid_pocket_nova.yaml
# (not installed: see package()).
# Runs with Game Mode only (kettle-inputplumber.service, device overlay): the desktop's own
# controller (kettle-desktop-controller) needs the raw pad.
# 0001 reads evdev motion sensors; the Portal's and Thor's configs take kettle-motiond's (packages/kettle-motion)
# as the Deck controller's gyro and accelerometer, in SI units and the kernel's sensor frame, as the
# targets take them since 0.82.
# 0002 has the evdev sources sleep in poll(2) while idle instead of waking every 2.5 ms (about
# 1,200 wakeups a second for the Portal's and Thor's three sources, on any core, in every game).
#
# Built with upstream Rust (build time only): InputPlumber's crates need a newer compiler than
# the snapshot's 1.78.
pkgname=inputplumber
pkgver=0.82.0
pkgrel=6
_rust=1.98.1
_rustdate=2026-09-03
pkgdesc='Input router and remapper daemon (Steam Deck controller emulation for AYN handhelds)'
arch=(aarch64)
url='https://github.com/ShadowBlip/InputPlumber'
license=(GPL-3.0-or-later)
depends=(dbus libevdev libiio systemd-libs)
makedepends=(clang make pkgconf)
options=(!lto)  # upstream's release profile does its own (Rust) LTO
source=("InputPlumber-$pkgver.tar.gz::https://github.com/ShadowBlip/InputPlumber/archive/refs/tags/v$pkgver.tar.gz"
        "https://static.rust-lang.org/dist/$_rustdate/rust-$_rust-aarch64-unknown-linux-gnu.tar.xz"
        40-kettle-odin2portal.yaml
        40-kettle-thor.yaml
        40-kettle-rp5.yaml
        40-kettle-pocketfitelite.yaml
        40-kettle-rpnova.yaml
        kettle-thor-capability-map.yaml
        kettle-rp5-capability-map.yaml
        kettle-pocketfitelite-capability-map.yaml
        kettle-rpnova-capability-map.yaml
        0001-source-add-an-evdev-motion-sensor-source.patch
        0002-source-sleep-on-the-device-while-idle.patch)
noextract=("rust-$_rust-aarch64-unknown-linux-gnu.tar.xz")
sha256sums=('aaee9b65b47a21756169eb1c49eb258ecdd1896fb8dd4996c2b50d11af049d21'
            '0b514a8cc1cbcd939bff0f151661fe58b6ea5c7a7f645a5098c69e32e8c1e0a2'
            'e130eb2a293e1f7a9dc90e61a060aa7d36b63e58642d4cadc9b3b1cf881c984b'
            '64558755be19f505d3a072e3e5e4e62ce9a8ab0be19d9d8d4ee239dd0b6439bb'
            'c17970bf78ddab689d8b93acebd78fdf6fa03befde4377b04bd5f9b3e3b78e89'
            '5f5c9ff2e3350f2441e43014ec2727a14b22a94dc227b0c36dd55b9a8a4a994f'
            '6ddd0a0b852c03558a5b71c4ca5944bf0b46d7c80b6cb0d9645792354d6b52e1'
            '2cb3955e5d30d85589ddce8cd260851e60367b18e8b44c0b09e9250cf5518ee8'
            '769f8dfdb945985a3417ab2cbb988d43ef76bec81b6989251821a0200fbac69c'
            '7cad1e633b35a3d19b03d6ea9aa22845d807439844343c03e33f3958e0377560'
            'e90a24feb10a8dc271057dd21b2f792eaeb3098ed3a64943fd32632dce98dd62'
            'f818673f665b2e17ca3d5857929399d368b92cf54d428f7eebed1430c1dde398'
            '9d0fec0d3e1bb8974813de003b40bcec69e2f7a192f0b5f4afdbd67073a8f106')

prepare() {
  patch -d "InputPlumber-$pkgver" -Np1 -i ../0001-source-add-an-evdev-motion-sensor-source.patch
  patch -d "InputPlumber-$pkgver" -Np1 -i ../0002-source-sleep-on-the-device-while-idle.patch
  rm -rf rust-dist rust && mkdir rust-dist
  bsdtar -xf "rust-$_rust-aarch64-unknown-linux-gnu.tar.xz" -C rust-dist --strip-components 1
  rust-dist/install.sh --prefix="$srcdir/rust" --disable-ldconfig \
    --components=rustc,cargo,rust-std-aarch64-unknown-linux-gnu >/dev/null
}

build() {
  cd "InputPlumber-$pkgver"
  export PATH="$srcdir/rust/bin:$PATH" CARGO_HOME="$srcdir/cargo-home"
  cargo build --release --locked --target aarch64-unknown-linux-gnu
}

package() {
  cd "InputPlumber-$pkgver"
  export PATH="$srcdir/rust/bin:$PATH" CARGO_HOME="$srcdir/cargo-home"
  make install PREFIX="$pkgdir/usr" NO_RELOAD=true TARGET_ARCH=aarch64-unknown-linux-gnu
  install -Dm644 "$srcdir"/40-kettle-{odin2portal,thor,rp5,pocketfitelite,rpnova}.yaml -t "$pkgdir/usr/share/inputplumber/devices"
  # Upstream's Nova config takes gpio-keys (Volume Up) besides the pad: ours leaves Volume Up to
  # the kernel and takes the paddles' own gpio-keys-paddles instead, so upstream's would still
  # find a free device and make a second controller, which then races ours for the pad (seen on
  # a Nova). 40-kettle-rpnova.yaml replaces it.
  rm "$pkgdir/usr/share/inputplumber/devices/50-retroid_pocket_nova.yaml"
  install -Dm644 "$srcdir/kettle-thor-capability-map.yaml" \
    "$pkgdir/usr/share/inputplumber/capability_maps/kettle_thor.yaml"
  install -Dm644 "$srcdir/kettle-rp5-capability-map.yaml" \
    "$pkgdir/usr/share/inputplumber/capability_maps/kettle_rp5.yaml"
  install -Dm644 "$srcdir/kettle-pocketfitelite-capability-map.yaml" \
    "$pkgdir/usr/share/inputplumber/capability_maps/kettle_pocketfitelite.yaml"
  install -Dm644 "$srcdir/kettle-rpnova-capability-map.yaml" \
    "$pkgdir/usr/share/inputplumber/capability_maps/kettle_rpnova.yaml"
  install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname"
}
