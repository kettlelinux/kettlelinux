+/// Whether the device has INPUT_PROP_ACCELEROMETER, from sysfs: devices found at start-up
+/// don't carry udev's ID_INPUT_* properties yet
+fn is_accelerometer(device: &UdevDevice) -> bool {
+    const INPUT_PROP_ACCELEROMETER: u32 = 0x06;
+    let path = format!("/sys/class/input/{}/device/properties", device.sysname());
+    // a bitmap in hex words, the lowest bits last
+    std::fs::read_to_string(path)
+        .ok()
+        .and_then(|bits| bits.split_whitespace().last().map(str::to_owned))
+        .and_then(|word| u64::from_str_radix(&word, 16).ok())
+        .is_some_and(|word| word & (1 << INPUT_PROP_ACCELEROMETER) != 0)
+}
