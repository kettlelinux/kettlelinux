new file mode 100644
index 0000000..e81e41e
--- /dev/null
+++ b/src/input/source/evdev/imu.rs
@@ -0,0 +1,144 @@
+use std::os::fd::AsFd;
+use std::{error::Error, fmt::Debug};
+
+use evdev::{AbsoluteAxisCode, Device, EventSummary};
+use nix::fcntl::{FcntlArg, OFlag};
+
+use crate::{
+    input::{
+        capability::{Capability, Source},
+        event::{native::NativeEvent, value::InputValue},
+        source::{InputError, SourceInputDevice, SourceOutputDevice},
+    },
+    udev::device::UdevDevice,
+};
+
+// Steam Deck UHID LSB, as the kernel's hid-steam driver reads them back
+// (STEAM_DECK_ACCEL_RES_PER_G, STEAM_DECK_GYRO_RES_PER_DPS).
+const DECK_ACCEL_LSB_PER_G: f64 = 16384.0;
+const DECK_GYRO_LSB_PER_DPS: f64 = 16.0;
+
+/// Source device implementation for evdev motion sensors (INPUT_PROP_ACCELEROMETER):
+/// ABS_X/Y/Z accelerometer and ABS_RX/RY/RZ gyroscope in the kernel's motion
+/// sensor frame (X right, Y toward the top edge, Z out of the screen), each
+/// scaled by its axis resolution (units per g, units per degree/s).
+pub struct ImuEventDevice {
+    device: Device,
+    accel_res: [f64; 3],
+    gyro_res: [f64; 3],
+    accel: [i32; 3],
+    gyro: [i32; 3],
+}
+
+impl ImuEventDevice {
+    /// Create a new [ImuEventDevice] source device from the given udev info
+    pub fn new(device_info: UdevDevice) -> Result<Self, Box<dyn Error + Send + Sync>> {
+        let path = device_info.devnode();
+        log::debug!("Opening device at: {}", path);
+        let mut device = Device::open(path.clone())?;
+        device.grab()?;
+
+        let fd = device.as_fd();
+        nix::fcntl::fcntl(fd, FcntlArg::F_SETFL(OFlag::O_NONBLOCK))?;
+
+        let mut accel_res = [DECK_ACCEL_LSB_PER_G; 3];
+        let mut gyro_res = [DECK_GYRO_LSB_PER_DPS; 3];
+        for (axis, info) in device.get_absinfo()? {
+            let res = if info.resolution() > 0 {
+                info.resolution() as f64
+            } else {
+                continue;
+            };
+            match axis {
+                AbsoluteAxisCode::ABS_X => accel_res[0] = res,
+                AbsoluteAxisCode::ABS_Y => accel_res[1] = res,
+                AbsoluteAxisCode::ABS_Z => accel_res[2] = res,
+                AbsoluteAxisCode::ABS_RX => gyro_res[0] = res,
+                AbsoluteAxisCode::ABS_RY => gyro_res[1] = res,
+                AbsoluteAxisCode::ABS_RZ => gyro_res[2] = res,
+                _ => (),
+            }
+        }
+        log::info!("Reading motion sensors from {path}");
+
+        Ok(Self {
+            device,
+            accel_res,
+            gyro_res,
+            accel: [0; 3],
+            gyro: [0; 3],
+        })
+    }
+
+    /// The kernel frame in Steam Deck order: hid-steam reports Deck X as X,
+    /// Deck Z as Y and -(Deck Y) as Z, so Deck (X, Y, Z) = (X, -Z, Y).
+    fn deck_vector(values: &[i32; 3], res: &[f64; 3], lsb: f64) -> InputValue {
+        let v = |i: usize| values[i] as f64 / res[i] * lsb;
+        InputValue::Vector3 {
+            x: Some(v(0)),
+            y: Some(-v(2)),
+            z: Some(v(1)),
+        }
+    }
+}
+
+impl SourceInputDevice for ImuEventDevice {
+    /// Poll the given input device for input events
+    fn poll(&mut self) -> Result<Vec<NativeEvent>, InputError> {
+        let events = match self.device.fetch_events() {
+            Ok(events) => events.collect::<Vec<_>>(),
+            Err(err) => match err.kind() {
+                std::io::ErrorKind::WouldBlock => return Ok(vec![]),
+                _ => return Err(format!("Failed to fetch events: {:?}", err).into()),
+            },
+        };
+
+        // Only the latest state matters: the target reports it at its own rate
+        let mut accel_changed = false;
+        let mut gyro_changed = false;
+        for event in events {
+            if let EventSummary::AbsoluteAxis(_, axis, value) = event.destructure() {
+                match axis {
+                    AbsoluteAxisCode::ABS_X => (self.accel[0], accel_changed) = (value, true),
+                    AbsoluteAxisCode::ABS_Y => (self.accel[1], accel_changed) = (value, true),
+                    AbsoluteAxisCode::ABS_Z => (self.accel[2], accel_changed) = (value, true),
+                    AbsoluteAxisCode::ABS_RX => (self.gyro[0], gyro_changed) = (value, true),
+                    AbsoluteAxisCode::ABS_RY => (self.gyro[1], gyro_changed) = (value, true),
+                    AbsoluteAxisCode::ABS_RZ => (self.gyro[2], gyro_changed) = (value, true),
+                    _ => (),
+                }
+            }
+        }
+
+        let mut native_events = vec![];
+        if accel_changed {
+            native_events.push(NativeEvent::new(
+                Capability::Accelerometer(Source::Center),
+                Self::deck_vector(&self.accel, &self.accel_res, DECK_ACCEL_LSB_PER_G),
+            ));
+        }
+        if gyro_changed {
+            native_events.push(NativeEvent::new(
+                Capability::Gyroscope(Source::Center),
+                Self::deck_vector(&self.gyro, &self.gyro_res, DECK_GYRO_LSB_PER_DPS),
+            ));
+        }
+        Ok(native_events)
+    }
+
+    /// Returns the possible input events this device is capable of emitting
+    fn get_capabilities(&self) -> Result<Vec<Capability>, InputError> {
+        Ok(vec![
+            Capability::Accelerometer(Source::Center),
+            Capability::Gyroscope(Source::Center),
+        ])
+    }
+}
+
+impl SourceOutputDevice for ImuEventDevice {}
+
+impl Debug for ImuEventDevice {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.debug_struct("ImuEventDevice").finish()
+    }
+}
