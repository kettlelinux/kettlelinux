+                let wake = self.wake;
                 let mut implementation = self.implementation.lock().unwrap();
+                // Devices with a file descriptor to wait on sleep while idle
+                let wait_fd = wake.as_ref().and(implementation.wait_fd());
                 let mut event_filter = implementation
