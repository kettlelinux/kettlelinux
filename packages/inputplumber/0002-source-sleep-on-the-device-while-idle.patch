+
+                    // With nothing due later, sleep until there is input or a command
+                    if let (Some(fd), Some(wake)) = (wait_fd, wake.as_ref()) {
+                        if !implementation.has_pending() {
+                            SourceDriver::<T>::wait_for_input(fd, wake);
+                        }
+                    }
                 }
 
                 Ok(())
