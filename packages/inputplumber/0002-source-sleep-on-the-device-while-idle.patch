-        self.tx.clone().into()
+        match self.wake.as_ref() {
+            Some(wake) => SourceDeviceClient::with_wake(self.tx.clone(), wake.clone()),
+            None => self.tx.clone().into(),
+        }
+    }
+
+    /// Sleep until the device has input, a client sent a command, or
+    /// [WAIT_TIMEOUT_MS] passed.
+    fn wait_for_input(fd: RawFd, wake: &EventFd) {
+        // SAFETY: the fd belongs to the device implementation, which stays
+        // locked and alive for as long as the source device thread runs.
+        let fd = unsafe { BorrowedFd::borrow_raw(fd) };
+        let mut fds = [
+            PollFd::new(fd, PollFlags::POLLIN),
+            PollFd::new(wake.as_fd(), PollFlags::POLLIN),
+        ];
+        if let Err(e) = nix::poll::poll(&mut fds, PollTimeout::from(WAIT_TIMEOUT_MS)) {
+            log::trace!("poll: {e}");
+        }
+        let woken = fds[1]
+            .revents()
+            .is_some_and(|r| r.contains(PollFlags::POLLIN));
+        if woken {
+            // Reset the counter: the commands are read right after this
+            let _ = wake.read();
+        }
     }
 
     /// Returns udev device information about the device as a reference
@@ -376,7 +431,10 @@ impl<T: SourceInputDevice + SourceOutputDevice + Send + 'static> SourceDriver<T>
         let task =
