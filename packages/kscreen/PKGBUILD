# Display Settings KCM + kscreen daemon, built for the base's Plasma 6.6.2 stack
# (kscreen is the one piece of Plasma missing from every deckard snapshot).
pkgname=kscreen
pkgver=6.6.2
pkgrel=1
pkgdesc='KDE screen management software (Display Settings)'
arch=(aarch64)
url='https://kde.org/plasma-desktop/'
license=(GPL-2.0-or-later LGPL-2.0-or-later)
depends=(gcc-libs glibc kcmutils kconfig kcoreaddons kdbusaddons kdeclarative kglobalaccel
         ki18n kirigami ksvg kwindowsystem kxmlgui layer-shell-qt libkscreen libplasma
         qt6-base qt6-declarative qt6-sensors wayland)
makedepends=(cmake ninja extra-cmake-modules qt6-tools plasma-wayland-protocols wayland-protocols)
source=(https://download.kde.org/stable/plasma/$pkgver/$pkgname-$pkgver.tar.xz)
sha256sums=('0152de1358f64475525e6c0e854fa8b6ecf9e7c5e9a3094610156a52482c2c43')

build() {
  cmake -B build -S $pkgname-$pkgver -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_INSTALL_LIBEXECDIR=lib \
    -DBUILD_TESTING=OFF \
    -DWITH_X11=OFF
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
