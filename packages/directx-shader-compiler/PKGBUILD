# Microsoft's DirectX Shader Compiler (HLSL -> DXIL), built from source for the aarch64 build
# chroot. Build-time only: optiscaler-arm64ec compiles FidelityFX FSR2 2.2.1's and Arm ASR's
# HLSL to DXIL with it. Not part of the image.
#
# Built here because Valve's deckard snapshot has no dxc, and Arch Linux ARM's needs a newer
# glibc than the chroot (and Arch's 1.10.2605 aborts on every input). Only the dxc target and
# the DXIL backend: SPIR-V codegen, which DXC forces on for Linux, is switched off, so the
# SPIRV-Tools/Headers submodules aren't needed. Under qemu this takes about an hour.
pkgname=directx-shader-compiler
pkgver=1.9.2607
pkgrel=2
_commit=0d3ee6b551b8fa768fbf825300ebab81047ef6a8   # v1.9.2607
pkgdesc='DirectX Shader Compiler (dxc), DXIL backend only; build dependency of optiscaler-arm64ec'
arch=(aarch64)
url='https://github.com/microsoft/DirectXShaderCompiler'
license=(LicenseRef-NCSA Apache-2.0)
depends=(gcc-libs glibc)
makedepends=(git cmake ninja python)
# Plain CMake Release flags: built with makepkg's (LTO, -D_FORTIFY_SOURCE=3, ...) this dxc
# segfaults on every shader, like Arch's own package; with CMake's defaults it works (and
# matches the x86-64 build's output).
options=(!buildflags !lto !debug)
source=("DirectXShaderCompiler::git+$url.git#commit=$_commit"
        "DirectX-Headers::git+https://github.com/microsoft/DirectX-Headers.git#commit=980971e835876dc0cde415e8f9bc646e64667bf7")
sha256sums=('SKIP' 'SKIP')

prepare() {
  cd DirectXShaderCompiler
  git submodule init external/DirectX-Headers
  git config submodule.external/DirectX-Headers.url "$srcdir/DirectX-Headers"
  git -c protocol.file.allow=always submodule update external/DirectX-Headers
  sed -i '/^# Enable SPIR-V CodeGen for Linux by default./,/^endif()/d' CMakeLists.txt
}

build() {
  # Not the repo's PredefinedParams.cmake: it overrides these and turns SPIR-V back on
  cmake -S DirectXShaderCompiler -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DLLVM_APPEND_VC_REV=OFF \
    -DLLVM_DEFAULT_TARGET_TRIPLE=dxil-ms-dx \
    -DLLVM_ENABLE_EH=ON -DLLVM_ENABLE_RTTI=ON \
    -DLLVM_INCLUDE_DOCS=OFF -DLLVM_INCLUDE_EXAMPLES=OFF -DLLVM_OPTIMIZED_TABLEGEN=OFF \
    -DLLVM_TARGETS_TO_BUILD=None -DLIBCLANG_BUILD_STATIC=ON \
    -DCLANG_BUILD_EXAMPLES=OFF -DCLANG_CL=OFF -DCLANG_ENABLE_ARCMT=OFF \
    -DCLANG_ENABLE_STATIC_ANALYZER=OFF -DLLVM_ENABLE_TERMINFO=OFF \
    -DHLSL_INCLUDE_TESTS=OFF -DENABLE_SPIRV_CODEGEN=OFF -DSPIRV_BUILD_TESTS=OFF \
    -DLLVM_INCLUDE_TESTS=OFF -DCLANG_INCLUDE_TESTS=OFF -DLLVM_BUILD_TESTS=OFF \
    -DLLVM_ENABLE_ASSERTIONS=OFF
  cmake --build build --target dxc
}

package() {
  install -Dm755 build/bin/dxc -t "$pkgdir/usr/bin"
  install -Dm755 build/lib/libdxcompiler.so* -t "$pkgdir/usr/lib"
  install -Dm644 DirectXShaderCompiler/LICENSE.TXT -t "$pkgdir/usr/share/licenses/$pkgname"
}
