warnings.filterwarnings("ignore", category=DeprecationWarning)

ROOT = os.environ.get("KETTLE_POWER_SYSROOT", "")  # fake sysfs prefix for testing
CONFIG_DIR = "/usr/share/kettle-power"
STATE = os.environ.get("KETTLE_POWER_STATE", "/var/lib/kettle-power/state.json")
BUS = Gio.BusType.SESSION if os.environ.get("KETTLE_POWER_BUS") == "session" else Gio.BusType.SYSTEM
BUS_NAME = "org.kettlelinux.Power1"
OBJ_PATH = "/org/kettlelinux/Power1"
SOM = "com.steampowered.SteamOSManager1."
TICK_MS = 1000
EMA = 0.4  # weight of each new power sample
TDP_DWELL = 2  # ticks to wait after changing a cap before judging its effect
CPU_STEPS = 16  # CPU budget ladder: 100% down to 30% of each cluster's top frequency
FAN_HYST = 3  # C: the fan slows down only once the temperature is this far below a point
CHARGE_RESUME = 5  # %: a held charge limit lets charging resume this far below the limit
CHARGE_TICKS = 5  # ticks between charge current checks (each read is a firmware round trip)
CUSTOM = "Custom"  # charge speed set as a current (charge_custom_ua)
CUSTOM_MIN_UA = 500_000
CUSTOM_STEP_UA = 500_000
FPS_FILES = "/run/user"  # <uid>/kettle-fps, written by mangoapp about once a second
FPS_STALE = 3  # s: an older frame rate means no game is drawing (paused, loading, gone)
AUTO_RESET = 10  # s without frames: Auto TDP starts again from no cap
AUTO_DWELL = 2  # ticks after an Auto TDP change before judging it
AUTO_SETTLE = 5  # ticks holding the target before trying a lower cap
AUTO_BACKOFF = 60  # ticks a unit stays off the step that made the game fall short, doubled
AUTO_BACKOFF_MAX = 4  # each time that step fails again, up to this many times as long
AUTO_UNDER = 0.95  # below this share of the target (over two seconds) the game falls short
AUTO_GPU_BUSY = 0.9  # a capped GPU this busy is at its limit
AUTO_STUCK = 3  # ticks falling short with neither unit at its limit before raising anyway


def log(msg):
    print(msg, file=sys.stderr, flush=True)


def config_path():
    """The device's description: KETTLE_POWER_CONFIG, else the file named after the device tree's
    first compatible that has one ("ayn,thor" -> thor.toml)."""
    if os.environ.get("KETTLE_POWER_CONFIG"):
        return os.environ["KETTLE_POWER_CONFIG"]
    try:
        with open(ROOT + "/proc/device-tree/compatible", "rb") as f:
            compatible = f.read().decode(errors="replace").split("\0")
    except OSError:
        compatible = []
    for c in compatible:
        path = f"{CONFIG_DIR}/{c.split(',')[-1]}.toml"
        if c and os.path.exists(path):
            return path
    sys.exit(f"kettle-powerd: no description for this device ({', '.join(filter(None, compatible))}) in {CONFIG_DIR}")


def load_config():
    path = config_path()
    log(f"device: {path}")
    with open(path, "rb") as f:
        return tomllib.load(f)


def read(path, default=None):
    try:
        with open(ROOT + path) as f:
            return f.read().strip()
    except OSError:
        return default


def read_int(path, default=None):
    try:
        return int(read(path))
    except (TypeError, ValueError):
        return default


def write(path, value):
    try:
        with open(ROOT + path, "w") as f:
            f.write(str(value))
        return True
    except OSError as e:
        log(f"write {path} = {value}: {e}")
        return False


def listdir(path):
    try:
        return sorted(os.listdir(ROOT + path))
    except OSError:
        return []


def find_class(cls, attr, value):
    """/sys/class/<cls>/<dev> whose <attr> file reads <value>."""
    for d in listdir(f"/sys/class/{cls}"):
        if read(f"/sys/class/{cls}/{d}/{attr}") == value:
            return f"/sys/class/{cls}/{d}"
    return None


def read_fps():
    """The newest kettle-fps (mangoapp): {fps, refresh, steam_focused, age}, or None."""
    best = None
    for uid in listdir(FPS_FILES):
        path = f"{FPS_FILES}/{uid}/kettle-fps"
        try:
            mtime = os.stat(ROOT + path).st_mtime
        except OSError:
            continue
        if best is None or mtime > best[1]:
            best = (path, mtime)
    if not best:
        return None
    kv = dict(line.split("=", 1) for line in (read(best[0], "") or "").splitlines() if "=" in line)
    try:
        return {"fps": float(kv["fps"]), "refresh": int(kv.get("refresh") or 0),
                "steam_focused": kv.get("steam_focused") == "1",
                "age": time.time() - best[1]}
    except (KeyError, ValueError):
        return None


class Hardware:
    def __init__(self, cfg):
        self.cfg = cfg
        # a parked cluster's policy can't be read: start from every CPU online
        for c in cfg["cpu"]["clusters"]:
            for cpu_id in c["cpus"]:
                if cpu_id != 0 and read_int(f"/sys/devices/system/cpu/cpu{cpu_id}/online") == 0:
                    write(f"/sys/devices/system/cpu/cpu{cpu_id}/online", 1)
        self.clusters = []
        for c in cfg["cpu"]["clusters"]:
            p = f"/sys/devices/system/cpu/cpufreq/policy{c['policy']}"
            freqs = {int(f) for f in (read(f"{p}/scaling_available_frequencies", "") + " "
                                      + read(f"{p}/scaling_boost_frequencies", "")).split()}
            self.clusters.append({**c, "path": p, "freqs": sorted(freqs),
                                  "base_max": max(int(f) for f in read(f"{p}/scaling_available_frequencies", "0").split())})
        g = cfg["gpu"]["devfreq"]
        self.gpu = g
        self.gpu_freqs = sorted(int(f) for f in read(f"{g}/available_frequencies", "").split())
        # auto (and the TDP limit's steps) stay at or below auto_max_mhz; the clocks above it
        # (overclock OPPs) are only for a manual GPU clock
        auto_max = cfg["gpu"].get("auto_max_mhz")
        self.gpu_auto_freqs = [f for f in self.gpu_freqs
                               if not auto_max or f <= auto_max * 1_000_000] or self.gpu_freqs
        self.gpu_load_path = cfg["gpu"].get("load")
        self.hwmon = find_class("hwmon", "name", cfg["fan"]["hwmon"])
        self.fan_cdev = find_class("thermal", "type", cfg["fan"]["cooling_device"])
        self.fan_zones = self._fan_zones()
        # custom fan settings need the user_space governor to keep step_wise off the fan
        self.fan_custom_ok = bool(self.hwmon and self.fan_zones) and all(
            "user_space" in (read(f"{z}/available_policies", "") or "").split() for z in self.fan_zones)
        # the fan's PWM kept through s2idle while a charger is plugged in (0: stopped, as always)
        p = f"{self.hwmon}/pwm1_sleep_charging" if self.hwmon else None
        self.sleep_fan = p if p and os.path.exists(ROOT + p) else None
        self.battery = f"/sys/class/power_supply/{cfg['power']['battery']}"
        self.charger = f"/sys/class/power_supply/{cfg['power']['charger']}"
        # the charge current the charger may use, uA (kernel patches 40-kettle/1190 on the
        # battery, 21-sm8250/0115 on the charger), and the charger's charge_behaviour
        self.charge_current = self._supply_attr("constant_charge_current")
        self.charge_behaviour = self._supply_attr("charge_behaviour")
        self._stat = None

    def _supply_attr(self, name):
        """The battery's or else the charger's power supply file of that name, if it has one."""
        for psy in (self.battery, self.charger):
            if read(f"{psy}/{name}") is not None:
                return f"{psy}/{name}"
        return None

    def _fan_zones(self):
        """Thermal zones that drive the fan (a cdevN link to the pwm-fan cooling device)."""
        if not self.fan_cdev:
            return []
        cdev = os.path.basename(self.fan_cdev)
        zones = []
        for z in listdir("/sys/class/thermal"):
            if not z.startswith("thermal_zone"):
                continue
            base = f"/sys/class/thermal/{z}"
            for e in listdir(base):
                if e.startswith("cdev") and e[4:].isdigit():
                    if os.path.basename(os.path.realpath(ROOT + f"{base}/{e}")) == cdev:
                        zones.append(base)
                        break
        return zones

    # --- readings ---

    def fan_temp(self):
        """Hottest fan zone, in C."""
        t = [read_int(f"{z}/temp") for z in self.fan_zones]
        t = [v for v in t if v is not None]
        return max(t) / 1000 if t else None

    def power_w(self):
        """Whole-device draw in watts: from the battery, or on the charger its input power
        less what goes into the battery."""
        b, c = self.battery, self.charger
        v, i = read_int(f"{b}/voltage_now"), read_int(f"{b}/current_now")
        if v is None or i is None:
            return None
        bat = v * abs(i) / 1e12
        status = read(f"{b}/status", "")
        if status == "Discharging" or read(f"{c}/online") != "1":
            return bat
        vin, iin = read_int(f"{c}/voltage_now"), read_int(f"{c}/current_now")
        if vin is None or iin is None:
            return None
        into_battery = bat if status == "Charging" else 0
        return max(0.0, vin * abs(iin) / 1e12 * self.cfg["power"]["charger_efficiency"] - into_battery)

    def cpu_busy(self):
        """Busiest online CPU since the last call, 0..1 (a game's main thread is what counts)."""
        now = {}
        for line in (read("/proc/stat", "") or "").splitlines():
            parts = line.split()
            if parts and parts[0].startswith("cpu") and parts[0] != "cpu":
                vals = [int(x) for x in parts[1:]]
                now[parts[0]] = (sum(vals), vals[3] + vals[4])  # total, idle + iowait
        prev, self._stat = self._stat, now
        if not prev:
            return 0.0
        busy = 0.0
        for k, (tot, idle) in now.items():
            if k in prev and tot > prev[k][0]:
                busy = max(busy, 1 - (idle - prev[k][1]) / (tot - prev[k][0]))
        return busy

    def gpu_busy(self):
        v = read_int(self.gpu_load_path) if self.gpu_load_path else None
        return None if v is None else v / 100


def floor_freq(freqs, cap):
    """Highest frequency in freqs at or below cap (the lowest one if none is)."""
    below = [f for f in freqs if f <= cap]
    return below[-1] if below else freqs[0]


def curve_pct(curve, temp):
    """Fan percent at temp, linear between curve points."""
    if temp <= curve[0][0]:
        return curve[0][1]
    for (t0, p0), (t1, p1) in zip(curve, curve[1:]):
        if temp <= t1:
            return p0 + (p1 - p0) * (temp - t0) / (t1 - t0)
    return curve[-1][1]


class Daemon:
    def __init__(self):
        self.cfg = load_config()
        self.hw = Hardware(self.cfg)
        pw = self.cfg["power"]
        self.profiles = {p["name"]: p for p in self.cfg.get("profile", [])}
        self.state = {
            "steam": {"tdp": pw["tdp_max"], "profile": next(iter(self.profiles), ""),
                      "gpu_level": "auto", "gpu_clock": self.hw.gpu_auto_freqs[-1] // 1_000_000,
                      "fan_control": 1, "charge_limit": -1},
            "games": {"default": self.normalize({})},
            "charge_speed": "",
            "charge_custom_ua": 0,
            "sleep_fan": 0,  # fan percent while charging asleep, 0: off
        }
        self.load()
        # charge_limit: true, the charger's end threshold; "current" or "inhibit", held here
        # through a charge current of 0 or the charger's charge_behaviour; false, none
        self.charge_mode = pw.get("charge_limit", True)
        need = {"current": self.hw.charge_current, "inhibit": self.hw.charge_behaviour}
        if self.charge_mode in need and not need[self.charge_mode]:
            log(f"charge_limit = {self.charge_mode!r} but the kernel has no control for it: no charge limit")
            self.charge_mode = False
        self.charge_ok = bool(self.charge_mode)
        self.speeds = {sp["name"]: sp["ua"] for sp in pw.get("charge_speed", [])} if self.hw.charge_current else {}
        # Custom: any current from CUSTOM_MIN_UA up to the firmware's own (charge_current)
        self.custom_max = pw.get("charge_current") if self.speeds else None
        if self.state["charge_speed"] not in self.speeds and not (self.custom_max and self.state["charge_speed"] == CUSTOM):
            self.state["charge_speed"] = next(iter(self.speeds), "")
        if self.custom_max:
            self.state["charge_custom_ua"] = self.clamp_custom(self.state["charge_custom_ua"] or self.custom_max // 2)
        self.charge_held = False  # at the charge limit, charging stopped
        self.charge_wait = 0
        self.active = ""  # running game's appid, from Device Settings
        self.written = {}  # path -> value last written, so only changes are written
        self.fan_saved_cdev = None  # device tree fan level when the daemon took the fan over
        self.fan_pct = None
        self.power = None
        self.tdp_cpu = 0  # steps down the CPU budget ladder (0: no cap)
        self.tdp_gpu = 0  # steps down the GPU frequency table
        self.tdp_wait = 0
        self.cpu_load = 0.0  # busiest CPU over the last tick
        self.fps_limit = 0  # Steam's frame rate limit (from Device Settings), 0: none
        self.ticks = 0
        self.auto_reset()
        self.cpu_ladder = self._cpu_ladder()
        self.conn = None

    # --- settings ---

    def normalize(self, g):
        """A game's (or the default) plugin settings with every field present and valid."""
        fan = g.get("fan") or {}
        cpu = g.get("cpu") or {}
        curve = fan.get("curve") or self.cfg["fan"]["default_curve"]
        points = {}
        for t, p in curve:  # one point per temperature, the later one wins
            points[max(0, min(110, int(t)))] = max(0, min(100, int(p)))
        curve = sorted([t, p] for t, p in points.items())
        mode = fan.get("mode") if fan.get("mode") in ("auto", "curve", "fixed") else "auto"
        out = {"fan": {"mode": mode, "curve": curve,
                       "fixed": max(0, min(100, int(fan.get("fixed", 50))))},
               "cpu": {"mid_cores": max(1, min(4, int(cpu.get("mid_cores", 4)))),
                       "prime_core": bool(cpu.get("prime_core", True))},
               "auto_tdp": bool(g.get("auto_tdp", False))}
        for c in self.cfg["cpu"]["clusters"]:
            v = cpu.get(c["name"])
            out["cpu"][c["name"]] = int(v) if v else None
        return out

    def load(self):
        try:
            with open(STATE) as f:
                saved = json.load(f)
        except (OSError, ValueError):
            return
        self.state["steam"].update({k: v for k, v in saved.get("steam", {}).items() if k in self.state["steam"]})
        self.state["charge_speed"] = saved.get("charge_speed", "")
        self.state["charge_custom_ua"] = saved.get("charge_custom_ua", 0)
        self.state["sleep_fan"] = clamp_pct(saved.get("sleep_fan", 0))
        for k, v in saved.get("games", {}).items():
            self.state["games"][k] = self.normalize(v)
        if self.state["steam"]["profile"] not in self.profiles:
            self.state["steam"]["profile"] = next(iter(self.profiles), "")

    def save(self):
        try:
            os.makedirs(os.path.dirname(STATE), exist_ok=True)
            tmp = STATE + ".tmp"
            with open(tmp, "w") as f:
                json.dump(self.state, f, indent=1)
            os.replace(tmp, STATE)
        except OSError as e:
            log(f"saving {STATE}: {e}")

    def game(self):
        g = self.state["games"]
        return g.get(self.active) or g["default"]

    # --- caps ---

    def _cpu_ladder(self):
        """CPU budget steps: each cluster capped to the same share of its top frequency."""
        ladder = []
        for k in range(CPU_STEPS):
            share = 1 - k * 0.7 / (CPU_STEPS - 1)
            ladder.append({c["name"]: floor_freq(c["freqs"], c["base_max"] * share) for c in self.hw.clusters})
        return ladder

    def targets(self):
        """Frequency caps from every source, the lowest winning: {cluster: kHz}, GPU (min, max) Hz."""
        steam = self.state["steam"]
        prof = self.profiles.get(steam["profile"], {})
        game = self.game()["cpu"]
        cpu = {}
        step_cpu = max(self.tdp_cpu, self.auto_cpu)  # the TDP limit's and Auto TDP's, the lower cap
        step_gpu = max(self.tdp_gpu, self.auto_gpu)
        for c in self.hw.clusters:
            cap = max(c["freqs"])
            for src in (prof.get(c["name"]), game.get(c["name"]),
                        self.cpu_ladder[step_cpu][c["name"]] if step_cpu else None):
                if src:
                    cap = min(cap, src)
            cpu[c["name"]] = floor_freq(c["freqs"], cap)
        gf = self.gpu_steps()
        gmax = gf[-1]
        if prof.get("gpu_mhz"):
            gmax = min(gmax, prof["gpu_mhz"] * 1_000_000)
        if step_gpu:
            gmax = min(gmax, gf[max(0, len(gf) - 1 - step_gpu)])
        gmin = gf[0]
        if steam["gpu_level"] == "manual":
            clock = steam["gpu_clock"] * 1_000_000
            gmax = min(gmax, clock)
            gmin = gmax
        gmax = floor_freq(gf, gmax)
        return cpu, (floor_freq(gf, gmin), gmax)

    def gpu_steps(self):
        """GPU frequencies auto and the TDP limit step through: all of them for a manual clock."""
        return self.hw.gpu_freqs if self.state["steam"]["gpu_level"] == "manual" else self.hw.gpu_auto_freqs

    def put(self, path, value):
        if self.written.get(path) != value and write(path, value):
            self.written[path] = value

    def apply_cores(self):
        cpu = self.game()["cpu"]
        want = {}
        for c in self.hw.clusters:
            n = len(c["cpus"])
            if c["name"] == "mid":
                n = cpu["mid_cores"]
            elif c["name"] == "prime" and not cpu["prime_core"]:
                n = 0
            for idx, cpu_id in enumerate(c["cpus"]):
                if cpu_id != 0:
                    want[cpu_id] = 1 if idx < n else 0
        onlined = False
        for cpu_id, on in want.items():
            path = f"/sys/devices/system/cpu/cpu{cpu_id}/online"
            if read_int(path) != on and write(path, on):
                onlined |= bool(on)
        if onlined:  # a policy coming back takes its caps anew
            self.written = {k: v for k, v in self.written.items() if "cpufreq" not in k}

    def apply_caps(self):
        cpu, (gmin, gmax) = self.targets()
        for c in self.hw.clusters:
            # a parked cluster's policy takes no writes; it gets its cap when it comes back
            if any(cpu_id == 0 or read_int(f"/sys/devices/system/cpu/cpu{cpu_id}/online") != 0 for cpu_id in c["cpus"]):
                self.put(f"{c['path']}/scaling_max_freq", cpu[c["name"]])
        g = self.hw.gpu
        # widen first so min <= max holds at every step
        if gmin > read_int(f"{g}/max_freq", 0):
            self.put(f"{g}/max_freq", gmax)
            self.put(f"{g}/min_freq", gmin)
        else:
            self.put(f"{g}/min_freq", gmin)
            self.put(f"{g}/max_freq", gmax)

    def apply(self):
        self.apply_cores()
        self.apply_caps()

    # --- fan ---

    def fan_setting(self):
        if self.state["steam"]["fan_control"] == 0 or not self.hw.fan_custom_ok:
            return {"mode": "auto"}
        return self.game()["fan"]

    def set_zone_policy(self, policy):
        for z in self.hw.fan_zones:
            if read(f"{z}/policy") != policy:
                write(f"{z}/policy", policy)

    def fan_takeover(self):
        if self.fan_saved_cdev is None:
            self.fan_saved_cdev = read_int(f"{self.hw.fan_cdev}/cur_state", 0)
            self.set_zone_policy("user_space")

    def fan_release(self):
        """Give the fan back to step_wise at the level it had (or the level for this temperature)."""
        if self.fan_saved_cdev is None and all(read(f"{z}/policy") == "step_wise" for z in self.hw.fan_zones):
            return
        level = self.fan_saved_cdev
        if level is None:
            level = kernel_fan_level(self.hw.fan_temp(), read_int(f"{self.hw.fan_cdev}/max_state", 7))
        self.set_zone_policy("step_wise")
        write(f"{self.hw.fan_cdev}/cur_state", level)
        self.fan_saved_cdev = None
        self.fan_pct = None

    def apply_sleep_fan(self):
        if self.hw.sleep_fan:
            write(self.hw.sleep_fan, round(self.state["sleep_fan"] * 255 / 100))

    def fan_tick(self):
        fan = self.fan_setting()
        if fan["mode"] == "auto":
            self.fan_release()
            return
        temp = self.hw.fan_temp()
        if temp is None:
            return
        self.fan_takeover()
        if temp >= self.cfg["fan"]["full_speed_temp"]:
            pct = 100
        elif fan["mode"] == "fixed":
            pct = fan["fixed"]
        else:
            pct = curve_pct(fan["curve"], temp)
            if self.fan_pct is not None and pct < self.fan_pct:
                # slow down only once clearly below: no hunting around a curve point
                pct = max(pct, min(self.fan_pct, curve_pct(fan["curve"], temp + FAN_HYST)))
        self.fan_pct = pct
        pwm = round(pct * 255 / 100)
        if read_int(f"{self.hw.hwmon}/pwm1_enable") != 1:
            write(f"{self.hw.hwmon}/pwm1_enable", 1)
        if read_int(f"{self.hw.hwmon}/pwm1") != pwm:
            write(f"{self.hw.hwmon}/pwm1", pwm)

    # --- power budget ---

    def tdp_tick(self):
        p = self.hw.power_w()
        cpu_busy = self.cpu_load = self.hw.cpu_busy()
        if p is not None:
            self.power = p if self.power is None else self.power + EMA * (p - self.power)
        limit = self.state["steam"]["tdp"]
        if limit >= self.cfg["power"]["tdp_max"] or self.power is None:
            changed = self.tdp_cpu or self.tdp_gpu
            self.tdp_cpu = self.tdp_gpu = 0
            return bool(changed)
        if self.tdp_wait:
            self.tdp_wait -= 1
            return False
        gpu_busy = self.hw.gpu_busy()
        if gpu_busy is None:
            gpu_busy = 1.0
        cpu_room = len(self.cpu_ladder) - 1 - self.tdp_cpu
        gpu_room = len(self.gpu_steps()) - 1 - self.tdp_gpu
        err = self.power - limit
        steps = 2 if abs(err) > 3 else 1
        before = (self.tdp_cpu, self.tdp_gpu)
        if err > 0.3:
            # over budget: slow down the busier unit, it's the one drawing the power
            for _ in range(steps):
                gpu_first = gpu_busy >= cpu_busy
                if (gpu_first or not cpu_room) and gpu_room:
                    self.tdp_gpu += 1
                    gpu_room -= 1
                elif cpu_room:
                    self.tdp_cpu += 1
                    cpu_room -= 1
        elif err < -0.8:
            # headroom: give it back to the busier unit first
            for _ in range(steps):
                gpu_first = gpu_busy >= cpu_busy
                if (gpu_first or not self.tdp_cpu) and self.tdp_gpu:
                    self.tdp_gpu -= 1
                elif self.tdp_cpu:
                    self.tdp_cpu -= 1
        if (self.tdp_cpu, self.tdp_gpu) != before:
            self.tdp_wait = TDP_DWELL
            return True
        return False

    # --- Auto TDP ---

    def auto_reset(self):
        self.auto_cpu = 0  # Auto TDP's steps down the CPU ladder and the GPU table, as tdp_cpu/gpu
        self.auto_gpu = 0
        self.auto_wait = 0
        self.auto_steady = 0  # ticks the game has held its target at these caps
        self.auto_idle = 0  # ticks without a frame rate to judge
        self.auto_short = 0  # ticks in a row falling short
        self.auto_prev = None  # the frame rate a tick before
        self.auto_last = None  # the unit lowered last, blamed if the game falls short next
        self.auto_block = {}  # unit -> (step it fell short at, tick it may be tried again)
        self.auto_fails = {}  # (unit, step) -> times the game fell short there
        self.auto_peak = {"cpu": 0.0, "gpu": 0}  # highest CPU share / GPU clock while holding
        self.auto_fps = None  # the frame rate and target judged last (Device Settings' Diagnostics readout)
        self.auto_target = None

    def auto_on(self):
        return bool(self.active) and self.game()["auto_tdp"]

    def auto_tick(self):
        """Auto TDP: lower a cap while the game holds its target frame rate, raise one as soon as
        it falls short. Returns whether the caps changed."""
        if not self.auto_on():
            changed = bool(self.auto_cpu or self.auto_gpu)
            if changed or self.auto_target:
                self.auto_reset()
            return changed
        f = read_fps()
        if f is None or f["age"] > FPS_STALE or f["steam_focused"]:
            # nothing to judge (Steam's UI in front, the game paused or loading): hold the caps,
            # and after a while lift them, to search again from the top once the game is back
            self.auto_fps = None
            self.auto_idle += 1
            if self.auto_idle >= AUTO_RESET and (self.auto_cpu or self.auto_gpu):
                self.auto_reset()
                return True
            return False
        target = self.fps_limit or f["refresh"]
        if f["refresh"]:
            target = min(target, f["refresh"])
        if target <= 0:
            return False
        self.auto_idle = 0
        self.auto_fps, self.auto_target = f["fps"], target
        # over two seconds: a game whose frames miss a refresh now and then (Skyrim at 60 fps
        # does at any clock) dips a frame or two in one second
        fps = f["fps"] if self.auto_prev is None else (f["fps"] + self.auto_prev) / 2
        self.auto_prev = f["fps"]
        short = fps < target * AUTO_UNDER
        self.auto_short = self.auto_short + 1 if short else 0
        # a cap just lowered that makes the game fall short goes back at once
        if self.auto_wait and not (short and self.auto_last):
            self.auto_wait -= 1
            return False
        gpu_busy = self.hw.gpu_busy()
        if gpu_busy is None:
            gpu_busy = 1.0
        before = (self.auto_cpu, self.auto_gpu)
        if short:
            self.auto_steady = 0
            # a cap is to blame only on a unit at its limit: the GPU busy at its cap, a CPU
            # cluster running at its cap (the game's threads spread over every core, so no
            # core's load tells). Otherwise the game stutters by itself (streaming, shader
            # compiles) unless that goes on.
            cpu_caps = self.targets()[0]
            limit = {"gpu": self.auto_gpu > 0 and gpu_busy >= AUTO_GPU_BUSY,
                     "cpu": self.auto_cpu > 0 and any(
                         (read_int(f"{c['path']}/scaling_cur_freq") or 0) >= cpu_caps[c["name"]] for c in self.hw.clusters)}
            stuck = self.auto_short >= AUTO_STUCK or fps < target * 0.85
            if self.auto_last and (limit[self.auto_last] or stuck):
                # the last cap lowered did it: back up, and keep off that step for a while,
                # longer each time it fails again
                unit = self.auto_last
                step = getattr(self, f"auto_{unit}")
                fails = self.auto_fails[(unit, step)] = self.auto_fails.get((unit, step), 0) + 1
                self.auto_block[unit] = (step, self.ticks + AUTO_BACKOFF * min(AUTO_BACKOFF_MAX, 2 ** (fails - 1)))
                setattr(self, f"auto_{unit}", step - 1)
                self.auto_last = None
            elif limit["gpu"] or limit["cpu"] or stuck:
                # the game got heavier: give a unit at its limit its clock back (the GPU first),
                # else the busier one; faster when far short
                for _ in range(2 if fps < target * 0.85 else 1):
                    gpu_first = limit["gpu"] if limit["gpu"] != limit["cpu"] else gpu_busy >= self.cpu_load
                    if (gpu_first or not self.auto_cpu) and self.auto_gpu:
                        self.auto_gpu -= 1
                    elif self.auto_cpu:
                        self.auto_cpu -= 1
        else:
            self.auto_steady += 1
            self.auto_peak["gpu"] = max(self.auto_peak["gpu"], read_int(f"{self.hw.gpu}/cur_freq", 0))
            for c in self.hw.clusters:
                cur = read_int(f"{c['path']}/scaling_cur_freq")
                if cur:
                    self.auto_peak["cpu"] = max(self.auto_peak["cpu"], cur / c["base_max"])
            if self.auto_steady >= AUTO_SETTLE:
                self.auto_lower(gpu_busy)
        if (self.auto_cpu, self.auto_gpu) != before:
            self.auto_wait = AUTO_DWELL
            return True
        return False

    def auto_lower(self, gpu_busy):
        """One cap lower, on the less busy unit not kept off its next step. A cap above what the
        unit ran at lately changes nothing, so it goes straight to the first one below that."""
        self.auto_steady = 0
        gf = self.gpu_steps()
        # first step whose cap is below the peak: GPU caps run down the table, CPU shares down
        # the ladder (1 at step 0, 0.3 at the last); no peak read, no skipping
        peak = self.auto_peak
        bind = {"gpu": sum(1 for f in gf if f >= peak["gpu"]) if peak["gpu"] else 0,
                "cpu": next((k for k in range(CPU_STEPS) if 1 - k * 0.7 / (CPU_STEPS - 1) < peak["cpu"]),
                            CPU_STEPS - 1) if peak["cpu"] else 0}
        top = {"gpu": len(gf) - 1, "cpu": len(self.cpu_ladder) - 1}
        busy = {"gpu": gpu_busy, "cpu": self.cpu_load}
        self.auto_peak = {"cpu": 0.0, "gpu": 0}
        options = {}
        for unit in ("gpu", "cpu"):
            limit = top[unit]
            block = self.auto_block.get(unit)
            if block and self.ticks < block[1]:
                limit = min(limit, block[0] - 1)
            step = getattr(self, f"auto_{unit}")
            if step < limit:
                options[unit] = min(limit, max(step + 1, bind[unit]))
        if options:
            unit = min(options, key=lambda u: busy[u])  # a tie goes to the GPU
            setattr(self, f"auto_{unit}", options[unit])
            self.auto_last = unit

    # --- charging ---

    def clamp_custom(self, ua):
        ua = round(int(ua) / CUSTOM_STEP_UA) * CUSTOM_STEP_UA
        return max(CUSTOM_MIN_UA, min(self.custom_max, ua))

    def charge_speed_ua(self):
        if self.state["charge_speed"] == CUSTOM and self.custom_max:
            return self.state["charge_custom_ua"]
        return self.speeds.get(self.state["charge_speed"]) or self.cfg["power"].get("charge_current")

    def charge_tick(self, now=False):
        """Charge current from the charge speed; while held at the charge limit, a current of
        0 or inhibit-charge (the charger keeps powering the system, the battery sits idle)."""
        if not (self.speeds or self.charge_mode in ("current", "inhibit")):
            return
        if not now and self.charge_wait:
            self.charge_wait -= 1
            return
        self.charge_wait = CHARGE_TICKS - 1
        limit = self.state["steam"]["charge_limit"]
        if self.charge_mode in ("current", "inhibit") and limit >= 0:
            level = read_int(f"{self.hw.battery}/capacity")
            if level is not None:
                if level >= limit:
                    self.charge_held = True
                elif level <= limit - CHARGE_RESUME:
                    self.charge_held = False
        else:
            self.charge_held = False
        if self.charge_mode == "inhibit":
            want = "inhibit-charge" if self.charge_held else "auto"
            # the file lists every behaviour with the active one in brackets
            if f"[{want}]" not in (read(self.hw.charge_behaviour) or ""):
                write(self.hw.charge_behaviour, want)
        want = 0 if self.charge_held and self.charge_mode == "current" else self.charge_speed_ua()
        # read back rather than trust the last write: a firmware restart resets it
        if self.hw.charge_current and want is not None and read_int(self.hw.charge_current) != want:
            write(self.hw.charge_current, want)

    def tick(self):
        self.ticks += 1
        try:
            # both run every tick: auto_tick judges the CPU load tdp_tick reads
            if self.tdp_tick() | self.auto_tick():
                self.apply_caps()
            self.fan_tick()
            self.charge_tick()
        except Exception as e:  # keep the fan loop alive whatever a sysfs read does
            log(f"tick: {e!r}")
        return True

    # --- Steam's properties ---

    def charge_limit(self):
        if self.charge_mode in ("current", "inhibit"):
            return self.state["steam"]["charge_limit"]
        v = read_int(f"{self.hw.battery}/charge_control_end_threshold")
        return -1 if not v or v >= 100 else v

    def apply_charge_limit(self):
        if self.charge_mode in ("current", "inhibit"):
            self.charge_tick(now=True)
            return
        limit = self.state["steam"]["charge_limit"]
        write(f"{self.hw.battery}/charge_control_end_threshold", 100 if limit < 0 else limit)

    def gpu_range(self):
        return (max(self.cfg["gpu"]["manual_min_mhz"], self.hw.gpu_freqs[0] // 1_000_000),
                self.hw.gpu_freqs[-1] // 1_000_000)

    def get_property(self, iface, prop):
        s = self.state["steam"]
        pw = self.cfg["power"]
        v = {
            ("TdpLimit1", "TdpLimit"): ("u", s["tdp"]),
            ("TdpLimit1", "TdpLimitMin"): ("u", pw["tdp_min"]),
            ("TdpLimit1", "TdpLimitMax"): ("u", pw["tdp_max"]),
            ("PerformanceProfile1", "AvailablePerformanceProfiles"): ("as", list(self.profiles)),
            ("PerformanceProfile1", "PerformanceProfile"): ("s", s["profile"]),
            ("PerformanceProfile1", "SuggestedDefaultPerformanceProfile"): ("s", next(iter(self.profiles), "")),
            ("GpuPerformanceLevel1", "AvailableGpuPerformanceLevels"): ("as", ["auto", "manual"]),
            ("GpuPerformanceLevel1", "GpuPerformanceLevel"): ("s", s["gpu_level"]),
            ("GpuPerformanceLevel1", "ManualGpuClock"): ("u", s["gpu_clock"]),
            ("GpuPerformanceLevel1", "ManualGpuClockMin"): ("u", self.gpu_range()[0]),
            ("GpuPerformanceLevel1", "ManualGpuClockMax"): ("u", self.gpu_range()[1]),
            ("BatteryChargeLimit1", "MaxChargeLevel"): ("i", self.charge_limit()),
            ("BatteryChargeLimit1", "SuggestedMinimumLimit"): ("i", pw["charge_limit_min"]),
            ("FanControl1", "FanControlState"): ("u", s["fan_control"]),
        }.get((iface.removeprefix(SOM), prop))
        return GLib.Variant(*v) if v else None

    def set_property(self, iface, prop, value):
        s = self.state["steam"]
        pw = self.cfg["power"]
        iface = iface.removeprefix(SOM)
        if (iface, prop) == ("TdpLimit1", "TdpLimit"):
            s["tdp"] = max(pw["tdp_min"], min(pw["tdp_max"], value))
        elif (iface, prop) == ("PerformanceProfile1", "PerformanceProfile"):
            if value not in self.profiles:
                return False
            s["profile"] = value
        elif (iface, prop) == ("GpuPerformanceLevel1", "GpuPerformanceLevel"):
            if value not in ("auto", "manual"):
                return False
            s["gpu_level"] = value
        elif (iface, prop) == ("GpuPerformanceLevel1", "ManualGpuClock"):
            lo, hi = self.gpu_range()
            s["gpu_clock"] = max(lo, min(hi, value))
        elif (iface, prop) == ("BatteryChargeLimit1", "MaxChargeLevel"):
            s["charge_limit"] = -1 if value < 0 or value >= 100 else max(pw["charge_limit_min"], value)
            self.apply_charge_limit()
        elif (iface, prop) == ("FanControl1", "FanControlState"):
            if value not in (0, 1):
                return False
            s["fan_control"] = value
            self.fan_tick()
        else:
            return False
        self.save()
        self.apply_caps()
        self.changed(SOM + iface, prop)
        return True

    def changed(self, iface, prop):
        if self.conn:
            v = self.get_property(iface, prop)
            self.conn.emit_signal(None, OBJ_PATH, "org.freedesktop.DBus.Properties", "PropertiesChanged",
                                  GLib.Variant("(sa{sv}as)", (iface, {prop: v}, [])))

    # --- the Device Settings and Game Settings plugins' interface ---

    def status(self):
        cpu, (gmin, gmax) = self.targets()
        hw = self.hw
        return {
            "power_w": None if self.power is None else round(self.power, 2),
            "temp_c": hw.fan_temp(),
            "fan_rpm": read_int(f"{hw.hwmon}/fan1_input") if hw.hwmon else None,
            "fan_pct": round(read_int(f"{hw.hwmon}/pwm1", 0) * 100 / 255) if hw.hwmon else None,
            "fan_custom": self.fan_saved_cdev is not None,
            "cpu_khz": {c["name"]: read_int(f"{c['path']}/scaling_cur_freq") for c in hw.clusters},
            "cpu_cap_khz": cpu,
            "gpu_mhz": (read_int(f"{hw.gpu}/cur_freq") or 0) // 1_000_000,
            "gpu_cap_mhz": gmax // 1_000_000,
            "gpu_load": hw.gpu_busy(),
            "tdp_limiting": bool(self.tdp_cpu or self.tdp_gpu),
            "auto_tdp": {"on": self.auto_on(), "target": self.auto_target, "fps_limit": self.fps_limit,
                         "fps": None if self.auto_fps is None else round(self.auto_fps, 1),
                         "limiting": bool(self.auto_cpu or self.auto_gpu)},
            "steam": {**self.state["steam"], "charge_limit": self.charge_limit() if self.charge_ok else None},
            "battery": {"status": read(f"{hw.battery}/status"), "capacity": read_int(f"{hw.battery}/capacity")},
            "charge_speed": self.state["charge_speed"],
            "charge_custom_ua": self.state["charge_custom_ua"],
            "charge_held": self.charge_held,
            "sleep_fan": self.state["sleep_fan"],
            "active_game": self.active,
        }

    def info(self):
        pw = self.cfg["power"]
        return {
            "clusters": [{"name": c["name"], "cpus": c["cpus"], "freqs": c["freqs"]} for c in self.hw.clusters],
            "gpu_mhz": [f // 1_000_000 for f in self.hw.gpu_freqs],
            "gpu_manual_mhz": list(self.gpu_range()),
            "default_curve": self.cfg["fan"]["default_curve"],
            "full_speed_temp": self.cfg["fan"]["full_speed_temp"],
            "fan": self.hw.fan_custom_ok,
            "sleep_fan": bool(self.hw.sleep_fan),
            "profiles": list(self.profiles),
            "tdp": [pw["tdp_min"], pw["tdp_max"]],
            "charge_limit": self.charge_ok,
            "charge_limit_min": pw["charge_limit_min"],
            "charge_speeds": [{"name": n, "ua": ua} for n, ua in self.speeds.items()],
            # the Custom charge speed's slider, uA; null without one
            "charge_custom": {"min": CUSTOM_MIN_UA, "max": self.custom_max, "step": CUSTOM_STEP_UA} if self.custom_max else None,
        }

    def method(self, name, args):
        if name == "GetStatus":
            return json.dumps(self.status())
        if name == "GetInfo":
            return json.dumps(self.info())
        if name == "GetGame":
            appid = args[0] or "default"
            g = self.state["games"]
            return json.dumps({"custom": appid in g, "settings": g.get(appid) or g["default"]})
        if name == "SetGame":
            appid, settings = args[0] or "default", json.loads(args[1] or "null")
            if settings is None:
                if appid != "default":
                    self.state["games"].pop(appid, None)
            else:
                g = self.state["games"]
                # a client without Auto TDP (the Performance app sends fan and cpu) leaves it as it
                # was; {} is a reset to the defaults
                if settings:
                    settings.setdefault("auto_tdp", (g.get(appid) or g["default"])["auto_tdp"])
                g[appid] = self.normalize(settings)
            self.save()
            self.apply()
            self.fan_tick()
            return ""
        if name == "SetChargeSpeed":
            if args[0] not in self.speeds and not (self.custom_max and args[0] == CUSTOM):
                raise ValueError(f"no charge speed {args[0]!r}")
            self.state["charge_speed"] = args[0]
            self.save()
            self.charge_tick(now=True)
            return ""
        if name == "SetChargeCurrent":
            if not self.custom_max:
                raise ValueError("no custom charge current on this device")
            self.state["charge_speed"] = CUSTOM
            self.state["charge_custom_ua"] = self.clamp_custom(args[0])
            self.save()
            self.charge_tick(now=True)
            return ""
        if name == "SetSleepFan":
            if not self.hw.sleep_fan:
                raise ValueError("no fan in sleep on this device")
            self.state["sleep_fan"] = clamp_pct(args[0])
            self.save()
            self.apply_sleep_fan()
            return ""
        if name == "SetFpsLimit":
            limit = max(0, int(args[0]))
            if limit != self.fps_limit:
                self.fps_limit = limit
                self.auto_block, self.auto_fails = {}, {}  # what fell short at the old target may hold the new one
                log(f"Steam's frame rate limit: {limit or 'none'}")
            return ""
        if name == "SetActiveGame":
            if args[0] != self.active:
                self.active = args[0]
                log(f"active game: {self.active or 'none'}")
                self.auto_reset()
                self.apply()
                self.fan_tick()
            return ""
        raise ValueError(name)

    # --- D-Bus ---

    def on_method(self, conn, sender, path, iface, name, params, invocation):
        try:
            out = self.method(name, params.unpack())
            invocation.return_value(GLib.Variant("(s)", (out,)) if name.startswith("Get") else None)
        except Exception as e:
            invocation.return_dbus_error("org.kettlelinux.Power1.Error", str(e))

    def on_get(self, conn, sender, path, iface, prop):
        return self.get_property(iface, prop)

    def on_set(self, conn, sender, path, iface, prop, value):
        return self.set_property(iface, prop, value.unpack())

    def on_bus(self, conn, name):
        self.conn = conn
        node = Gio.DBusNodeInfo.new_for_xml(INTROSPECTION)
        for iface in node.interfaces:
            if iface.name == SOM + "BatteryChargeLimit1" and not self.charge_ok:
                continue
            conn.register_object(OBJ_PATH, iface, self.on_method, self.on_get, self.on_set)

    def run(self):
        self.apply()
        self.apply_sleep_fan()
        if self.charge_ok and self.state["steam"]["charge_limit"] >= 0:
            self.apply_charge_limit()
        self.tick()
        loop = GLib.MainLoop()

        def stop():
            loop.quit()
            return False

        for sig in (signal.SIGTERM, signal.SIGINT):
            GLib.unix_signal_add(GLib.PRIORITY_HIGH, sig, stop)
        Gio.bus_own_name(BUS, BUS_NAME, Gio.BusNameOwnerFlags.NONE, self.on_bus, None,
                         lambda *_: log(f"lost the bus name {BUS_NAME}"))
        GLib.timeout_add(TICK_MS, self.tick)
        loop.run()
        restore(self.hw, self)


def clamp_pct(v):
    try:
        return max(0, min(100, int(v)))
    except (TypeError, ValueError):
        return 0


def kernel_fan_level(temp, max_state):
    """The device tree curve's level for temp: one per 5 C from 50 C."""
    if temp is None:
        return max_state
    return max(0, min(max_state, int((temp - 50) // 5) + 1)) if temp >= 50 else 0


def restore(hw, daemon=None):
    """The fan back to the kernel's curve, every CPU online, no caps."""
    if daemon:
        daemon.fan_release()
    elif any(read(f"{z}/policy") != "step_wise" for z in hw.fan_zones):
        for z in hw.fan_zones:
            write(f"{z}/policy", "step_wise")
        if hw.fan_cdev:
            write(f"{hw.fan_cdev}/cur_state",
                  kernel_fan_level(hw.fan_temp(), read_int(f"{hw.fan_cdev}/max_state", 7)))
    for c in hw.clusters:
        for cpu_id in c["cpus"]:
            if cpu_id != 0 and read_int(f"/sys/devices/system/cpu/cpu{cpu_id}/online") == 0:
                write(f"/sys/devices/system/cpu/cpu{cpu_id}/online", 1)
    if hw.sleep_fan:
        write(hw.sleep_fan, 0)
    # charging back on, at the firmware's own current: a stopped daemon holds no charge limit
    if hw.charge_behaviour:
        write(hw.charge_behaviour, "auto")
    if hw.charge_current and "charge_current" in hw.cfg["power"]:
        write(hw.charge_current, hw.cfg["power"]["charge_current"])
    for c in hw.clusters:
        write(f"{c['path']}/scaling_max_freq", max(c["freqs"]))
    if hw.gpu_freqs:
        write(f"{hw.gpu}/min_freq", hw.gpu_freqs[0])
        write(f"{hw.gpu}/max_freq", hw.gpu_auto_freqs[-1])


INTROSPECTION = f"""<node>
  <interface name="{SOM}TdpLimit1">
    <property name="TdpLimit" type="u" access="readwrite"/>
    <property name="TdpLimitMin" type="u" access="read"/>
    <property name="TdpLimitMax" type="u" access="read"/>
  </interface>
  <interface name="{SOM}PerformanceProfile1">
    <property name="AvailablePerformanceProfiles" type="as" access="read"/>
    <property name="PerformanceProfile" type="s" access="readwrite"/>
    <property name="SuggestedDefaultPerformanceProfile" type="s" access="read"/>
  </interface>
  <interface name="{SOM}GpuPerformanceLevel1">
    <property name="AvailableGpuPerformanceLevels" type="as" access="read"/>
    <property name="GpuPerformanceLevel" type="s" access="readwrite"/>
    <property name="ManualGpuClock" type="u" access="readwrite"/>
    <property name="ManualGpuClockMin" type="u" access="read"/>
    <property name="ManualGpuClockMax" type="u" access="read"/>
  </interface>
  <interface name="{SOM}BatteryChargeLimit1">
    <property name="MaxChargeLevel" type="i" access="readwrite"/>
    <property name="SuggestedMinimumLimit" type="i" access="read"/>
  </interface>
  <interface name="{SOM}FanControl1">
    <property name="FanControlState" type="u" access="readwrite"/>
  </interface>
