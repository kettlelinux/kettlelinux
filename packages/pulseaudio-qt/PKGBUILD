# Qt bindings for libpulse, which Plasma's volume applet (plasma-pa) is built on: the base's
# 1.8.1 (mash-20260305) with two fixes from 1.9.0 on top. 0001 makes reconnects retry again,
# 0002 stops a device that is not the default from being reported as default (KDE bug 500968).
# Neither changes the ABI (0002 touches server.h's comments only), so the base's plasma-pa runs
# on it. 1.9.0 itself needs ECM 6.27 (the base has 6.23). Arch's PKGBUILD, without the API docs.
# pkgrel 1.x replaces the base's 1.
pkgname=pulseaudio-qt
pkgver=1.8.1
pkgrel=1.1
pkgdesc='Qt bindings for libpulse'
arch=(aarch64)
url='https://community.kde.org/Frameworks'
license=(LGPL-2.1-only LGPL-3.0-only)
depends=(gcc-libs glibc libpulse qt6-base)
makedepends=(cmake ninja extra-cmake-modules qt6-tools)
source=(https://download.kde.org/stable/$pkgname/$pkgname-$pkgver.tar.xz
        0001-context-reset-before-reconnectDaemon.patch
        0002-server-do-not-return-incorrect-default-devices.patch)
sha256sums=('79619c55b94808aa7d307fb234ad39a1096d088f21f806be0e788be79a76b3c9'
            '7764f1dcc13d7cebf42d03909178ec821802f805e8040bf8207758a6e0e7c98a'
            '7a497991f36196e8179b5908d2b2180f37ab57a3be8937f7a383c12dc3dd4f78')

prepare() {
  local p
  for p in 0*.patch; do
    patch -d $pkgname-$pkgver -p1 --fuzz=0 <"$p"
  done
}

build() {
  cmake -B build -S $pkgname-$pkgver -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DBUILD_TESTING=OFF
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
