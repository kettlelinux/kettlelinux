@@ -169,6 +176,18 @@ void EmuThread::run()
         if (emuInstance->hotkeyPressed(HK_SwapScreens)) emit swapScreensToggle();
         if (emuInstance->hotkeyPressed(HK_SwapScreenEmphasis)) emit screenEmphasisToggle();
 
+        // state slots 1-8 by hotkey, for a pad-only setup
+        if (emuInstance->hotkeyPressed(HK_NextStateSlot) || emuInstance->hotkeyPressed(HK_PrevStateSlot))
+        {
+            stateSlot += emuInstance->hotkeyPressed(HK_NextStateSlot) ? 1 : -1;
+            if (stateSlot > 8) stateSlot = 1;
+            if (stateSlot < 1) stateSlot = 8;
+            emuInstance->osdAddMessage(0, "State slot %d", stateSlot);
+        }
+        if (emuInstance->hotkeyPressed(HK_SaveState)) emit hotkeySaveState(stateSlot);
+        if (emuInstance->hotkeyPressed(HK_LoadState)) emit hotkeyLoadState(stateSlot);
+        if (emuInstance->hotkeyPressed(HK_Quit)) emit hotkeyQuit();
+
