# melonDS: the Nintendo DS (and DSi) emulator Kettle's emulation runs DS games in (Game Mode's
# Emulation plugin adds them to the library as shortcuts through /usr/lib/kettle/emu-run). Qt 6
# frontend with the JIT and the OpenGL renderer. Without the user's own BIOS and firmware it boots
# DS games on its built-in FreeBIOS (Gilead Kutnick's DraStic replacement, BSD). kettle-emulation
# seeds each user's melonDS.toml (hotkeys, pad, screen layout, folders); nothing here changes
# melonDS's defaults.
#
# 0001 adds hotkeys for save/load state on a current slot, slot +/- and quit (melonDS has only
# fixed F-key menu shortcuts for states), so its hotkeys can be Kettle's standard keys.
#
# ENet (local multiplayer) is built in statically: no ENet package in the repos.
pkgname=melonds
pkgver=1.1
pkgrel=1
_enet=1.3.18
pkgdesc='Nintendo DS emulator (Qt 6)'
arch=(aarch64)
url='https://melonds.kuribo64.net'
# melonDS GPL 3 or later (its FreeBIOS BSD-2, its libslirp BSD-3); ENet MIT
license=(GPL-3.0-or-later BSD-2-Clause BSD-3-Clause MIT)
depends=(faad2 libarchive libglvnd qt6-base qt6-multimedia qt6-svg qt6-wayland sdl2 wayland
         libx11 zstd)
makedepends=(cmake ninja extra-cmake-modules wayland-protocols)
options=(!lto)  # GCC 15 LTO hits an internal compiler error in melonDS (DMA.cpp)
source=("melonDS-$pkgver.tar.gz::https://github.com/melonDS-emu/melonDS/archive/refs/tags/$pkgver.tar.gz"
        "http://enet.bespin.org/download/enet-$_enet.tar.gz"
        0001-state-slot-and-quit-hotkeys.patch)
sha256sums=('61e339bcb18a68a17485973637d972ea628c5624d7e6b8adf6870f895d5e26fd'
            '2a8a0c5360d68bb4fcd11f2e4c47c69976e8d2c85b109dd7d60b1181a4f85d36'
            '3ece5f041f0bee65d2b198f5b79c3e43bf61a625940db9faeae272ed6ad57a3c')

prepare() {
  patch -d "melonDS-$pkgver" -p1 --fuzz=0 <0001-state-slot-and-quit-hotkeys.patch
}

build() {
  cd "enet-$_enet"
  CFLAGS+=" -fPIC" ./configure --prefix="$srcdir/enet-root" --disable-shared --enable-static
  make install
  cd "$srcdir"

  export PKG_CONFIG_PATH="$srcdir/enet-root/lib/pkgconfig"
  cmake -S "melonDS-$pkgver" -B build -G Ninja -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr -DUSE_QT6=ON -DENABLE_WAYLAND=ON -DENABLE_GDBSTUB=OFF \
    -DENABLE_LTO_RELEASE=OFF -DPORTABLE=OFF
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  local l="$pkgdir/usr/share/licenses/$pkgname"
  install -Dm644 "melonDS-$pkgver/LICENSE" "$l/LICENSE"
  install -Dm644 "melonDS-$pkgver/freebios/drastic_bios_readme.txt" "$l/FreeBIOS-LICENSE"
  install -Dm644 "enet-$_enet/LICENSE" "$l/enet-LICENSE"
}
