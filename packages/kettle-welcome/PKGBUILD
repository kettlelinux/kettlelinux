# Kettle Welcome: the desktop's welcome window and hub (our own Kirigami app, src/). Opens on a
# user's first desktop login (/etc/xdg/autostart, --autostart; "Show this window every time the
# desktop starts" makes that every login), from the application menu as Kettle Welcome, and from
# its icon on the desktop (/etc/skel/Desktop/Welcome.desktop).
# Pages: Welcome (get-started checklist), Setup (System Settings modules in their own windows:
# password and account, Wi-Fi, display, sound, ...), Controls (the controller as mouse and
# keyboard, Return to Game Mode), Games (Heroic, Lutris, Steam; Windows games), Android (APKs
# and F-Droid games into Steam, with kettle-lepton), Gaming Extras, System (Kettle Installer,
# Discover, System Monitor, battery, about).
#
# Gaming Extras: optional apps (emulators, streaming, Steam helpers) with aarch64 builds on
# Flathub, installed per user by welcome-flatpak, which runs as a transient systemd user unit so
# installs finish even if the window is closed. Also in the menu on its own
# (org.kettle.GamingExtras.desktop: kettle-welcome --page extras).
pkgname=kettle-welcome
pkgver=2.0.0
pkgrel=8
pkgdesc='Kettle Linux welcome and setup hub for the desktop'
arch=(aarch64)
license=(BSD-3-Clause)
depends=(qt6-base qt6-declarative kirigami kirigami-addons kcoreaddons kconfig kdbusaddons kio
         kservice kwindowsystem qqc2-desktop-style kde-cli-tools flatpak systemd
         kettle-plasma-splash)
makedepends=(cmake ninja extra-cmake-modules)

build() {
  cmake -B build -S "$startdir" -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 "$startdir/LICENSE" -t "$pkgdir/usr/share/licenses/$pkgname"
}
