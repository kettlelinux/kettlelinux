# Heroic Games Launcher (Epic, GOG and Amazon games) for aarch64, with Kettle's ARM64EC Wine
# (packages/wine) as its Wine. Heroic publishes no Linux arm64 build, so it's built here,
# with its store helpers built from source instead of the release binaries its build script
# downloads:
#   legendary  Epic Games       python, pinned to the version Heroic 2.22.3 expects
#   gogdl      GOG              python + the xdelta3 C extension (gogdl-setup.py: see there)
#   nile       Amazon Games     python
#   vulkan-helper               Rust; replaces the prebuilt binary committed to Heroic's tree
# comet (GOG Galaxy online features) is left out: Heroic runs without it.
#
# Electron is upstream's arm64 release (MIT; Chromium's licenses ship in the zip): building
# Chromium isn't practical, and no deckard snapshot has Electron. Node 22 (Heroic needs >= 22,
# the snapshot has 21) is upstream's arm64 build too, used at build time only.
#
# skel/config.json: new users' Heroic defaults (~/.config/heroic): the system Wine, and none
# of Heroic's downloaded x86 DXVK/VKD3D/anti-cheat runtimes installed into prefixes.
pkgname=heroic-games-launcher
pkgver=2.22.3
pkgrel=1
_electron=43.7.5
_node=22.23.3
_legendary=0.21.1
_gogdl=1.3.0
_nile=1.2.0
_vkhelper=b2fdbab594dc4d41987fcdcdb893c7441d804550
pkgdesc='Open source launcher for Epic, GOG and Amazon games'
arch=(aarch64)
url='https://heroicgameslauncher.com'
license=(GPL-3.0-only MIT)
depends=(alsa-lib gtk3 nss python python-requests python-filelock python-pycryptodomex
         python-protobuf python-pycryptodome python-zstandard python-json5 python-platformdirs
         vulkan-icd-loader wine winetricks)
makedepends=(git rust python-build python-installer python-wheel python-setuptools
             desktop-file-utils)
options=(!strip)  # Electron's binaries come stripped; stripping chrome-sandbox et al. again breaks nothing but gains nothing
source=("HeroicGamesLauncher-$pkgver.tar.gz::https://github.com/Heroic-Games-Launcher/HeroicGamesLauncher/archive/refs/tags/v$pkgver.tar.gz"
        "https://github.com/electron/electron/releases/download/v$_electron/electron-v$_electron-linux-arm64.zip"
        "https://nodejs.org/dist/v$_node/node-v$_node-linux-arm64.tar.xz"
        "legendary-$_legendary.tar.gz::https://github.com/legendary-gl/legendary/archive/refs/tags/$_legendary.tar.gz"
        "heroic-gogdl::git+https://github.com/Heroic-Games-Launcher/heroic-gogdl.git#tag=v$_gogdl"
        "xdelta::git+https://github.com/jmacd/xdelta.git#commit=0525275fe4b553a10f38e455d30c60dc6ed9b45d"
        "nile-$_nile.tar.gz::https://github.com/imLinguin/nile/archive/refs/tags/v$_nile.tar.gz"
        "vulkan-helper-rs::git+https://github.com/imLinguin/vulkan-helper-rs.git#commit=$_vkhelper"
        gogdl-setup.py)
noextract=("electron-v$_electron-linux-arm64.zip")
sha256sums=('f542b2f894288df6fc3992ccc135798110ab952889a7def0c7a203d7524c9923'
            '0e8017c56a243deed2510467e5de4be17a2c0634eb017429851ad026551e28ec'
            'a44aeb94849a299b22df10b9e622ec2f605c2183501bc40590705131de7c740f'
            'b78e6dc73d859a324b228ea28839d06fc0561c7143c3d0838e00cba992643f57'
            'SKIP'
            'SKIP'
            'a06dd595248f0b4bf8fccf2b14a534391c94b810f725b6bbeaca92bc3ac2673d'
            'SKIP'
            'SKIP')

prepare() {
  rm -rf electron; mkdir electron
  bsdtar -xf "electron-v$_electron-linux-arm64.zip" -C electron

  # legendary builds with uv_build, which the snapshot doesn't have; plain setuptools does it
  cd "$srcdir/legendary-$_legendary"
  python - <<'EOF'
import re
p = "pyproject.toml"
s = open(p).read()
s = re.sub(r'\[build-system\]\n(.*\n)*?(?=\n)', '[build-system]\nrequires = ["setuptools"]\nbuild-backend = "setuptools.build_meta"\n', s, count=1)
s = s.replace('license = "GPL-3.0-or-later"\nlicense-files = ["LICENSE"]', 'license = {text = "GPL-3.0-or-later"}')
s = re.sub(r'\[tool\.uv[^\]]*\]\n(.*\n)*?(?=\n|\Z)', '', s)
s += '\n[tool.setuptools.packages.find]\ninclude = ["legendary*"]\n'
open(p, "w").write(s)
EOF

  cd "$srcdir/heroic-gogdl"
  git submodule init
  git config submodule.xdelta3.url "$srcdir/xdelta"
  git -c protocol.file.allow=always submodule update
  python - <<'EOF'
import re
p = "pyproject.toml"
s = open(p).read()
s = re.sub(r'\[\[tool\.setuptools\.ext-modules\]\]\n(.*\n)*?(?=\n)', '', s, count=1)
open(p, "w").write(s)
EOF
  cp "$srcdir/gogdl-setup.py" setup.py

  cd "$srcdir/nile-$_nile"
  grep -q '^\[tool.setuptools.packages.find\]' pyproject.toml ||
    printf '\n[tool.setuptools.packages.find]\ninclude = ["nile*"]\n' >>pyproject.toml

  # our vulkan-helper in place of the committed binaries
  cd "$srcdir/HeroicGamesLauncher-$pkgver"
  rm -f public/bin/*/linux/vulkan-helper
}

build() {
  for d in "legendary-$_legendary" heroic-gogdl "nile-$_nile"; do
    (cd "$srcdir/$d" && python -m build --wheel --no-isolation)
  done

  cd "$srcdir/vulkan-helper-rs"
  cargo build --release --locked
  install -Dm755 target/release/vulkan-helper -t "$srcdir/HeroicGamesLauncher-$pkgver/public/bin/arm64/linux"

  cd "$srcdir/HeroicGamesLauncher-$pkgver"
  export PATH="$srcdir/node-v$_node-linux-arm64/bin:$PATH"
  export ELECTRON_SKIP_BINARY_DOWNLOAD=1
  npx --yes pnpm@10.28.0 install --frozen-lockfile --ignore-scripts
  # no download-helper-binaries: the helpers are ours (package())
  npx --yes pnpm@10.28.0 run dist:linux --dir --arm64 \
    -c.electronDist="$srcdir/electron" -c.electronVersion=$_electron
}

package() {
  for d in "legendary-$_legendary" heroic-gogdl "nile-$_nile"; do
    python -m installer --destdir="$pkgdir" "$srcdir/$d"/dist/*.whl
  done

  cd "$srcdir/HeroicGamesLauncher-$pkgver"
  install -d "$pkgdir/usr/lib" "$pkgdir/usr/bin"
  cp -a dist/linux-arm64-unpacked "$pkgdir/usr/lib/heroic"
  chmod 4755 "$pkgdir/usr/lib/heroic/chrome-sandbox"
  ln -s /usr/lib/heroic/heroic "$pkgdir/usr/bin/heroic"
  # Heroic looks for its helpers next to vulkan-helper (bin/<arch>/<platform>)
  local bin="$pkgdir/usr/lib/heroic/resources/app.asar.unpacked/build/bin/arm64/linux"
  for t in legendary gogdl nile; do
    ln -s /usr/bin/$t "$bin/$t"
  done

  install -Dm644 flatpak/com.heroicgameslauncher.hgl.png -t "$pkgdir/usr/share/icons/hicolor/128x128/apps"
  desktop-file-edit --set-key=Exec --set-value="heroic %u" flatpak/com.heroicgameslauncher.hgl.desktop
  install -Dm644 flatpak/com.heroicgameslauncher.hgl.desktop -t "$pkgdir/usr/share/applications"

  install -Dm644 "$startdir/skel/config.json" -t "$pkgdir/etc/skel/.config/heroic"

  local l="$pkgdir/usr/share/licenses/$pkgname"
  install -Dm644 COPYING "$l/Heroic_COPYING"
  install -Dm644 "$srcdir/electron/LICENSE" "$l/Electron_LICENSE"
  install -Dm644 "$srcdir/electron/LICENSES.chromium.html" -t "$l"
  install -Dm644 "$srcdir/vulkan-helper-rs/LICENSE" "$l/vulkan-helper_LICENSE"
}
