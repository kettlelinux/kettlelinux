diff --git a/src/panfrost/vulkan/panvk_linked_shader_cache.c b/src/panfrost/vulkan/panvk_linked_shader_cache.c
new file mode 100644
index 00000000000..4b3941da970
--- /dev/null
+++ b/src/panfrost/vulkan/panvk_linked_shader_cache.c
@@ -0,0 +1,149 @@
+/*
+ * Copyright © 2026 Google, Inc.
+ * SPDX-License-Identifier: MIT
+ */
+
+#include "panvk_linked_shader_cache.h"
+
+#include "util/hash_table.h"
+#include "util/ralloc.h"
+
+DERIVE_HASH_TABLE(panvk_fs_prolog_cache_key);
+DERIVE_HASH_TABLE(panvk_linked_shader_key);
+
+static void
+panvk_fs_prolog_destroy(struct panvk_fs_prolog *prolog)
+{
+   panvk_pool_free_mem(&prolog->code_mem);
+   panvk_pool_free_mem(&prolog->spd);
+   ralloc_free(prolog);
+}
+
+static void
+panvk_linked_shader_entry_destroy(struct panvk_linked_shader_entry *entry)
+{
+   panvk_pool_free_mem(&entry->spd);
+   ralloc_free(entry);
+}
+
+void
+panvk_linked_shader_cache_init(struct panvk_linked_shader_cache *cache)
+{
+   cache->prologs = panvk_fs_prolog_cache_key_table_create(NULL);
+   cache->ht = panvk_linked_shader_key_table_create(NULL);
+   simple_mtx_init(&cache->lock, mtx_plain);
+}
+
+void
+panvk_linked_shader_cache_destroy(struct panvk_linked_shader_cache *cache)
+{
+   hash_table_foreach(cache->ht, entry)
+      panvk_linked_shader_entry_destroy(entry->data);
+
+   hash_table_foreach(cache->prologs, entry)
+      panvk_fs_prolog_destroy(entry->data);
+
+   _mesa_hash_table_destroy(cache->ht, NULL);
+   _mesa_hash_table_destroy(cache->prologs, NULL);
+   cache->ht = NULL;
+   cache->prologs = NULL;
+   simple_mtx_destroy(&cache->lock);
+}
+
+struct panvk_fs_prolog *
+panvk_linked_shader_cache_lookup_prolog(
+   struct panvk_linked_shader_cache *cache,
+   const struct panvk_fs_prolog_cache_key *key)
+{
+   simple_mtx_lock(&cache->lock);
+   struct hash_entry *entry = _mesa_hash_table_search(cache->prologs, key);
+   simple_mtx_unlock(&cache->lock);
+
+   return entry ? entry->data : NULL;
+}
+
+struct panvk_fs_prolog *
+panvk_linked_shader_cache_insert_prolog(struct panvk_linked_shader_cache *cache,
+                                        struct panvk_fs_prolog *prolog)
+{
+   simple_mtx_lock(&cache->lock);
+
+   /* Lost the race with another thread's insert - drop our duplicate and
+    * return theirs.
+    */
+   struct hash_entry *existing =
+      _mesa_hash_table_search(cache->prologs, &prolog->key);
+   if (existing) {
+      simple_mtx_unlock(&cache->lock);
+      panvk_fs_prolog_destroy(prolog);
+      return existing->data;
+   }
+
+   _mesa_hash_table_insert(cache->prologs, &prolog->key, prolog);
+   simple_mtx_unlock(&cache->lock);
+
+   return prolog;
+}
+
+struct panvk_linked_shader_entry *
+panvk_linked_shader_cache_lookup(struct panvk_linked_shader_cache *cache,
+                                 const struct panvk_linked_shader_key *key)
+{
+   simple_mtx_lock(&cache->lock);
+   struct hash_entry *entry = _mesa_hash_table_search(cache->ht, key);
+   simple_mtx_unlock(&cache->lock);
+
+   return entry ? entry->data : NULL;
+}
+
+struct panvk_linked_shader_entry *
+panvk_linked_shader_cache_insert(struct panvk_linked_shader_cache *cache,
+                                 const struct panvk_linked_shader_key *key,
+                                 struct panvk_priv_mem spd)
+{
+   struct panvk_linked_shader_entry *entry =
+      rzalloc(NULL, struct panvk_linked_shader_entry);
+
+   if (!entry) {
+      panvk_pool_free_mem(&spd);
+      return NULL;
+   }
+
+   entry->key = *key;
+   entry->spd = spd;
+
+   simple_mtx_lock(&cache->lock);
+
+   /* Lost the race with another thread's insert - drop our duplicate and
+    * return theirs.
+    */
+   struct hash_entry *existing = _mesa_hash_table_search(cache->ht, key);
+   if (existing) {
+      simple_mtx_unlock(&cache->lock);
+      panvk_linked_shader_entry_destroy(entry);
+      return existing->data;
+   }
+
+   _mesa_hash_table_insert(cache->ht, &entry->key, entry);
+   simple_mtx_unlock(&cache->lock);
+
+   return entry;
+}
+
+void
+panvk_linked_shader_cache_invalidate(struct panvk_linked_shader_cache *cache,
+                                     const void *main_binary)
+{
+   simple_mtx_lock(&cache->lock);
+
+   hash_table_foreach(cache->ht, entry) {
+      struct panvk_linked_shader_entry *linked = entry->data;
+
+      if (linked->key.main_binary == main_binary) {
+         _mesa_hash_table_remove(cache->ht, entry);
+         panvk_linked_shader_entry_destroy(linked);
+      }
+   }
+
+   simple_mtx_unlock(&cache->lock);
+}
diff --git a/src/panfrost/vulkan/panvk_linked_shader_cache.h b/src/panfrost/vulkan/panvk_linked_shader_cache.h
new file mode 100644
index 00000000000..7803ad994df
--- /dev/null
+++ b/src/panfrost/vulkan/panvk_linked_shader_cache.h
@@ -0,0 +1,66 @@
+/*
+ * Copyright © 2026 Google, Inc.
+ * SPDX-License-Identifier: MIT
+ */
+
+#pragma once
+
+#include "util/hash_table.h"
+#include "util/simple_mtx.h"
+#include "pan_nir_prolog.h"
+#include "panvk_mempool.h"
+
+struct panvk_fs_prolog_cache_key {
+   struct pan_fs_prolog_key prolog;
+   bool linked;
+};
+
+struct panvk_fs_prolog {
+   struct panvk_fs_prolog_cache_key key;
+   struct panvk_priv_mem code_mem;
+   /* Only for a standalone prolog, a linked one uses the linked entry's */
+   struct panvk_priv_mem spd;
+   unsigned work_reg_count;
+   uint64_t preload;
+};
+
+struct panvk_linked_shader_key {
+   const void *main_binary;
+   struct pan_fs_prolog_key fs_prolog;
+};
+
+struct panvk_linked_shader_entry {
+   struct panvk_linked_shader_key key;
+   struct panvk_priv_mem spd;
+};
+
+struct panvk_linked_shader_cache {
+   struct hash_table *prologs;
+   struct hash_table *ht;
+   simple_mtx_t lock;
+};
+
+void panvk_linked_shader_cache_init(struct panvk_linked_shader_cache *cache);
+void panvk_linked_shader_cache_destroy(struct panvk_linked_shader_cache *cache);
+
+struct panvk_fs_prolog *
+panvk_linked_shader_cache_lookup_prolog(
+   struct panvk_linked_shader_cache *cache,
+   const struct panvk_fs_prolog_cache_key *key);
+
+struct panvk_fs_prolog *
+panvk_linked_shader_cache_insert_prolog(struct panvk_linked_shader_cache *cache,
+                                        struct panvk_fs_prolog *prolog);
+
+struct panvk_linked_shader_entry *
+panvk_linked_shader_cache_lookup(struct panvk_linked_shader_cache *cache,
+                                 const struct panvk_linked_shader_key *key);
+
+struct panvk_linked_shader_entry *
+panvk_linked_shader_cache_insert(struct panvk_linked_shader_cache *cache,
+                                 const struct panvk_linked_shader_key *key,
+                                 struct panvk_priv_mem spd);
+
+void
+panvk_linked_shader_cache_invalidate(struct panvk_linked_shader_cache *cache,
+                                     const void *main_binary);
