 err_free_precomp:
    panvk_precomp_cleanup(device);
 err_free_priv_bos:
@@ -723,6 +726,7 @@ panvk_per_arch(destroy_device)(struct panvk_device *device,
    panvk_per_arch(device_draw_context_cleanup)(device);
