+/* Registers a v9+ fragment shader may have preloaded */
+#define FS_PRELOAD_REGS BITFIELD64_RANGE(57, 7)
+
+static const struct panvk_fs_prolog *
+get_fs_prolog(struct panvk_cmd_buffer *cmdbuf,
+              const struct pan_fs_prolog_key *prolog_key, bool linked,
+              const struct pan_varying_layout *varying_layout)
+{
+   struct panvk_device *dev = to_panvk_device(cmdbuf->vk.base.device);
+   struct panvk_fs_prolog_cache_key key = {
+      .prolog = *prolog_key,
+      .linked = linked,
+   };
+
+   struct panvk_fs_prolog *prolog =
+      panvk_linked_shader_cache_lookup_prolog(&dev->linked_shader_cache, &key);
+   if (prolog)
+      return prolog;
+
+   prolog = rzalloc(NULL, struct panvk_fs_prolog);
+   if (!prolog) {
+      vk_command_buffer_set_error(&cmdbuf->vk, VK_ERROR_OUT_OF_HOST_MEMORY);
+      return NULL;
+   }
+
+   struct panvk_physical_device *phys_dev =
+      to_panvk_physical_device(dev->vk.physical);
+   const nir_shader_compiler_options *nir_options =
+      pan_get_nir_shader_compiler_options(PAN_ARCH, MESA_SHADER_FRAGMENT,
+                                          false);
+
+   nir_shader *prolog_nir = pan_nir_build_fs_prolog(prolog_key, nir_options);
+
+   struct pan_compile_inputs prolog_inputs = {
+      .gpu_id = phys_dev->kmod.dev->props.gpu_id,
+      .gpu_variant = phys_dev->kmod.dev->props.gpu_variant,
+      /* When linked, the main FS emits the ATEST. A standalone prolog needs
+       * its own to commit the coverage result. */
+      .skip_atest = linked,
+      .preserved_regs = linked ? FS_PRELOAD_REGS : 0,
+      .next_shader_fau =
+         linked ? sysval_offset(graphics, fs_prolog_next) / sizeof(uint32_t)
+                : 0,
+      /* Must match the VS layout so LD_VAR_BUF offsets match the main FS. */
+      .varying_layout = varying_layout,
+   };
+
+   struct util_dynarray prolog_binary = UTIL_DYNARRAY_INIT;
+   struct pan_shader_info prolog_info = {0};
+
+   panvk_per_arch(compiler_lock)();
+   pan_postprocess_nir(prolog_nir, &prolog_inputs, &prolog_info);
+   pan_shader_compile(prolog_nir, &prolog_inputs, &prolog_binary, &prolog_info);
+   panvk_per_arch(compiler_unlock)();
+   ralloc_free(prolog_nir);
+
+   assert(prolog_info.tls_size == 0);
+
+   prolog->key = key;
+   prolog->work_reg_count = prolog_info.work_reg_count;
+   prolog->preload = prolog_info.preload;
+   prolog->code_mem = panvk_pool_upload_aligned(
+      &dev->mempools.exec, util_dynarray_begin(&prolog_binary),
+      util_dynarray_num_elements(&prolog_binary, uint8_t), 128);
+   util_dynarray_fini(&prolog_binary);
+
+   if (!panvk_priv_mem_check_alloc(prolog->code_mem))
+      goto err_oom;
+
+   if (!linked) {
+      prolog->spd = panvk_pool_alloc_desc(&dev->mempools.rw, SHADER_PROGRAM);
+      if (!panvk_priv_mem_check_alloc(prolog->spd))
+         goto err_oom;
+
+      panvk_priv_mem_write_desc(prolog->spd, 0, SHADER_PROGRAM, cfg) {
+         panvk_per_arch(prepare_fs_spd)(
+            &prolog_info, panvk_priv_mem_dev_addr(prolog->code_mem),
+            prolog_info.work_reg_count, prolog_info.preload, &cfg);
+      }
+   }
+
+   return panvk_linked_shader_cache_insert_prolog(&dev->linked_shader_cache,
+                                                  prolog);
+
+err_oom:
+   panvk_pool_free_mem(&prolog->code_mem);
+   ralloc_free(prolog);
+   vk_command_buffer_set_error(&cmdbuf->vk, VK_ERROR_OUT_OF_DEVICE_MEMORY);
+   return NULL;
+}
+
+static uint64_t
+link_fs_prolog(struct panvk_cmd_buffer *cmdbuf,
+               const struct panvk_shader_variant *fs)
+{
+   const struct panvk_shader_variant *vs =
+      panvk_shader_hw_variant(cmdbuf->state.gfx.vs.shader);
+
+   if (!vs || vs->info.vs.clip_distance_array_size == 0)
+      return 0;
+
+   /* The cache key only holds the clip distance count, which is enough
+    * because clip distances always pack first in the varying buffer. */
+   ASSERTED const struct pan_varying_slot *clip_slot =
+      pan_varying_layout_find_slot(&vs->info.varyings.formats,
+                                   VARYING_SLOT_CLIP_DIST0);
+   assert(clip_slot && clip_slot->offset == 0);
+
+   struct panvk_device *dev = to_panvk_device(cmdbuf->vk.base.device);
+   const struct pan_fs_prolog_key prolog_key = {
+      .clip_distance_array_size = vs->info.vs.clip_distance_array_size,
+   };
+
+   if (!fs) {
+      const struct panvk_fs_prolog *prolog = get_fs_prolog(
+         cmdbuf, &prolog_key, false, &vs->info.varyings.formats);
+      return prolog ? panvk_priv_mem_dev_addr(prolog->spd) : 0;
+   }
+
+   struct panvk_linked_shader_key key = {
+      .main_binary = fs->bin_ptr,
+      .fs_prolog = prolog_key,
+   };
+
+   struct panvk_linked_shader_entry *entry =
+      panvk_linked_shader_cache_lookup(&dev->linked_shader_cache, &key);
+   if (entry)
+      return panvk_priv_mem_dev_addr(entry->spd);
+
+   const struct panvk_fs_prolog *prolog = get_fs_prolog(
+      cmdbuf, &prolog_key, true, &vs->info.varyings.formats);
+   if (!prolog)
+      return 0;
+
+   const uint64_t prolog_code = panvk_priv_mem_dev_addr(prolog->code_mem);
+
+   assert(!(fs->info.preload & ~FS_PRELOAD_REGS));
+   assert((prolog_code >> 32) ==
+          (panvk_shader_variant_get_dev_addr(fs) >> 32));
+
+   struct panvk_priv_mem spd =
+      panvk_pool_alloc_desc(&dev->mempools.rw, SHADER_PROGRAM);
+   if (!panvk_priv_mem_check_alloc(spd)) {
+      vk_command_buffer_set_error(&cmdbuf->vk, VK_ERROR_OUT_OF_DEVICE_MEMORY);
+      return 0;
+   }
+
+   panvk_priv_mem_write_desc(spd, 0, SHADER_PROGRAM, cfg) {
+      panvk_per_arch(prepare_fs_spd)(
+         &fs->info, prolog_code,
+         MAX2(prolog->work_reg_count, fs->info.work_reg_count),
+         prolog->preload | fs->info.preload, &cfg);
+   }
+
+   entry = panvk_linked_shader_cache_insert(&dev->linked_shader_cache, &key,
+                                            spd);
+   if (!entry) {
+      vk_command_buffer_set_error(&cmdbuf->vk, VK_ERROR_OUT_OF_HOST_MEMORY);
+      return 0;
+   }
+
+   return panvk_priv_mem_dev_addr(entry->spd);
+}
+
 static void
 prepare_fs(struct panvk_cmd_buffer *cmdbuf,
            const struct panvk_shader_variant *fs)
@@ -2482,9 +2647,19 @@ prepare_fs(struct panvk_cmd_buffer *cmdbuf,
       if (fs_desc_dirty(cmdbuf))
          cs_move64_to(b, cs_sr_reg64(b, IDVS, FRAGMENT_SRT),
                       fs ? fs_desc_state->res_table : 0);
-      if (fs_user_dirty(cmdbuf))
-         cs_move64_to(b, cs_sr_reg64(b, IDVS, FRAGMENT_SPD),
-                      fs ? panvk_priv_mem_dev_addr(fs->spd) : 0);
+      if (fs_user_dirty(cmdbuf) || gfx_state_dirty(cmdbuf, VS)) {
+         const struct vk_rasterization_state *rs =
+            &cmdbuf->vk.dynamic_graphics_state.rs;
+         uint64_t fs_spd = 0;
+
+         if (fs || !rs->rasterizer_discard_enable)
+            fs_spd = link_fs_prolog(cmdbuf, fs);
+
+         if (!fs_spd && fs)
+            fs_spd = panvk_priv_mem_dev_addr(fs->spd);
+
+         cs_move64_to(b, cs_sr_reg64(b, IDVS, FRAGMENT_SPD), fs_spd);
+      }
    }
 }
 
@@ -2763,11 +2938,17 @@ build_dcd_flags(struct panvk_cmd_buffer *cmdbuf,
    uint8_t rt_mask = cmdbuf->state.gfx.render.bound_attachments &
                      MESA_VK_RP_ATTACHMENT_ANY_COLOR_BITS;
 
+   const struct panvk_shader_variant *vs =
