+/*
+ * Instead of ending the shader, jump to the shader whose address is in the
+ * next_shader_fau word, after waiting for everything END would have waited
+ * for.
+ */
+static void
+va_lower_end_to_jump(bi_context *ctx)
+{
+   const unsigned word = ctx->inputs->next_shader_fau;
+   const bi_index target = bi_fau(BIR_FAU_UNIFORM | (word >> 1), word & 1);
+
+   bi_foreach_instr_global_safe(ctx, I) {
+      if (I->flow != VA_FLOW_END)
+         continue;
+
+      assert(I->op != BI_OPCODE_BLEND);
+      I->flow = VA_FLOW_WAIT0126;
+
+      bi_builder b = bi_init_builder(ctx, bi_after_instr(I));
+      bi_branchzi(&b, va_zero_lut(), target, BI_CMPF_EQ);
+   }
+}
