+++ b/src/panfrost/compiler/kraid/lower_end_to_jump.rs
@@ -0,0 +1,40 @@
+// Copyright © 2026 Google, Inc.
+// SPDX-License-Identifier: MIT
+
+use crate::builder::{Builder, InstrBuilder};
+use crate::flow::FlowWaitBit;
+use crate::ir::*;
+use crate::ops::*;
+
+impl Shader<'_> {
+    /// Instead of ending the shader, jump to the shader whose address is in
+    /// the 32-bit FAU word `fau_word`, after waiting for everything END would
+    /// have waited for.  This must run after `opt_flow`.
+    pub fn lower_end_to_jump(&mut self, fau_word: u16) {
+        let model = self.model;
+        self.map_instrs(|mut instr, _| {
+            if !instr.flow.take_end_shader() {
+                return [instr].into();
+            }
+
+            for bit in [
+                FlowWaitBit::Slot0,
+                FlowWaitBit::Slot1,
+                FlowWaitBit::Slot2,
+                FlowWaitBit::ZS,
+            ] {
+                instr.flow.set_wait_bit(bit);
+            }
+
+            let mut b = InstrBuilder::new(model);
+            b.push_instr(instr);
+            b.push_op(OpJump {
+                not: true,
+                cond: 0u32.into(),
+                combine_op: BranchCombineOp::None,
+                address: FAURef::user_i32(fau_word).into(),
+            });
+            b.into_mapped()
+        });
+    }
+}
