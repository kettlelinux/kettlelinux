+{
+   if (!nir_def_is_intrinsic(def) ||
+       nir_def_as_intrinsic(def)->intrinsic != nir_intrinsic_load_deref)
+      return -1;
+
+   nir_deref_instr *d =
+      nir_src_as_deref(nir_def_as_intrinsic(def)->src[0]);
+   if (!nir_deref_mode_is(d, nir_var_shader_in))
+      return -1;
+
+   if (d->deref_type != nir_deref_type_array ||
+       !nir_src_is_const(d->arr.index))
+      return -2;
+
+   nir_deref_instr *parent = nir_deref_instr_parent(d);
+   if (parent->deref_type != nir_deref_type_var ||
+       !glsl_type_is_vector_or_scalar(glsl_get_array_element(
+          parent->var->type)))
+      return -2;
+
+   *var = parent->var;
+   return nir_src_as_uint(d->arr.index);
