@@ -4823,6 +4823,21 @@ panvk_cmd_draw(struct panvk_cmd_buffer *cmdbuf, struct panvk_draw_info draw)
       panvk_cmd_launch_xfb(cmdbuf, &draw);
 }
 
+/* 06n-arch: a VS with a replicating GS folded in (see
+ * analyze_passthrough_gs()) draws each copy of the primitives as a separate
+ * draw, with the copy index in the vs.gs_copy sysval. */
+static void
+panvk_cmd_draw(struct panvk_cmd_buffer *cmdbuf, struct panvk_draw_info draw)
+{
+   const struct panvk_shader *vs = cmdbuf->state.gfx.vs.shader;
+   uint32_t copies = vs && vs->gs_copies > 1 ? vs->gs_copies : 1;
+
+   for (uint32_t copy = 0; copy < copies; copy++) {
+      draw.gs_copy = copy;
+      panvk_cmd_draw_one(cmdbuf, draw);
+   }
+}
+
