+bool pan_nir_lower_clip_cull_distance_fs(nir_shader *shader);
diff --git a/src/panfrost/vulkan/panvk_vX_shader.c b/src/panfrost/vulkan/panvk_vX_shader.c
index eb9d0f8a1f5..84bb664157e 100644
--- a/src/panfrost/vulkan/panvk_vX_shader.c
+++ b/src/panfrost/vulkan/panvk_vX_shader.c
@@ -1751,7 +1751,7 @@ panvk_compile_shader(struct panvk_device *dev,
       nir_assign_io_var_locations(nir, nir_var_shader_out);
       panvk_lower_nir_io(nir);
 
-      NIR_PASS(_, nir, pan_nir_lower_clip_distance_fs);
+      NIR_PASS(_, nir, pan_nir_lower_clip_cull_distance_fs);
 
       /* Lower FS outputs now so that we can lower load_blend_descriptor_pan
        * to a driver-provided FAU instead of using the blend descriptors
