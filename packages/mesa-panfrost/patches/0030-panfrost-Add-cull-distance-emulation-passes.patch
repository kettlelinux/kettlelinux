        * ssbo_atomic and store_output */
       NIR_PASS(_, nir, pan_nir_lower_noperspective_vs);
       info->vs.clip_distance_array_size = inputs->clip_distance_array_size;
-      NIR_PASS(_, nir, pan_nir_lower_clip_distance_vs,
-               inputs->clip_distance_array_size);
+      info->vs.cull_distance_array_size = inputs->cull_distance_array_size;
+      NIR_PASS(_, nir, pan_nir_lower_clip_cull_distance_vs,
+               inputs->clip_distance_array_size,
+               inputs->cull_distance_array_size);
       NIR_PASS(_, nir, pan_nir_lower_vs_inputs, inputs->gpu_id);
