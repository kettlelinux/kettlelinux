diff --git a/src/panfrost/compiler/pan_nir_prolog.c b/src/panfrost/compiler/pan_nir_prolog.c
index f8cd8381d0b..baa651e90cf 100644
--- a/src/panfrost/compiler/pan_nir_prolog.c
+++ b/src/panfrost/compiler/pan_nir_prolog.c
@@ -6,6 +6,7 @@
 #include "pan_nir_prolog.h"
 #include "compiler/nir/nir_builder.h"
 #include "compiler/shader_enums.h"
+#include "pan_nir.h"
 
 /* Build a standalone fragment shader prolog that interpolates clip distances
  * from VARYING_SLOT_CLIP_DIST0/1 and demotes fragments where any clip
@@ -59,3 +60,97 @@ pan_nir_build_fs_prolog(const struct pan_fs_prolog_key *key,
 
    return b.shader;
 }
+
+/* Mali only supports perspective-correct or flat interpolation. To get linear
+ * interpolation for clip distances (required by Vulkan), the VS stores
+ * (clip_dist * W) and the FS divides out by multiplying by FragCoord.w after
+ * perspective-correct interpolation.
+ *
+ * Like pan_nir_lower_noperspective_vs, this must run after
+ * nir_lower_viewport_transform. That pass may clamp W, and we must scale by the
+ * same W the hardware uses for interpolation. After it, position W holds 1/W,
+ * so we take its reciprocal.
+ *
+ * We do not reuse pan_nir_lower_noperspective_vs. That pass is for user
+ * varyings, where the VS and FS interpolation modes can differ, so it uses a
+ * runtime mask to pick which stores to multiply by W. Clip distances are
+ * always linear and a separate FS prolog reads them back, so here we always
+ * multiply and need no mask.
+ */
+
+static bool
+is_clip_dist_loc(unsigned loc)
+{
+   return loc == VARYING_SLOT_CLIP_DIST0 || loc == VARYING_SLOT_CLIP_DIST1;
+}
+
+static bool
+multiply_clip_store_by_pos_w(nir_builder *b, nir_intrinsic_instr *intrin,
+                             void *data)
+{
+   nir_def *pos_w = data;
+
+   if (intrin->intrinsic != nir_intrinsic_store_output)
+      return false;
+
+   if (!is_clip_dist_loc(nir_intrinsic_io_semantics(intrin).location))
+      return false;
+
+   b->cursor = nir_before_instr(&intrin->instr);
+   nir_def *scaled = nir_fmul(b, intrin->src[0].ssa, pos_w);
+   nir_src_rewrite(&intrin->src[0], scaled);
+
+   return true;
+}
+
+bool
+pan_nir_lower_clip_distance_vs(nir_shader *shader,
+                               unsigned clip_distance_array_size)
+{
+   assert(shader->info.stage == MESA_SHADER_VERTEX);
+
+   if (clip_distance_array_size == 0)
+      return false;
+
+   nir_builder b;
+   nir_def *pos_w = pan_nir_get_pos_w(&b, shader);
+   if (!pos_w)
+      return false;
+
+   nir_shader_intrinsics_pass(shader, multiply_clip_store_by_pos_w,
+                              nir_metadata_control_flow, pos_w);
+
+   return true;
+}
+
+static bool
+lower_clip_distance_fs_instr(nir_builder *b, nir_intrinsic_instr *intrin,
+                             UNUSED void *data)
+{
+   if (intrin->intrinsic != nir_intrinsic_load_interpolated_input)
+      return false;
+
+   if (!is_clip_dist_loc(nir_intrinsic_io_semantics(intrin).location))
+      return false;
+
+   b->cursor = nir_after_instr(&intrin->instr);
+   nir_def *fragcoord = nir_load_frag_coord(b);
+   nir_def *fragcoord_w = nir_channel(b, fragcoord, 3);
+   nir_def *corrected = nir_fmul(b, &intrin->def, fragcoord_w);
+
+   nir_def_rewrite_uses_after(&intrin->def, corrected);
+
+   return true;
+}
+
+bool
+pan_nir_lower_clip_distance_fs(nir_shader *shader)
+{
+   assert(shader->info.stage == MESA_SHADER_FRAGMENT);
+
+   if (shader->info.clip_distance_array_size == 0)
+      return false;
+
+   return nir_shader_intrinsics_pass(shader, lower_clip_distance_fs_instr,
+                                     nir_metadata_control_flow, NULL);
+}
diff --git a/src/panfrost/compiler/pan_nir_prolog.h b/src/panfrost/compiler/pan_nir_prolog.h
index 1558127b3f7..e0193e4e94b 100644
--- a/src/panfrost/compiler/pan_nir_prolog.h
+++ b/src/panfrost/compiler/pan_nir_prolog.h
@@ -14,3 +14,8 @@ struct pan_fs_prolog_key {
 nir_shader *
 pan_nir_build_fs_prolog(const struct pan_fs_prolog_key *key,
                         const nir_shader_compiler_options *options);
+
+bool pan_nir_lower_clip_distance_vs(nir_shader *shader,
+                                    unsigned clip_distance_array_size);
+
+bool pan_nir_lower_clip_distance_fs(nir_shader *shader);
