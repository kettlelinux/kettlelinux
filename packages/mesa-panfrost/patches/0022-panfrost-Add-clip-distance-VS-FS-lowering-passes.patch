--- a/src/panfrost/compiler/bifrost/bifrost_nir.c
+++ b/src/panfrost/compiler/bifrost/bifrost_nir.c
@@ -9,6 +9,7 @@
 #include "compiler/nir/nir_builder.h"
 #include "panfrost/compiler/pan_compiler.h"
 #include "panfrost/compiler/pan_nir.h"
+#include "panfrost/compiler/pan_nir_prolog.h"
 #include "util/perf/cpu_trace.h"
 
 #include "panfrost/model/pan_model.h"
@@ -887,6 +888,9 @@ bifrost_postprocess_nir(nir_shader *nir,
       /* Needs to run after lower_vs_atomics as it inserts operations between
        * ssbo_atomic and store_output */
       NIR_PASS(_, nir, pan_nir_lower_noperspective_vs);
+      info->vs.clip_distance_array_size = inputs->clip_distance_array_size;
+      NIR_PASS(_, nir, pan_nir_lower_clip_distance_vs,
+               inputs->clip_distance_array_size);
       NIR_PASS(_, nir, pan_nir_lower_vs_inputs, inputs->gpu_id);
       NIR_PASS(_, nir, pan_nir_lower_vs_outputs, inputs->gpu_id,
                inputs->varying_layout, info->vs.idvs,
diff --git a/src/panfrost/compiler/pan_compiler.h b/src/panfrost/compiler/pan_compiler.h
index c8d753e3ec2..80a5df84063 100644
--- a/src/panfrost/compiler/pan_compiler.h
+++ b/src/panfrost/compiler/pan_compiler.h
@@ -52,6 +52,10 @@ struct pan_compile_inputs {
    /* Varying layout in memory, if known */
