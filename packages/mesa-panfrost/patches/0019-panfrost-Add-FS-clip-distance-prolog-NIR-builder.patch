diff --git a/src/panfrost/compiler/pan_nir_prolog.c b/src/panfrost/compiler/pan_nir_prolog.c
new file mode 100644
index 00000000000..f8cd8381d0b
--- /dev/null
+++ b/src/panfrost/compiler/pan_nir_prolog.c
@@ -0,0 +1,61 @@
+/*
+ * Copyright © 2026 Google, Inc.
+ * SPDX-License-Identifier: MIT
+ */
+
+#include "pan_nir_prolog.h"
+#include "compiler/nir/nir_builder.h"
+#include "compiler/shader_enums.h"
+
+/* Build a standalone fragment shader prolog that interpolates clip distances
+ * from VARYING_SLOT_CLIP_DIST0/1 and demotes fragments where any clip
+ * distance is negative. The prolog is compiled against the VS's varying
+ * layout and ends with a jump to the main FS.
+ */
+nir_shader *
+pan_nir_build_fs_prolog(const struct pan_fs_prolog_key *key,
+                        const nir_shader_compiler_options *options)
+{
+   assert(key->clip_distance_array_size > 0);
+   assert(key->clip_distance_array_size <= 8);
+
+   nir_builder b = nir_builder_init_simple_shader(MESA_SHADER_FRAGMENT, options,
+                                                  "pan-fs-prolog");
+
+   b.shader->info.io_lowered = true;
+
+   nir_def *barycentric =
+      nir_load_barycentric(&b, nir_intrinsic_load_barycentric_pixel,
+                           INTERP_MODE_NONE);
+
+   /* The VS stores clip_dist * W. The hardware loads with perspective-correct
+    * interpolation, so multiply by fragcoord_w to recover linear values.
+    */
+   nir_def *fragcoord_w = nir_load_frag_coord_w(&b);
+
+   nir_def *cond = NULL;
+   unsigned num_slots = DIV_ROUND_UP(key->clip_distance_array_size, 4);
+
+   for (unsigned s = 0; s < num_slots; s++) {
+      unsigned var_slot = VARYING_SLOT_CLIP_DIST0 + s;
+      unsigned ncomps = MIN2(key->clip_distance_array_size - s * 4, 4);
+
+      nir_def *load =
+         nir_load_interpolated_input(&b, ncomps, 32, barycentric,
+                                     nir_imm_int(&b, 0),
+                                     .base = s,
+                                     .io_semantics.location = var_slot,
+                                     .io_semantics.num_slots = 1);
+
+      nir_def *clipdist = nir_fmul(&b, load, fragcoord_w);
+      nir_def *negative = nir_bany(&b, nir_flt_imm(&b, clipdist, 0.0));
+      cond = cond ? nir_ior(&b, cond, negative) : negative;
+
+      b.shader->info.inputs_read |= BITFIELD64_BIT(var_slot);
+   }
+
+   nir_demote_if(&b, cond);
+   b.shader->info.fs.uses_discard = true;
+
+   return b.shader;
+}
diff --git a/src/panfrost/compiler/pan_nir_prolog.h b/src/panfrost/compiler/pan_nir_prolog.h
new file mode 100644
index 00000000000..1558127b3f7
