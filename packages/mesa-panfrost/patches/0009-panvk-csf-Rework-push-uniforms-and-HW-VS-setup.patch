+                         ((uint64_t)hw_vs->fau.total_count << 56));
 
 #if PAN_ARCH >= 12
-      if (gfx_state_dirty(cmdbuf, VS) ||
-          gfx_state_dirty(cmdbuf, IDVS)) {
