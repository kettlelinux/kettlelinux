From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: gennro <gennro2004@gmail.com>
Date: Wed, 30 Sep 2026 21:09:15 -0500
Subject: [PATCH 09/57] panvk/csf: Rework push uniforms and HW VS setup

Ported from mesa!38401 (c4866fa63b3) onto the current upstream draw
path, which now passes the VS/FS variants down from prepare_draw() and
keeps the sysvals for the blend descriptors: the VS sysvals and push
uniforms are prepared in panvk_cmd_draw() before the geometry pipeline,
and prepare_draw() refreshes the sysvals after prepare_blend() as before.

Also fixes hw_vs_desc_dirty() (|| for &&) and a missing error check on
the HW VS push uniforms.

(cherry picked from commit c4866fa63b3b60f66e607598b5a325aa1b4fde3d)

Assisted-by: LLM
---
 src/panfrost/vulkan/csf/panvk_vX_cmd_draw.c | 156 ++++++++++++++------
 src/panfrost/vulkan/panvk_cmd_draw.h        |   4 +
 2 files changed, 117 insertions(+), 43 deletions(-)

diff --git a/src/panfrost/vulkan/csf/panvk_vX_cmd_draw.c b/src/panfrost/vulkan/csf/panvk_vX_cmd_draw.c
index ac977a60171..693a9a8b90e 100644
--- a/src/panfrost/vulkan/csf/panvk_vX_cmd_draw.c
+++ b/src/panfrost/vulkan/csf/panvk_vX_cmd_draw.c
@@ -549,6 +549,43 @@ prepare_tes_desc(struct panvk_cmd_buffer *cmdbuf)
                               &cmdbuf->state.gfx.tes.desc);
 }
 
+static bool
+hw_vs_desc_dirty(struct panvk_cmd_buffer *cmdbuf)
+{
+   if (hw_vs_user_dirty(cmdbuf))
+      return true;
+
+   if (!cmdbuf->state.gfx.gs.shader && !cmdbuf->state.gfx.tes.shader)
+      return vs_desc_dirty(cmdbuf);
+
+   return gfx_state_dirty(cmdbuf, DESC_STATE);
+}
+
+static bool
+hw_vs_push_uniforms_dirty(struct panvk_cmd_buffer *cmdbuf)
+{
+   if (hw_vs_user_dirty(cmdbuf))
+      return true;
+
+   if (cmdbuf->state.gfx.gs.shader)
+      return gfx_state_dirty(cmdbuf, GS_PUSH_UNIFORMS);
+   else if (cmdbuf->state.gfx.tes.shader)
+      return gfx_state_dirty(cmdbuf, TES_PUSH_UNIFORMS);
+   else
+      return gfx_state_dirty(cmdbuf, VS_PUSH_UNIFORMS);
+}
+
+static struct panvk_shader_desc_state *
+get_hw_vs_desc_state(struct panvk_cmd_buffer *cmdbuf)
+{
+   if (cmdbuf->state.gfx.gs.shader)
+      return &cmdbuf->state.gfx.gs.desc;
+   else if (cmdbuf->state.gfx.tes.shader)
+      return &cmdbuf->state.gfx.tes.desc;
+   else
+      return &cmdbuf->state.gfx.vs.desc;
+}
+
 static void
 emit_varying_descs(const struct panvk_cmd_buffer *cmdbuf,
                    struct mali_attribute_packed *descs)
@@ -2272,40 +2309,43 @@ get_render_ctx(struct panvk_cmd_buffer *cmdbuf)
 }
 
