#!/bin/bash
# Start Decky Loader (as root) for the Game Mode user, uid 1000.
#  - plugins (and Decky's own settings, loader.json) are in /home/.kettle/decky, owned by root:
#    Decky runs whatever it finds there, a plugin asking for it as root, and Game Mode's polkit
#    rules trust its backends (reset, SSH, the bootloader). In ~/homebrew, the user's (or a
#    game's) files could add one, or swap the whole folder. /home keeps it across A/B updates.
#    Plugins from Decky's store are unpacked there by Decky, as root, and stay root's
#    (CHOWN_PLUGIN_PATH=0): one can't write to its own folder, only to its settings, data and logs
#  - ~/homebrew holds each plugin's settings, data and logs, as on a Steam Deck
#  - plugins shipped with the image (/usr/share/decky/plugins) are symlinked in; they can't
#    be removed from the Decky UI, only by removing their package
#  - Steam opens its CEF devtools port (localhost:8080), which Decky injects through, only
#    when .cef-enable-remote-debugging exists at client start
set -eu
IFS=: read -r user _ uid gid _ home _ < <(getent passwd 1000)
hb="$home/homebrew"
priv=/home/.kettle/decky
# Paths under the user's home are made as the user: as root, a link there could point anywhere
asuser() { setpriv --reuid="$uid" --regid="$gid" --clear-groups -- "$@"; }
asuser mkdir -p "$hb"/{settings,data,logs,services} || :
install -d -m 0755 -o 0 -g 0 /home/.kettle "$priv" "$priv"/{plugins,plugins-aside,settings}

# Once, from images that kept plugins in ~/homebrew/plugins: Decky's settings come along, and so
# do store plugins Decky unpacked (all root's); anything else there was put by the user and goes
# to ~/homebrew/plugins-aside, not loaded. Links to the shipped plugins are made again below.
# Python, to walk the user's folders by fd without following links, and to check each entry only
# after it is in root's staging folder, where the user can't swap it.
if [ ! -e "$priv/.moved" ]; then
  asuser mkdir -p "$hb/plugins-aside" 2>/dev/null || :
  stage=$(mktemp -d "$priv/.migrate.XXXXXX")
  /usr/bin/python3 -I - "$home" "$priv" "$stage" <<'EOF' || echo "decky-loader-start: plugin migration failed" >&2
import os, stat, sys, time
home, priv, stage = sys.argv[1:]
D = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC

def opendir(path):
    fd = os.open("/", D)
    for part in path.strip("/").split("/"):
        try:
            nfd = os.open(part, D, dir_fd=fd)
        finally:
            os.close(fd)
        fd = nfd
    return fd

def root_owned(sfd, n):
    if os.stat(n, dir_fd=sfd, follow_symlinks=False).st_uid != 0:
        return False
    for _, dirs, files, dfd in os.fwalk(n, dir_fd=sfd):
        for e in dirs + files:
            if os.stat(e, dir_fd=dfd, follow_symlinks=False).st_uid != 0:
                return False
    return True

def plugin(sfd, n):
    try:
        st = os.stat(n, dir_fd=sfd, follow_symlinks=False)
        if not stat.S_ISDIR(st.st_mode) or ".user-" in n:
            return False
        pj = os.stat(n + "/plugin.json", dir_fd=sfd, follow_symlinks=False)
        return stat.S_ISREG(pj.st_mode) and root_owned(sfd, n)
    except OSError:
        return False

try:
    hb = opendir(home + "/homebrew")
except OSError:
    sys.exit(0)
sfd, pfd = os.open(stage, D), os.open(priv + "/plugins", D)

try:
    set_fd = os.open("settings", D, dir_fd=hb)
    if not os.path.lexists(priv + "/settings/loader.json"):
        f = os.open("loader.json", os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC, dir_fd=set_fd)
        if stat.S_ISREG(os.fstat(f).st_mode):
            data = os.read(f, 1 << 20)
            tmp = priv + "/settings/.loader.json.new"
            with open(tmp, "wb") as out:
                out.write(data)
            os.chmod(tmp, 0o644)
            os.rename(tmp, priv + "/settings/loader.json")
            os.unlink("loader.json", dir_fd=set_fd)
        os.close(f)
except OSError:
    pass

try:
    plugins = os.open("plugins", D, dir_fd=hb)
except OSError:
    sys.exit(0)
try:
    aside = os.open("plugins-aside", D, dir_fd=hb)
except OSError:
    aside = None
for n in os.listdir(plugins):
    try:
        os.rename(n, n, src_dir_fd=plugins, dst_dir_fd=sfd)
    except OSError:
        continue
    try:
        st = os.stat(n, dir_fd=sfd, follow_symlinks=False)
        if stat.S_ISLNK(st.st_mode) and os.readlink(n, dir_fd=sfd).startswith("/usr/share/decky/plugins/"):
            os.unlink(n, dir_fd=sfd)
        elif plugin(sfd, n) and not os.path.lexists(priv + "/plugins/" + n):
            os.rename(n, n, src_dir_fd=sfd, dst_dir_fd=pfd)
        elif aside is not None:
            os.rename(n, "%s.moved-%d" % (n, time.time()), src_dir_fd=sfd, dst_dir_fd=aside)
        else:
            raise OSError("no plugins-aside")
    except OSError:
        # back where it was; anything that can't go back stays in root's staging folder
        try:
            os.rename(n, n, src_dir_fd=sfd, dst_dir_fd=plugins)
        except OSError:
            pass
try:
    os.rmdir("plugins", dir_fd=hb)
except OSError:
    pass
EOF
  rmdir "$stage" 2>/dev/null || :
  touch "$priv/.moved"
fi

asuser mkdir -p "$home/.local/share/Steam" || :
asuser touch "$home/.local/share/Steam/.cef-enable-remote-debugging" || :

for p in /usr/share/decky/plugins/*/; do
  [ -f "$p/plugin.json" ] || continue
  p="${p%/}"; l="$priv/plugins/${p##*/}"
  [ -L "$l" ] && [ "$(readlink "$l")" = "$p" ] && continue
  # a store copy of the same plugin: keep it aside rather than delete it, outside plugins/ so
  # Decky doesn't load it next to the shipped one
  [ -e "$l" ] || [ -L "$l" ] && mv -T "$l" "$priv/plugins-aside/${p##*/}.user-$(date +%s)"
  ln -s "$p" "$l"
done
# links to plugins whose package was removed
for l in "$priv"/plugins/*; do
  [ -L "$l" ] && [ ! -e "$l" ] && case "$(readlink "$l")" in /usr/share/decky/plugins/*) rm -f "$l";; esac
done

export UNPRIVILEGED_USER="$user" UNPRIVILEGED_PATH="$hb" PRIVILEGED_PATH="$priv"
# Don't chown -R plugin dirs: the system ones are symlinks into /usr, and the others stay root's
export CHOWN_PLUGIN_PATH=0 KEEP_SYSTEMD_SERVICE=1
export PYTHONPATH=/usr/lib/decky-loader PYTHONDONTWRITEBYTECODE=1
# -P: no '' (the cwd) on sys.path, and a root-owned cwd, so nothing the user can write is imported.
# Decky only used its cwd for the self-updater, which 0001 turns off.
cd "$priv"
exec /usr/bin/python3 -P -c 'from decky_loader.main import main; main()'
