#!/bin/bash
# Start Decky Loader (as root) for the Game Mode user, uid 1000.
#  - ~/homebrew holds plugins, settings, data and logs, as on a Steam Deck
#  - plugins shipped with the image (/usr/share/decky/plugins) are symlinked in; they can't
#    be removed from the Decky UI, only by removing their package
#  - Steam opens its CEF devtools port (localhost:8080), which Decky injects through, only
#    when .cef-enable-remote-debugging exists at client start
set -eu
IFS=: read -r user _ uid gid _ home _ < <(getent passwd 1000)
hb="$home/homebrew"
install -d -o "$uid" -g "$gid" "$hb" "$hb"/{plugins,settings,data,logs,services}

install -d -o "$uid" -g "$gid" "$home/.local" "$home/.local/share" "$home/.local/share/Steam"
f="$home/.local/share/Steam/.cef-enable-remote-debugging"
[ -e "$f" ] || install -m 0644 -o "$uid" -g "$gid" /dev/null "$f"

for p in /usr/share/decky/plugins/*/; do
  [ -f "$p/plugin.json" ] || continue
  p="${p%/}"; l="$hb/plugins/${p##*/}"
  [ -L "$l" ] && [ "$(readlink "$l")" = "$p" ] && continue
  # a store copy of the same plugin: keep it aside rather than delete it
  [ -e "$l" ] || [ -L "$l" ] && mv -T "$l" "$l.user-$(date +%s)"
  ln -s "$p" "$l"
done
# links to plugins whose package was removed
for l in "$hb"/plugins/*; do
  [ -L "$l" ] && [ ! -e "$l" ] && case "$(readlink "$l")" in /usr/share/decky/plugins/*) rm -f "$l";; esac
done

export UNPRIVILEGED_USER="$user" UNPRIVILEGED_PATH="$hb" PRIVILEGED_PATH="$hb"
# Don't chown -R plugin dirs: the system ones are symlinks into /usr
export CHOWN_PLUGIN_PATH=0 KEEP_SYSTEMD_SERVICE=1
export PYTHONPATH=/usr/lib/decky-loader PYTHONDONTWRITEBYTECODE=1
cd "$hb/services"
exec /usr/bin/python3 -c 'from decky_loader.main import main; main()'
