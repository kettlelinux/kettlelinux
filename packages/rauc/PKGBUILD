# RAUC, the update installer of SteamOS's A/B updates (docs/UPDATES.md): Valve's holo package
# (streaming off), built for aarch64, at RAUC 1.15.2 where Valve is still on 1.14. 1.15 has the
# fixes 1.14 needed patches for: OpenSSL 3.5 (Valve's backports, PR #1697) and the dm-verity
# status of Linux 6.14+ ("V -", which 1.14 did not accept, so it could not open a verity bundle;
# PR #1846). 1.15.2 fixes CVE-2026-34155 (plain bundles over 2 GiB; ours are verity).
# 1.15 asks the bootloader backend for the booted slot first (get-current). Valve's custom backend
# has no get-current, so RAUC logs "Failed to get bootname" and falls back to root=, as 1.14 did.
# (glib2-devel: part of glib2 in the pinned snapshot)
# Maintainer (Upstream): David Runge <dvzrv@archlinux.org>
# Maintainer (Holo): Ludovico de Nittis <ludovico.denittis@collabora.com>

pkgname=rauc
pkgver=1.15.2
pkgrel=1
pkgdesc="Safe and secure software updates for embedded Linux"
arch=(aarch64)
url="https://rauc.io"
license=(LGPL-2.1-or-later)
depends=(
  gcc-libs
  glibc
  libnl
  openssl
  sh
)
makedepends=(
  curl
  dbus
  glib2
  json-glib
  meson
  python
  systemd
  util-linux
)
optdepends=(
  'casync: for casync conversion support'
  'cryptsetup: for disk encryption support'
  'dosfstools: for creating and checking FAT filesystems'
  'e2fsprogs: for creating and checking ext2/3/4 filesystems'
  'efibootmgr: for interacting with EFI boot manager'
  'grub: for GRUB support'
  'mtd-utils: for interacting with MTD devices'
  'squashfs-tools: for creating and inspecting bundles'
  'uboot-tools: for u-boot support'
)
# (the release tarball is pinned by its hash; Valve's package also checks its signature)
source=(
  https://github.com/rauc/rauc/releases/download/v$pkgver/$pkgname-$pkgver.tar.xz
  $pkgname.tmpfiles
)
sha512sums=('8d62e667afa34541c57e751bf939277c791112d0aec9795d5a29bff25ea31a4291a4de17b9518bd4b8702fed07fa03ff21c09be2b960627dd5de92fa41fc8993'
            '35173525a8529c4d5a227186db353107193bf8cdd3e8ab0cd94c418b34187be50fe379bcabf623bfddbf1916e8e7e965800a269e823f7ee9c26f44ac1f689c94')

build() {
  # Holo: disable streaming option until we switch to verity update bundle type
  #  https://gitlab.steamos.cloud/holo-team/tasks/-/issues/672
  # (pkcs11_engine, new in 1.15: OpenSSL's deprecated ENGINE API for PKCS#11 keys; not used here)
  arch-meson $pkgname-$pkgver build -Dstreaming=false -Dpkcs11_engine=false
  meson compile -C build
}

# (Valve's check() runs RAUC's test suite, which needs loop and dm devices: not in the rootless
# build chroot)

package() {
  depends+=(
    curl libcurl.so
    glib2 lib{gobject,gio,glib}-2.0.so
    json-glib libjson-glib-1.0.so
    util-linux-libs libfdisk.so
  )

  meson install -C build --destdir "$pkgdir"
  install -vdm 755 "$pkgdir/etc/$pkgname/"
  install -vDm 644 $pkgname-$pkgver/contrib/{grub.conf,uboot.sh} -t "$pkgdir/usr/share/doc/$pkgname/"
  install -vDm 644 $pkgname.tmpfiles "$pkgdir/usr/lib/tmpfiles.d/$pkgname.conf"
}
