Kettle Linux: dm: accept the dm-verity status with the FEC field of Linux 6.14+

The kernel reports "V -" (or "V <corrected blocks>") for a verified dm-verity
device since Linux 6.14; RAUC 1.14 compared the whole status with "V" and
refused to mount verity bundles.

--- a/src/dm.c
+++ b/src/dm.c
@@ -235,7 +235,10 @@
 		res = FALSE;
 		goto out_remove_dm;
 	}
-	if (g_strcmp0(setup.params, dmstatus_by_dmtype(dm->type)) != 0) {
+	/* Linux 6.14+ appends the dm-verity FEC correction count ("V -", "V 0"): only the
+	 * first field says whether the device is verified */
+	if (g_strcmp0(setup.params, dmstatus_by_dmtype(dm->type)) != 0 &&
+	    !(dm->type == RAUC_DM_VERITY && g_str_has_prefix(setup.params, "V "))) {
 		g_set_error(error,
 				G_FILE_ERROR,
 				G_FILE_ERROR_FAILED,
