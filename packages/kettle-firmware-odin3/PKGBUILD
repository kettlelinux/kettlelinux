# Firmware for AYN's SM8750 handheld (the Odin 3, CQ8725S), only the files its drivers and device
# tree ask for. Its own package rather than a split of kettle-firmware-ayn: that one is the
# SM8550 boards' files at an older pin, and moving its pin would change their firmware too.
#  - ROCKNIX extra-firmware (pinned commit, the Pocket FIT Elite's), SM8750/: ADSP/CDSP and
#    battery manager config, the AW88166 amplifier tuning, WCN7860 Wi-Fi (ath12k) and Bluetooth
#    (gng). Upstream linux-firmware has no WCN7860 files yet.
#  - Arch linux-firmware-qcom (Valve's deckard mirror): A830 GPU (gen80000 SQE/GMU/AQE and the
#    SM8750 zap, signed with Qualcomm's test key, so the same on every SM8750 board) and the
#    iris video firmware (vpu35_p4: a link to vpu35_p4_s7, both extracted)
#  - Armada (pinned commit): the SoCCP image, soccp.mbn, from the Odin 3's own Android modem
#    partition. The kernel reloads it so the SoCCP parks itself (40-kettle/1451), which the
#    SoC's deep sleep needs; ROCKNIX's set has no SoCCP image. And the audio topology
#    (SM8750-AYN-tplg.bin, built from Armada's audio_topology/sm8750/SM8750-AYN.m4): ROCKNIX's
#    has no MultiMedia4 stream, which the UCM profile (kettle-ucm-odin3) routes to DisplayPort,
#    so with it the HiFi verb fails and PipeWire has no outputs at all (seen on the unit 11-07).
# Valve's own linux-firmware-deckard is ignored (image/pacman.conf); these files are ours alone.
pkgname=kettle-firmware-odin3
_extra_rev=8834a0c80f5b24fee5ed9e18c1560dc48a6f1bd9
_linux_fw=20260221-1
_armada_rev=d5f0724e610e91c2245dd12c692c0843b60a0068
pkgver=${_linux_fw%-*}.${_extra_rev:0:8}
pkgrel=2
pkgdesc='Firmware for the AYN Odin 3 (DSPs, audio, GPU, video, Wi-Fi, Bluetooth)'
arch=(any)
url='https://github.com/ROCKNIX/extra-firmware'
license=(LicenseRef-linux-firmware LicenseRef-proprietary)
makedepends=(git)
# the same WCN7860, Bluetooth, GPU and video files at the same paths
conflicts=(kettle-firmware-pocketfitelite)
# firmware images, not ELF binaries: nothing to strip
options=(!strip)
_mirror=https://steamdeck-packages.steamos.cloud/archlinux-deckard/archlinux/mash-20260305/core/os/aarch64
source=("extra-firmware::git+https://github.com/ROCKNIX/extra-firmware.git#commit=$_extra_rev"
        "$_mirror/linux-firmware-qcom-$_linux_fw-any.pkg.tar.zst"
        LICENSE.extra-firmware
        "soccp-odin3-$_armada_rev.mbn::https://raw.githubusercontent.com/armada-os/armada/$_armada_rev/system_files/usr/lib/firmware/qcom/sm8750/ayn/odin3/soccp.mbn"
        "SM8750-AYN-tplg-$_armada_rev.bin::https://raw.githubusercontent.com/armada-os/armada/$_armada_rev/system_files/usr/lib/firmware/qcom/sm8750/SM8750-AYN-tplg.bin")
noextract=("linux-firmware-qcom-$_linux_fw-any.pkg.tar.zst")
sha256sums=('SKIP'
            'd7d520aa66b66004e2de1632ce80c16539b6058d0e6bdef5f66ca6e6ef6a26bd'
            '609e2a6888eba08bb2e7dbb3936ea8ebfb328a3602a5836c8bbd05af5d0cf088'
            '9d34942b304045fc872b79baaec9b41876eefce528d7d2d33ed1983b6b2be8bb'
            '821d52b7be37420766cfbf8910cf8baa97bf10c34c530330a366e13f15f5f2de')

package() {
  local fw="$pkgdir/usr/lib/firmware"
  install -d "$fw"
  (cd "$srcdir/extra-firmware/SM8750" && cp --parents -t "$fw" \
    ath12k/WCN7860/hw2.0/* \
    qca/gngbtfw20.mbn qca/gngbtnv20.bin \
    qcom/sm8750/ayn/odin3/*)
  install -Dm644 "$srcdir/soccp-odin3-$_armada_rev.mbn" "$fw/qcom/sm8750/ayn/odin3/soccp.mbn"
  install -Dm644 "$srcdir/SM8750-AYN-tplg-$_armada_rev.bin" "$fw/qcom/sm8750/SM8750-AYN-tplg.bin"
  # where ROCKNIX's and Armada's files come from, and that no licence for them is recorded
  install -Dm644 "$srcdir/LICENSE.extra-firmware" -t "$pkgdir/usr/share/licenses/$pkgname"

  bsdtar -xf "$srcdir/linux-firmware-qcom-$_linux_fw-any.pkg.tar.zst" -C "$pkgdir" \
    'usr/lib/firmware/qcom/gen80000_*' \
    usr/lib/firmware/qcom/sm8750/gen80000_zap.mbn.zst \
    usr/lib/firmware/qcom/vpu/vpu35_p4.mbn.zst \
    usr/lib/firmware/qcom/vpu/vpu35_p4_s7.mbn.zst \
    'usr/share/licenses/linux-firmware-qcom/*'
  find "$pkgdir" -type d -exec chmod 755 {} + && find "$fw" -type f -exec chmod 644 {} +
}
