# winetricks: installs Windows runtime libraries (VC++ runtimes, fonts, .NET, ...) into a Wine
# prefix. Lutris and Heroic call it; no deckard snapshot has it. zenity (in the image) is its GUI.
pkgname=winetricks
pkgver=20260125
pkgrel=1
pkgdesc='Script to install various redistributable runtime libraries in Wine'
arch=(any)
url='https://github.com/Winetricks/winetricks'
license=(LGPL-2.1-or-later)
depends=(bash cabextract perl unzip 7zip wine)
optdepends=('zenity: GUI')
source=("$pkgname-$pkgver.tar.gz::https://github.com/Winetricks/winetricks/archive/$pkgver.tar.gz")
sha256sums=('2890bd9fbbade4638e58b4999a237273192df03b58516ae7b8771e09c22d2f56')

package() {
  make -C $pkgname-$pkgver DESTDIR="$pkgdir" install
}
