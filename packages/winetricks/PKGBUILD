# winetricks: installs Windows runtime libraries (VC++ runtimes, fonts, .NET, ...) into a Wine
# prefix. Lutris and Heroic call it; no deckard snapshot has it. zenity (in the image) is its GUI.
# Pinned to master 44 commits after 20260125: Microsoft changed the vcrun2019/vcrun2026
# downloads (the release's checksums fail), msvcp140_2 is replaced on Wine 11+, and it adds
# vcrun2026, dotnet10/desktop10 and webview2. Back to a release tag once one has these.
pkgname=winetricks
pkgver=20260125.r44.gf3890f6
_commit=f3890f670867b5ffbc3938726db45c0f7d16c8ba
pkgrel=1
pkgdesc='Script to install various redistributable runtime libraries in Wine'
arch=(any)
url='https://github.com/Winetricks/winetricks'
license=(LGPL-2.1-or-later)
depends=(bash cabextract perl unzip 7zip wine)
optdepends=('zenity: GUI')
source=("$pkgname-$_commit.tar.gz::https://github.com/Winetricks/winetricks/archive/$_commit.tar.gz")
sha256sums=('69e82e4da8937e26ed95c48ed724afacad1bfd0069a8800f757665e9d091e261')

package() {
  make -C $pkgname-$_commit DESTDIR="$pkgdir" install
}
