# protobuf-c rebuilt against the protobuf in Valve's deckard hotfix repo. That repo moves protobuf
# (25.3-5) and abseil-cpp to 20250814, but Arch's protobuf-c 1.5.0-2 was built against the older
# abseil, so its protoc-gen-c can't load, and builds that generate C from .proto files (libssc)
# fail. 1.5.2 rather than Arch's 1.5.0: 1.5.1 fixes memory corruption in protobuf_c_message_unpack
# (uninitialised unknown_fields) and changes the generated structs (oneof members), so libssc is
# rebuilt with it. The [kettle] repo comes first, so this replaces Arch's.
pkgname=protobuf-c
pkgver=1.5.2
pkgrel=1
pkgdesc='Protocol Buffers implementation in C'
arch=(aarch64)
url='https://github.com/protobuf-c/protobuf-c'
license=(BSD-2-Clause)
depends=(protobuf)
provides=(libprotobuf-c.so)
options=(!lto)  # https://github.com/protobuf-c/protobuf-c/issues/488
source=("$url/releases/download/v$pkgver/$pkgname-$pkgver.tar.gz")
sha256sums=('e2c86271873a79c92b58fef7ebf8de1aa0df4738347a8bd5d4e65a80a16d0d24')

build() {
  cd "$pkgname-$pkgver"
  ./configure --prefix=/usr --disable-static
  make
}

package() {
  cd "$pkgname-$pkgver"
  make DESTDIR="$pkgdir" install
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
