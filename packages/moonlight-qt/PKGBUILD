# Moonlight: the game streaming client for Sunshine and Apollo hosts. The streaming engine of
# Kettle's Moonlight: Game Mode's Moonlight plugin pairs, lists a host's apps and adds them to
# the library as shortcuts that run `moonlight stream <host> <app>`.
#
# Video is decoded by the SoC's V4L2 decoder (iris) through ffmpeg-v4l2's *_v4l2m2m decoders,
# whose DRM-PRIME frames (dmabufs) the EGL renderer shows with no copy. Valve's FFmpeg 7.0
# outputs no DRM-PRIME from v4l2m2m, so this builds against ffmpeg-v4l2's private headers and
# loads its libraries by rpath.
#
# Left out: VAAPI, VDPAU, CUDA and MMAL (no such hardware), and libplacebo's Vulkan renderer
# (Arch's 6.338 predates FFmpeg 8.1, and it decodes nothing on iris).
#
# The release's source tarball carries moonlight-common-c, qmdnsengine and h264bitstream.
pkgname=moonlight-qt
pkgver=6.2.0
pkgrel=2
pkgdesc='GameStream client for Sunshine and Apollo hosts, with V4L2 hardware decoding'
arch=(aarch64)
url='https://moonlight-stream.org'
# moonlight-qt and moonlight-common-c: GPL 3 (no "or later" notice); h264bitstream LGPL 2.1;
# qmdnsengine, ENet and nanors MIT; SDL_GameControllerDB zlib
license=(GPL-3.0-only LGPL-2.1-only MIT Zlib)
depends=(ffmpeg-v4l2 libdrm libglvnd openssl opus qt6-base qt6-declarative qt6-svg qt6-wayland
         sdl2 sdl2_ttf wayland libx11)
makedepends=(pkgconf)
source=("https://github.com/moonlight-stream/moonlight-qt/releases/download/v$pkgver/MoonlightSrc-$pkgver.tar.gz")
noextract=("MoonlightSrc-$pkgver.tar.gz")
sha256sums=('217afac54e4f8734f3d97b32cb8c8b46b677e87f25b77c945343dd06f359e189')

prepare() {
  mkdir -p moonlight-qt
  bsdtar -xf "MoonlightSrc-$pkgver.tar.gz" -C moonlight-qt
}

build() {
  cd moonlight-qt
  export PKG_CONFIG_PATH=/usr/lib/ffmpeg-v4l2/pkgconfig
  qmake6 PREFIX=/usr \
    CONFIG+=disable-libva CONFIG+=disable-libvdpau CONFIG+=disable-mmal \
    CONFIG+=disable-libplacebo \
    QMAKE_LFLAGS+="-Wl,-rpath,/usr/lib/ffmpeg-v4l2" \
    moonlight-qt.pro
  make
}

package() {
  cd moonlight-qt
  make INSTALL_ROOT="$pkgdir" install
  local l="$pkgdir/usr/share/licenses/$pkgname"
  install -Dm644 LICENSE "$l/LICENSE"
  install -Dm644 h264bitstream/LICENSE "$l/h264bitstream-LICENSE"
  install -Dm644 qmdnsengine/qmdnsengine/LICENSE.txt "$l/qmdnsengine-LICENSE"
  install -Dm644 moonlight-common-c/moonlight-common-c/enet/LICENSE "$l/enet-LICENSE"
  install -Dm644 moonlight-common-c/moonlight-common-c/nanors/LICENSE "$l/nanors-LICENSE"
  install -Dm644 app/SDL_GameControllerDB/LICENSE "$l/SDL_GameControllerDB-LICENSE"
}
