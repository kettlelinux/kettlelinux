+#   DXC=/path/to/dxc ./arm64ec/build.sh ...
+# Without one the DLL still builds, but "asr" reports itself unavailable.
+ASR_COMMIT=0501f490bd9946a2e1806b5363d7ab8a9a6a5e0a # tag 25.06
+ASR_DIR="$DEPS/asr"
+ASR_GEN="$DEPS/asrgen"
+if [ ! -d "$ASR_DIR" ]; then
+  git clone -q https://github.com/arm/accuracy-super-resolution-generic-library "$ASR_DIR"
