+fi
+
+if [ ! -f "$ASR_GEN/asr_dx12_shaders.h" ]; then
+  DXC="${DXC:-dxc}"
+  # Arch's directx-shader-compiler 1.10.2605.37-1 (x86_64 and ALARM aarch64)
+  # aborts on every input with an LLVM "hung off uses" assertion, so probe it
+  # with a trivial shader instead of trusting that it exists.
+  probe="$(mktemp -d)"
+  printf 'float4 main(float4 p : SV_Position) : SV_Target { return p; }\n' > "$probe/t.hlsl"
+  if "$DXC" -T ps_6_0 -E main -Fo "$probe/t.dxil" "$probe/t.hlsl" >/dev/null 2>&1 && [ -s "$probe/t.dxil" ]; then
+    echo ">> compiling Arm ASR shaders to DXIL ($("$DXC" --version 2>/dev/null | head -1))"
+    python3 "$ROOT/arm64ec/gen_asr_shaders.py" --asr "$ASR_DIR" --out "$ASR_GEN" --dxc "$DXC" -j "$(nproc)"
+  else
+    echo "!! no working DXC ('$DXC'); building WITHOUT Arm ASR shaders -- upscaler=asr will be unavailable" >&2
+  fi
+  rm -rf "$probe"
+fi
+
