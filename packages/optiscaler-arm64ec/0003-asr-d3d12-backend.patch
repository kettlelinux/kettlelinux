diff --git a/arm64ec/gen_asr_shaders.py b/arm64ec/gen_asr_shaders.py
new file mode 100644
index 00000000..2e101b20
--- /dev/null
+++ b/arm64ec/gen_asr_shaders.py
@@ -0,0 +1,316 @@
+#!/usr/bin/env python3
+"""Compile Arm ASR's HLSL passes to DXIL for OptiScaler's D3D12 ASR backend.
+
+    gen_asr_shaders.py --asr <accuracy-super-resolution-generic-library> --out <dir> [--dxc dxc] [-j N]
+
+Arm ASR ships only a Vulkan backend, with shaders prebuilt as SPIR-V by AMD's
+Windows-only FidelityFX_SC. Its HLSL still carries the D3D register layout it
+inherited from FSR2 (t#/u#/b#/s#), so it compiles to DXIL unchanged with a Linux
+DXC, and that DXIL is what vkd3d-proton consumes on the device.
+
+Output is a single C++ header, asr_dx12_shaders.h: one DXIL blob per distinct
+permutation plus the reflection the backend needs to build root signatures and
+to hand ffxm_fsr2.cpp the binding names it matches resources by.
+
+Permutations cover the options OptiScaler can actually request:
+  * passes    luminance pyramid, reconstruct-previous-depth, depth clip, lock,
+              accumulate (no sharpening: OptiScaler sharpens with its own RCAS),
+              plus the shared full-screen vertex shader
+  * presets   quality, balanced, performance
+  * flags     HDR input, low-res MVs, jittered MVs, inverted depth
+Permutations whose preprocessed source is identical (a flag the pass ignores)
+are compiled once.
+
+Precision: FFXM_HLSL_6_2=0, i.e. min16float at SM6.0. vkd3d-proton lowers
+min-precision to native fp16 when the device exposes it (Turnip does) and to
+RelaxedPrecision otherwise, so one set of blobs is both fast and always
+loadable -- unlike SM6.2 -enable-16bit-types, which fails PSO creation outright
+where Native16BitShaderOpsSupported is false.
+"""
+
+import argparse
+import concurrent.futures
+import hashlib
+import os
+import re
+import subprocess
+import sys
+import tempfile
+
+# FfxmFsr2Pass values (ffxm_fsr2.h)
+PASS_DEPTH_CLIP = 0
+PASS_RECONSTRUCT_PREVIOUS_DEPTH = 1
+PASS_LOCK = 2
+PASS_ACCUMULATE = 3
+PASS_LUMINANCE_PYRAMID = 6
+PASS_COUNT = 8
+
+QUALITIES = ["quality", "balanced", "performance"]  # FfxmFsr2ShaderQualityMode 1..3
+
+# (pass id, source file, stage)
+PASSES = [
+    (PASS_DEPTH_CLIP, "ffxm_fsr2_depth_clip_pass_fs.hlsl", "ps"),
+    (PASS_RECONSTRUCT_PREVIOUS_DEPTH, "ffxm_fsr2_reconstruct_previous_depth_pass_fs.hlsl", "ps"),
+    (PASS_LOCK, "ffxm_fsr2_lock_pass.hlsl", "cs"),
+    (PASS_ACCUMULATE, "ffxm_fsr2_accumulate_pass_fs.hlsl", "ps"),
+    (PASS_LUMINANCE_PYRAMID, "ffxm_fsr2_compute_luminance_pyramid_pass.hlsl", "cs"),
+]
+VS_SOURCE = "ffxm_fsr2_vs.hlsl"
+
+# Render-target names. ASR's extended FidelityFX_SC hardcodes these per pass and
+# SV_Target index (see tools/ffx_shader_compiler.diff); ffxm_fsr2.cpp matches
+# them against its rtTextureBindingTable. Keyed by (pass, balanced-or-performance).
+RT_NAMES = {
+    (PASS_RECONSTRUCT_PREVIOUS_DEPTH, False): ["rw_dilatedDepth", "rw_dilated_motion_vectors", "rw_lock_input_luma"],
+    (PASS_RECONSTRUCT_PREVIOUS_DEPTH, True): ["rw_dilatedDepth", "rw_dilated_motion_vectors", "rw_lock_input_luma"],
+    (PASS_DEPTH_CLIP, False): ["rw_dilated_reactive_masks", "rw_prepared_input_color"],
+    (PASS_DEPTH_CLIP, True): ["rw_dilated_reactive_masks", "rw_prepared_input_color"],
+    (PASS_ACCUMULATE, False): ["rw_internal_upscaled_color", "rw_lock_status", "rw_luma_history", "rw_upscaled_output"],
+    (PASS_ACCUMULATE, True): ["rw_internal_upscaled_color", "rw_internal_temporal_reactive", "rw_lock_status",
+                              "rw_upscaled_output"],
+}
+
+FLAG_DEFINES = [
+    "FFXM_FSR2_OPTION_HDR_COLOR_INPUT",               # bit 0
+    "FFXM_FSR2_OPTION_LOW_RESOLUTION_MOTION_VECTORS",  # bit 1
+    "FFXM_FSR2_OPTION_JITTERED_MOTION_VECTORS",        # bit 2
+    "FFXM_FSR2_OPTION_INVERTED_DEPTH",                 # bit 3
+]
+
+
+def permutation_defines(quality, flags):
+    d = {name: (flags >> i) & 1 for i, name in enumerate(FLAG_DEFINES)}
+    d["FFXM_FSR2_OPTION_APPLY_SHARPENING"] = 0
+    d["FFXM_FSR2_OPTION_SHADER_OPT_BALANCED"] = 1 if quality in ("balanced", "performance") else 0
+    d["FFXM_FSR2_OPTION_SHADER_OPT_PERFORMANCE"] = 1 if quality == "performance" else 0
+    d["FFXM_FSR2_OPTION_SHADER_OPT_ULTRA_PERFORMANCE"] = 0
+    return d
+
+
+# ASR_NATIVE_16BIT=1 selects SM6.2 explicit 16-bit types instead (experiments only).
+NATIVE16 = os.environ.get("ASR_NATIVE_16BIT", "0") == "1"
+SM = "6_2" if NATIVE16 else "6_0"
+HLSL_6_2 = 1 if NATIVE16 else 0
+
+
+def base_args(asr, stage):
+    extra = ["-enable-16bit-types"] if NATIVE16 else []
+    gpu = os.path.join(asr, "include", "gpu")
+    return [
+        "-T", f"{stage}_{SM}", "-E", "main", "-HV", "2021",
+        "-DFFXM_GPU=1", "-DFFXM_HLSL=1", f"-DFFXM_HLSL_6_2={HLSL_6_2}", "-DFFXM_HALF=1",
+        "-I", gpu, "-I", os.path.join(gpu, "fsr2"),
+        "-Wno-ambig-lit-shift", "-Wno-for-redefinition", "-Wno-conversion", "-Wno-unused-value",
+    ] + extra
+
+
+def run(cmd):
+    p = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
+    if p.returncode != 0:
+        raise RuntimeError(f"{' '.join(cmd)}\n{p.stdout}\n{p.stderr}")
+    return p
+
+
+def preprocess(dxc, asr, src, stage, defines, work):
+    fd, out = tempfile.mkstemp(suffix=".i", dir=work)
+    os.close(fd)
+    cmd = [dxc, "-P", "-Fi", out] + base_args(asr, stage) + [f"-D{k}={v}" for k, v in defines.items()] + [src]
+    run(cmd)
+    with open(out, "r", errors="replace") as f:
+        text = f.read()
+    os.unlink(out)
+    # #line directives carry absolute paths; they do not change the code.
+    text = "\n".join(l for l in text.splitlines() if not l.startswith("#line"))
+    return hashlib.sha256(text.encode()).hexdigest()
+
+
+BIND_RE = re.compile(r"^(cb|t|u|s)(\d+)$")
+
+
+def reflect(asm_text):
+    """Pull resource bindings and SV_Target count out of a DXC -Fc listing."""
+    res = {"cb": [], "t": [], "u": [], "s": []}
+    lines = asm_text.splitlines()
+    try:
+        start = next(i for i, l in enumerate(lines) if l.startswith("; Resource Bindings:"))
+    except StopIteration:
+        start = None
+    if start is not None:
+        i = start + 1
+        while i < len(lines) and not lines[i].startswith("; ------"):
+            i += 1
+        i += 1
+        while i < len(lines):
+            l = lines[i].lstrip(";").strip()
+            if not l:
+                break
+            tok = l.split()
+            name, bind, count = tok[0], tok[-2], tok[-1]
+            m = BIND_RE.match(bind)
+            if not m:
+                raise RuntimeError(f"unparsed binding line: {lines[i]}")
+            res[m.group(1)].append((name, int(m.group(2)), int(count)))
+            i += 1
+
+    rts = 0
+    try:
+        o = next(i for i, l in enumerate(lines) if l.startswith("; Output signature:"))
+        i = o + 1
+        while i < len(lines) and not lines[i].startswith("; ------"):
+            i += 1
+        i += 1
+        while i < len(lines):
+            l = lines[i].lstrip(";").strip()
+            if not l:
+                break
+            tok = l.split()
+            if tok[0].upper() == "SV_TARGET":
+                rts = max(rts, int(tok[1]) + 1)
+            i += 1
+    except StopIteration:
+        pass
+    for k in res:
+        res[k].sort(key=lambda b: b[1])
+    return res, rts
+
+
+def compile_blob(dxc, asr, src, stage, defines, work, tag):
+    dxil = os.path.join(work, tag + ".dxil")
+    asm = os.path.join(work, tag + ".asm")
+    args = base_args(asr, stage) + [f"-D{k}={v}" for k, v in defines.items()]
+    # The listing is taken from an unstripped build: with -Qstrip_reflect DXC
+    # drops the resource names from it, and the names are what ffxm_fsr2.cpp
+    # binds resources by. The shipped blob is stripped.
+    run([dxc] + args + ["-Fc", asm, src])
+    run([dxc] + args + ["-Qstrip_debug", "-Qstrip_reflect", "-Qstrip_rootsignature", "-Fo", dxil, src])
+    with open(dxil, "rb") as f:
+        data = f.read()
+    with open(asm, "r", errors="replace") as f:
+        refl, rts = reflect(f.read())
+    return data, refl, rts
+
+
+def c_bytes(data):
+    out = []
+    for i in range(0, len(data), 24):
+        out.append("    " + ",".join(f"0x{b:02x}" for b in data[i:i + 24]) + ",")
+    return "\n".join(out)
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--asr", required=True)
+    ap.add_argument("--out", required=True)
+    ap.add_argument("--dxc", default=os.environ.get("DXC", "dxc"))
+    ap.add_argument("-j", type=int, default=int(os.environ.get("ASR_SHADER_JOBS", "4")))
+    a = ap.parse_args()
+
+    hlsl_dir = os.path.join(a.asr, "src", "backends", "vk", "shaders", "fsr2", "hlsl")
+    os.makedirs(a.out, exist_ok=True)
+    work = tempfile.mkdtemp(prefix="asrgen-", dir=a.out)
+
+    jobs = []  # (pass, qi, flags, src, stage, defines)
+    for pass_id, fname, stage in PASSES:
+        for qi, q in enumerate(QUALITIES):
+            for flags in range(16):
+                jobs.append((pass_id, qi, flags, os.path.join(hlsl_dir, fname), stage, permutation_defines(q, flags)))
+
+    with concurrent.futures.ThreadPoolExecutor(max_workers=a.j) as ex:
+        hashes = list(ex.map(lambda j: preprocess(a.dxc, a.asr, j[3], j[4], j[5], work), jobs))
+
+    # Distinct (pass, preprocessed text) -> blob index.
+    unique = {}
+    order = []
+    for j, h in zip(jobs, hashes):
+        key = (j[0], h)
+        if key not in unique:
+            unique[key] = len(order)
+            order.append(j)
+
+    def build(idx_job):
+        idx, j = idx_job
+        return compile_blob(a.dxc, a.asr, j[3], j[4], j[5], work, f"b{idx}")
+
+    with concurrent.futures.ThreadPoolExecutor(max_workers=a.j) as ex:
+        blobs = list(ex.map(build, enumerate(order)))
+
+    vs = compile_blob(a.dxc, a.asr, os.path.join(hlsl_dir, VS_SOURCE), "vs", {}, work, "vs")
+
+    table = [[[-1] * 16 for _ in QUALITIES] for _ in range(PASS_COUNT)]
+    for j, h in zip(jobs, hashes):
+        table[j[0]][j[1]][j[2]] = unique[(j[0], h)]
+
+    # Render-target names, checked against the SV_Target count DXC reports.
+    rt_names = []
+    for j, (data, refl, rts) in zip(order, blobs):
+        if j[4] != "ps":
+            rt_names.append([])
+            continue
+        names = RT_NAMES[(j[0], QUALITIES[j[1]] != "quality")]
+        if rts != len(names):
+            sys.exit(f"pass {j[0]} quality {QUALITIES[j[1]]}: DXC reports {rts} render targets, "
+                     f"the name table has {len(names)}")
+        rt_names.append(names)
+
+    hdr = os.path.join(a.out, "asr_dx12_shaders.h")
+    total = 0
+    with open(hdr + ".tmp", "w") as f:
+        f.write("// Generated by arm64ec/gen_asr_shaders.py -- do not edit.\n")
+        f.write("// DXIL compiled from Arm ASR's HLSL (MIT, Copyright (c) 2024-2025 Arm Limited;\n")
+        f.write("// derived from AMD FidelityFX Super Resolution 2, MIT, Copyright (c) 2023 AMD).\n")
+        f.write(f"// Compiler: {run([a.dxc, '--version']).stdout.strip()}\n")
+        f.write("#pragma once\n#include <cstdint>\n\nnamespace asr_dx12_shaders\n{\n")
+        f.write("struct Binding\n{\n    const char* name;\n    uint32_t reg;\n    uint32_t count;\n};\n\n")
+        f.write("struct Blob\n{\n    const uint8_t* data;\n    uint32_t size;\n"
+                "    uint32_t cbCount, srvCount, uavCount, samplerCount, rtCount;\n"
+                "    const Binding* cbs;\n    const Binding* srvs;\n    const Binding* uavs;\n"
+                "    const Binding* samplers;\n    const char* const* rtNames;\n};\n\n")
+
+        def emit(idx, data, refl, rts, names):
+            nonlocal total
+            total += len(data)
+            f.write(f"alignas(4) static const uint8_t blob{idx}_data[] = {{\n{c_bytes(data)}\n}};\n")
+            for kind, label in (("cb", "cbs"), ("t", "srvs"), ("u", "uavs"), ("s", "samplers")):
+                if refl[kind]:
+                    items = ", ".join(f'{{ "{n}", {r}, {c} }}' for n, r, c in refl[kind])
+                    f.write(f"static const Binding blob{idx}_{label}[] = {{ {items} }};\n")
+            if names:
+                f.write(f"static const char* const blob{idx}_rts[] = {{ " + ", ".join(f'"{n}"' for n in names) + " };\n")
+
+        def ref(idx, refl, label, kind):
+            return f"blob{idx}_{label}" if refl[kind] else "nullptr"
+
+        for idx, (data, refl, rts) in enumerate(blobs):
+            emit(idx, data, refl, rts, rt_names[idx])
+        emit("vs", vs[0], vs[1], vs[2], [])
+
+        def blob_entry(idx, data, refl, rts, names):
+            return (f"    {{ blob{idx}_data, {len(data)}, {len(refl['cb'])}, {len(refl['t'])}, {len(refl['u'])}, "
+                    f"{len(refl['s'])}, {len(names)}, {ref(idx, refl, 'cbs', 'cb')}, {ref(idx, refl, 'srvs', 't')}, "
+                    f"{ref(idx, refl, 'uavs', 'u')}, {ref(idx, refl, 'samplers', 's')}, "
+                    f"{('blob%s_rts' % idx) if names else 'nullptr'} }},\n")
+
+        f.write("\nstatic const Blob g_blobs[] = {\n")
+        for idx, (data, refl, rts) in enumerate(blobs):
+            f.write(blob_entry(idx, data, refl, rts, rt_names[idx]))
+        f.write("};\n\n")
+        f.write("static const Blob g_vertexShader =\n" + blob_entry("vs", vs[0], vs[1], vs[2], []).rstrip(",\n") + ";\n\n")
+
+        f.write("// [FfxmFsr2Pass][quality - 1][hdr | lowResMV << 1 | jitteredMV << 2 | invertedDepth << 3] -> g_blobs index, -1 = not built\n")
+        f.write(f"static const int16_t g_permutations[{PASS_COUNT}][{len(QUALITIES)}][16] = {{\n")
+        for p in range(PASS_COUNT):
+            f.write("    {\n")
+            for q in range(len(QUALITIES)):
+                f.write("        { " + ", ".join(str(v) for v in table[p][q]) + " },\n")
+            f.write("    },\n")
+        f.write("};\n} // namespace asr_dx12_shaders\n")
+    os.replace(hdr + ".tmp", hdr)
+
+    for fn in os.listdir(work):
+        os.unlink(os.path.join(work, fn))
+    os.rmdir(work)
+    print(f"asr shaders: {len(jobs)} permutations -> {len(order)} unique blobs + VS, {total // 1024} KiB DXIL -> {hdr}")
+
+
+if __name__ == "__main__":
+    main()
