_submodules=(simpleini unordered_dense xess vulkan spdlog magic_enum nvapi)

prepare() {
  cd Sloptiscaler
  for p in "$srcdir"/0*.patch; do
    patch -Np1 -i "$p"
  done
  git submodule init "${_submodules[@]/#/external/}"
  for s in "${_submodules[@]}"; do
    git config "submodule.external/$s.url" "$srcdir/$s"
  done
  git -c protocol.file.allow=always submodule update "${_submodules[@]/#/external/}"

  local ffx=external/FidelityFX-SDK/ffx-api/include/ffx_api
  for h in "${_ffx_headers[@]}"; do
    install -Dm644 "$srcdir/ffx-${h//\//-}" "$ffx/$h"
  done

  # build.sh expects the x86-64 llvm-mingw and fetches missing deps; hand it ours
  sed -i 's|^LLVM_MINGW=.*|LLVM_MINGW="${LLVM_MINGW:?}"|' arm64ec/build.sh
  rm -rf "$srcdir/deps"; mkdir "$srcdir/deps"
  for d in DirectXMath Detours freetype asr FidelityFX-FSR2; do
    ln -s "$srcdir/$d" "$srcdir/deps/$d"
  done
}

build() {
  cd Sloptiscaler
  # the committed SGSR2 SPIR-V predates our shader patches
  DXC=/usr/bin/dxc ./arm64ec/gen_sgsr2_spirv.sh "$srcdir/deps"
  LLVM_MINGW="$srcdir/$_llvm" DXC=/usr/bin/dxc ./arm64ec/build.sh "$srcdir/deps"
  # build.sh quietly falls back to stubs when dxc or the FSR2 library build fails;
  # this package has to have both
  [ -f "$srcdir/deps/asrgen/asr_dx12_shaders.h" ] || { echo "Arm ASR shaders missing (dxc)" >&2; return 1; }
  [ -d "$srcdir/deps/fsr2gen/dx12" ] || { echo "FSR2 shaders missing (dxc)" >&2; return 1; }
  [ -f "$srcdir/deps/fsr2gen/obj/libffx_fsr2_arm64ec.a" ] || { echo "FSR2 library build failed" >&2; return 1; }
}

package() {
  cd Sloptiscaler
  local d="$pkgdir/usr/share/optiscaler"
  install -Dm644 "$srcdir/deps/build/OptiScaler.dll" OptiScaler.ini -t "$d"
  echo "$pkgver-$pkgrel" >"$d/VERSION"
  printf 'OptiScaler (ARM64EC, Sloptiscaler fork) is free software under the GPL-3.0.\nCorresponding source: %s/tree/%s\nplus the patches in Kettle Linux packages/optiscaler-arm64ec/\n' \
    "$url" "$_commit" >"$d/SOURCE"

  local l="$pkgdir/usr/share/licenses/$pkgname"
  install -Dm644 LICENSE "$l/OptiScaler_LICENSE"
  install -Dm644 LICENSES/BSD-3-Clause-Qualcomm.txt "$l/SGSR_LICENSE"
  install -Dm644 LICENSES/MIT-Arm-ASR.txt "$l/ArmASR_LICENSE"
  install -Dm644 "$srcdir/FidelityFX-FSR2/LICENSE.txt" "$l/FidelityFX-FSR2_LICENSE"
  install -Dm644 OptiScaler/include/imgui/LICENSE.txt "$l/imgui_LICENSE"
  install -Dm644 "$srcdir/Detours/LICENSE" "$l/Detours_LICENSE"
  install -Dm644 "$srcdir/freetype/docs/FTL.TXT" "$l/FreeType_FTL.TXT"
  install -Dm644 external/simpleini/LICENCE.txt "$l/simpleini_LICENSE"
  install -Dm644 external/unordered_dense/LICENSE "$l/unordered_dense_LICENSE"
  install -Dm644 external/spdlog/LICENSE "$l/spdlog_LICENSE"
  install -Dm644 external/magic_enum/LICENSE "$l/magic_enum_LICENSE"
  install -Dm644 external/nvapi/License.txt "$l/nvapi_LICENSE"
}
