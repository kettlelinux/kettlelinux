+#pragma once
+
+#include "ASRFeature.h"
+#include <upscalers/IFeature_Dx12.h>
+
+#include <d3d12.h>
+#include <chrono>
+#include <memory>
+#include <vector>
+
+//============================================================================================================
+// Arm ASR on D3D12, through ffxm_dx12.cpp.
+//
+// Passes (per frame): luminance pyramid (compute), reconstruct previous depth,
+// depth clip (fragment), lock (compute), accumulate (fragment). Sharpening is
+// OptiScaler's own RCAS, as for SGSR2, so ASR's RCAS pass never runs.
+//
+// The accumulate pass writes the upscaled image as a render target. When the
+// output the caller hands over is not render-target capable (NGX outputs
+// usually are UAVs only), ASR renders into _outputBuffer and it is copied over.
+//============================================================================================================
+
+class ASRFeatureDx12 : public ASRFeature, public IFeature_Dx12
+{
+  private:
+    struct Context
+    {
+        std::unique_ptr<arm::FfxmFsr2Context> ctx;
+        std::vector<uint8_t> scratch;
+        uint32_t renderWidth = 0;
+        uint32_t renderHeight = 0;
+        arm::FfxmFsr2ShaderQualityMode quality = arm::FFXM_FSR2_SHADER_QUALITY_MODE_BALANCED;
+    };
+
+    // A context replaced mid-game (render size or preset change) may still have
+    // work in flight, so it is destroyed a few evaluations later instead.
+    struct Retired
+    {
+        std::unique_ptr<Context> context;
+        uint32_t framesLeft = 0;
+    };
+
+    static constexpr uint32_t RetireFrames = 8;
+    static constexpr uint32_t ResizeSettleFrames = 30;
+
+    // A smaller render size waiting to settle before the context is rebuilt.
+    uint32_t _pendingWidth = 0;
+    uint32_t _pendingHeight = 0;
+    uint32_t _pendingFrames = 0;
+
+    // The last size and preset a context failed to build for.
+    uint32_t _failedWidth = 0;
+    uint32_t _failedHeight = 0;
+    arm::FfxmFsr2ShaderQualityMode _failedQuality {};
+
+    std::unique_ptr<Context> _context;
+    std::vector<Retired> _retired;
+
+    ID3D12Resource* _outputBuffer = nullptr;
+    DXGI_FORMAT _outputBufferFormat = DXGI_FORMAT_UNKNOWN;
+    uint32_t _outputBufferWidth = 0;
+    uint32_t _outputBufferHeight = 0;
+
+    bool _loggedInputs = false;
+
+    // GPU timing, opt-in via OPTI_ASR_TIMING=1 (same report shape as SGSR2's).
+    static constexpr uint32_t TimingRing = 4;
+    ID3D12QueryHeap* _timestampHeap = nullptr;
+    ID3D12Resource* _timestampReadback = nullptr;
+    bool _timingEnabled = false;
+    uint64_t _timerFrequency = 0;
+    uint32_t _timingSlot = 0;
+    double _timingSumMs = 0.0;
+    double _timingWorstMs = 0.0;
+    uint32_t _timingSamples = 0;
+    std::chrono::steady_clock::time_point _timingLastEvaluate {};
+    double _timingWallMs = 0.0;
+    uint32_t _timingWallSamples = 0;
+
+    std::unique_ptr<Context> CreateContext(uint32_t renderWidth, uint32_t renderHeight,
+                                           arm::FfxmFsr2ShaderQualityMode quality);
+    static void DestroyContext(Context& context);
+    void TickRetired(bool flushAll);
+
+    bool EnsureOutputBuffer(ID3D12Resource* output);
+    void SetupTiming();
+    void ResolveTiming(ID3D12GraphicsCommandList* cmdList);
+
+  protected:
+    bool InitInternal(ID3D12GraphicsCommandList* InCommandList, NVSDK_NGX_Parameter* InParameters) override;
+    bool EvaluateInternal(ID3D12GraphicsCommandList* InCommandList, NVSDK_NGX_Parameter* InParameters) override;
+
+  public:
+    ASRFeatureDx12(unsigned int InHandleId, NVSDK_NGX_Parameter* InParameters)
+        : ASRFeature(InHandleId, InParameters), IFeature_Dx12(InHandleId, InParameters),
+          IFeature(InHandleId, InParameters)
+    {
+    }
+
+    feature_version Version() override { return ASRFeature::Version(); }
+    Upscaler GetUpscalerType() const final { return Upscaler::ASR; }
+    API Api() const override { return IFeature_Dx12::Api(); }
+    bool IsWithDx12() final { return false; }
+
+    ~ASRFeatureDx12() override;
+};
