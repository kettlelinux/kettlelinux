+namespace
+{
+
+void BackendLog(int level, const char* message)
+{
+    if (level == 0)
+        LOG_ERROR("Arm ASR backend: {}", message);
+    else if (level == 1)
+        LOG_WARN("Arm ASR backend: {}", message);
+    else
+        LOG_INFO("Arm ASR backend: {}", message);
+}
+
+void AsrMessage(FfxmMsgType type, const wchar_t* message)
+{
+    LOG_DEBUG("Arm ASR runtime ({}): {}", (int) type, wstring_to_string(std::wstring(message)));
+}
+
+const char* ErrorName(FfxmErrorCode code)
+{
+    switch (code)
+    {
+    case FFXM_OK: return "ok";
+    case FFXM_ERROR_INVALID_POINTER: return "invalid pointer";
+    case FFXM_ERROR_INVALID_ALIGNMENT: return "invalid alignment";
+    case FFXM_ERROR_INVALID_SIZE: return "invalid size";
+    case FFXM_ERROR_OUT_OF_MEMORY: return "out of memory";
+    case FFXM_ERROR_INCOMPLETE_INTERFACE: return "incomplete interface";
+    case FFXM_ERROR_INVALID_ENUM: return "invalid enum";
+    case FFXM_ERROR_INVALID_ARGUMENT: return "invalid argument";
+    case FFXM_ERROR_OUT_OF_RANGE: return "out of range";
+    case FFXM_ERROR_NULL_DEVICE: return "null device";
+    case FFXM_ERROR_BACKEND_API_ERROR: return "backend API error";
+    case FFXM_ERROR_INSUFFICIENT_MEMORY: return "insufficient memory";
+    default: return "unknown";
+    }
+}
+
+// Copy-compatible typeless family, so the render-target buffer can be copied
+// into whatever typed or sRGB flavour the caller's output uses.
+DXGI_FORMAT TypelessOf(DXGI_FORMAT f)
+{
+    switch (f)
+    {
+    case DXGI_FORMAT_R8G8B8A8_UNORM:
+    case DXGI_FORMAT_R8G8B8A8_UNORM_SRGB:
+    case DXGI_FORMAT_R8G8B8A8_TYPELESS: return DXGI_FORMAT_R8G8B8A8_TYPELESS;
+    case DXGI_FORMAT_B8G8R8A8_UNORM:
+    case DXGI_FORMAT_B8G8R8A8_UNORM_SRGB:
+    case DXGI_FORMAT_B8G8R8A8_TYPELESS: return DXGI_FORMAT_B8G8R8A8_TYPELESS;
+    case DXGI_FORMAT_B8G8R8X8_UNORM:
+    case DXGI_FORMAT_B8G8R8X8_UNORM_SRGB:
+    case DXGI_FORMAT_B8G8R8X8_TYPELESS: return DXGI_FORMAT_B8G8R8X8_TYPELESS;
+    case DXGI_FORMAT_R16G16B16A16_FLOAT:
+    case DXGI_FORMAT_R16G16B16A16_TYPELESS: return DXGI_FORMAT_R16G16B16A16_TYPELESS;
+    case DXGI_FORMAT_R10G10B10A2_UNORM:
+    case DXGI_FORMAT_R10G10B10A2_TYPELESS: return DXGI_FORMAT_R10G10B10A2_TYPELESS;
+    case DXGI_FORMAT_R32G32B32A32_FLOAT:
+    case DXGI_FORMAT_R32G32B32A32_TYPELESS: return DXGI_FORMAT_R32G32B32A32_TYPELESS;
+    default: return f;
+    }
+}
+
+bool IsSrgb(DXGI_FORMAT f)
+{
+    return f == DXGI_FORMAT_R8G8B8A8_UNORM_SRGB || f == DXGI_FORMAT_B8G8R8A8_UNORM_SRGB ||
+           f == DXGI_FORMAT_B8G8R8X8_UNORM_SRGB;
+}
+
+// Linear, typed view of a typeless or sRGB format; the backend makes the same choice.
+DXGI_FORMAT TypedOf(DXGI_FORMAT f)
+{
+    switch (TypelessOf(f))
+    {
+    case DXGI_FORMAT_R8G8B8A8_TYPELESS: return DXGI_FORMAT_R8G8B8A8_UNORM;
+    case DXGI_FORMAT_B8G8R8A8_TYPELESS: return DXGI_FORMAT_B8G8R8A8_UNORM;
+    case DXGI_FORMAT_B8G8R8X8_TYPELESS: return DXGI_FORMAT_B8G8R8X8_UNORM;
+    case DXGI_FORMAT_R16G16B16A16_TYPELESS: return DXGI_FORMAT_R16G16B16A16_FLOAT;
+    case DXGI_FORMAT_R10G10B10A2_TYPELESS: return DXGI_FORMAT_R10G10B10A2_UNORM;
+    case DXGI_FORMAT_R32G32B32A32_TYPELESS: return DXGI_FORMAT_R32G32B32A32_FLOAT;
+    default: return f;
+    }
+}
+
+template <typename T> T* GetParam(NVSDK_NGX_Parameter* params, const char* name)
+{
+    T* value = nullptr;
+    if (params->Get(name, &value) != NVSDK_NGX_Result_Success)
+        params->Get(name, (void**) &value);
+    return value;
+}
+
+} // namespace
+
+// ------------------------------------------------------------------ contexts
+std::unique_ptr<ASRFeatureDx12::Context> ASRFeatureDx12::CreateContext(uint32_t renderWidth, uint32_t renderHeight,
+                                                                       FfxmFsr2ShaderQualityMode quality)
+{
+    auto context = std::make_unique<Context>();
+    context->ctx = std::make_unique<FfxmFsr2Context>();
+    context->scratch.resize(ffxmGetScratchMemorySizeDX12());
+    context->renderWidth = renderWidth;
+    context->renderHeight = renderHeight;
+    context->quality = quality;
+
+    FfxmFsr2ContextDescription desc {};
+    auto err = ffxmGetInterfaceDX12(&desc.backendInterface, Device, context->scratch.data(), context->scratch.size());
+    if (err != FFXM_OK)
+    {
+        LOG_ERROR("Arm ASR: ffxmGetInterfaceDX12: {}", ErrorName(err));
+        return nullptr;
+    }
+
+    desc.qualityMode = quality;
+    desc.flags = ContextFlags();
+    desc.displaySize = { TargetWidth(), TargetHeight() };
+    // Sized for the actual render resolution rather than the display: ASR
+    // 25.06 degrades badly when renderSize < maxRenderSize (its own Vulkan
+    // backend shows the same on a synthetic test, ~8 dB PSNR in the quality
+    // preset), so a render-size change recreates the context instead.
+    desc.maxRenderSize = { renderWidth, renderHeight };
+    desc.fpMessage = AsrMessage;
+
+    LOG_INFO("Arm ASR: creating context {}x{} -> {}x{}, preset {}, flags {:#x}", renderWidth, renderHeight,
+             TargetWidth(), TargetHeight(), QualityName(quality), desc.flags);
+
+    ScopedSkipHeapCapture skipHeapCapture {};
+    err = ffxmFsr2ContextCreate(context->ctx.get(), &desc);
+    if (err != FFXM_OK)
+    {
+        LOG_ERROR("Arm ASR: ffxmFsr2ContextCreate: {}", ErrorName(err));
+        // ASR returns on the first error without releasing what it made: the
+        // backend's heaps, constant ring, textures and pipelines so far.
+        desc.backendInterface.fpDestroyBackendContext(&desc.backendInterface, 0);
+        return nullptr;
+    }
+
+    return context;
+}
+
+void ASRFeatureDx12::DestroyContext(Context& context)
+{
+    if (context.ctx)
+        ffxmFsr2ContextDestroy(context.ctx.get());
+    context.ctx.reset();
+}
+
+void ASRFeatureDx12::TickRetired(bool flushAll)
+{
+    for (auto it = _retired.begin(); it != _retired.end();)
+    {
+        if (flushAll || it->framesLeft == 0)
+        {
+            DestroyContext(*it->context);
+            it = _retired.erase(it);
+        }
+        else
+        {
+            it->framesLeft--;
+            ++it;
+        }
+    }
+}
+
+// ------------------------------------------------------------------ output
+bool ASRFeatureDx12::EnsureOutputBuffer(ID3D12Resource* output)
+{
+    const auto od = output->GetDesc();
+    const DXGI_FORMAT format = TypelessOf(od.Format);
+
+    if (_outputBuffer != nullptr && _outputBufferFormat == format && _outputBufferWidth == TargetWidth() &&
+        _outputBufferHeight == TargetHeight())
+        return true;
+
+    if (_outputBuffer != nullptr)
+    {
+        _outputBuffer->Release();
+        _outputBuffer = nullptr;
+    }
+
+    D3D12_FEATURE_DATA_FORMAT_SUPPORT fs { TypedOf(od.Format) };
+    if (FAILED(Device->CheckFeatureSupport(D3D12_FEATURE_FORMAT_SUPPORT, &fs, sizeof(fs))) ||
+        !(fs.Support1 & D3D12_FORMAT_SUPPORT1_RENDER_TARGET))
+    {
+        LOG_ERROR("Arm ASR: output format {} cannot be rendered to", (int) od.Format);
+        return false;
+    }
+
+    D3D12_HEAP_PROPERTIES heap {};
+    heap.Type = D3D12_HEAP_TYPE_DEFAULT;
+    D3D12_RESOURCE_DESC desc {};
+    desc.Dimension = D3D12_RESOURCE_DIMENSION_TEXTURE2D;
+    desc.Width = TargetWidth();
+    desc.Height = TargetHeight();
+    desc.DepthOrArraySize = 1;
+    desc.MipLevels = 1;
+    desc.Format = format;
+    desc.SampleDesc.Count = 1;
+    desc.Flags = D3D12_RESOURCE_FLAG_ALLOW_RENDER_TARGET;
+
+    if (FAILED(Device->CreateCommittedResource(&heap, D3D12_HEAP_FLAG_NONE, &desc, D3D12_RESOURCE_STATE_RENDER_TARGET,
+                                               nullptr, IID_PPV_ARGS(&_outputBuffer))))
+    {
+        LOG_ERROR("Arm ASR: output buffer creation failed ({}x{} fmt {})", TargetWidth(), TargetHeight(), (int) format);
+        return false;
+    }
+
+    _outputBuffer->SetName(L"ASR_Output");
+    _outputBufferFormat = format;
+    _outputBufferWidth = TargetWidth();
+    _outputBufferHeight = TargetHeight();
+    return true;
+}
+
+// ------------------------------------------------------------------ timing
+void ASRFeatureDx12::SetupTiming()
+{
+    const char* env = std::getenv("OPTI_ASR_TIMING");
+    _timingEnabled = env != nullptr && env[0] == '1';
+    if (!_timingEnabled)
+        return;
+
+    auto* queue = State::Instance().currentCommandQueue;
+    if (queue == nullptr || FAILED(queue->GetTimestampFrequency(&_timerFrequency)) || _timerFrequency == 0)
+    {
+        LOG_WARN("OPTI_ASR_TIMING set but no queue timestamp frequency; timing disabled");
+        _timingEnabled = false;
+        return;
+    }
+
+    D3D12_QUERY_HEAP_DESC qh {};
+    qh.Type = D3D12_QUERY_HEAP_TYPE_TIMESTAMP;
+    qh.Count = 2 * TimingRing;
+
+    D3D12_HEAP_PROPERTIES rb {};
+    rb.Type = D3D12_HEAP_TYPE_READBACK;
+    D3D12_RESOURCE_DESC rd {};
+    rd.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER;
+    rd.Width = (UINT64) qh.Count * sizeof(uint64_t);
+    rd.Height = 1;
+    rd.DepthOrArraySize = 1;
+    rd.MipLevels = 1;
+    rd.SampleDesc.Count = 1;
+    rd.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR;
+
+    if (FAILED(Device->CreateQueryHeap(&qh, IID_PPV_ARGS(&_timestampHeap))) ||
+        FAILED(Device->CreateCommittedResource(&rb, D3D12_HEAP_FLAG_NONE, &rd, D3D12_RESOURCE_STATE_COPY_DEST, nullptr,
+                                               IID_PPV_ARGS(&_timestampReadback))))
+    {
+        LOG_WARN("Arm ASR: timestamp resources failed; timing disabled");
+        _timingEnabled = false;
+        return;
+    }
+
+    LOG_INFO("Arm ASR: GPU timing enabled, timestamp frequency {} Hz", _timerFrequency);
+}
+
+// Reads the slot written TimingRing evaluations ago (long retired), then
+// resolves this frame's pair into it.
+void ASRFeatureDx12::ResolveTiming(ID3D12GraphicsCommandList* cmdList)
+{
+    const uint32_t base = _timingSlot * 2;
+
+    auto now = std::chrono::steady_clock::now();
+    if (_timingLastEvaluate.time_since_epoch().count() != 0)
+    {
+        _timingWallMs += std::chrono::duration<double, std::milli>(now - _timingLastEvaluate).count();
+        _timingWallSamples++;
+    }
+    _timingLastEvaluate = now;
+
+    if (_frameCount >= (long) TimingRing)
+    {
+        uint64_t ts[2] {};
+        D3D12_RANGE r { (SIZE_T) base * sizeof(uint64_t), (SIZE_T) (base + 2) * sizeof(uint64_t) };
+        void* mapped = nullptr;
+        if (SUCCEEDED(_timestampReadback->Map(0, &r, &mapped)) && mapped != nullptr)
+        {
+            memcpy(ts, (const uint8_t*) mapped + r.Begin, sizeof(ts));
+            D3D12_RANGE none { 0, 0 };
+            _timestampReadback->Unmap(0, &none);
+        }
+
+        if (ts[1] > ts[0])
+        {
+            const double ms = (double) (ts[1] - ts[0]) * 1000.0 / (double) _timerFrequency;
+            _timingSumMs += ms;
+            _timingWorstMs = std::max(_timingWorstMs, ms);
+            _timingSamples++;
+        }
+
+        if (_timingSamples >= 300)
+        {
+            const double avg = _timingSumMs / _timingSamples;
+            const double wall = _timingWallSamples > 0 ? _timingWallMs / _timingWallSamples : 0.0;
+            LOG_INFO("Arm ASR {}x{} -> {}x{} ({}) over {} frames: {:.3f} ms/frame GPU (worst {:.3f}); frame {:.2f} ms "
+                     "= {:.1f} fps, upscaler is {:.1f}% of it",
+                     _context ? _context->renderWidth : 0, _context ? _context->renderHeight : 0, TargetWidth(),
+                     TargetHeight(), _context ? QualityName(_context->quality) : "?", _timingSamples, avg,
+                     _timingWorstMs, wall, wall > 0.0 ? 1000.0 / wall : 0.0, wall > 0.0 ? 100.0 * avg / wall : 0.0);
+            _timingSumMs = _timingWorstMs = 0.0;
+            _timingSamples = 0;
+            _timingWallMs = 0.0;
+            _timingWallSamples = 0;
+        }
+    }
+
+    cmdList->ResolveQueryData(_timestampHeap, D3D12_QUERY_TYPE_TIMESTAMP, base, 2, _timestampReadback,
+                              (UINT64) base * sizeof(uint64_t));
+    _timingSlot = (_timingSlot + 1) % TimingRing;
+}
+
+// ------------------------------------------------------------------ feature
+bool ASRFeatureDx12::InitInternal(ID3D12GraphicsCommandList* InCommandList, NVSDK_NGX_Parameter* InParameters)
+{
+    if (IsInited())
+        return true;
+
+    if (Device == nullptr)
+    {
+        LOG_ERROR("Arm ASR: no D3D12 device");
+        return false;
+    }
+
+    if (!ModuleLoaded())
+        return false;
+
+    ffxmSetLogCallbackDX12(BackendLog);
+
+    // Output scaling renders at a multiple of display size and downsamples
+    // afterwards; same rule as the other backends.
+    if (Config::Instance()->OutputScalingEnabled.value_or_default() &&
+        (LowResMV() || RenderWidth() == DisplayWidth()))
+    {
+        float ssMulti = std::clamp(Config::Instance()->OutputScalingMultiplier.value_or_default(), 0.5f, 3.0f);
+        Config::Instance()->OutputScalingMultiplier.set_volatile_value(ssMulti);
+        _targetWidth = static_cast<unsigned int>(DisplayWidth() * ssMulti);
+        _targetHeight = static_cast<unsigned int>(DisplayHeight() * ssMulti);
+    }
+    else
+    {
+        _targetWidth = DisplayWidth();
+        _targetHeight = DisplayHeight();
+    }
+
+    if (RenderWidth() == 0 || RenderHeight() == 0 || TargetWidth() == 0 || TargetHeight() == 0)
+    {
+        LOG_ERROR("Arm ASR: invalid dimensions {}x{} -> {}x{}", RenderWidth(), RenderHeight(), TargetWidth(),
+                  TargetHeight());
+        return false;
+    }
+
+    // Created here so a broken device or pipeline fails the init, which is
+    // where OptiScaler handles fallback; recreated in Evaluate if the render
+    // size or preset moves.
+    _context = CreateContext(RenderWidth(), RenderHeight(), ConfiguredQuality());
+    if (!_context)
+        return false;
+
+    SetupTiming();
+
+    SetInit(true);
+    return true;
+}
+
+bool ASRFeatureDx12::EvaluateInternal(ID3D12GraphicsCommandList* InCommandList, NVSDK_NGX_Parameter* InParameters)
+{
+    if (!IsInited() || InCommandList == nullptr)
+        return false;
+
+    auto& cfg = *Config::Instance();
+
+    TickRetired(false);
+
+    auto* paramColor = GetParam<ID3D12Resource>(InParameters, NVSDK_NGX_Parameter_Color);
+    auto* paramVelocity = GetParam<ID3D12Resource>(InParameters, NVSDK_NGX_Parameter_MotionVectors);
+    auto* paramDepth = GetParam<ID3D12Resource>(InParameters, NVSDK_NGX_Parameter_Depth);
+    auto* paramOutput = GetParam<ID3D12Resource>(InParameters, NVSDK_NGX_Parameter_Output);
+
+    if (paramColor == nullptr || paramVelocity == nullptr || paramOutput == nullptr)
+    {
+        LOG_ERROR("Arm ASR: missing inputs: color {}, mv {}, output {}", paramColor != nullptr,
+                  paramVelocity != nullptr, paramOutput != nullptr);
+        return false;
+    }
+
+    // Depth feeds ASR's disocclusion and lock logic; without it (UE through
+    // Streamline without OptiPatcher) a null SRV reads zero and the result only
+    // degrades, as with SGSR2.
+    if (paramDepth == nullptr && _frameCount == 0)
+        LOG_WARN("Arm ASR: no depth buffer supplied; expect ghosting on disocclusion");
+
+    // Without the game's exposure texture, switch to ASR's auto exposure rather
+    // than run at exposure 1: the feature is rebuilt with it, as the FSR2
+    // backends do. Before any context or barrier work, which this frame skips.
+    if (!AutoExposure() && GetParam<ID3D12Resource>(InParameters, NVSDK_NGX_Parameter_ExposureTexture) == nullptr)
+    {
+        LOG_INFO("Arm ASR: no exposure texture and AutoExposure off; enabling auto exposure");
+        State::Instance().autoExposure = true;
+        State::Instance().changeBackend[Handle()->Id] = true;
+        return true;
+    }
+
+    // ---------------------------------------------------------------- context
+    unsigned int renderWidth = 0, renderHeight = 0;
+    GetRenderResolution(InParameters, &renderWidth, &renderHeight);
+    if (renderWidth == 0 || renderHeight == 0)
+    {
+        renderWidth = RenderWidth();
+        renderHeight = RenderHeight();
+    }
+
+    // A larger render size or a new preset needs a new context right away. A
+    // smaller one still fits the current context (ASR only degrades there, see
+    // CreateContext), so dynamic-resolution games are not made to rebuild the
+    // context -- and its PSOs -- every time the size moves: only once it has
+    // held for a while.
+    const auto quality = ConfiguredQuality();
+    bool recreate = !_context || _context->quality != quality || renderWidth > _context->renderWidth ||
+                    renderHeight > _context->renderHeight;
+
+    if (!recreate && (renderWidth != _context->renderWidth || renderHeight != _context->renderHeight))
+    {
+        if (renderWidth == _pendingWidth && renderHeight == _pendingHeight)
+            recreate = ++_pendingFrames >= ResizeSettleFrames;
+        else
+        {
+            _pendingWidth = renderWidth;
+            _pendingHeight = renderHeight;
+            _pendingFrames = 0;
+        }
+    }
+    else
+    {
+        _pendingFrames = 0;
+    }
+
+    // A size and preset that failed to build once aren't tried again every frame.
+    if (recreate && !(renderWidth == _failedWidth && renderHeight == _failedHeight && quality == _failedQuality))
+    {
+        if (auto fresh = CreateContext(renderWidth, renderHeight, quality))
+        {
+            if (_context)
+                _retired.push_back({ std::move(_context), RetireFrames });
+            _context = std::move(fresh);
+            _failedWidth = _failedHeight = 0;
+        }
+        else
+        {
+            _failedWidth = renderWidth;
+            _failedHeight = renderHeight;
+            _failedQuality = quality;
+        }
+    }
+
+    // Without a new one, the current context still serves any size that fits it.
+    if (!_context || renderWidth > _context->renderWidth || renderHeight > _context->renderHeight)
+        return false;
+
+    if (!_loggedInputs)
+    {
+        _loggedInputs = true;
+        auto cd = paramColor->GetDesc();
+        auto vd = paramVelocity->GetDesc();
+        auto od = paramOutput->GetDesc();
+        LOG_INFO("Arm ASR inputs: color {}x{} fmt {}, mv {}x{} fmt {}, depth {}, output {}x{} fmt {} flags {:#x}, "
+                 "render {}x{} -> {}x{}",
+                 cd.Width, cd.Height, (int) cd.Format, vd.Width, vd.Height, (int) vd.Format,
+                 paramDepth ? (int) paramDepth->GetDesc().Format : -1, od.Width, od.Height, (int) od.Format,
+                 (uint32_t) od.Flags, renderWidth, renderHeight, TargetWidth(), TargetHeight());
+        LOG_INFO("  flags: DepthInverted={} JitteredMV={} LowResMV={} AutoExposure={} HDR={}", DepthInverted(),
+                 JitteredMV(), LowResMV(), AutoExposure(), IsHdr());
+    }
+
+    // ------------------------------------------------------------ input states
+    // The game's resources arrive in whatever state it left them in. Same
+    // defaults as the SGSR2 backend, which is what has been exercised on the
+    // Proton/vkd3d-proton/Turnip stack; the [...]ResourceBarrier keys override.
+    const auto colorState =
+        (D3D12_RESOURCE_STATES) cfg.ColorResourceBarrier.value_or(D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE);
+    const auto depthState = (D3D12_RESOURCE_STATES) cfg.DepthResourceBarrier.value_or(D3D12_RESOURCE_STATE_DEPTH_WRITE);
+    const auto mvState =
+        (D3D12_RESOURCE_STATES) cfg.MVResourceBarrier.value_or(D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE);
+    const auto outputState =
+        (D3D12_RESOURCE_STATES) cfg.OutputResourceBarrier.value_or(D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
+    constexpr auto readState = D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE;
+
+    ResourceBarrier(InCommandList, paramColor, colorState, readState);
+    if (paramDepth)
+        ResourceBarrier(InCommandList, paramDepth, depthState, readState);
+    ResourceBarrier(InCommandList, paramVelocity, mvState, readState);
+
+    FfxmFsr2DispatchDescription params {};
+    params.commandList = InCommandList;
+    params.color = ffxmGetResourceDX12(paramColor, FFXM_RESOURCE_STATE_COMPUTE_READ, L"ASR_Color");
+    params.motionVectors = ffxmGetResourceDX12(paramVelocity, FFXM_RESOURCE_STATE_COMPUTE_READ, L"ASR_MotionVectors");
+    if (paramDepth)
+        params.depth = ffxmGetResourceDX12(paramDepth, FFXM_RESOURCE_STATE_COMPUTE_READ, L"ASR_Depth");
+
+    // Exposure (the texture is there: checked above)
+    ID3D12Resource* paramExp = nullptr;
+    if (!AutoExposure())
+    {
+        paramExp = GetParam<ID3D12Resource>(InParameters, NVSDK_NGX_Parameter_ExposureTexture);
+        if (cfg.ExposureResourceBarrier.has_value())
+            ResourceBarrier(InCommandList, paramExp, (D3D12_RESOURCE_STATES) cfg.ExposureResourceBarrier.value(),
+                            readState);
+        params.exposure = ffxmGetResourceDX12(paramExp, FFXM_RESOURCE_STATE_COMPUTE_READ, L"ASR_Exposure");
+    }
+
+    // Reactive / transparency masks, following the FSR2 backends' rules.
+    auto* paramTransparency = GetParam<ID3D12Resource>(InParameters, "FSR.transparencyAndComposition");
+    auto* paramReactive = GetParam<ID3D12Resource>(InParameters, "FSR.reactive");
+    auto* paramBiasMask = GetParam<ID3D12Resource>(InParameters, NVSDK_NGX_Parameter_DLSS_Input_Bias_Current_Color_Mask);
+    bool biasMaskTransitioned = false;
+
+    if (!cfg.DisableReactiveMask.value_or(paramReactive == nullptr && paramBiasMask == nullptr))
+    {
+        if (paramTransparency)
+            params.transparencyAndComposition =
+                ffxmGetResourceDX12(paramTransparency, FFXM_RESOURCE_STATE_COMPUTE_READ, L"ASR_Transparency");
+
+        if (paramReactive)
+        {
+            params.reactive = ffxmGetResourceDX12(paramReactive, FFXM_RESOURCE_STATE_COMPUTE_READ, L"ASR_Reactive");
+        }
+        else if (paramBiasMask)
+        {
+            cfg.DisableReactiveMask.set_volatile_value(false);
+
+            if (cfg.MaskResourceBarrier.has_value())
+            {
+                ResourceBarrier(InCommandList, paramBiasMask, (D3D12_RESOURCE_STATES) cfg.MaskResourceBarrier.value(),
+                                readState);
+                biasMaskTransitioned = true;
+            }
+
+            if (paramTransparency == nullptr && cfg.FsrUseMaskForTransparency.value_or_default())
+                params.transparencyAndComposition =
+                    ffxmGetResourceDX12(paramBiasMask, FFXM_RESOURCE_STATE_COMPUTE_READ, L"ASR_Transparency");
+
+            if (cfg.DlssReactiveMaskBias.value_or_default() > 0.0f && Bias->IsInit() &&
+                Bias->CreateBufferResource(Device, paramBiasMask, D3D12_RESOURCE_STATE_UNORDERED_ACCESS) &&
+                Bias->CanRender())
+            {
+                Bias->SetBufferState(InCommandList, D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
+                if (Bias->Dispatch(InCommandList, paramBiasMask, cfg.DlssReactiveMaskBias.value_or_default(),
+                                   Bias->Buffer()))
+                {
+                    Bias->SetBufferState(InCommandList, readState);
+                    params.reactive = ffxmGetResourceDX12(Bias->Buffer(), FFXM_RESOURCE_STATE_COMPUTE_READ, L"ASR_Reactive");
+                }
+            }
+        }
+    }
+
+    // ------------------------------------------------------------------ output
+    const auto od = paramOutput->GetDesc();
+    const bool direct = (od.Flags & D3D12_RESOURCE_FLAG_ALLOW_RENDER_TARGET) && !IsSrgb(od.Format) &&
+                        od.Width >= TargetWidth() && od.Height >= TargetHeight();
+
+    ID3D12Resource* asrOutput = paramOutput;
+    if (direct)
+    {
+        ResourceBarrier(InCommandList, paramOutput, outputState, D3D12_RESOURCE_STATE_RENDER_TARGET);
+    }
+    else
+    {
+        if (!EnsureOutputBuffer(paramOutput))
+        {
+            ResourceBarrier(InCommandList, paramColor, readState, colorState);
+            if (paramDepth)
+                ResourceBarrier(InCommandList, paramDepth, readState, depthState);
+            ResourceBarrier(InCommandList, paramVelocity, readState, mvState);
+            return false;
+        }
+        asrOutput = _outputBuffer; // lives in RENDER_TARGET between frames
+    }
+    params.output = ffxmGetResourceDX12(asrOutput, FFXM_RESOURCE_STATE_PIXEL_WRITE, L"ASR_Output");
+
+    _hasColor = true;
+    _hasMV = true;
+    _hasDepth = paramDepth != nullptr;
+    _hasExposure = params.exposure.resource != nullptr;
+    _hasTM = params.transparencyAndComposition.resource != nullptr;
+    _accessToReactiveMask = paramReactive != nullptr;
+    _hasOutput = true;
+
+    // ------------------------------------------------------------------ params
+    InParameters->Get(NVSDK_NGX_Parameter_Jitter_Offset_X, &params.jitterOffset.x);
+    InParameters->Get(NVSDK_NGX_Parameter_Jitter_Offset_Y, &params.jitterOffset.y);
+
+    // FSR2's convention, which NGX shares: vectors point from the current pixel
+    // to where it was, in texture units that MV_Scale turns into pixels. ASR
+    // divides by the render (or, for display-res vectors, display) size itself.
+    params.motionVectorScale = { 1.0f, 1.0f };
+    if (InParameters->Get(NVSDK_NGX_Parameter_MV_Scale_X, &params.motionVectorScale.x) != NVSDK_NGX_Result_Success ||
+        InParameters->Get(NVSDK_NGX_Parameter_MV_Scale_Y, &params.motionVectorScale.y) != NVSDK_NGX_Result_Success)
+    {
+        params.motionVectorScale = { 1.0f, 1.0f };
+        if (_frameCount == 0)
+            LOG_WARN("Arm ASR: no motion vector scale supplied, assuming 1");
+    }
+
+    params.renderSize = { renderWidth, renderHeight };
+
+    // Sharpening runs as OptiScaler's RCAS after the upscale (see
+    // IFeature_Dx12::Evaluate); ASR's own sharpened passes are not built.
+    params.enableSharpening = false;
+    params.sharpness = 0.0f;
+
+    int reset = 0;
+    InParameters->Get(NVSDK_NGX_Parameter_Reset, &reset);
+    params.reset = reset != 0;
+
+    GetCamera(InParameters, &params.cameraNear, &params.cameraFar, &params.cameraFovAngleVertical);
+    params.viewSpaceToMetersFactor = 1.0f;
+
+    if (!cfg.FsrUseFsrInputValues.value_or_default() ||
+        InParameters->Get("FSR.frameTimeDelta", &params.frameTimeDelta) != NVSDK_NGX_Result_Success)
+    {
+        if (InParameters->Get(NVSDK_NGX_Parameter_FrameTimeDeltaInMsec, &params.frameTimeDelta) !=
+                NVSDK_NGX_Result_Success ||
+            params.frameTimeDelta < 1.0f)
+            params.frameTimeDelta = (float) GetDeltaTime();
+    }
+
+    if (InParameters->Get(NVSDK_NGX_Parameter_DLSS_Pre_Exposure, &params.preExposure) != NVSDK_NGX_Result_Success ||
+        params.preExposure <= 0.0f)
+        params.preExposure = 1.0f;
+
+    if (_frameCount == 0)
+        LOG_INFO("Arm ASR: MV scale ({}, {}), camera near {} far {} vfov {} rad, preExposure {}, output {}",
+                 params.motionVectorScale.x, params.motionVectorScale.y, params.cameraNear, params.cameraFar,
+                 params.cameraFovAngleVertical, params.preExposure, direct ? "direct" : "via copy");
+
+    // ---------------------------------------------------------------- dispatch
+    if (_timingEnabled)
+        InCommandList->EndQuery(_timestampHeap, D3D12_QUERY_TYPE_TIMESTAMP, _timingSlot * 2);
+
+    auto err = ffxmFsr2ContextDispatch(_context->ctx.get(), &params);
+
+    if (_timingEnabled)
+        InCommandList->EndQuery(_timestampHeap, D3D12_QUERY_TYPE_TIMESTAMP, _timingSlot * 2 + 1);
+
+    if (err != FFXM_OK)
+        LOG_ERROR("Arm ASR: ffxmFsr2ContextDispatch: {}", ErrorName(err));
+
+    // ------------------------------------------------------------ output copy
+    if (direct)
+    {
+        ResourceBarrier(InCommandList, paramOutput, D3D12_RESOURCE_STATE_RENDER_TARGET, outputState);
+    }
+    else if (err == FFXM_OK)
+    {
+        ResourceBarrier(InCommandList, _outputBuffer, D3D12_RESOURCE_STATE_RENDER_TARGET,
+                        D3D12_RESOURCE_STATE_COPY_SOURCE);
+        ResourceBarrier(InCommandList, paramOutput, outputState, D3D12_RESOURCE_STATE_COPY_DEST);
+
+        D3D12_TEXTURE_COPY_LOCATION dst {};
+        dst.pResource = paramOutput;
+        dst.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+        D3D12_TEXTURE_COPY_LOCATION src {};
+        src.pResource = _outputBuffer;
+        src.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+        D3D12_BOX box { 0, 0, 0, std::min<UINT>(TargetWidth(), (UINT) od.Width), std::min<UINT>(TargetHeight(), od.Height), 1 };
+        InCommandList->CopyTextureRegion(&dst, 0, 0, 0, &src, &box);
+
+        ResourceBarrier(InCommandList, paramOutput, D3D12_RESOURCE_STATE_COPY_DEST, outputState);
+        ResourceBarrier(InCommandList, _outputBuffer, D3D12_RESOURCE_STATE_COPY_SOURCE,
+                        D3D12_RESOURCE_STATE_RENDER_TARGET);
+    }
+
+    // ------------------------------------------------------ restore the inputs
+    ResourceBarrier(InCommandList, paramColor, readState, colorState);
+    if (paramDepth)
+        ResourceBarrier(InCommandList, paramDepth, readState, depthState);
+    ResourceBarrier(InCommandList, paramVelocity, readState, mvState);
+    if (paramExp && cfg.ExposureResourceBarrier.has_value())
+        ResourceBarrier(InCommandList, paramExp, readState, (D3D12_RESOURCE_STATES) cfg.ExposureResourceBarrier.value());
+    if (biasMaskTransitioned)
+        ResourceBarrier(InCommandList, paramBiasMask, readState, (D3D12_RESOURCE_STATES) cfg.MaskResourceBarrier.value());
+
+    if (_timingEnabled)
+        ResolveTiming(InCommandList);
+
+    if (err != FFXM_OK)
+        return false;
+
+    _frameCount++;
+    return true;
+}
+
+ASRFeatureDx12::~ASRFeatureDx12()
+{
+    if (State::Instance().isShuttingDown)
+        return;
+
+    TickRetired(true);
+    if (_context)
+        DestroyContext(*_context);
+    _context.reset();
+
+    if (_outputBuffer)
+        _outputBuffer->Release();
+    if (_timestampHeap)
+        _timestampHeap->Release();
+    if (_timestampReadback)
+        _timestampReadback->Release();
+}
