diff --git a/OptiScaler/upscalers/asr/ASRFeature.cpp b/OptiScaler/upscalers/asr/ASRFeature.cpp
new file mode 100644
index 00000000..2e401ed9
--- /dev/null
+++ b/OptiScaler/upscalers/asr/ASRFeature.cpp
@@ -0,0 +1,123 @@
+#include "pch.h"
+#include "ASRFeature.h"
+#include "ffxm_dx12.h"
+
+#include <Config.h>
+#include <MathUtils.h>
+
+using namespace OptiMath;
+
+ASRFeature::ASRFeature(unsigned int InHandleId, NVSDK_NGX_Parameter* InParameters) : IFeature(InHandleId, InParameters)
+{
+    // Pull render/display size and init flags out of the NGX parameters, as
+    // every feature base must; see the note in SGSR2Feature.
+    _initParameters = SetInitParameters(InParameters);
+    _moduleLoaded = arm::ffxmDX12HasShaders();
+    _lastFrameTime = Util::MillisecondsNow();
+
+    if (!_moduleLoaded)
+        LOG_ERROR("Arm ASR: this build carries no ASR shaders (gen_asr_shaders.py did not run)");
+}
+
+bool ASRFeature::ModuleLoaded() { return _moduleLoaded; }
+
+double ASRFeature::GetDeltaTime()
+{
+    const double now = Util::MillisecondsNow();
+    const double delta = now - _lastFrameTime;
+    _lastFrameTime = now;
+    return delta;
+}
+
+arm::FfxmFsr2ShaderQualityMode ASRFeature::ConfiguredQuality()
+{
+    switch (Config::Instance()->AsrShaderQuality.value_or_default())
+    {
+    case AsrQuality::Quality:
+        return arm::FFXM_FSR2_SHADER_QUALITY_MODE_QUALITY;
+    case AsrQuality::Performance:
+        return arm::FFXM_FSR2_SHADER_QUALITY_MODE_PERFORMANCE;
+    default:
+        return arm::FFXM_FSR2_SHADER_QUALITY_MODE_BALANCED;
+    }
+}
+
+const char* ASRFeature::QualityName(arm::FfxmFsr2ShaderQualityMode quality)
+{
+    switch (quality)
+    {
+    case arm::FFXM_FSR2_SHADER_QUALITY_MODE_QUALITY:
+        return "quality";
+    case arm::FFXM_FSR2_SHADER_QUALITY_MODE_PERFORMANCE:
+        return "performance";
+    default:
+        return "balanced";
+    }
+}
+
+uint32_t ASRFeature::ContextFlags()
+{
+    uint32_t flags = 0;
+
+    if (DepthInverted())
+        flags |= arm::FFXM_FSR2_ENABLE_DEPTH_INVERTED;
+
+    if (AutoExposure())
+        flags |= arm::FFXM_FSR2_ENABLE_AUTO_EXPOSURE;
+
+    if (IsHdr())
+        flags |= arm::FFXM_FSR2_ENABLE_HIGH_DYNAMIC_RANGE;
+
+    if (JitteredMV())
+        flags |= arm::FFXM_FSR2_ENABLE_MOTION_VECTORS_JITTER_CANCELLATION;
+
+    // NGX MVLowRes unset: the vectors are at display resolution and in display
+    // pixels. ASR handles that natively (it is FSR2's display-res MV path), so
+    // unlike SGSR2 there is nothing to rescale here.
+    if (!LowResMV())
+        flags |= arm::FFXM_FSR2_ENABLE_DISPLAY_RESOLUTION_MOTION_VECTORS;
+
+#if _DEBUG
+    flags |= arm::FFXM_FSR2_ENABLE_DEBUG_CHECKING;
+#endif
+
+    return flags;
+}
+
+void ASRFeature::GetCamera(NVSDK_NGX_Parameter* InParameters, float* cameraNear, float* cameraFar, float* fovVertical)
+{
+    auto& cfg = *Config::Instance();
+
+    *cameraNear = 0.0f;
+    *cameraFar = 0.0f;
+
+    if (!cfg.FsrUseFsrInputValues.value_or_default() ||
+        InParameters->Get("FSR.cameraNear", cameraNear) != NVSDK_NGX_Result_Success)
+    {
+        if (DepthInverted())
+            *cameraFar = cfg.FsrCameraNear.value_or_default();
+        else
+            *cameraNear = cfg.FsrCameraNear.value_or_default();
+    }
+
+    if (!cfg.FsrUseFsrInputValues.value_or_default() ||
+        InParameters->Get(OptiKeys::FSR_FarPlane, cameraFar) != NVSDK_NGX_Result_Success)
+    {
+        if (DepthInverted())
+            *cameraNear = cfg.FsrCameraFar.value_or_default();
+        else
+            *cameraFar = cfg.FsrCameraFar.value_or_default();
+    }
+
+    if (!cfg.FsrUseFsrInputValues.value_or_default() ||
+        InParameters->Get(OptiKeys::FSR_CameraFovVertical, fovVertical) != NVSDK_NGX_Result_Success)
+    {
+        if (cfg.FsrVerticalFov.has_value())
+            *fovVertical = GetRadiansFromDeg(cfg.FsrVerticalFov.value());
+        else if (cfg.FsrHorizontalFov.value_or_default() > 0.0f)
+            *fovVertical = GetVerticalFovFromHorizontal(GetRadiansFromDeg(cfg.FsrHorizontalFov.value()),
+                                                        (float) TargetWidth(), (float) TargetHeight());
+        else
+            *fovVertical = GetRadiansFromDeg(60);
+    }
+}
diff --git a/OptiScaler/upscalers/asr/ASRFeature.h b/OptiScaler/upscalers/asr/ASRFeature.h
new file mode 100644
index 00000000..b49cff42
--- /dev/null
+++ b/OptiScaler/upscalers/asr/ASRFeature.h
@@ -0,0 +1,51 @@
+#pragma once
+
+#include <upscalers/IFeature.h>
+
+#include <host/ffxm_fsr2.h>
+
+//============================================================================================================
+// Arm Accuracy Super Resolution -- shared, API-independent bits.
+//
+// Arm ASR (MIT) is AMD's FSR 2.2.2 reworked for mobile GPUs: most passes are
+// full-screen fragment shaders, fp16 throughout, and a shader "quality" preset
+// that is independent of the upscaling ratio. Arm only ships a Vulkan backend;
+// ffxm_dx12.cpp is the D3D12 one this port uses, fed DXIL that
+// arm64ec/gen_asr_shaders.py compiles from ASR's own HLSL at build time.
+//
+// The host API is FSR2's, so the inputs follow OptiScaler's FSR2 backends:
+// NGX motion vectors go in as-is with MV_Scale as motionVectorScale, and the
+// NGX init flags map onto the FSR2 context flags one to one.
+//============================================================================================================
+
+class ASRFeature : public virtual IFeature
+{
+  private:
+    double _lastFrameTime = 0.0;
+
+  protected:
+    double GetDeltaTime();
+
+    // Config [ASR] ShaderQuality -> ffxm preset.
+    static arm::FfxmFsr2ShaderQualityMode ConfiguredQuality();
+    static const char* QualityName(arm::FfxmFsr2ShaderQualityMode quality);
+
+    // Context flags from the NGX init flags.
+    uint32_t ContextFlags();
+
+    // Camera near/far/vertical FOV from the FSR input keys or the [FSR] config
+    // fallbacks, exactly as OptiScaler's FSR2 backends take them.
+    void GetCamera(NVSDK_NGX_Parameter* InParameters, float* cameraNear, float* cameraFar, float* fovVertical);
+
+  public:
+    // Arm ASR release 25.06 (FSR 2.2.2 derivative).
+    feature_version Version() override { return feature_version { 25, 6, 0 }; }
+    Upscaler GetUpscalerType() const override { return Upscaler::ASR; }
+
+    // Shader-only, nothing to load at runtime -- but a build made without the
+    // shader generator (no DXC) has no blobs, and FeatureProvider falls back
+    // when this is false.
+    bool ModuleLoaded() override;
+
+    ASRFeature(unsigned int InHandleId, NVSDK_NGX_Parameter* InParameters);
+};
