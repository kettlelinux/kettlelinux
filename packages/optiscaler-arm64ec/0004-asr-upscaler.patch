+++ b/OptiScaler.ini
@@ -2,11 +2,11 @@
 [Upscalers]
 ; -------------------------------------------------------
 ; Select Upscaler for Dx11 games
-; fsr22 (native DX11), fsr31 (native DX11), xess (native DX11, Arc only), xess_12 (dx11on12), fsr21_12 (dx11on12), fsr22_12 (dx11on12), ffx_12 (FSR 2.3; 3.1; 4.x), sgsr2_12 (dx11on12), dlss - Default (auto) is fsr22
+; fsr22 (native DX11), fsr31 (native DX11), xess (native DX11, Arc only), xess_12 (dx11on12), fsr21_12 (dx11on12), fsr22_12 (dx11on12), ffx_12 (FSR 2.3; 3.1; 4.x), sgsr2_12 (dx11on12), asr_12 (Arm ASR, dx11on12), dlss - Default (auto) is fsr22
