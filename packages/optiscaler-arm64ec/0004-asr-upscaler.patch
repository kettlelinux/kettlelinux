+
+std::string AsrQualityToCode(AsrQuality quality)
+{
+    switch (quality)
+    {
+    case AsrQuality::Quality:
+        return "quality";
+    case AsrQuality::Balanced:
+        return "balanced";
+    case AsrQuality::Performance:
+        return "performance";
+    default:
+        return "";
+    }
+}
+
+AsrQuality CodeToAsrQuality(const std::string& code)
+{
+    static const std::unordered_map<std::string, AsrQuality> mapping = {
+        { "quality", AsrQuality::Quality },
+        { "balanced", AsrQuality::Balanced },
+        { "performance", AsrQuality::Performance },
+    };
+
+    auto it = mapping.find(code);
+    return (it != mapping.end()) ? it->second : AsrQuality::Balanced;
+}
