@@ -0,0 +1,243 @@
+#!/usr/bin/env python3
+"""Generate FSR2 2.2.1 DX12 shader permutation headers with Linux dxc.
+
+A stand-in for AMD's FidelityFX_SC.exe (tools/sc in the FSR2 repo), which is a
+Windows binary: this drives Microsoft's DirectXShaderCompiler directly and
+writes headers in SC's layout, so dx12/shaders/ffx_fsr2_shaders_dx12.cpp builds
+against them unchanged:
+
+  <name>_permutations.h   ffx_<pass>_PermutationKey (a bitfield union over the
+                          permutation defines, first define = bit 0),
+                          <name>_PermutationInfo, g_<name>_IndirectionTable
+                          (permutation index -> blob) and
+                          g_<name>_PermutationInfo (one entry per unique blob)
+  <name>_<md5>.h          one DXIL blob with its reflected CBV/SRV/UAV/sampler
+                          names, registers, counts and spaces
+
+The compile arguments are exactly those FSR2's CMake hands SC (src/ffx-fsr2-api
+/CMakeLists.txt and dx12/CMakeLists.txt): same defines, entry point, profiles
+and warning switches. SC's own switches (-reflection, -deps, -name, -output)
+are what this script implements. Identical blobs are shared, as SC does; the
+blob file names are the MD5 of the DXIL rather than SC's hash, which nothing
+outside these headers refers to.
+
+Resource reflection is read from dxc's disassembly (-Fc), whose "Resource
+Bindings" table lists the resources that survive optimisation -- the same set
+ID3D12ShaderReflection reports, which is what SC emits.
+
+Checked against SC 1.6.2112 under wine with dxc v1.9.2607: all 30 headers give
+the same permutation -> blob grouping (218 unique blobs), the same reflected
+resources in the same order, and identical disassembly metadata (signatures,
+cbuffer layouts, bindings, thread group and wave sizes, required features);
+the code differs only by optimiser version. dxc 1.9's built-in validator signs
+the container, so libdxil.so is not needed.
+
+Usage: gen_fsr2_shaders.py --dxc DXC --fsr2 FidelityFX-FSR2 --out DIR [-j N]
+"""
+import argparse
+import concurrent.futures as cf
+import hashlib
+import os
+import re
+import subprocess
+import sys
+import tempfile
+
+PASSES = ["tcr_autogen", "autogen_reactive", "accumulate", "compute_luminance_pyramid",
+          "depth_clip", "lock", "reconstruct_previous_depth", "rcas"]
+
+# FFX_SC_BASE_ARGS minus SC's own -reflection/-deps, plus FFX_SC_DX12_BASE_ARGS.
+BASE = ["-DFFX_GPU=1",
+        "-DFFX_FSR2_OPTION_UPSAMPLE_SAMPLERS_USE_DATA_HALF=0",
+        "-DFFX_FSR2_OPTION_ACCUMULATE_SAMPLERS_USE_DATA_HALF=0",
+        "-DFFX_FSR2_OPTION_REPROJECT_SAMPLERS_USE_DATA_HALF=1",
+        "-DFFX_FSR2_OPTION_POSTPROCESSLOCKSTATUS_SAMPLERS_USE_DATA_HALF=0",
+        "-DFFX_FSR2_OPTION_UPSAMPLE_USE_LANCZOS_TYPE=2",
+        "-E", "CS", "-Wno-for-redefinition", "-Wno-ambig-lit-shift",
+        "-DFFX_HLSL=1", "-DFFX_HLSL_6_2=1"]
+
+# FFX_SC_PERMUTATION_ARGS, in order: define i is bit i of the permutation index.
+PERMUTATION_DEFINES = ["FFX_FSR2_OPTION_REPROJECT_USE_LANCZOS_TYPE",
+                       "FFX_FSR2_OPTION_HDR_COLOR_INPUT",
+                       "FFX_FSR2_OPTION_LOW_RESOLUTION_MOTION_VECTORS",
+                       "FFX_FSR2_OPTION_JITTERED_MOTION_VECTORS",
+                       "FFX_FSR2_OPTION_INVERTED_DEPTH",
+                       "FFX_FSR2_OPTION_APPLY_SHARPENING"]
+
+WAVE64 = "-DFFX_FSR2_PREFER_WAVE64=[WaveSize(64)]"
+# (name suffix, extra args), as in dx12/CMakeLists.txt. The luminance pyramid
+# pass has no 16-bit variants.
+VARIANTS = [("",              ["-DFFX_HALF=0", "-T", "cs_6_2"]),
+            ("_wave64",       [WAVE64, "-DFFX_HALF=0", "-T", "cs_6_6"]),
+            ("_16bit",        ["-DFFX_HALF=1", "-enable-16bit-types", "-T", "cs_6_2"]),
+            ("_wave64_16bit", [WAVE64, "-DFFX_HALF=1", "-enable-16bit-types", "-T", "cs_6_6"])]
+
+CLASSES = ["CBV", "SRV", "UAV", "Sampler", "RTAccelerationStructure"]
+FIELD_PREFIX = {"CBV": "cbv", "SRV": "srv", "UAV": "uav", "Sampler": "sampler",
+                "RTAccelerationStructure": "rtAccelerationStructure"}
+BIND = re.compile(r"^([a-z]+)(\d+)(?:,space(\d+))?$")
+
+
+def reflect(asm):
+    """Resources per class from dxc's "Resource Bindings" table, in its order.
+
+    Rows are "; name type format dim id bind count". The type and format
+    columns can run into each other ("texture" + "unorm_f32" prints as
+    "textureunorm_f32"), so the row is read from both ends: the name first, then
+    dim, ID, bind point and count from the right. The class comes from the ID's
+    prefix (CB, T, U, S), with dim "ras" marking an acceleration structure."""
+    res = {c: [] for c in CLASSES}
+    lines = asm.splitlines()
+    try:
+        start = lines.index("; Resource Bindings:")
+    except ValueError:
+        return res
+    rows = 0
+    for line in lines[start + 1:]:
+        tok = line[1:].split()
+        if not line.startswith(";") or (not tok and rows):
+            break  # the blank ";" after the last row ends the table
+        if len(tok) < 6 or tok[0] == "Name" or tok[0].startswith("---"):
+            continue
+        rows += 1
+        name, dim, rid, bind, count = tok[0], tok[-4], tok[-3], tok[-2], tok[-1]
+        m, k = BIND.match(bind), re.match(r"^(CB|T|U|S)\d+$", rid)
+        if not m or not k:
+            raise RuntimeError("unparsed resource binding row: %r" % line)
+        c = {"CB": "CBV", "T": "SRV", "U": "UAV", "S": "Sampler"}[k.group(1)]
+        if dim == "ras":
+            c = "RTAccelerationStructure"
+        # D3D reflection reports an unbounded array as count 0.
+        res[c].append((name, int(m.group(2)), 0 if count == "unbounded" else int(count),
+                       int(m.group(3) or 0)))
+    return res
+
+
+def compile_one(dxc, src, inc, args, tmpdir, tag):
+    fo = os.path.join(tmpdir, tag + ".dxil")
+    fc = os.path.join(tmpdir, tag + ".asm")
+    cmd = [dxc] + args + ["-I", inc, "-Fo", fo, "-Fc", fc, src]
+    p = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
+    if p.returncode != 0:
+        raise RuntimeError("dxc failed (%s):\n%s\n%s" % (tag, " ".join(cmd), p.stdout))
+    with open(fo, "rb") as f:
+        blob = f.read()
+    with open(fc) as f:
+        asm = f.read()
+    return blob, reflect(asm), p.stdout
+
+
+def blob_header(sym, blob, res):
+    out = ["// %s.h.\n// Auto generated by gen_fsr2_shaders.py (dxc) in the FidelityFX-SC format.\n\n" % sym[2:]]
+    for c in CLASSES:
+        r = res[c]
+        if not r:
+            continue
+        out.append("static const char* %s_%sResourceNames[] = {  %s };\n"
+                   % (sym, c, " ".join('"%s",' % n for n, _, _, _ in r)))
+        for field, i in (("Bindings", 1), ("Counts", 2), ("Spaces", 3)):
+            out.append("static const uint32_t %s_%sResource%s[] = {  %s };\n"
+                       % (sym, c, field, " ".join("%d," % x[i] for x in r)))
+        out.append("\n")
+    out.append("static const uint32_t %s_size = %d;\n\n" % (sym, len(blob)))
+    out.append("static const unsigned char %s_data[] = {\n" % sym)
+    for i in range(0, len(blob), 16):
+        out.append(",".join("0x%02x" % b for b in blob[i:i + 16]))
+        out.append(",\n" if i + 16 < len(blob) else "\n")
+    out.append("};\n\n")
+    return "".join(out)
+
+
+def permutations_header(name, blob_syms, table, infos):
+    out = []
+    for sym in blob_syms:
+        out.append('#include "%s.h"\n' % sym[2:])
+    out.append("\ntypedef union %s_PermutationKey {\n    struct {\n" % name)
+    for d in PERMUTATION_DEFINES:
+        out.append("        uint32_t %s : 1;\n" % d)
+    out.append("    };\n    uint32_t index;\n} %s_PermutationKey;\n\n" % name)
+    out.append("typedef struct %s_PermutationInfo {\n"
+               "    const uint32_t       blobSize;\n"
+               "    const unsigned char* blobData;\n\n" % name)
+    for c in CLASSES:
+        lc = FIELD_PREFIX[c]
+        out.append("\n    const uint32_t  num%sResources;\n" % c)
+        for f in ("Names", "Bindings", "Counts", "Spaces"):
+            t = "const char**   " if f == "Names" else "const uint32_t*"
+            out.append("    %s %sResource%s;\n" % (t, lc, f))
+    out.append("} %s_PermutationInfo;\n\n" % name)
+    out.append("static const uint32_t g_%s_IndirectionTable[] = {\n" % name)
+    out.extend("    %d,\n" % i for i in table)
+    out.append("};\n\n")
+    out.append("static const %s_PermutationInfo g_%s_PermutationInfo[] = {\n" % (name, name))
+    for sym, res in zip(blob_syms, infos):
+        fields = ["%s_size" % sym, "%s_data" % sym]
+        for c in CLASSES:
+            if res[c]:
+                fields += [str(len(res[c]))] + ["%s_%sResource%s" % (sym, c, f)
+                                                for f in ("Names", "Bindings", "Counts", "Spaces")]
+            else:
+                fields += ["0"] * 5
+        out.append("    { %s, },\n" % ", ".join(fields))
+    out.append("};\n\n")
+    return "".join(out)
+
+
+def main():
+    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
+    ap.add_argument("--dxc", default=os.environ.get("DXC", "dxc"))
+    ap.add_argument("--fsr2", required=True, help="FidelityFX-FSR2 v2.2.1 checkout")
+    ap.add_argument("--out", required=True)
+    ap.add_argument("-j", "--jobs", type=int, default=len(os.sched_getaffinity(0)))
+    ap.add_argument("--only", help="comma-separated header names (e.g. ffx_fsr2_rcas_pass_16bit)")
+    a = ap.parse_args()
+
+    inc = os.path.join(a.fsr2, "src", "ffx-fsr2-api", "shaders")
+    os.makedirs(a.out, exist_ok=True)
+    only = set(a.only.split(",")) if a.only else None
+    nblobs = nheaders = 0
+    unsigned_warned = False
+    with tempfile.TemporaryDirectory() as tmp, cf.ThreadPoolExecutor(a.jobs) as pool:
+        for p in PASSES:
+            base = "ffx_fsr2_%s_pass" % p
+            src = os.path.join(inc, base + ".hlsl")
+            for suffix, vargs in VARIANTS:
+                if p == "compute_luminance_pyramid" and "16bit" in suffix:
+                    continue
+                name = base + suffix
+                if only and name not in only:
+                    continue
+                jobs = []
+                for idx in range(1 << len(PERMUTATION_DEFINES)):
+                    perm = ["-D%s=%d" % (d, (idx >> b) & 1) for b, d in enumerate(PERMUTATION_DEFINES)]
+                    args = BASE + perm + vargs
+                    jobs.append(pool.submit(compile_one, a.dxc, src, inc, args, tmp, "%s_%d" % (name, idx)))
+                uniq = {}          # md5 -> position in PermutationInfo
+                syms, infos, table = [], [], []
+                for idx, j in enumerate(jobs):
+                    blob, res, log = j.result()
+                    if "warning" in log and idx == 0:
+                        sys.stderr.write(log)
+                    if blob[4:20] == bytes(16) and not unsigned_warned:
+                        # Windows' D3D12 rejects unsigned DXIL; vkd3d-proton does not check.
+                        sys.stderr.write("warning: dxc emitted unsigned DXIL (zero container hash)\n")
+                        unsigned_warned = True
+                    h = hashlib.md5(blob).hexdigest()
+                    if h not in uniq:
+                        uniq[h] = len(syms)
+                        sym = "g_%s_%s" % (name, h)
+                        syms.append(sym)
+                        infos.append(res)
+                        with open(os.path.join(a.out, "%s_%s.h" % (name, h)), "w") as f:
+                            f.write(blob_header(sym, blob, res))
+                    table.append(uniq[h])
+                with open(os.path.join(a.out, name + "_permutations.h"), "w") as f:
+                    f.write(permutations_header(name, syms, table, infos))
+                print("%s: %d permutations, %d unique" % (name, len(table), len(syms)))
+                nblobs += len(syms)
+                nheaders += 1
+    print("permutation headers: %d  blobs: %d" % (nheaders, nblobs))
+
+
+if __name__ == "__main__":
+    main()
diff --git a/arm64ec/gen_fsr2_shaders.sh b/arm64ec/gen_fsr2_shaders.sh
