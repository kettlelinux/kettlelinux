From: gennro <gennro2004@gmail.com>
Subject: [PATCH] input: qcom-hv-haptics: no rsinput playback while suspended or removed

The rsinput playback work (20-sm8550/1005) was cancelled at suspend, but
a request made after that queued it again and it drove the hardware of
a suspended device. Mark the device suspended under the playback lock
before cancelling the work; requests made meanwhile are dropped and the
work stops early. Resume, restore and a failed suspend clear the mark.

remove() cleared global_haptics without any lock against callers that
had already read it, then cancelled the work, so a playback could queue
work on, or an upload use, a chip being freed. Guard the pointer with a
mutex (upload, set_gain) and a spinlock (playback, which is called under
the input event lock), clear it under both, then cancel the work.

Also give haptics_get_status_data()'s name a default and the sweep_run
error message its missing argument (W=1 warnings).

On the SM8750 driver revision (20-sm8550/1000), whose rsinput pointer is
phapchip: resume clears the mark before its runtime PM return, and its
sweep_run message already had the argument.
---
diff --git a/drivers/input/misc/qcom-hv-haptics.c b/drivers/input/misc/qcom-hv-haptics.c
index c20d333e9..4032df804 100644
--- a/drivers/input/misc/qcom-hv-haptics.c
+++ b/drivers/input/misc/qcom-hv-haptics.c
@@ -796,6 +796,7 @@ struct haptics_chip {
 	struct work_struct		global_playback_work;
 	spinlock_t			global_playback_lock;
 	u32				global_playback_seq;
+	bool				global_suspended;
 	int				global_effect_id;
 	int				global_playback_val;
 	volatile bool			chip_effect_loaded;
@@ -864,6 +865,13 @@ static const struct fifo_hw_info hap530_fifo = {
 };
 
 static struct haptics_chip *phapchip;
+/*
+ * Guard phapchip against remove(): the mutex for the sleeping
+ * upload/set_gain callers, the spinlock for playback (called under the
+ * input event lock).
+ */
+static DEFINE_MUTEX(phapchip_mutex);
+static DEFINE_SPINLOCK(phapchip_lock);
 static void haptics_global_playback_work(struct work_struct *work);
 
 bool qcom_haptics_vi_sense_is_enabled(void)
@@ -1176,7 +1184,7 @@ static int haptics_get_status_data(struct haptics_chip *chip,
 		"RNAT_RCAL_INT",
 		"BRAKE_CAL_SCALAR",
 	};
-	const char *name;
+	const char *name = "UNKNOWN_STS";
 
 	mod_sel_val[0] = sel & 0xff;
 	mod_sel_val[1] = (sel >> 8) & 0xff;
@@ -6535,7 +6543,11 @@ static int haptics_probe(struct platform_device *pdev)
 //		dev_err(chip->dev, "Creating debugfs failed, rc=%d\n", rc);
 
 	haptics_runtime_autosuspend(chip);
+	mutex_lock(&phapchip_mutex);
+	spin_lock_irq(&phapchip_lock);
 	phapchip = chip;
+	spin_unlock_irq(&phapchip_lock);
+	mutex_unlock(&phapchip_mutex);
 	return 0;
 
 remove_v_gain_error:
@@ -6547,12 +6559,34 @@ static int haptics_probe(struct platform_device *pdev)
 	return rc;
 }
 
+/*
+ * Stop the global (rsinput) playback work from touching the hardware
+ * while the device is suspended or going away; requests made meanwhile
+ * are dropped.
+ */
+static void haptics_global_suspend(struct haptics_chip *chip, bool suspend)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&chip->global_playback_lock, flags);
+	chip->global_suspended = suspend;
+	spin_unlock_irqrestore(&chip->global_playback_lock, flags);
+
+	if (suspend)
+		cancel_work_sync(&chip->global_playback_work);
+}
+
 static void haptics_remove(struct platform_device *pdev)
 {
 	struct haptics_chip *chip = dev_get_drvdata(&pdev->dev);
 
-	phapchip = NULL;
-	cancel_work_sync(&chip->global_playback_work);
+	mutex_lock(&phapchip_mutex);
+	spin_lock_irq(&phapchip_lock);
+	if (phapchip == chip)
+		phapchip = NULL;
+	spin_unlock_irq(&phapchip_lock);
+	mutex_unlock(&phapchip_mutex);
+	haptics_global_suspend(chip, true);
 	if (chip->pbs_node)
 		of_node_put(chip->pbs_node);
 
@@ -6610,7 +6644,7 @@ static int haptics_suspend_config(struct device *dev)
 	struct haptics_play_info *play = &chip->play;
 	int rc;
 
-	cancel_work_sync(&chip->global_playback_work);
+	haptics_global_suspend(chip, true);
 	cancel_delayed_work_sync(&chip->stop_work);
 
 	mutex_lock(&play->lock);
@@ -6687,8 +6721,10 @@ static int __maybe_unused haptics_suspend(struct device *dev)
 		return 0;
 
 	rc = haptics_suspend_config(dev);
-	if (rc < 0)
+	if (rc < 0) {
+		haptics_global_suspend(chip, false);
 		return rc;
+	}
 
 	return 0;
 }
@@ -6696,7 +6732,10 @@ static int __maybe_unused haptics_suspend(struct device *dev)
 static int __maybe_unused haptics_resume(struct device *dev)
 {
 	struct haptics_chip *chip = dev_get_drvdata(dev);
-	
+
+	/* before the runtime PM return: haptics_suspend() marks it either way */
+	haptics_global_suspend(chip, false);
+
 	if (is_haptics_runtime_pm_enabled(chip))
 		return 0;
 
@@ -6708,8 +6747,10 @@ static int __maybe_unused haptics_freeze(struct device *dev)
 	int rc = 0;
 
 	rc = haptics_suspend_config(dev);
-	if (rc < 0)
+	if (rc < 0) {
+		haptics_global_suspend(dev_get_drvdata(dev), false);
 		return rc;
+	}
 
 	haptics_ds_suspend_config(dev);
 
@@ -6721,6 +6762,8 @@ static int __maybe_unused haptics_restore(struct device *dev)
 	struct haptics_chip *chip = dev_get_drvdata(dev);
 	int rc = 0;
 
+	haptics_global_suspend(chip, false);
+
 	rc = haptics_ds_resume_config(dev);
 	if (rc < 0)
 		return rc;
@@ -6758,6 +6801,10 @@ static void haptics_global_playback_work(struct work_struct *work)
 	 */
 	do {
 		spin_lock_irqsave(&chip->global_playback_lock, flags);
+		if (chip->global_suspended) {
+			spin_unlock_irqrestore(&chip->global_playback_lock, flags);
+			return;
+		}
 		sequence = chip->global_playback_seq;
 		effect_id = chip->global_effect_id;
 		val = chip->global_playback_val;
@@ -6775,59 +6822,69 @@ static void haptics_global_playback_work(struct work_struct *work)
 				 val ? "playback" : "erase", ret);
 
 		spin_lock_irqsave(&chip->global_playback_lock, flags);
-		ret = sequence != chip->global_playback_seq;
+		ret = !chip->global_suspended &&
+		      sequence != chip->global_playback_seq;
 		spin_unlock_irqrestore(&chip->global_playback_lock, flags);
 	} while (ret);
 }
 
 int qcom_spmi_haptics_global_upload(struct ff_effect *effect)
 {
-	struct haptics_chip *chip = READ_ONCE(phapchip);
-	int ret;
-
-	if (!chip)
-		return -ENODEV;
+	struct haptics_chip *chip;
+	int ret = -ENODEV;
 
-	mutex_lock(&chip->global_ff_lock);
-	ret = haptics_upload_effect(chip->input_dev, effect, NULL);
-	mutex_unlock(&chip->global_ff_lock);
+	mutex_lock(&phapchip_mutex);
+	chip = phapchip;
+	if (chip) {
+		mutex_lock(&chip->global_ff_lock);
+		ret = haptics_upload_effect(chip->input_dev, effect, NULL);
+		mutex_unlock(&chip->global_ff_lock);
+	}
+	mutex_unlock(&phapchip_mutex);
 
 	return ret;
 }
 
 int qcom_spmi_haptics_global_playback(int effect_id, int val)
 {
-	struct haptics_chip *chip = READ_ONCE(phapchip);
+	struct haptics_chip *chip;
 	unsigned long flags;
+	int ret = -ENODEV;
+
+	spin_lock_irqsave(&phapchip_lock, flags);
+	chip = phapchip;
+	if (chip) {
+		spin_lock(&chip->global_playback_lock);
+		chip->global_effect_id = effect_id;
+		chip->global_playback_val = val;
+		chip->global_playback_seq++;
+		if (!chip->global_suspended)
+			schedule_work(&chip->global_playback_work);
+		spin_unlock(&chip->global_playback_lock);
+		ret = 0;
+	}
+	spin_unlock_irqrestore(&phapchip_lock, flags);
 
-	if (!chip)
-		return -ENODEV;
-
-	spin_lock_irqsave(&chip->global_playback_lock, flags);
-	chip->global_effect_id = effect_id;
-	chip->global_playback_val = val;
-	chip->global_playback_seq++;
-	spin_unlock_irqrestore(&chip->global_playback_lock, flags);
-
-	schedule_work(&chip->global_playback_work);
-	return 0;
+	return ret;
 }
 
 int qcom_spmi_haptics_global_set_gain(u16 gain)
 {
-	struct haptics_chip *chip = READ_ONCE(phapchip);
-
-	if (!chip)
-		return -ENODEV;
+	struct haptics_chip *chip;
 
 	//max is 0x7fff, and minimum is 0x4000 the same values android uses
 	gain = clamp(gain, 0x4000, 0x7fff);
 
-	mutex_lock(&chip->global_ff_lock);
-	haptics_set_gain(chip->input_dev, gain);
-	mutex_unlock(&chip->global_ff_lock);
+	mutex_lock(&phapchip_mutex);
+	chip = phapchip;
+	if (chip) {
+		mutex_lock(&chip->global_ff_lock);
+		haptics_set_gain(chip->input_dev, gain);
+		mutex_unlock(&chip->global_ff_lock);
+	}
+	mutex_unlock(&phapchip_mutex);
 
-	return 0;
+	return chip ? 0 : -ENODEV;
 }
 
 EXPORT_SYMBOL_GPL(qcom_spmi_haptics_global_upload);
