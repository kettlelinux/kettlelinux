+/*
+ * Power-cycle the MCU (off for a moment, then out of reset) and set it up.
+ * The writes landing proves nothing about an MCU still booting: it is up once
+ * it streams reports.
+ */
+static int gamepad_power_on(struct gamepad_device *dev)
+{
+	int ret;
+
+	reinit_completion(&dev->report_seen);
+
+	if (dev->boot_gpio)
+		gpiod_set_value_cansleep(dev->boot_gpio, 0);
+
+	if (dev->enable_gpio)
+		gpiod_set_value_cansleep(dev->enable_gpio, 0);
+
+	if (dev->reset_gpio)
+		gpiod_set_value_cansleep(dev->reset_gpio, 0);
+
+	msleep(100);
+
+	if (dev->enable_gpio)
+		gpiod_set_value_cansleep(dev->enable_gpio, 1);
+
+	if (dev->reset_gpio)
+		gpiod_set_value_cansleep(dev->reset_gpio, 1);
+
+	msleep(100);
+
+	ret = gamepad_send_init_sequence(dev->serdev);
+	if (ret)
+		return ret;
+
+	if (!wait_for_completion_timeout(&dev->report_seen,
+					 msecs_to_jiffies(MCU_REPORT_TIMEOUT_MS)))
+		return -ETIMEDOUT;
+
+	return 0;
+}
+
+/*
+ * Bring the MCU up from probe and resume: off the system resume path (it takes
+ * the better part of a second), and again later if it fails -- a pad left dead
+ * until the next suspend or reboot is worse than a late one.
+ */
+static void gamepad_init_work(struct work_struct *work)
+{
+	struct gamepad_device *dev = container_of(to_delayed_work(work),
+						  struct gamepad_device, init_work);
+	int ret;
+
+	ret = gamepad_power_on(dev);
+	if (!ret)
+		return;
+
+	if (++dev->init_attempts < MCU_INIT_MAX_ATTEMPTS)
+		schedule_delayed_work(&dev->init_work, msecs_to_jiffies(MCU_INIT_RETRY_MS));
+	else
+		dev_err(dev->dev, "MCU init failed, giving up: %d\n", ret);
+}
+
+static void gamepad_set_abs_ranges(struct input_dev *indev)
+{
+	input_set_abs_params(indev, ABS_X,
+		INT_SIGN(axis_leftx_min) * ( abs(axis_leftx_min) - axis_leftx_antideadzone ),
+		INT_SIGN(axis_leftx_max) * ( abs(axis_leftx_max) - axis_leftx_antideadzone ),
+		0, 0);
+	input_set_abs_params(indev, ABS_Y,
+		INT_SIGN(axis_lefty_min) * ( abs(axis_lefty_min) - axis_lefty_antideadzone ),
+		INT_SIGN(axis_lefty_max) * ( abs(axis_lefty_max) - axis_lefty_antideadzone ),
+		0, 0);
+	/*
+	 * Never reported, but advertised from the start: dropping them would
+	 * renumber the axes after them for SDL mappings and emulator configs.
+	 */
+	input_set_abs_params(indev, ABS_Z,
+		INT_SIGN(axis_leftz_min) * ( abs(axis_leftz_min) - axis_leftz_antideadzone ),
+		INT_SIGN(axis_leftz_max) * ( abs(axis_leftz_max) - axis_leftz_antideadzone ),
+		0, 0);
+	input_set_abs_params(indev, ABS_RX,
+		INT_SIGN(axis_rightx_min) * ( abs(axis_rightx_min) - axis_rightx_antideadzone ),
+		INT_SIGN(axis_rightx_max) * ( abs(axis_rightx_max) - axis_rightx_antideadzone ),
+		0, 0);
+	input_set_abs_params(indev, ABS_RY,
+		INT_SIGN(axis_righty_min) * ( abs(axis_righty_min) - axis_righty_antideadzone ),
+		INT_SIGN(axis_righty_max) * ( abs(axis_righty_max) - axis_righty_antideadzone ),
+		0, 0);
+	input_set_abs_params(indev, ABS_RZ,
+		INT_SIGN(axis_rightz_min) * ( abs(axis_rightz_min) - axis_rightz_antideadzone ),
+		INT_SIGN(axis_rightz_max) * ( abs(axis_rightz_max) - axis_rightz_antideadzone ),
+		0, 0);
+	/*
+	 * The triggers stay on HAT2X (left) and HAT2Y (right), the reverse of
+	 * Documentation/input/gamepad.rst: ROCKNIX, InputPlumber's Retroid maps
+	 * and Kettle's own (kettle-rp5, the desktop controller) all expect it.
+	 */
+	input_set_abs_params(indev, ABS_HAT2X, 0, trigger_left_max - trigger_left_antideadzone, 0, 30);
+	input_set_abs_params(indev, ABS_HAT2Y, 0, trigger_right_max - trigger_right_antideadzone, 0, 30);
+}
+
+/* A trigger's travel from its rest reading, within the range reported for it. */
+static int gamepad_trigger(const u8 *raw, int max, int deadzone, int antideadzone)
+{
+	int value = max - (raw[0] | (raw[1] << 8));
+
+	if (value < deadzone)
+		return 0;
+	return clamp(value - antideadzone, 0, max - antideadzone);
 }
 
