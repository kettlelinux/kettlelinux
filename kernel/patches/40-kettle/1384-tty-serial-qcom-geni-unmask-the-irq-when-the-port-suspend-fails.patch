From: gennro <gennro2004@gmail.com>
Subject: [PATCH] tty: serial: qcom-geni: unmask the IRQ when the port suspend fails

20-sm8550/1006 masks a non-console port's IRQ before uart_suspend_port()
and unmasks it at resume. When uart_suspend_port() fails, the PM core
does not call this device's resume, so the IRQ stayed masked for good.
Unmask it on that error.
---
--- a/drivers/tty/serial/qcom_geni_serial.c
+++ b/drivers/tty/serial/qcom_geni_serial.c
@@ -1983,6 +1983,7 @@ static int qcom_geni_serial_suspend(struct device *dev)
 	struct qcom_geni_serial_port *port = dev_get_drvdata(dev);
 	struct uart_port *uport = &port->uport;
 	struct qcom_geni_private_data *private_data = uport->private_data;
+	int ret;
 
 	/*
 	 * A peer that keeps streaming into a non-console geni UART across the
@@ -2009,7 +2010,13 @@ static int qcom_geni_serial_suspend(struct device *dev)
 		geni_icc_set_tag(&port->se, QCOM_ICC_TAG_ACTIVE_ONLY);
 		geni_icc_set_bw(&port->se);
 	}
-	return uart_suspend_port(private_data->drv, uport);
+
+	ret = uart_suspend_port(private_data->drv, uport);
+	/* A failed suspend gets no resume call to unmask it. */
+	if (ret && !uart_console(uport))
+		enable_irq(uport->irq);
+
+	return ret;
 }
 
 static int qcom_geni_serial_resume(struct device *dev)
