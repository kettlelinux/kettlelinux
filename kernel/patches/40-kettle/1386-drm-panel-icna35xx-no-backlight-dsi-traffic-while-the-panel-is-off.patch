From: gennro <gennro2004@gmail.com>
Subject: [PATCH] drm/panel: icna35xx: no backlight DSI traffic while the panel is off

- A failed init sequence in prepare turned the supplies off with the
  panel out of reset. Assert reset first, as unprepare does.
- The backlight ops cleared MIPI_DSI_MODE_LPM for their DCS command and
  set it again only on success, so one failed command left every later
  command (the init sequence's included) in high-speed mode. Set it
  again either way.
- Brightness writes went over DSI while the panel was unprepared (no
  supplies, the DSI host possibly off) and failed or timed out.
  Skip them then: drm_panel_enable() calls backlight_enable(), which
  sends the brightness once the panel is up.
- .get_brightness read the brightness back over DSI at every read of
  actual_brightness, also while the panel was off, only to return what
  was written. Drop it, and with it the panel-to-slider conversion only
  it used; the backlight core then reports the set brightness.
---
--- a/drivers/gpu/drm/panel/panel-chipone-icna35xx.c
+++ b/drivers/gpu/drm/panel/panel-chipone-icna35xx.c
@@ -405,6 +405,8 @@ static int icna35xx_prepare(struct drm_panel *panel)
 
 	ret = pinfo->desc->init_sequence(pinfo);
 	if (ret < 0) {
+		/* As unprepare: hold it in reset before cutting its supplies. */
+		gpiod_set_value_cansleep(pinfo->reset_gpio, 1);
         regulator_bulk_disable(ARRAY_SIZE(panel_supplies), pinfo->supplies);
 		dev_err(panel->dev, "failed to initialize panel: %d\n", ret);
 		return ret;
@@ -513,56 +515,32 @@ static u16 icna35xx_bl_to_panel(struct backlight_device *bl, u16 level)
 	return min + (u32)level * (max - min) / max;
 }
 
-static u16 icna35xx_bl_from_panel(struct backlight_device *bl, u16 level)
-{
-	struct panel_info *pinfo = mipi_dsi_get_drvdata(bl_get_data(bl));
-	u32 min = pinfo->desc->bl_min, max = bl->props.max_brightness;
-
-	if (!min)
-		return level;
-	if (level <= min)
-		return 0;
-
-	return min_t(u32, DIV_ROUND_UP((level - min) * max, max - min), max);
-}
-
 static int icna35xx_bl_update_status(struct backlight_device *bl)
 {
 	struct mipi_dsi_device *dsi = bl_get_data(bl);
+	struct panel_info *pinfo = mipi_dsi_get_drvdata(dsi);
 	u16 brightness = icna35xx_bl_to_panel(bl, backlight_get_brightness(bl));
 	int ret;
 
-	dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
-
-	ret = mipi_dsi_dcs_set_display_brightness_large(dsi, brightness);
-	if (ret < 0)
-		return ret;
-
-	dsi->mode_flags |= MIPI_DSI_MODE_LPM;
-
-	return 0;
-}
-
-static int icna35xx_bl_get_brightness(struct backlight_device *bl)
-{
-	struct mipi_dsi_device *dsi = bl_get_data(bl);
-	u16 brightness;
-	int ret;
+	/* Powered off: drm_panel_enable() sends the brightness once it is up. */
+	if (!pinfo->panel.prepared)
+		return 0;
 
 	dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
 
-	ret = mipi_dsi_dcs_get_display_brightness_large(dsi, &brightness);
-	if (ret < 0)
-		return ret;
+	ret = mipi_dsi_dcs_set_display_brightness_large(dsi, brightness);
 
 	dsi->mode_flags |= MIPI_DSI_MODE_LPM;
 
-	return icna35xx_bl_from_panel(bl, brightness);
+	return ret < 0 ? ret : 0;
 }
 
+/*
+ * No .get_brightness: reading it back went over DSI, also while the panel
+ * was off, and only returned what was written.
+ */
 static const struct backlight_ops icna35xx_bl_ops = {
 	.update_status = icna35xx_bl_update_status,
-	.get_brightness = icna35xx_bl_get_brightness,
 };
 
 static struct backlight_device *icna35xx_create_backlight(struct mipi_dsi_device *dsi)
