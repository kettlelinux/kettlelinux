From: Kettle Linux
Subject: [PATCH] soundwire: qcom, ASoC: lpass macros: stop register access before the ADSP goes down

On SM8550/SM8750 the LPASS codec macros and the SoundWire controllers
sit behind clocks the ADSP provides (q6prm). When the ADSP crashes and
remoteproc recovers it, nothing tells these drivers: the SoundWire
interrupt thread and the macros' DAPM/clock paths keep reading and
writing LPASS registers after the ADSP has been shut down. That access
stalls the bus and hangs the whole SoC; neither the watchdog nor the
lockup detectors get it back. Forcing a recovery (debugfs
remoteproc/<adsp>/crash = 2) froze the AYN Odin 3 Portal and the Odin 3
every time; the last trace before the hang was the soundwire IRQ
thread in qcom_swrm_cpu_reg_read() right after q6prm's clocks were
unregistered.

Listen to the "lpass" SSR notifications. The ssr subdevice is stopped
first, so QCOM_SSR_BEFORE_SHUTDOWN arrives before glink and the audio
card are torn down and while the hardware is still reachable. On it:

- soundwire qcom (CPU-mapped controllers only): disable the controller
  interrupt, fail every register access, skip runtime PM;
- rx/tx/va/wsa macros: put the regmap cache-only and keep it so in
  runtime resume.

The clock handles the drivers took at probe stay dead after the ADSP
comes back (q6prm registers new clocks), so this is one-way: audio is
gone until the next boot, but the device keeps running.
---
--- a/drivers/soundwire/Kconfig
+++ b/drivers/soundwire/Kconfig
@@ -51,6 +51,7 @@
 	tristate "Qualcomm SoundWire Master driver"
 	imply SLIMBUS
 	depends on SND_SOC
+	depends on QCOM_RPROC_COMMON || !QCOM_RPROC_COMMON
 	help
 	  SoundWire Qualcomm Master driver.
 	  If you have an Qualcomm platform which has a SoundWire Master then
--- a/drivers/soundwire/qcom.c
+++ b/drivers/soundwire/qcom.c
@@ -12,6 +12,7 @@
 #include <linux/of_irq.h>
 #include <linux/pm_runtime.h>
 #include <linux/regmap.h>
+#include <linux/remoteproc/qcom_rproc.h>
 #include <linux/reset.h>
 #include <linux/slab.h>
 #include <linux/pm_wakeirq.h>
@@ -223,6 +224,10 @@
 	u32 slave_status;
 	u32 wr_fifo_depth;
 	bool clock_stop_not_supported;
+	/* LPASS is going down: the registers must not be touched */
+	bool lpass_down;
+	struct notifier_block ssr_nb;
+	void *ssr_notifier;
 };
 
 struct qcom_swrm_data {
@@ -372,6 +377,11 @@
 static int qcom_swrm_cpu_reg_read(struct qcom_swrm_ctrl *ctrl, int reg,
 				  u32 *val)
 {
+	if (READ_ONCE(ctrl->lpass_down)) {
+		*val = 0;
+		return SDW_CMD_FAIL;
+	}
+
 	*val = readl(ctrl->mmio + reg);
 	return SDW_CMD_OK;
 }
@@ -379,10 +389,44 @@
 static int qcom_swrm_cpu_reg_write(struct qcom_swrm_ctrl *ctrl, int reg,
 				   int val)
 {
+	if (READ_ONCE(ctrl->lpass_down))
+		return SDW_CMD_FAIL;
+
 	writel(val, ctrl->mmio + reg);
 	return SDW_CMD_OK;
 }
 
+/*
+ * The controller sits in LPASS, clocked through the ADSP. An access after
+ * the ADSP has gone down stalls the bus and hangs the SoC. Stop the
+ * interrupt and every register access before it shuts down; the clock
+ * handles stay dead after a restart, so the controller stays off until
+ * the next boot.
+ */
+static int qcom_swrm_ssr_notify(struct notifier_block *nb,
+				unsigned long action, void *data)
+{
+	struct qcom_swrm_ctrl *ctrl = container_of(nb, struct qcom_swrm_ctrl,
+						   ssr_nb);
+
+	if (action != QCOM_SSR_BEFORE_SHUTDOWN || READ_ONCE(ctrl->lpass_down))
+		return NOTIFY_OK;
+
+	WRITE_ONCE(ctrl->lpass_down, true);
+	/* Waits for a running interrupt thread to finish */
+	disable_irq(ctrl->irq);
+	dev_warn(ctrl->dev, "LPASS going down, no more register access\n");
+
+	return NOTIFY_OK;
+}
+
+static void qcom_swrm_ssr_exit(void *data)
+{
+	struct qcom_swrm_ctrl *ctrl = data;
+
+	qcom_unregister_ssr_notifier(ctrl->ssr_notifier, &ctrl->ssr_nb);
+}
+
 static u32 swrm_get_packed_reg_val(u8 *cmd_id, u8 cmd_data,
 				   u8 dev_addr, u16 reg_addr)
 {
@@ -1680,6 +1724,20 @@
 		goto err_clk;
 	}
 
+	if (ctrl->reg_read == qcom_swrm_cpu_reg_read) {
+		void *notifier;
+
+		ctrl->ssr_nb.notifier_call = qcom_swrm_ssr_notify;
+		notifier = qcom_register_ssr_notifier("lpass", &ctrl->ssr_nb);
+		if (!IS_ERR_OR_NULL(notifier)) {
+			ctrl->ssr_notifier = notifier;
+			ret = devm_add_action_or_reset(dev, qcom_swrm_ssr_exit,
+						       ctrl);
+			if (ret)
+				goto err_clk;
+		}
+	}
+
 	ctrl->wake_irq = of_irq_get(dev->of_node, 1);
 	if (ctrl->wake_irq > 0) {
 		ret = devm_request_threaded_irq(dev, ctrl->wake_irq, NULL,
@@ -1752,6 +1810,10 @@
 	struct qcom_swrm_ctrl *ctrl = dev_get_drvdata(dev);
 	int ret;
 
+	/* LPASS went down: leave the hardware alone */
+	if (READ_ONCE(ctrl->lpass_down))
+		return 0;
+
 	if (ctrl->wake_irq > 0) {
 		if (!irqd_irq_disabled(irq_get_irq_data(ctrl->wake_irq)))
 			disable_irq_nosync(ctrl->wake_irq);
@@ -1817,6 +1879,10 @@
 	struct qcom_swrm_ctrl *ctrl = dev_get_drvdata(dev);
 	int ret;
 
+	/* LPASS went down: leave the hardware alone */
+	if (READ_ONCE(ctrl->lpass_down))
+		return 0;
+
 	swrm_wait_for_wr_fifo_done(ctrl);
 	if (!ctrl->clock_stop_not_supported) {
 		/* Mask bus clash interrupt */
