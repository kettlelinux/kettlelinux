+++ b/sound/soc/codecs/Kconfig
@@ -2923,6 +2923,7 @@
 
 config SND_SOC_LPASS_WSA_MACRO
 	depends on COMMON_CLK
+	depends on QCOM_RPROC_COMMON || !QCOM_RPROC_COMMON
 	depends on PM_CLK
 	select REGMAP_MMIO
 	select SND_SOC_LPASS_MACRO_COMMON
@@ -2930,6 +2931,7 @@
 
 config SND_SOC_LPASS_VA_MACRO
 	depends on COMMON_CLK
+	depends on QCOM_RPROC_COMMON || !QCOM_RPROC_COMMON
 	depends on PM_CLK
 	select REGMAP_MMIO
 	select SND_SOC_LPASS_MACRO_COMMON
@@ -2937,6 +2939,7 @@
 
 config SND_SOC_LPASS_RX_MACRO
 	depends on COMMON_CLK
+	depends on QCOM_RPROC_COMMON || !QCOM_RPROC_COMMON
 	depends on PM_CLK
 	select REGMAP_MMIO
 	select SND_SOC_LPASS_MACRO_COMMON
@@ -2944,6 +2947,7 @@
 
 config SND_SOC_LPASS_TX_MACRO
 	depends on COMMON_CLK
+	depends on QCOM_RPROC_COMMON || !QCOM_RPROC_COMMON
 	depends on PM_CLK
 	select REGMAP_MMIO
 	select SND_SOC_LPASS_MACRO_COMMON
--- a/sound/soc/codecs/lpass-macro-common.c
+++ b/sound/soc/codecs/lpass-macro-common.c
@@ -9,9 +9,67 @@
 #include <linux/platform_device.h>
 #include <linux/pm_domain.h>
 #include <linux/pm_runtime.h>
+#include <linux/regmap.h>
+#include <linux/remoteproc/qcom_rproc.h>
 
 #include "lpass-macro-common.h"
 
+static int lpass_macro_ssr_notify(struct notifier_block *nb,
+				  unsigned long action, void *data)
+{
+	struct lpass_macro_ssr *ssr = container_of(nb, struct lpass_macro_ssr, nb);
+
+	if (action != QCOM_SSR_BEFORE_SHUTDOWN || READ_ONCE(ssr->down))
+		return NOTIFY_OK;
+
+	/*
+	 * The clocks behind these registers go away with the ADSP, and the
+	 * handles taken at probe stay dead after it restarts. Keep the
+	 * hardware untouched until the next boot: audio is lost, but the
+	 * SoC does not hang.
+	 */
+	WRITE_ONCE(ssr->down, true);
+	regcache_cache_only(ssr->regmap, true);
+	regcache_mark_dirty(ssr->regmap);
+	dev_warn(ssr->dev, "LPASS going down, no more register access\n");
+
+	return NOTIFY_OK;
+}
+
+static void lpass_macro_ssr_exit(void *data)
+{
+	struct lpass_macro_ssr *ssr = data;
+
+	qcom_unregister_ssr_notifier(ssr->notifier, &ssr->nb);
+}
+
+/* Not fatal: on failure the macro simply runs without the protection. */
+struct lpass_macro_ssr *lpass_macro_ssr_init(struct device *dev,
+					     struct regmap *regmap)
+{
+	struct lpass_macro_ssr *ssr;
+	void *notifier;
+
+	ssr = devm_kzalloc(dev, sizeof(*ssr), GFP_KERNEL);
+	if (!ssr)
+		return NULL;
+
+	ssr->dev = dev;
+	ssr->regmap = regmap;
+	ssr->nb.notifier_call = lpass_macro_ssr_notify;
+
+	notifier = qcom_register_ssr_notifier("lpass", &ssr->nb);
+	if (IS_ERR_OR_NULL(notifier))
+		return ssr;
+	ssr->notifier = notifier;
+
+	if (devm_add_action_or_reset(dev, lpass_macro_ssr_exit, ssr))
+		return NULL;
+
+	return ssr;
+}
+EXPORT_SYMBOL_GPL(lpass_macro_ssr_init);
+
 static DEFINE_MUTEX(lpass_codec_mutex);
 static enum lpass_codec_version lpass_codec_version;
 
--- a/sound/soc/codecs/lpass-macro-common.h
+++ b/sound/soc/codecs/lpass-macro-common.h
@@ -6,6 +6,9 @@
 #ifndef __LPASS_MACRO_COMMON_H__
 #define __LPASS_MACRO_COMMON_H__
 
+#include <linux/compiler.h>
+#include <linux/notifier.h>
+
 /* NPL clock is expected */
 #define LPASS_MACRO_FLAG_HAS_NPL_CLOCK		BIT(0)
 /* The soundwire block should be internally reset at probe */
@@ -37,6 +40,29 @@
 	struct device *dcodec_pd;
 };
 
+struct regmap;
+
+/*
+ * The macros' clocks come from the ADSP (q6prm). Once the ADSP goes down,
+ * touching their registers stalls the bus and hangs the SoC, so the
+ * macros run cache-only from then on. See lpass_macro_ssr_init().
+ */
+struct lpass_macro_ssr {
+	struct notifier_block nb;
+	void *notifier;
+	struct device *dev;
+	struct regmap *regmap;
+	bool down;
+};
+
+struct lpass_macro_ssr *lpass_macro_ssr_init(struct device *dev,
+					     struct regmap *regmap);
+
+static inline bool lpass_macro_ssr_down(struct lpass_macro_ssr *ssr)
+{
+	return ssr && READ_ONCE(ssr->down);
+}
+
 struct lpass_macro *lpass_macro_pds_init(struct device *dev);
 void lpass_macro_pds_exit(struct lpass_macro *pds);
 void lpass_macro_set_codec_version(enum lpass_codec_version version);
--- a/sound/soc/codecs/lpass-rx-macro.c
+++ b/sound/soc/codecs/lpass-rx-macro.c
@@ -663,6 +663,7 @@
 	int softclip_clk_users;
 	struct lpass_macro *pds;
 	struct regmap *regmap;
+	struct lpass_macro_ssr *ssr;
 	struct clk *mclk;
 	struct clk *npl;
 	struct clk *macro;
@@ -3918,6 +3919,8 @@
 	if (IS_ERR(rx->regmap))
 		return PTR_ERR(rx->regmap);
 
+	rx->ssr = lpass_macro_ssr_init(dev, rx->regmap);
+
 	dev_set_drvdata(dev, rx);
 
 	rx->dev = dev;
@@ -4016,7 +4019,8 @@
 
 	ret = pm_clk_suspend(dev);
 	if (ret) {
-		regcache_cache_only(rx->regmap, false);
+		if (!lpass_macro_ssr_down(rx->ssr))
+			regcache_cache_only(rx->regmap, false);
 		return ret;
 	}
 
@@ -4037,6 +4041,10 @@
 		return ret;
 	}
 
+	/* The ADSP went down: the registers stay cache-only. */
+	if (lpass_macro_ssr_down(rx->ssr))
+		return 0;
+
 	regcache_cache_only(rx->regmap, false);
 	ret = regcache_sync(rx->regmap);
 	if (ret) {
