  * for the asynchronous version reply before sending the parameter command that
- * selects framed-report mode. Each attempt waits up to MCU_VERSION_ACK_TIMEOUT
- * for the reply; if the MCU is slow to boot or missed the request we redo the
- * reset/power/version sequence up to MCU_INIT_MAX_ATTEMPTS times.
+ * selects framed-report mode, and for that command's acknowledgement. Each
+ * reply is waited for up to MCU_ACK_TIMEOUT_MS; if one does not come we redo
+ * the power-cycle/version/params sequence up to MCU_INIT_MAX_ATTEMPTS times.
  */
-#define MCU_VERSION_ACK_TIMEOUT_MS  500
+#define MCU_ACK_TIMEOUT_MS          500
 #define MCU_INIT_MAX_ATTEMPTS       3
 
 /* A failed resume init is retried from a work this often, this many times. */
@@ -159,15 +161,18 @@ struct rsinput_driver {
     uint8_t rx_buf[1024];
