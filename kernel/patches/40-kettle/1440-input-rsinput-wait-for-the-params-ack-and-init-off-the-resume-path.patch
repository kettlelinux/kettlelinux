+    struct completion ack;
     /*
-     * Flag marking the window during which a version reply should satisfy
-     * version_ack. It is written only from the single-threaded init path
-     * (probe/resume), published before the request is sent, and read from the
-     * serdev rx callback so that an unsolicited version frame arriving outside a
-     * handshake cannot falsely complete the wait.
+     * The CMD_COMMOD reply the init path is waiting for (DATA_COMMOD_VERSION or
+     * DATA_COMMOD_SET_PAR), 0 for none. Set by the init path (probe, resume
+     * work) before it sends the request; the rx callback completes ack only for
+     * that reply. ack_lock makes the check and the complete() one step against
+     * the init path rearming for its next request, so a late reply to one
+     * request cannot complete the next, and one outside a handshake completes
