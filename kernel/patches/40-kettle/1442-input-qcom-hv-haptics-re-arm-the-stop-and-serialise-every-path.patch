From: gennro <gennro2004@gmail.com>
Subject: [PATCH] Input: qcom-hv-haptics: re-arm the stop, check the load, serialise every path

Uploading a constant effect armed stop_work with schedule_delayed_work(),
a no-op while a stop is already pending: a 60 s effect uploaded right
after a 50 ms one (InputPlumber's first rumble) stopped after 50 ms.
Use mod_delayed_work(), after the load, whose result was ignored (a
failed load still reported success and played the previous pattern).

stop_work stopped play without any lock and could interleave with the
playback work enabling a new play, leaving chip_is_playing out of step
with PLAY_EN. It now runs under global_ff_lock, taken with a trylock and
a requeue because the lock holders cancel it synchronously.

The chip's own force-feedback device reached the same callbacks as
rsinput's global path without its lock, and its playback ran sleeping
SPMI writes under the input event lock. Its upload and erase now take
global_ff_lock and its playback goes through the playback work (a stop
still leaves the effect loaded, as before). Remove cancels stop_work, so
a pending stop cannot run on the freed chip.
---
diff --git a/drivers/input/misc/qcom-hv-haptics.c b/drivers/input/misc/qcom-hv-haptics.c
index 78bf9e2..32c359d 100644
--- a/drivers/input/misc/qcom-hv-haptics.c
+++ b/drivers/input/misc/qcom-hv-haptics.c
@@ -2698,6 +2698,18 @@ static void haptics_stop_constant_effect_play(struct work_struct *work)
 	struct haptics_chip *chip = container_of(work, struct haptics_chip, stop_work.work);
 	int rc = 0;
 
+	/*
+	 * Force-feedback uploads, plays and stops (rsinput's and the chip's own
+	 * device's) run under global_ff_lock, so a stop racing one of them cannot
+	 * leave chip_is_playing out of step with PLAY_EN. Those paths cancel this
+	 * work synchronously with the lock held: try it and come back a tick later
+	 * instead of waiting for it (a cancel drops the requeue).
+	 */
+	if (!mutex_trylock(&chip->global_ff_lock)) {
+		schedule_delayed_work(&chip->stop_work, 1);
+		return;
+	}
+
 	rc = haptics_enable_play(chip, false);
 	if (rc < 0)
 		dev_err(chip->dev, "stop constant effect play failed\n");
@@ -2705,6 +2717,8 @@ static void haptics_stop_constant_effect_play(struct work_struct *work)
 	rc = haptics_enable_hpwr_vreg(chip, false);
 	if (rc < 0)
 		dev_err(chip->dev, "disable hpwr_vreg failed\n");
+
+	mutex_unlock(&chip->global_ff_lock);
 }
 
 static int haptics_erase(struct input_dev *dev, int effect_id);
@@ -2757,7 +2771,8 @@ static int haptics_upload_effect(struct input_dev *dev,
 			dev->ff->set_gain(dev, gain);
 
 			//Also, reschedule the stop_work timer
-			schedule_delayed_work(&chip->stop_work, msecs_to_jiffies(effect->replay.length));
+			mod_delayed_work(system_wq, &chip->stop_work,
+					 msecs_to_jiffies(effect->replay.length));
 		}
 
 		return 0;
@@ -2774,13 +2789,14 @@ static int haptics_upload_effect(struct input_dev *dev,
 		amplitude = tmp / 0x7fff;
 		dev_dbg(chip->dev, "upload constant effect, length = %dms, amplitude = %#x\n",
 				length_ms, amplitude);
-		schedule_delayed_work(&chip->stop_work, msecs_to_jiffies(length_ms));
-		haptics_load_constant_effect(chip, amplitude);
+		rc = haptics_load_constant_effect(chip, amplitude);
 		if (rc < 0) {
 			dev_err(chip->dev, "set direct play failed, rc=%d\n",
 					rc);
 			return rc;
 		}
+		/* This effect's length: a stop still pending from an earlier one is re-armed. */
+		mod_delayed_work(system_wq, &chip->stop_work, msecs_to_jiffies(length_ms));
 
 		break;
 	case FF_PERIODIC:
@@ -5956,6 +5972,62 @@ static int haptics_boost_notifier(struct notifier_block *nb, unsigned long event
 	return 0;
 }
 
+/* Queue a play (val != 0) or stop for the playback work; callable in atomic context. */
+static void haptics_queue_playback(struct haptics_chip *chip, int effect_id, int val)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&chip->global_playback_lock, flags);
+	chip->global_effect_id = effect_id;
+	chip->global_playback_val = val;
+	chip->global_playback_seq++;
+	if (!chip->global_suspended)
+		schedule_work(&chip->global_playback_work);
+	spin_unlock_irqrestore(&chip->global_playback_lock, flags);
+}
+
+/*
+ * The chip's own force-feedback device drives the same hardware as rsinput's
+ * global path: serialise its uploads and erases on the same lock, and send its
+ * playback (called under the input event lock, where the SPMI writes cannot
+ * sleep) through the same work.
+ */
+static int haptics_ff_upload(struct input_dev *dev, struct ff_effect *effect,
+			     struct ff_effect *old)
+{
+	struct haptics_chip *chip = input_get_drvdata(dev);
+	int rc;
+
+	mutex_lock(&chip->global_ff_lock);
+	rc = haptics_upload_effect(dev, effect, old);
+	mutex_unlock(&chip->global_ff_lock);
+
+	return rc;
+}
+
+static int haptics_ff_playback(struct input_dev *dev, int effect_id, int val)
+{
+	/*
+	 * As before, a stop leaves the effect loaded to play again (the work would
+	 * erase it); the effect's length or an erase stops the play.
+	 */
+	if (val)
+		haptics_queue_playback(input_get_drvdata(dev), effect_id, val);
+	return 0;
+}
+
+static int haptics_ff_erase(struct input_dev *dev, int effect_id)
+{
+	struct haptics_chip *chip = input_get_drvdata(dev);
+	int rc;
+
+	mutex_lock(&chip->global_ff_lock);
+	rc = haptics_erase(dev, effect_id);
+	mutex_unlock(&chip->global_ff_lock);
+
+	return rc;
+}
+
 static int haptics_probe(struct platform_device *pdev)
 {
 	struct haptics_chip *chip;
@@ -6064,9 +6136,9 @@ static int haptics_probe(struct platform_device *pdev)
 	}
 
 	ff_dev = input_dev->ff;
-	ff_dev->upload = haptics_upload_effect;
-	ff_dev->playback = haptics_playback;
-	ff_dev->erase = haptics_erase;
+	ff_dev->upload = haptics_ff_upload;
+	ff_dev->playback = haptics_ff_playback;
+	ff_dev->erase = haptics_ff_erase;
 	ff_dev->set_gain = haptics_set_gain;
 	rc = input_register_device(input_dev);
 	if (rc < 0) {
@@ -6142,6 +6214,8 @@ static void haptics_remove(struct platform_device *pdev)
 	debugfs_remove_recursive(chip->debugfs_dir);
 #endif
 	input_unregister_device(chip->input_dev);
+	/* No uploads after the unregister: a pending stop must not outlive the chip. */
+	cancel_delayed_work_sync(&chip->stop_work);
 	dev_set_drvdata(chip->dev, NULL);
 
 	return;
@@ -6413,13 +6487,7 @@ int qcom_spmi_haptics_global_playback(int effect_id, int val)
 	spin_lock_irqsave(&global_haptics_lock, flags);
 	chip = global_haptics;
 	if (chip) {
-		spin_lock(&chip->global_playback_lock);
-		chip->global_effect_id = effect_id;
-		chip->global_playback_val = val;
-		chip->global_playback_seq++;
-		if (!chip->global_suspended)
-			schedule_work(&chip->global_playback_work);
-		spin_unlock(&chip->global_playback_lock);
+		haptics_queue_playback(chip, effect_id, val);
 		ret = 0;
 	}
 	spin_unlock_irqrestore(&global_haptics_lock, flags);
