From 480b00c14cdc3d0a25b1138a2927470fa3df710a Mon Sep 17 00:00:00 2001
From: Alexandre Hamamdjian <azkali.limited@gmail.com>
Date: Thu, 23 Jul 2026 18:20:18 +0700
Subject: [PATCH] drm/panel: st7703: Add AYANEO Pocket DS lower panel

The lower (secondary) 5.0" 1024x768 4:3 IPS LCD panel of the AYANEO
Pocket DS dual-screen QCS8550 (Snapdragon 8 Gen 2) handheld is driven by
a Sitronix ST7703 DDIC: every command in the vendor init sequence maps to
an ST7703 manufacturer command (SETEXTC 0xB9, SETMIPI 0xBA, SETRGBIF,
SETSCR, SETPOWER, SETGAMMA, SETGIP1/2 0xE9/0xEA), and the SETMIPI and
SETRGBIF payloads are near-identical to the already-supported Powkiddy
RGB10MAX3. Extend the mainline sitronix-st7703 driver rather than carry a
bespoke generated driver.

The panel is mounted in portrait (768x1024) and rotated 270 degrees in
the device, expressed through the panel rotation property. The SETEXTC
unlock password ends in 0x87 rather than the canonical 0x83; this is the
value shipped by the vendor firmware and is kept verbatim.

Init sequence extracted from the AYANEO Pocket DS BSP kernel.

The panel's AVDD/AVEE pair is generated by an SGM3804 dual-output
regulator, which the kernel exposes as two independent rails. vcc-supply
covers the positive one; add an optional avee-supply for the negative one
so both are sequenced with the panel instead of being left to whatever
state the bootloader handed over. No other st7703 panel declares it, so
the supply is optional and those boards are unaffected.

Signed-off-by: Alexandre Hamamdjian <azkali.limited@gmail.com>

Kettle: the panel itself is in Linux 7.3 (same mode and init sequence);
only its optional avee supply is left here.

---
 .../display/panel/rocktech,jh057n00900.yaml   |  7 ++
 drivers/gpu/drm/panel/panel-sitronix-st7703.c | 122 ++++++++++++++++++++
 2 files changed, 129 insertions(+)

diff --git a/Documentation/devicetree/bindings/display/panel/rocktech,jh057n00900.yaml b/Documentation/devicetree/bindings/display/panel/rocktech,jh057n00900.yaml
index 91e06d6a6..9a4d7e46c 100644
--- a/Documentation/devicetree/bindings/display/panel/rocktech,jh057n00900.yaml
+++ b/Documentation/devicetree/bindings/display/panel/rocktech,jh057n00900.yaml
@@ -45,6 +45,11 @@ properties:
   iovcc-supply:
     description: I/O voltage supply
 
+  avee-supply:
+    description:
+      Negative panel supply, for panels whose AVDD/AVEE pair is generated by a
+      dual-output regulator. Optional; most panels have no separate negative rail.
+
   backlight: true
   port: true
   reset-gpios: true
diff --git a/drivers/gpu/drm/panel/panel-sitronix-st7703.c b/drivers/gpu/drm/panel/panel-sitronix-st7703.c
index 70f728247..5bbba991f 100644
--- a/drivers/gpu/drm/panel/panel-sitronix-st7703.c
+++ b/drivers/gpu/drm/panel/panel-sitronix-st7703.c
@@ -59,6 +59,7 @@ struct st7703 {
 	struct gpio_desc *reset_gpio;
 	struct regulator *vcc;
 	struct regulator *iovcc;
+	struct regulator *avee;
 
 	struct dentry *debugfs;
 	const struct st7703_panel_desc *desc;
@@ -810,6 +811,8 @@ static int st7703_unprepare(struct drm_panel *panel)
 	struct st7703 *ctx = panel_to_st7703(panel);
 
 	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+	if (ctx->avee)
+		regulator_disable(ctx->avee);
 	regulator_disable(ctx->iovcc);
 	regulator_disable(ctx->vcc);
 
@@ -837,6 +840,16 @@ static int st7703_prepare(struct drm_panel *panel)
 		return ret;
 	}
 
+	if (ctx->avee) {
+		ret = regulator_enable(ctx->avee);
+		if (ret < 0) {
+			dev_err(ctx->dev, "Failed to enable avee supply: %d\n", ret);
+			regulator_disable(ctx->vcc);
+			regulator_disable(ctx->iovcc);
+			return ret;
+		}
+	}
+
 	/* Give power supplies time to stabilize before deasserting reset. */
 	usleep_range(10000, 20000);
 
@@ -969,6 +982,19 @@ static int st7703_probe(struct mipi_dsi_device *dsi)
 		return dev_err_probe(dev, PTR_ERR(ctx->iovcc),
 				     "Failed to request iovcc regulator\n");
 
+	/*
+	 * Panels whose positive rail comes from a dual-output regulator - the
+	 * AYANEO Pocket DS lower panel is fed by an SGM3804 - need the matching
+	 * negative rail brought up with it. Optional: no other panel here has one.
+	 */
+	ctx->avee = devm_regulator_get_optional(dev, "avee");
+	if (IS_ERR(ctx->avee)) {
+		if (PTR_ERR(ctx->avee) != -ENODEV)
+			return dev_err_probe(dev, PTR_ERR(ctx->avee),
+					     "Failed to request avee regulator\n");
+		ctx->avee = NULL;
+	}
+
 	ret = drm_of_get_panel_orientation(dsi->dev.of_node, &ctx->orientation);
 	if (ret < 0)
 		return dev_err_probe(&dsi->dev, ret, "Failed to get orientation\n");
