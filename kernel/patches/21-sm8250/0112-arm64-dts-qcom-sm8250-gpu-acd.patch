From: Kettle Linux <noreply@kettlelinux>
Subject: [PATCH] arm64: dts: qcom: sm8250: enable A650 ACD

Adaptive clock distribution lets the GPU run each level at a lower
voltage margin. ACD levels per OPP and the GMU's AOSS (qcom,qmp) link,
as in ROCKNIX's SM8250 9998-gpu-tuning: 0x802b5ffd from 525 MHz up,
0xa02b5ffd below.

---
--- a/arch/arm64/boot/dts/qcom/sm8250.dtsi
+++ b/arch/arm64/boot/dts/qcom/sm8250.dtsi
@@ -2980,6 +2980,7 @@
 					opp-hz = /bits/ 64 <750000000>;
 					opp-level = <RPMH_REGULATOR_LEVEL_TURBO_L1>;
 					opp-supported-hw = <0xb>;
+					qcom,opp-acd-level = <0x802b5ffd>;
 					opp-peak-kBps = <8171875>;
 				};
 
@@ -2987,6 +2988,7 @@
 					opp-hz = /bits/ 64 <725000000>;
 					opp-level = <RPMH_REGULATOR_LEVEL_TURBO_L1>;
 					opp-supported-hw = <0xb>;
+					qcom,opp-acd-level = <0x802b5ffd>;
 					opp-peak-kBps = <8171875>;
 				};
 
@@ -2994,6 +2996,7 @@
 					opp-hz = /bits/ 64 <700000000>;
 					opp-level = <RPMH_REGULATOR_LEVEL_TURBO>;
 					opp-supported-hw = <0xb>;
+					qcom,opp-acd-level = <0x802b5ffd>;
 					opp-peak-kBps = <8171875>;
 				};
 
@@ -3001,6 +3004,7 @@
 					opp-hz = /bits/ 64 <670000000>;
 					opp-level = <RPMH_REGULATOR_LEVEL_NOM_L1>;
 					opp-supported-hw = <0xb>;
+					qcom,opp-acd-level = <0x802b5ffd>;
 					opp-peak-kBps = <8171875>;
 				};
 
@@ -3008,6 +3012,7 @@
 					opp-hz = /bits/ 64 <650000000>;
 					opp-level = <RPMH_REGULATOR_LEVEL_NOM_L1>;
 					opp-supported-hw = <0xb>;
+					qcom,opp-acd-level = <0x802b5ffd>;
 					opp-peak-kBps = <8171875>;
 				};
 
@@ -3015,6 +3020,7 @@
 					opp-hz = /bits/ 64 <587000000>;
 					opp-level = <RPMH_REGULATOR_LEVEL_NOM>;
 					opp-supported-hw = <0xb>;
+					qcom,opp-acd-level = <0x802b5ffd>;
 					opp-peak-kBps = <8171875>;
 				};
 
@@ -3022,6 +3028,7 @@
 					opp-hz = /bits/ 64 <525000000>;
 					opp-level = <RPMH_REGULATOR_LEVEL_SVS_L2>;
 					opp-supported-hw = <0xf>;
+					qcom,opp-acd-level = <0x802b5ffd>;
 					opp-peak-kBps = <6074218>;
 				};
 
@@ -3029,6 +3036,7 @@
 					opp-hz = /bits/ 64 <490000000>;
 					opp-level = <RPMH_REGULATOR_LEVEL_SVS_L1>;
 					opp-supported-hw = <0xf>;
+					qcom,opp-acd-level = <0xa02b5ffd>;
 					opp-peak-kBps = <6074218>;
 				};
 
@@ -3036,6 +3044,7 @@
 					opp-hz = /bits/ 64 <441600000>;
 					opp-level = <RPMH_REGULATOR_LEVEL_SVS_L0>;
 					opp-supported-hw = <0xf>;
+					qcom,opp-acd-level = <0xa02b5ffd>;
 					opp-peak-kBps = <6074218>;
 				};
 
@@ -3043,6 +3052,7 @@
 					opp-hz = /bits/ 64 <400000000>;
 					opp-level = <RPMH_REGULATOR_LEVEL_SVS>;
 					opp-supported-hw = <0xf>;
+					qcom,opp-acd-level = <0xa02b5ffd>;
 					opp-peak-kBps = <3972656>;
 				};
 
@@ -3050,6 +3060,7 @@
 					opp-hz = /bits/ 64 <305000000>;
 					opp-level = <RPMH_REGULATOR_LEVEL_LOW_SVS>;
 					opp-supported-hw = <0xf>;
+					qcom,opp-acd-level = <0xa02b5ffd>;
 					opp-peak-kBps = <1761718>;
 				};
 			};
@@ -3081,6 +3092,8 @@
 
 			iommus = <&adreno_smmu 5 0x400>;
 
+			qcom,qmp = <&aoss_qmp>;
+
 			operating-points-v2 = <&gmu_opp_table>;
 
 			status = "disabled";
