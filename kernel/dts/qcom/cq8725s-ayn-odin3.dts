/dts-v1/;

#include "cq8725s-ayn-common.dtsi"

/ {
	model = "AYN Odin 3";
	compatible = "ayn,odin3", "qcom,cq8725s", "qcom,sm8750-mtp", "qcom,sm8750";

	vdd_bl_5v0: vdd-bl-5v0-regulator {
		compatible = "regulator-fixed";
		regulator-name = "vdd_bl_5v0";

		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;

		gpio = <&tlmm 56 GPIO_ACTIVE_HIGH>;
		enable-active-high;
	};

	vdd_disp_2v8: vdd-disp-2v8-regulator {
		compatible = "regulator-fixed";
		regulator-name = "vdd_disp_2v8";

		regulator-min-microvolt = <2800000>;
		regulator-max-microvolt = <2800000>;

		gpio = <&tlmm 97 GPIO_ACTIVE_HIGH>;
		enable-active-high;
	};

	/* Kettle: the stick rings as multicolor LEDs rgb:l1..l4 and rgb:r1..r4 (kettle-ledd), from the
	 * HTR3212 channels below, as qcs8550-ayn-odin2portal.dts does for the same chips and labels.
	 * The ring order is the Portal's; not yet checked on an Odin 3. */
	multi-ledr1 {
		compatible = "leds-group-multicolor";
		color = <LED_COLOR_ID_RGB>;
		function = "r1";
		leds = <&ledr_r4>, <&ledr_g4>, <&ledr_b4>;
	};

	multi-ledl1 {
		compatible = "leds-group-multicolor";
		color = <LED_COLOR_ID_RGB>;
		function = "l1";
		leds = <&ledl_r4>, <&ledl_g4>, <&ledl_b4>;
	};

	multi-ledr2 {
		compatible = "leds-group-multicolor";
		color = <LED_COLOR_ID_RGB>;
		function = "r2";
		leds = <&ledr_r1>, <&ledr_g1>, <&ledr_b1>;
	};

	multi-ledl2 {
		compatible = "leds-group-multicolor";
		color = <LED_COLOR_ID_RGB>;
		function = "l2";
		leds = <&ledl_r1>, <&ledl_g1>, <&ledl_b1>;
	};

	multi-ledr3 {
		compatible = "leds-group-multicolor";
		color = <LED_COLOR_ID_RGB>;
		function = "r3";
		leds = <&ledr_r2>, <&ledr_g2>, <&ledr_b2>;
	};

	multi-ledl3 {
		compatible = "leds-group-multicolor";
		color = <LED_COLOR_ID_RGB>;
		function = "l3";
		leds = <&ledl_r2>, <&ledl_g2>, <&ledl_b2>;
	};

	multi-ledr4 {
		compatible = "leds-group-multicolor";
		color = <LED_COLOR_ID_RGB>;
		function = "r4";
		leds = <&ledr_r3>, <&ledr_g3>, <&ledr_b3>;
	};

	multi-ledl4 {
		compatible = "leds-group-multicolor";
		color = <LED_COLOR_ID_RGB>;
		function = "l4";
		leds = <&ledl_r3>, <&ledl_g3>, <&ledl_b3>;
	};
};

&i2c4 {
	clock-frequency = <400000>;
	status = "okay";

	touchscreen@38 {
		compatible = "focaltech,ft5426";
		reg = <0x38>;
		#address-cells = <1>;
		#size-cells = <0>;

		interrupt-parent = <&tlmm>;
		interrupts = <162 IRQ_TYPE_EDGE_FALLING>;

		reset-gpios = <&tlmm 161 GPIO_ACTIVE_LOW>;

		vcc-supply = <&vreg_l14b_3p2>;
		iovcc-supply = <&vreg_l12b_1p8>;

		pinctrl-0 = <&ts_p_rst_default &ts_p_int_default>;
		pinctrl-1 = <&ts_p_rst_sleep &ts_p_int_sleep>;
		pinctrl-names = "default", "sleep";

		touchscreen-size-x = <1080>;
		touchscreen-size-y = <1920>;
	};
};

&i2c_master_hub_0 {
	status = "okay";
};

&i2c_hub_3 {
	clock-frequency = <400000>;
	status = "okay";
	htr3212r: led-controller@3c {
		compatible = "heroic,htr3212";
		reg = <0x3c>;
		#address-cells = <1>;
		#size-cells = <0>;
		sdb-gpios = <&tlmm 88 GPIO_ACTIVE_HIGH>;
		vdd-supply = <&vdd_mcu_3v3>;

		ledr_b1: led@1 {
			reg = <1>;
			label = "r:r1";
			color = <LED_COLOR_ID_RED>;
		};
		ledr_g1: led@2 {
			reg = <2>;
			label = "r:g1";
			color = <LED_COLOR_ID_GREEN>;
		};
		ledr_r1: led@3 {
			reg = <3>;
			label = "r:b1";
			color = <LED_COLOR_ID_BLUE>;
		};
		ledr_b2: led@4 {
			reg = <4>;
			label = "r:r2";
			color = <LED_COLOR_ID_RED>;
		};
		ledr_g2: led@5 {
			reg = <5>;
			label = "r:g2";
			color = <LED_COLOR_ID_GREEN>;
		};
		ledr_r2: led@6 {
			reg = <6>;
			label = "r:b2";
 			color = <LED_COLOR_ID_BLUE>;
		};
		ledr_b3: led@7 {
			reg = <7>;
			label = "r:r3";
			color = <LED_COLOR_ID_RED>;
		};
		ledr_g3: led@8 {
			reg = <8>;
			label = "r:g3";
			color = <LED_COLOR_ID_GREEN>;
		};
		ledr_r3: led@9 {
			reg = <9>;
			label = "r:b3";
			color = <LED_COLOR_ID_BLUE>;
		};
		ledr_b4: led@10 {
			reg = <10>;
			label = "r:r4";
			color = <LED_COLOR_ID_RED>;
		};
		ledr_g4: led@11 {
			reg = <11>;
			label = "r:g4";
			color = <LED_COLOR_ID_GREEN>;
		};
		ledr_r4: led@12 {
			reg = <12>;
			label = "r:b4";
			color = <LED_COLOR_ID_BLUE>;
		};
	};
};

&i2c_hub_4 {
	clock-frequency = <400000>;
	status = "okay";

	htr3212l: led-controller@3c {
		compatible = "heroic,htr3212";
		reg = <0x3c>;
		#address-cells = <1>;
		#size-cells = <0>;
		sdb-gpios = <&tlmm 87 GPIO_ACTIVE_HIGH>;
		vdd-supply = <&vdd_mcu_3v3>;

		ledl_b1: led@1 {
			reg = <1>;
			label = "l:r1";
			color = <LED_COLOR_ID_RED>;
		};
		ledl_g1: led@2 {
			reg = <2>;
			label = "l:g1";
			color = <LED_COLOR_ID_GREEN>;
		};
		ledl_r1: led@3 {
			reg = <3>;
			label = "l:b1";
			color = <LED_COLOR_ID_BLUE>;
		};
		ledl_b2: led@4 {
			reg = <4>;
			label = "l:r2";
			color = <LED_COLOR_ID_RED>;
		};
		ledl_g2: led@5 {
			reg = <5>;
			label = "l:g2";
			color = <LED_COLOR_ID_GREEN>;
		};
		ledl_r2: led@6 {
			reg = <6>;
			label = "l:b2";
			color = <LED_COLOR_ID_BLUE>;
		};
		ledl_b3: led@7 {
			reg = <7>;
			label = "l:r3";
			color = <LED_COLOR_ID_RED>;
		};
		ledl_g3: led@8 {
			reg = <8>;
			label = "l:g3";
			color = <LED_COLOR_ID_GREEN>;
		};
		ledl_r3: led@9 {
			reg = <9>;
			label = "l:b3";
			color = <LED_COLOR_ID_BLUE>;
		};
		ledl_b4: led@10 {
			reg = <10>;
			label = "l:r4";
			color = <LED_COLOR_ID_RED>;
		};
		ledl_g4: led@11 {
			reg = <11>;
			label = "l:g4";
			color = <LED_COLOR_ID_GREEN>;
		};
		ledl_r4: led@12 {
			reg = <12>;
			label = "l:b4";
			color = <LED_COLOR_ID_BLUE>;
		};
	};
};

&display_panel {
	compatible = "chipone,icna3520";

	reset-gpios = <&tlmm 98 GPIO_ACTIVE_LOW>;

	vddio-supply = <&vreg_l12b_1p8>;
	vci-supply = <&vreg_l13b_3p0>;
	vdd-supply = <&vreg_l11b_1p0>;
	disp-supply = <&vdd_disp_2v8>;
	blvdd-supply = <&vdd_bl_5v0>;

	pinctrl-0 = <&disp0_reset_n_active>, <&mdp_vsync_active>;
	pinctrl-1 = <&disp0_reset_n_suspend>, <&mdp_vsync_suspend>;
	pinctrl-names = "default", "sleep";

	rotation = <90>;
};

&remoteproc_adsp {
	firmware-name = "qcom/sm8750/ayn/odin3/adsp.mbn",
			"qcom/sm8750/ayn/odin3/adsp_dtb.mbn";

	status = "okay";

	/* Kettle: a non-secure ADSP fastrpc device (/dev/fastrpc-adsp), as sm8550.dtsi has, for
	 * hexagonrpcd to serve the sensors process its files (kettle-motion: the gyro). sm8750.dtsi
	 * leaves it secure only (/dev/fastrpc-adsp-secure). */
	glink-edge {
		fastrpc {
			qcom,non-secure-domain;
		};
	};
};

/* Kettle: the CDSP is off, as on the Pocket FIT Elite (whose CDSP firmware crash-looped at every
 * start and starved the system). Nothing Kettle runs uses the compute DSP. */
&remoteproc_cdsp {
	firmware-name = "qcom/sm8750/ayn/odin3/cdsp.mbn",
			"qcom/sm8750/ayn/odin3/cdsp_dtb.mbn";

	status = "disabled";
};

&spk_amp_l {
	firmware-name = "qcom/sm8750/ayn/odin3/aw883xx_acf.bin";
};

&spk_amp_r {
	firmware-name = "qcom/sm8750/ayn/odin3/aw883xx_acf.bin";
};

&tlmm {
	disp0_reset_n_active: disp0-reset-n-active-state {
		pins = "gpio98";
		function = "gpio";
		drive-strength = <8>;
		bias-disable;
	};

	disp0_reset_n_suspend: disp0-reset-n-suspend-state {
		pins = "gpio98";
		function = "gpio";
		drive-strength = <2>;
		bias-pull-down;
	};

	mdp_vsync_active: mdp-vsync-active-state {
		pins = "gpio86";
		function = "mdp_vsync";
		drive-strength = <2>;
		bias-pull-down;
	};

	mdp_vsync_suspend: mdp-vsync-suspend-state {
		pins = "gpio86";
		function = "mdp_vsync";
		drive-strength = <2>;
		bias-pull-down;
	};

	ts_p_rst_default: ts-p-rst-default-state {
		pins = "gpio161";
		function = "gpio";
		bias-pull-up;
		drive-strength = <8>;
	};

	ts_p_rst_sleep: ts-p-rst-sleep-state {
		pins = "gpio161";
		function = "gpio";
		bias-pull-down;
		drive-strength = <2>;
	};

	ts_p_int_default: ts-p-int-default-state {
		pins = "gpio162";
		function = "gpio";
		bias-pull-up;
		drive-strength = <8>;
	};

	ts_p_int_sleep: ts-p-int-sleep-state {
		pins = "gpio162";
		function = "gpio";
		bias-pull-down;
		drive-strength = <2>;
	};

	paddle_keys_default: paddle-keys-default-state {
		pins = "gpio3", "gpio7";
		function = "gpio";
		bias-pull-up;
		drive-strength = <2>;
	};
};

/*
 * AYN Odin 3 has two extra back paddles (M1, M2) below the shoulder
 * triggers. They are plain active-low SoC TLMM GPIOs (M1 = GPIO_3,
 * M2 = GPIO_7), not on the gamepad MCU UART and not ADC (despite AYN's
 * Android "adckey"/keydetect.ko naming). Expose them as a gpio-keys
 * device emitting BTN_Z (M1, left) / BTN_C (M2, right); ROCKNIX's
 * InputPlumber map (ayn_mcu.yaml) already routes BTN_Z -> LeftPaddle1 and
 * BTN_C -> RightPaddle1. RE'd from the AYN Android keydetect driver
 * (gpio_request 515/519 = TLMM base 512 + offsets 3/7).
 */
/ {
	gpio-keys-paddles {
		compatible = "gpio-keys";
		pinctrl-names = "default";
		pinctrl-0 = <&paddle_keys_default>;

		key-paddle-m1 {
			label = "Back Paddle M1";
			linux,code = <BTN_Z>;
			gpios = <&tlmm 3 GPIO_ACTIVE_LOW>;
			debounce-interval = <15>;
		};

		key-paddle-m2 {
			label = "Back Paddle M2";
			linux,code = <BTN_C>;
			gpios = <&tlmm 7 GPIO_ACTIVE_LOW>;
			debounce-interval = <15>;
		};
	};
};

/* The codec keeps these rails enabled through s2idle; idle them in LPM */
&vreg_bob1 {
	regulator-state-mem {
		regulator-on-in-suspend;
		regulator-mode = <RPMH_REGULATOR_MODE_LPM>;
	};
};

&vreg_l15b_1p8 {
	regulator-state-mem {
		regulator-on-in-suspend;
		regulator-mode = <RPMH_REGULATOR_MODE_LPM>;
	};
};

&vreg_l2i_1p2 {
	regulator-state-mem {
		regulator-on-in-suspend;
		regulator-mode = <RPMH_REGULATOR_MODE_LPM>;
	};
};

&vreg_s3g_1p8 {
	regulator-state-mem {
		regulator-on-in-suspend;
		regulator-mode = <RPMH_REGULATOR_MODE_LPM>;
	};
};

&vreg_s7i_1p2 {
	regulator-state-mem {
		regulator-on-in-suspend;
		regulator-mode = <RPMH_REGULATOR_MODE_LPM>;
	};
};

/* Replaces the bootloader's early SoCCP image, which blocks SoC deep sleep */
&remoteproc_soccp {
	firmware-name = "qcom/sm8750/ayn/odin3/soccp.mbn";
};

/* The RGB light on PMIC LPG channels 1-3 (channel 4 is the fan's PWM), Armada's charge LED. Kettle
 * names it power-led, as on the Portal and the Pocket FIT Elite, with no kernel trigger: kettle-ledd
 * is its one writer (Device Settings' Lights tab; its "charging" mode is Armada's trigger) */
&pm8550_pwm {
	multi-led {
		color = <LED_COLOR_ID_RGB>;
		label = "power-led";

		#address-cells = <1>;
		#size-cells = <0>;

		led@1 {
			reg = <1>;
			color = <LED_COLOR_ID_RED>;
		};

		led@2 {
			reg = <2>;
			color = <LED_COLOR_ID_GREEN>;
		};

		led@3 {
			reg = <3>;
			color = <LED_COLOR_ID_BLUE>;
		};
	};
};

/* wcd939x has no DMIC input widget; without one DAPM never powers DMIC3 */
&{/sound} {
	widgets = "Microphone", "Internal Mic";
	audio-routing = "IN1_HPHL", "HPHL_OUT",
			"IN2_HPHR", "HPHR_OUT",
			"AMIC2", "MIC BIAS2",
			"TX SWR_INPUT1", "ADC2_OUTPUT",
			"DMIC3", "Internal Mic",
			"DMIC3", "MIC BIAS3",
			"TX SWR_INPUT6", "DMIC3_OUTPUT";
};

/* ===== Kettle's changes, the same as on the Pocket FIT Elite (sm8750-konkr-pf-elite.dts) ===== */

/*
 * The crypto engine (QCE) has no driver from Linux 7.3 on (CRYPTO_DEV_QCE depends on BROKEN).
 * Left enabled, the node never probes, so the interconnect providers it uses never reach
 * sync_state and keep DDR voted at its maximum: DDR stays at its top clock and the SoC never
 * reaches CX, AOSS or DDR collapse in s2idle (the Pocket FIT Elite also hung in suspend).
 */
&crypto {
	status = "disabled";
};

/* At most 100 MHz (SDR50): at SDR104 the Pocket FIT Elite read cards with I/O errors every few
 * seconds on its first boots. Same SoC and SD controller; to be re-tested at SDR104 here. */
&sdhc_2 {
	max-frequency = <100000000>;
};

/* Linux 7.3 made the SM8750 USB controller a wakeup source; keep 7.2's behaviour */
&usb {
	/delete-property/ wakeup-source;
};

/* No wake-gpios (WAKE#, gpio104 active low): Linux 7.3 arms it as a wakeup IRQ, enabled by
 * default, and nothing here wants Wi-Fi to wake the device */
&pcieport0 {
	/delete-property/ wake-gpios;
};

/* The CoreSight trace network's TNOC off: Kettle builds no CoreSight drivers, and with
 * fw_devlink.strict=1 PCIe (Wi-Fi) once waited on one of its endpoints forever. 40-kettle/1430
 * fixed the cause; this stays as a second guard, as on the Pocket FIT Elite. */
&{/soc@0/tn@109ab000} {
	status = "disabled";
};

#include "cq8725s-ayn-odin3-fan.dtsi"
