From: Kettle Linux
Subject: [PATCH] drm/panel: icna35xx: experimental uncompressed video mode

In video mode with DSC (1435, 1437, 1438) the Thor's top panel showed the
picture under noise repeating every 12 rows, its DSC slice height: the
decoder loses sync inside each slice. video_mode=3 drives the panel in video
mode bypassing GRAM without DSC: no DSC config for the DSI host, the
standard compression mode command (off) instead of the PPS, and on the
ICNA3520 60 and 90 Hz modes with a short front porch, since the panel's
input tops out near 1.3 Gbps a lane (216 MHz RGB888 over 4 lanes).
---
--- a/drivers/gpu/drm/panel/panel-chipone-icna35xx.c	2026-10-12 06:32:15.509559631 -0500
+++ b/drivers/gpu/drm/panel/panel-chipone-icna35xx.c	2026-10-12 06:32:23.274808059 -0500
@@ -64,7 +64,7 @@
  */
 static unsigned int video_mode;
 module_param(video_mode, uint, 0444);
-MODULE_PARM_DESC(video_mode, "DSI video mode (experimental): 0 command mode, 1 video bypassing the panel's GRAM, 2 video through GRAM");
+MODULE_PARM_DESC(video_mode, "DSI video mode (experimental): 0 command mode, 1 video bypassing the panel's GRAM, 2 video through GRAM, 3 video bypassing GRAM without DSC");
 
 static unsigned int vrr_min_hz;
 module_param(vrr_min_hz, uint, 0444);
@@ -81,7 +81,7 @@
 {
 	u8 buf[2] = { 0x48, hfr };
 
-	if (video_mode == 1)
+	if (video_mode == 1 || video_mode == 3)
 		buf[1] |= 0x03;
 	else if (video_mode == 2)
 		buf[1] |= 0x02;
@@ -105,7 +105,7 @@
 	u8 buf[1 + 32];
 	int i;
 
-	if (!video_mode)
+	if (!video_mode || video_mode == 3)
 		return;
 
 	drm_dsc_pps_payload_pack(&pps, dsc);
@@ -233,8 +233,13 @@
 			icna35xx_write_dsim(&dsi_ctx, 0x30);
 	}
 
-	drm_dsc_pps_payload_pack(&pps, &pinfo->desc->dsc);
-	mipi_dsi_picture_parameter_set_multi(&dsi_ctx, &pps);
+	if (video_mode == 3) {
+		/* uncompressed video: the DSI host sends plain RGB */
+		mipi_dsi_compression_mode_multi(&dsi_ctx, false);
+	} else {
+		drm_dsc_pps_payload_pack(&pps, &pinfo->desc->dsc);
+		mipi_dsi_picture_parameter_set_multi(&dsi_ctx, &pps);
+	}
 
 	mipi_dsi_msleep(&dsi_ctx, 20);
 
@@ -291,8 +296,13 @@
 	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0xBB, 0x01);
 	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0xB2, 0x24);
 
-	drm_dsc_pps_payload_pack(&pps, &pinfo->desc->dsc);
-	mipi_dsi_picture_parameter_set_multi(&dsi_ctx, &pps);
+	if (video_mode == 3) {
+		/* uncompressed video: the DSI host sends plain RGB */
+		mipi_dsi_compression_mode_multi(&dsi_ctx, false);
+	} else {
+		drm_dsc_pps_payload_pack(&pps, &pinfo->desc->dsc);
+		mipi_dsi_picture_parameter_set_multi(&dsi_ctx, &pps);
+	}
 	
 	mipi_dsi_msleep(&dsi_ctx, 20);
 
@@ -440,6 +450,39 @@
 	},
 };
 
+/*
+ * video_mode=3, uncompressed: the panel's MIPI input tops out near 1.3 Gbps
+ * a lane (ICNA3512 datasheet, UI 0.77 ns min), so RGB888 over 4 lanes fits
+ * a pixel clock up to about 216 MHz. The 120 Hz mode's 268 MHz does not;
+ * these keep its horizontal timing and back porch with a short front porch.
+ */
+static const struct drm_display_mode icna3520_video_modes[] = {
+	{
+		.clock = (1080 + 24 + 1 + 24) * (1920 + 28 + 1 + 28) * 60 / 1000,
+		.hdisplay = 1080,
+		.hsync_start = 1080 + 24,
+		.hsync_end = 1080 + 24 + 1,
+		.htotal = 1080 + 24 + 1 + 24,
+		.vdisplay = 1920,
+		.vsync_start = 1920 + 28,
+		.vsync_end = 1920 + 28 + 1,
+		.vtotal = 1920 + 28 + 1 + 28,
+	},
+	{
+		.clock = (1080 + 24 + 1 + 24) * (1920 + 28 + 1 + 28) * 90 / 1000,
+		.hdisplay = 1080,
+		.hsync_start = 1080 + 24,
+		.hsync_end = 1080 + 24 + 1,
+		.htotal = 1080 + 24 + 1 + 24,
+		.vdisplay = 1920,
+		.vsync_start = 1920 + 28,
+		.vsync_end = 1920 + 28 + 1,
+		.vtotal = 1920 + 28 + 1 + 28,
+	},
+};
+
+static struct panel_desc icna3520_video_desc;
+
 static void icna35xx_reset(struct panel_info *pinfo)
 {
 	gpiod_set_value_cansleep(pinfo->reset_gpio, 0);
@@ -654,6 +697,12 @@
 	pinfo->desc = (struct panel_desc *)of_device_get_match_data(dev);
 	if (!pinfo->desc)
 		return -ENODEV;
+	if (video_mode == 3 && pinfo->desc == &icna3520_desc) {
+		icna3520_video_desc = icna3520_desc;
+		icna3520_video_desc.modes = icna3520_video_modes;
+		icna3520_video_desc.num_modes = ARRAY_SIZE(icna3520_video_modes);
+		pinfo->desc = &icna3520_video_desc;
+	}
 
 	pinfo->dsi = dsi;
 	mipi_dsi_set_drvdata(dsi, pinfo);
@@ -683,10 +732,12 @@
 		 * (qcom,mdss-dsc-slice-per-pkt = 2); in video mode the panel
 		 * shows noise with one packet a slice.
 		 */
-		pinfo->dsi->dsc_slice_per_pkt = 2;
+		if (video_mode != 3)
+			pinfo->dsi->dsc_slice_per_pkt = 2;
 		dev_info(dev, "video mode (experimental)\n");
 	}
-    pinfo->dsi->dsc = &pinfo->desc->dsc;
+	if (video_mode != 3)
+		pinfo->dsi->dsc = &pinfo->desc->dsc;
 
     ret = mipi_dsi_attach(pinfo->dsi);
     if (ret < 0){
