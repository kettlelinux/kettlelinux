From: Kettle Linux
Subject: [PATCH] drm/msm/dpu: experimental single DSC encoder for one interface

msm always gives a DSC panel two DSC encoders and two layer mixers merged
into one interface when the SoC has two encoders. Qualcomm's Android drives
the AYN Thor's ICNA3520 with one of each (display-topology 1 1 1), both
slices from one encoder. In video mode (1435) the panel decodes each
12-row slice into noise; msm.dpu_dsc_single=1, off by default, gives a
single-interface DSC panel one encoder (and so one mixer) to compare.
---
--- a/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder.c	2026-10-12 07:29:37.603991027 -0500
+++ b/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder.c	2026-10-12 07:29:37.613589534 -0500
@@ -678,6 +678,15 @@
 	return NULL;
 }
 
+/*
+ * Experimental: one DSC encoder for a single-interface panel, as Qualcomm's
+ * Android drives the AYN Thor's ICNA3520 (display-topology 1 1 1), instead
+ * of two merged. Two slices then come from one encoder.
+ */
+static bool dpu_dsc_single;
+module_param(dpu_dsc_single, bool, 0444);
+MODULE_PARM_DESC(dpu_dsc_single, "One DSC encoder for a single-interface DSC panel (experimental)");
+
 void dpu_encoder_update_topology(struct drm_encoder *drm_enc,
 				 struct msm_display_topology *topology,
 				 struct drm_atomic_commit *state,
@@ -711,7 +720,9 @@
 		 */
 		WARN(topology->num_intf > 2,
 		     "DSC topology cannot support more than 2 interfaces\n");
-		if (topology->num_intf >= 2 || dpu_kms->catalog->dsc_count >= 2)
+		if (dpu_dsc_single && topology->num_intf == 1)
+			topology->num_dsc = 1;
+		else if (topology->num_intf >= 2 || dpu_kms->catalog->dsc_count >= 2)
 			topology->num_dsc = 2;
 		else
 			topology->num_dsc = 1;
