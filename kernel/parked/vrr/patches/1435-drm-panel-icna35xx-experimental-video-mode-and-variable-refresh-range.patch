From: Kettle Linux
Subject: [PATCH] drm/panel: icna35xx: experimental video mode and variable refresh range

Android and this driver run the ICNA3512 (Portal) and ICNA3520 (Thor top)
in command mode, where the DPU's AVR variable refresh (1430) does not
apply. Chipone's ICNA3512 datasheet: 48h WRDSIM bits 1:0 select the
interface (00 command mode through GRAM, 10 video mode through GRAM, 11
video mode bypassing GRAM), bits 5:4 the timing set; the vendor's video
init writes 48 33 before sleep out. Every 0x48 write now goes through one
helper, and two module parameters, both off by default, try video mode:
video_mode=1 (bypass GRAM) or 2 (through GRAM) sets MIPI_DSI_MODE_VIDEO and
the DSI_MODE bits; vrr_min_hz=N (video mode only) declares a range from N
up to the fastest mode and sets the connector's vrr_capable.
---
diff --git a/drivers/gpu/drm/panel/panel-chipone-icna35xx.c b/drivers/gpu/drm/panel/panel-chipone-icna35xx.c
index 707c5d1..b8dc949 100644
--- a/drivers/gpu/drm/panel/panel-chipone-icna35xx.c
+++ b/drivers/gpu/drm/panel/panel-chipone-icna35xx.c
@@ -56,6 +56,38 @@ struct panel_desc {
 	u16 bl_min;
 };
 
+/*
+ * Experimental: Android and this driver run these panels in command mode,
+ * where the DPU's AVR (variable refresh) does not apply. video_mode=1 drives
+ * them in video mode instead; vrr_min_hz then declares a refresh range from
+ * that floor up to the fastest mode and sets the connector's vrr_capable.
+ */
+static unsigned int video_mode;
+module_param(video_mode, uint, 0444);
+MODULE_PARM_DESC(video_mode, "DSI video mode (experimental): 0 command mode, 1 video bypassing the panel's GRAM, 2 video through GRAM");
+
+static unsigned int vrr_min_hz;
+module_param(vrr_min_hz, uint, 0444);
+MODULE_PARM_DESC(vrr_min_hz, "Variable refresh floor in Hz, video mode only (0: none)");
+
+/*
+ * 48h WRDSIM: bits 5:4 pick the timing set (HFR_MODE: normal, HF1-HF3),
+ * bits 1:0 the interface (DSI_MODE: 00 command mode through GRAM, 10 video
+ * mode through GRAM, 11 video mode bypassing GRAM), per Chipone's ICNA3512
+ * datasheet. Every rate this driver sets is written through here, so video
+ * mode keeps the rate's HFR_MODE.
+ */
+static void icna35xx_write_dsim(struct mipi_dsi_multi_context *dsi_ctx, u8 hfr)
+{
+	u8 buf[2] = { 0x48, hfr };
+
+	if (video_mode == 1)
+		buf[1] |= 0x03;
+	else if (video_mode == 2)
+		buf[1] |= 0x02;
+	mipi_dsi_generic_write_multi(dsi_ctx, buf, sizeof(buf));
+}
+
 static const struct regulator_bulk_data panel_supplies[] = {
 	{ .supply = "vdd" },
 	{ .supply = "vddio" },
@@ -103,11 +135,14 @@ static int icna3512_init_sequence(struct panel_info *pinfo)
 
     mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0x9C, 0xA5, 0xA5);
     mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0xFD, 0x5A, 0x5A);
-	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0x48, 0x00);
+	icna35xx_write_dsim(&dsi_ctx, 0x00);
 
 	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0x53, 0xE0);
     mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0x35, 0x00);
 
+	/* the vendor's video-mode init selects the interface before sleep out */
+	if (video_mode)
+		icna35xx_write_dsim(&dsi_ctx, 0x00);
 	mipi_dsi_dcs_exit_sleep_mode_multi(&dsi_ctx);
 
 	mipi_dsi_msleep(&dsi_ctx, 120);
@@ -126,7 +161,7 @@ static int icna3512_init_sequence(struct panel_info *pinfo)
 	 */
 	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0x9F, 0x01);
 	if (cur_vrefresh == 165) {
-		mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0x48, 0x20);
+		icna35xx_write_dsim(&dsi_ctx, 0x20);
 	}
 	else if (cur_vrefresh == 120) {
 		mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0xB3, 
@@ -143,8 +178,8 @@ static int icna3512_init_sequence(struct panel_info *pinfo)
                 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00);
         mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0xCE,
                 0x01, 0x01, 0x01, 0x01, 0x04, 0x09, 0x2C);
-        mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0x48, 0x00);
-        mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0x48, 0x30);
+        icna35xx_write_dsim(&dsi_ctx, 0x00);
+        icna35xx_write_dsim(&dsi_ctx, 0x30);
 	}
 	else {
         mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0xB3, 
@@ -157,12 +192,12 @@ static int icna3512_init_sequence(struct panel_info *pinfo)
                 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00);
         mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0xCB,
                 0x01, 0x01, 0x01, 0x01, 0x04, 0x09, 0x2C);
-        mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0x48, 0x30);
-        mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0x48, 0x00);
+        icna35xx_write_dsim(&dsi_ctx, 0x30);
+        icna35xx_write_dsim(&dsi_ctx, 0x00);
 		if (cur_vrefresh == 50)
-			mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0x48, 0x10);
+			icna35xx_write_dsim(&dsi_ctx, 0x10);
 		else if (cur_vrefresh == 145)
-			mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0x48, 0x30);
+			icna35xx_write_dsim(&dsi_ctx, 0x30);
 	}
 
 	drm_dsc_pps_payload_pack(&pps, &pinfo->desc->dsc);
@@ -191,18 +226,21 @@ static int icna3520_init_sequence(struct panel_info *pinfo)
 	mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0x53, 0xE0);
     mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0x35, 0x00);
 
+	/* the vendor's video-mode init selects the interface before sleep out */
+	if (video_mode)
+		icna35xx_write_dsim(&dsi_ctx, 0x00);
 	mipi_dsi_dcs_exit_sleep_mode_multi(&dsi_ctx);
 
 	mipi_dsi_msleep(&dsi_ctx, 120);
 
 	if (cur_vrefresh == 120) {
-		mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0x48, 0x00);
+		icna35xx_write_dsim(&dsi_ctx, 0x00);
 		mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0x9F, 0x00);
 		mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0xB3, 
                 0x00, 0xD8, 0x00, 0x1C, 0x00, 0x4C);
 	}
 	else {
-		mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0x48, 0x10);
+		icna35xx_write_dsim(&dsi_ctx, 0x10);
 		mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0x9F, 0x00);
 		mipi_dsi_generic_write_seq_multi(&dsi_ctx, 0xB3, 
                 0x00, 0xDB, 0x00, 0x1C, 0x00, 0x1C, 0x00, 0x00,
@@ -467,6 +505,20 @@ static int icna35xx_get_modes(struct drm_panel *panel,
 	connector->display_info.width_mm = pinfo->desc->width_mm;
 	connector->display_info.height_mm = pinfo->desc->height_mm;
 	connector->display_info.bpc = pinfo->desc->bpc;
+	if (video_mode && vrr_min_hz) {
+		unsigned int max_hz = 0;
+
+		/* Rounded up, so the fastest mode reads as inside the range. */
+		for (i = 0; i < pinfo->desc->num_modes; i++) {
+			const struct drm_display_mode *m = &pinfo->desc->modes[i];
+
+			max_hz = max_t(unsigned int, max_hz,
+				       DIV_ROUND_UP(m->clock * 1000, m->htotal * m->vtotal));
+		}
+		connector->display_info.monitor_range.min_vfreq = vrr_min_hz;
+		connector->display_info.monitor_range.max_vfreq = max_hz;
+		drm_connector_set_vrr_capable_property(connector, true);
+	}
 	pinfo->connector = connector;
 
 	return pinfo->desc->num_modes;
@@ -589,6 +641,10 @@ static int icna35xx_probe(struct mipi_dsi_device *dsi)
     pinfo->dsi->lanes = pinfo->desc->lanes;
     pinfo->dsi->format = pinfo->desc->format;
     pinfo->dsi->mode_flags = pinfo->desc->mode_flags;
+	if (video_mode) {
+		pinfo->dsi->mode_flags |= MIPI_DSI_MODE_VIDEO;
+		dev_info(dev, "video mode (experimental)\n");
+	}
     pinfo->dsi->dsc = &pinfo->desc->dsc;
 
     ret = mipi_dsi_attach(pinfo->dsi);
