From: Kettle Linux
Subject: [PATCH] drm/panel: icna35xx: debugfs register access

The ICNA3512 datasheet lists command-mode variable refresh controls (6Bh
WRQSYNC, 6Dh WRQSYNCTO with a TE extension timeout, 91h WRVR_CTRL, 69h
WRMSYNC, 63h WRLTPOMD) and status reads (05h, 0Eh, 0Fh, 49h, 8Fh
RDERRFLAG). icna35xx_regs in the connector's debugfs sends one write or read
at a time while the panel is on, so they can be tried live instead of one
boot each: "w 6b 01", "d 29", "r 0a 1", "g c0 2"; reading the file gives
the result.
---
--- a/drivers/gpu/drm/panel/panel-chipone-icna35xx.c	2026-10-12 16:12:45.385811456 -0500
+++ b/drivers/gpu/drm/panel/panel-chipone-icna35xx.c	2026-10-12 16:12:45.401379169 -0500
@@ -6,6 +6,7 @@
  */
 
 #include <linux/backlight.h>
+#include <linux/debugfs.h>
 #include <linux/delay.h>
 #include <linux/gpio/consumer.h>
 #include <linux/module.h>
@@ -32,6 +33,10 @@
 
 	struct gpio_desc *reset_gpio;
 	struct regulator_bulk_data *supplies;
+
+	/* debugfs icna35xx_regs: the last command's result */
+	struct mutex dbg_lock;
+	char dbg_result[160];
 };
 
 struct panel_desc {
@@ -643,7 +648,115 @@
 	return pinfo->orientation;
 }
 
+/*
+ * debugfs icna35xx_regs, for finding the panel's variable refresh controls
+ * (Qsync 6Bh/6Dh, VR 91h, MSYNC 69h, LTPO 63h) and reading its status.
+ * Write one command a line, hex bytes:
+ *   w 6b 01    generic write (vendor registers; select a group with w 9f NN)
+ *   d 29       DCS write
+ *   r 0a 1     DCS read of 1 byte
+ *   g c0 2     generic read of 2 bytes
+ * and read the file for the result. Refused while the panel is off.
+ */
+static ssize_t icna35xx_regs_write(struct file *file, const char __user *ubuf,
+				   size_t len, loff_t *ppos)
+{
+	struct panel_info *pinfo = file->private_data;
+	struct mipi_dsi_device *dsi = pinfo->dsi;
+	char kbuf[256], *p, *tok;
+	u8 bytes[64], rb[32];
+	int n = 0, ret, i, cnt;
+	size_t pos;
+	char op;
+
+	if (!len || len >= sizeof(kbuf))
+		return -EINVAL;
+	if (copy_from_user(kbuf, ubuf, len))
+		return -EFAULT;
+	kbuf[len] = 0;
+	p = strim(kbuf);
+	op = *p++;
+	while ((tok = strsep(&p, " \t\n")) != NULL) {
+		unsigned int v;
+
+		if (!*tok)
+			continue;
+		if (n >= ARRAY_SIZE(bytes) || kstrtouint(tok, 16, &v) || v > 0xff)
+			return -EINVAL;
+		bytes[n++] = v;
+	}
+	if (!n)
+		return -EINVAL;
+	if (!pinfo->panel.prepared)
+		return -ENODEV;
+
+	mutex_lock(&pinfo->dbg_lock);
+	switch (op) {
+	case 'w':
+	case 'd':
+		dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
+		if (op == 'w')
+			ret = mipi_dsi_generic_write(dsi, bytes, n);
+		else
+			ret = mipi_dsi_dcs_write_buffer(dsi, bytes, n);
+		dsi->mode_flags |= MIPI_DSI_MODE_LPM;
+		snprintf(pinfo->dbg_result, sizeof(pinfo->dbg_result), "%c %02x: %d\n",
+			 op, bytes[0], ret);
+		break;
+	case 'r':
+	case 'g':
+		cnt = clamp_t(int, n > 1 ? bytes[1] : 1, 1, (int)sizeof(rb));
+		if (op == 'r')
+			ret = mipi_dsi_dcs_read(dsi, bytes[0], rb, cnt);
+		else
+			ret = mipi_dsi_generic_read(dsi, bytes, 1, rb, cnt);
+		pos = scnprintf(pinfo->dbg_result, sizeof(pinfo->dbg_result), "%c %02x:",
+				op, bytes[0]);
+		if (ret < 0)
+			pos += scnprintf(pinfo->dbg_result + pos,
+					 sizeof(pinfo->dbg_result) - pos, " error %d", ret);
+		for (i = 0; ret > 0 && i < ret; i++)
+			pos += scnprintf(pinfo->dbg_result + pos,
+					 sizeof(pinfo->dbg_result) - pos, " %02x", rb[i]);
+		scnprintf(pinfo->dbg_result + pos, sizeof(pinfo->dbg_result) - pos, "\n");
+		break;
+	default:
+		ret = -EINVAL;
+	}
+	mutex_unlock(&pinfo->dbg_lock);
+
+	return ret < 0 ? ret : len;
+}
+
+static ssize_t icna35xx_regs_read(struct file *file, char __user *ubuf,
+				  size_t len, loff_t *ppos)
+{
+	struct panel_info *pinfo = file->private_data;
+	ssize_t ret;
+
+	mutex_lock(&pinfo->dbg_lock);
+	ret = simple_read_from_buffer(ubuf, len, ppos, pinfo->dbg_result,
+				      strlen(pinfo->dbg_result));
+	mutex_unlock(&pinfo->dbg_lock);
+	return ret;
+}
+
+static const struct file_operations icna35xx_regs_fops = {
+	.owner = THIS_MODULE,
+	.open = simple_open,
+	.read = icna35xx_regs_read,
+	.write = icna35xx_regs_write,
+};
+
+static void icna35xx_debugfs_init(struct drm_panel *panel, struct dentry *root)
+{
+	struct panel_info *pinfo = to_panel_info(panel);
+
+	debugfs_create_file("icna35xx_regs", 0600, root, pinfo, &icna35xx_regs_fops);
+}
+
 static const struct drm_panel_funcs icna35xx_panel_funcs = {
+	.debugfs_init = icna35xx_debugfs_init,
 	.disable = icna35xx_disable,
 	.prepare = icna35xx_prepare,
 	.unprepare = icna35xx_unprepare,
@@ -739,6 +852,7 @@
 	}
 
 	pinfo->dsi = dsi;
+	mutex_init(&pinfo->dbg_lock);
 	mipi_dsi_set_drvdata(dsi, pinfo);
 
 	ret = of_drm_get_panel_orientation(dev->of_node, &pinfo->orientation);
