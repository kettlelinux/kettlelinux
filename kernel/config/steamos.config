# SteamOS/Steam Portal additions merged on top of base.config (ROCKNIX SM8550).
# References: Valve's linux-72-deckard config (Steam Frame, IKCONFIG) and
# pocknix-os scripts/build-kernel.sh (hardware-debugged rationale for most of these).

CONFIG_LOCALVERSION="-steamportal"
CONFIG_HZ_1000=y

# sched_ext (scx-scheds / scx_lavd, as on SteamOS). BTF needs the debug-info
# choice visible (DEBUG_KERNEL); lavd resolves the 'runqueues' ksym (KALLSYMS_ALL),
# calls bpf_trace_printk (FTRACE + BPF_EVENTS) and attaches fentry programs
# (DYNAMIC_FTRACE direct calls on arm64).
CONFIG_DEBUG_KERNEL=y
CONFIG_KALLSYMS_ALL=y
# CONFIG_DEBUG_INFO_NONE is not set
CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT=y
# CONFIG_DEBUG_INFO_REDUCED is not set
CONFIG_DEBUG_INFO_BTF=y
CONFIG_BPF_JIT=y
CONFIG_SCHED_CLASS_EXT=y
CONFIG_SCHED_CLUSTER=y
CONFIG_FTRACE=y
CONFIG_FUNCTION_TRACER=y
CONFIG_DYNAMIC_FTRACE=y
CONFIG_KPROBES=y
CONFIG_KPROBE_EVENTS=y
CONFIG_UPROBE_EVENTS=y
CONFIG_PERF_EVENTS=y
CONFIG_BPF_EVENTS=y
# lavd drives per-core DVFS, which only schedutil honours
# CONFIG_CPU_FREQ_DEFAULT_GOV_PERFORMANCE is not set
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y

# Controllers
CONFIG_HID_STEAM=y
CONFIG_USBIP_CORE=m
CONFIG_USBIP_VHCI_HCD=m

# Lepton (Valve's Android container)
CONFIG_ANDROID=y
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder"

# SteamOS image layout: btrfs root (built in), RAUC bundles, verity, overlays
CONFIG_BTRFS_FS=y
CONFIG_OVERLAY_FS=y
CONFIG_EROFS_FS=y
CONFIG_BLK_DEV_DM=y
CONFIG_DM_VERITY=y
CONFIG_ZRAM=y
# SteamOS formats SD cards ext4 with casefold; won't mount without UNICODE
CONFIG_UNICODE=y

# microSD at UHS-I SDR104 via downstream sdhci-msm (patches 0210-0212)
CONFIG_MMC_SDHCI_MSM_DOWNSTREAM=y

# Arch linux-firmware ships .zst blobs
CONFIG_FW_LOADER_COMPRESS=y
CONFIG_FW_LOADER_COMPRESS_ZSTD=y
CONFIG_FW_LOADER_COMPRESS_XZ=y

# DSP remoteprocs must probe after the rootfs (firmware) is available
CONFIG_QCOM_Q6V5_PAS=m

# Suspend triage without a serial console (pm_wakeup_irq, pm_test)
CONFIG_PM_DEBUG=y
CONFIG_PM_SLEEP_DEBUG=y
