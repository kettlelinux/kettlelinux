# SteamOS/Kettle Linux additions merged on top of base.config (ROCKNIX SM8550).
# References: Valve's linux-72-deckard config (Steam Frame, IKCONFIG) and
# pocknix-os scripts/build-kernel.sh (hardware-debugged rationale for most of these).

CONFIG_LOCALVERSION="-kettle"
CONFIG_HZ_1000=y

# sched_ext (scx-scheds / scx_lavd, as on SteamOS). BTF needs the debug-info
# choice visible (DEBUG_KERNEL); lavd resolves the 'runqueues' ksym (KALLSYMS_ALL),
# calls bpf_trace_printk (FTRACE + BPF_EVENTS) and attaches fentry programs
# (DYNAMIC_FTRACE direct calls on arm64).
CONFIG_DEBUG_KERNEL=y
CONFIG_KALLSYMS_ALL=y
# CONFIG_DEBUG_INFO_NONE is not set
CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT=y
# CONFIG_DEBUG_INFO_REDUCED is not set
CONFIG_DEBUG_INFO_BTF=y
CONFIG_BPF_JIT=y
CONFIG_SCHED_CLASS_EXT=y
CONFIG_SCHED_CLUSTER=y
CONFIG_FTRACE=y
CONFIG_FUNCTION_TRACER=y
CONFIG_DYNAMIC_FTRACE=y
CONFIG_KPROBES=y
CONFIG_KPROBE_EVENTS=y
CONFIG_UPROBE_EVENTS=y
CONFIG_PERF_EVENTS=y
CONFIG_BPF_EVENTS=y
# conservative by default, on every device. It turns EAS off (EAS needs schedutil) but measured
# better in games: Portal, Skyrim at 60 fps, ~4.7% less power and ~5 instead of ~60 frames over
# 25 ms per 3 min, as it holds the mid cluster steady where schedutil dips it. Idle costs ~2% more
# (1.46 vs 1.44 W). Tested 2026-10-09. schedutil stays built in for EAS and scx_lavd's per-core DVFS.
# CONFIG_CPU_FREQ_DEFAULT_GOV_PERFORMANCE is not set
# CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL is not set
CONFIG_CPU_FREQ_DEFAULT_GOV_CONSERVATIVE=y
CONFIG_CPU_FREQ_GOV_CONSERVATIVE=y
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y

# Idle power (as ChromeOS/Android): offload RCU callbacks to kthreads and batch the
# non-urgent ones, so idle CPUs aren't woken every few ms just to run callbacks.
# RCU_NOCB_CPU is only visible with RCU_EXPERT (or NO_HZ_FULL).
CONFIG_RCU_EXPERT=y
CONFIG_RCU_NOCB_CPU=y
CONFIG_RCU_NOCB_CPU_DEFAULT_ALL=y
CONFIG_RCU_LAZY=y

# Controllers
CONFIG_HID_STEAM=y
CONFIG_USBIP_CORE=m
CONFIG_USBIP_VHCI_HCD=m

# Lepton (Valve's Android container)
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder"

# SteamOS image layout: btrfs root (built in), RAUC bundles, verity, overlays
CONFIG_BTRFS_FS=y
CONFIG_OVERLAY_FS=y
CONFIG_EROFS_FS=y
CONFIG_BLK_DEV_DM=y
CONFIG_DM_VERITY=y
CONFIG_ZRAM=y
# SteamOS formats SD cards ext4 with casefold; won't mount without UNICODE
CONFIG_UNICODE=y

# microSD at UHS-I SDR104 via downstream sdhci-msm (patches 0210-0212)
CONFIG_MMC_SDHCI_MSM_DOWNSTREAM=y

# Arch linux-firmware ships .zst blobs
CONFIG_FW_LOADER_COMPRESS=y
CONFIG_FW_LOADER_COMPRESS_ZSTD=y
CONFIG_FW_LOADER_COMPRESS_XZ=y

# DSP remoteprocs must probe after the rootfs (firmware) is available
CONFIG_QCOM_Q6V5_PAS=m

# Suspend triage without a serial console (pm_wakeup_irq, pm_test)
CONFIG_PM_DEBUG=y
CONFIG_PM_SLEEP_DEBUG=y

# External initramfs (mkinitcpio), not ROCKNIX's built-in one
CONFIG_INITRAMFS_SOURCE=""
CONFIG_RD_ZSTD=y

# Wi-Fi core as modules: built in, cfg80211 looks for regulatory.db before the
# rootfs is mounted and falls back to the restrictive world regdomain
CONFIG_CFG80211=m
CONFIG_MAC80211=m

# Custom fan curves (kettle-powerd): switching the fan's thermal zones to the user_space
# governor stops step_wise from driving pwm-fan while the daemon sets pwm1 itself;
# switching back to step_wise restores the device tree curve
CONFIG_THERMAL_GOV_USER_SPACE=y

# Core dumps carry each module's ELF headers (coredump_filter 0x33, as on SteamOS and most
# distributions): without their build IDs systemd-coredump's stack traces, and so
# kettle-crash's reports, name no function or library
CONFIG_CORE_DUMP_DEFAULT_ELF_HEADERS=y
