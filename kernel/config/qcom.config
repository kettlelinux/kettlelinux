# Qualcomm-only additions, merged after steamos.config in the qcom kernel flavour.

# microSD at UHS-I SDR104 via downstream sdhci-msm (patches 0210-0212)
CONFIG_MMC_SDHCI_MSM_DOWNSTREAM=y

# DSP remoteprocs must probe after the rootfs (firmware) is available
CONFIG_QCOM_Q6V5_PAS=m

# The Gunyah hypervisor's watchdog (SM8550, SM8750; qcom_scm registers it when Gunyah is there,
# nothing on the RP5's SM8250): systemd feeds it, so a hard hang resets the handheld
CONFIG_GUNYAH_WATCHDOG=y

# Lockup and hung task detectors (sysctl.d/60-kettle-panic.conf makes them panic, so the handheld
# reboots): a hang that leaves systemd running keeps the watchdog fed. The hard lockup detector
# is the buddy one here (CPUs checking each other; arm64 has no perf one without pseudo-NMIs)
CONFIG_SOFTLOCKUP_DETECTOR=y
CONFIG_HARDLOCKUP_DETECTOR=y
CONFIG_DETECT_HUNG_TASK=y
CONFIG_DEFAULT_HUNG_TASK_TIMEOUT=120
