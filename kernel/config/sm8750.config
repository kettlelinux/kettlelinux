# SM8750 (Snapdragon 8 Elite) support, merged on top of base.config (ROCKNIX's SM8550 config)
# and steamos.config by scripts/build-kernel.sh. Taken from ROCKNIX's
# devices/SM8750/linux/linux.aarch64.conf: the symbols it enables that base.config lacks,
# limited to what the KONKR Pocket FIT Elite uses (the Odin 3's CQ8725S, rsinput and haptics
# left out; coresight, QCOMTEE and the USB DWC2/PCI glue too).

# SoC: clocks, pinctrl and interconnect are needed before rootfs, so built in. The camera clock
# controller too, though nothing uses the camera: unbound it would keep GCC and rpmhpd from
# sync_state() (see sm8250.config)
CONFIG_SM_GCC_8750=y
CONFIG_SM_TCSRCC_8750=y
CONFIG_SM_DISPCC_8750=y
CONFIG_SM_GPUCC_8750=y
CONFIG_SM_VIDEOCC_8750=y
CONFIG_SM_CAMCC_8750=y
CONFIG_PINCTRL_SM8750=y
CONFIG_INTERCONNECT_QCOM_SM8750=y

# CPU frequency: SCMI perf over the CPUCP mailbox (no EPSS on SM8750)
CONFIG_QCOM_CPUCP_MBOX=y

# USB: the M31 eUSB2 PHY (the repeater on PMIH0108 is already in base.config) and the WCD9395's
# USB-C SBU/headphone switch
CONFIG_PHY_QCOM_M31_EUSB=y
CONFIG_TYPEC_MUX_WCD939X_USBSS=y

# Display: the 1080x1920 144 Hz panel (22-sm8750/0055) and its AW99706 backlight (0056/0057)
CONFIG_DRM_PANEL_AR14=y
CONFIG_BACKLIGHT_AW99706=y

# Input: the AYANEO gamepad MCU on SPI (0058), the system buttons and stick RGB MCU on UART
# (0069), the Chipone TDDI touchscreen (0061)
CONFIG_JOYSTICK_MCU=y
CONFIG_INPUT_KONKR_SYSBTN=y
CONFIG_TOUCHSCREEN_CHIPONE_TDDI=y

# Audio: AW88261 speaker amps on MI2S, WCD9395 headphone codec over SoundWire, LPASS LPI pins
# (SM8650's driver, the SM8750 node's fallback). Modules, as on SM8250 and SM8550.
CONFIG_SND_SOC_AW88261=y
CONFIG_SND_SOC_WCD939X=m
CONFIG_SND_SOC_WCD939X_SDW=m
CONFIG_PINCTRL_SM8650_LPASS_LPI=m
