# SM8250 (Snapdragon 865) support, merged on top of base.config (ROCKNIX's SM8550 config)
# and steamos.config by scripts/build-kernel.sh. Taken from ROCKNIX's
# devices/SM8250/linux/linux.aarch64.conf: the symbols it enables that base.config lacks,
# limited to what the Retroid Pocket 5 uses (Mangmi/Thor Lite drivers and Xen left out).

# SoC: clocks, pinctrl and interconnect are needed before rootfs, so built in.
CONFIG_SM_GCC_8250=y
CONFIG_SM_DISPCC_8250=y
CONFIG_SM_GPUCC_8250=y
CONFIG_SM_VIDEOCC_8250=y
# Not CONFIG_SM_CAMCC_8250: the camera clock controller (no camera here) is a consumer of rpmhpd
# and GCC, so leaving it unbound keeps them from sync_state() until fw_devlink.sync_state=timeout
# (device/rp5/device.conf) forces it. Built in, it let rpmhpd sync ~3 s into boot, and Wi-Fi
# (iwd, WPA) then failed every connect on 20261003.1; cause not yet found.
CONFIG_PINCTRL_SM8250=y
CONFIG_INTERCONNECT_QCOM_SM8250=y

# Audio: SM8250 sound card, WSA881x speaker amps, LPASS LPI pins. Modules, like ROCKNIX
# (built in they raced the ADSP and left the card silent on some boots).
CONFIG_PINCTRL_SM8250_LPASS_LPI=m
CONFIG_SND_SOC_SM8250=m
CONFIG_SND_SOC_WSA881X=m

# Wi-Fi: QCA6390 (ath11k over PCIe).
CONFIG_ATH11K=m
CONFIG_ATH11K_PCI=m

# RP5 gamepad MCU (21-sm8250/0008) and PM8150B haptics (21-sm8250/0009).
CONFIG_JOYSTICK_RETROID=m
CONFIG_INPUT_QCOM_SPMI_HAPTICS=y

# PM8150B charger and fuel gauge (21-sm8250/0011).
CONFIG_CHARGER_QCOM_SMB5=y
CONFIG_BATTERY_QCOM_FG=y

# USB-C ID/VBUS detection on PM8150B.
CONFIG_EXTCON_QCOM_SPMI_MISC=m

# No Qualcomm crypto engine (qcom_qce): on the RP5, iwd's WPA authentication failed on some
# builds ("wrong password"), and QCE is the suspect (it serves AF_ALG hmac/aes ahead of the CPU's
# ARMv8 crypto instructions, which are as fast here). One kernel serves every device, so this
# applies to the SM8550 devices too.
# CONFIG_CRYPTO_DEV_QCE is not set
