From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: 06n-arch <gennro2004@gmail.com>
Date: Sun, 27 Sep 2026 21:30:00 -0500
Subject: drm/panthor: Sky1: cached GPU memory, uncached imports

On top of CIX's coherency rework (00114). That rework runs Sky1's GPU in
ACE-Lite but with GPU-private memory attributes and, since the GPU has no
IOMMU, maps all GPU memory non-cacheable. Non-cacheable everything hides
the display artifacts that cached mappings showed, but costs about 7x on
every GPU workload (Skyrim SE via DXVK: ~7 fps -> ~50 fps with this).

Run Sky1 like upstream runs a Mali with a non-snooping display:

- Coherency protocol NONE, write-back GPU mappings (the non-coherent
  memattrs upstream uses), write-combined CPU mappings.
- Report the selected coherency to userspace. The rework left
  gpu_info.selected_coherency at 0 (ACE-Lite) everywhere, so Mesa skipped
  CPU cache maintenance.
- ACPI marks the GPU coherent (_CCA=1), so the DMA API skipped cache
  maintenance too, and dirty lines from shmem page zeroing were evicted
  later over GPU/display data (black blocks). Clear the device's DMA
  coherency so the maintenance happens. The devicetree boot gets this
  already: its GPU node isn't dma-coherent.
- The display controller (_CCA=0) allocates KWin's scanout buffers and
  misses GPU writes made through cached mappings. Map dma-bufs imported
  from other devices uncached; panthor's own exported BOs stay cached so
  all GPU mappings of a BO agree.

Tested on a Radxa Orion O6N: clean SDDM/Plasma/Steam, no GPU faults,
glmark2 and Skyrim SE correct.
---
 drivers/gpu/drm/panthor/panthor_device.h |  8 ++++++
 drivers/gpu/drm/panthor/panthor_gpu.c    | 35 +++++++++++++++++++-----
 drivers/gpu/drm/panthor/panthor_mmu.c    | 16 ++++-------
 3 files changed, 42 insertions(+), 17 deletions(-)

diff --git a/drivers/gpu/drm/panthor/panthor_device.h b/drivers/gpu/drm/panthor/panthor_device.h
index 99ab1eb67..b0b8e77df 100644
--- a/drivers/gpu/drm/panthor/panthor_device.h
+++ b/drivers/gpu/drm/panthor/panthor_device.h
@@ -183,6 +183,14 @@ struct panthor_device {
 	/** @coherency_mode: GPU bus coherency protocol. */
 	enum panthor_coherency_mode coherency_mode;
 
+	/**
+	 * @uncached_imports: Map dma-bufs imported from other devices
+	 * uncached on the GPU. Set on Sky1, whose display controller
+	 * allocates the scanout buffers, doesn't snoop, and misses GPU
+	 * writes made through cached mappings.
+	 */
+	bool uncached_imports;
+
 	/** @gpu_info: GPU information. */
 	struct drm_panthor_gpu_info gpu_info;
 
diff --git a/drivers/gpu/drm/panthor/panthor_gpu.c b/drivers/gpu/drm/panthor/panthor_gpu.c
index c40c78817..9443fa02b 100644
--- a/drivers/gpu/drm/panthor/panthor_gpu.c
+++ b/drivers/gpu/drm/panthor/panthor_gpu.c
@@ -18,6 +18,8 @@
 #include <drm/drm_print.h>
 
 #include "panthor_device.h"
+#include <linux/dma-map-ops.h>
+
 #include "panthor_gpu.h"
 #include "panthor_gpu_regs.h"
 #include "panthor_hw.h"
@@ -476,21 +478,40 @@ int panthor_gpu_coherency_init(struct panthor_device *ptdev)
 	bool dma_coherent = device_get_dma_attr(ptdev->base.dev) == DEV_DMA_COHERENT;
 
 	/*
-	 * Sky1 SoC: The GPU hardware supports full ACE (128/256-bit AMBA 4
-	 * ACE master), but the platform uses ACE-Lite (DT system-coherency=0).
-	 * The DPU is non-snooping and reads from SLC/DRAM, so ACE-Lite is the
-	 * correct choice: GPU L2 evictions route through HN-F and are absorbed
-	 * into the SLC, making WB data visible to the DPU without NC memattr.
+	 * Sky1: run the GPU non-coherent with cached (write-back) memory, as
+	 * upstream does for Mali with a non-snooping display (and as the
+	 * devicetree boot, without dma-coherent, ends up doing):
+	 *
+	 * - ACE-Lite with GPU-private attributes left stale GPU L2 copies of
+	 *   CPU-written data, so CIX mapped all GPU memory non-cacheable,
+	 *   which costs ~7x GPU performance.
+	 * - ACPI marks the GPU coherent (_CCA=1), which makes the DMA API skip
+	 *   CPU cache maintenance. With write-combined CPU mappings, the dirty
+	 *   lines from shmem page zeroing are then evicted later over GPU or
+	 *   display data (black blocks). Do the maintenance anyway.
+	 * - The display controller (_CCA=0) allocates the scanout buffers and
+	 *   doesn't see GPU writes made through cached mappings, so buffers
+	 *   imported from other devices are mapped uncached
+	 *   (panthor_vm_exec_map_op()).
 	 */
 	if (panthor_is_sky1(ptdev)) {
-		ptdev->coherency_mode = PANTHOR_COHERENCY_ACE_LITE;
-		drm_info(&ptdev->base, "Using ACE-Lite bus coherency (Sky1)\n");
+		ptdev->coherency_mode = PANTHOR_COHERENCY_NONE;
+		ptdev->uncached_imports = true;
+		dev_clear_dma_coherent(ptdev->base.dev);
+		dma_reset_need_sync(ptdev->base.dev);
+		drm_info(&ptdev->base,
+			 "Sky1: non-coherent GPU, cached memory, uncached imports\n");
 	} else if (!dma_coherent) {
 		ptdev->coherency_mode = PANTHOR_COHERENCY_NONE;
 	} else {
 		ptdev->coherency_mode = PANTHOR_COHERENCY_ACE_LITE;
 	}
 
+	/* Userspace (Mesa) does CPU cache maintenance based on this; the CIX
+	 * rework had left it at 0 (ACE-Lite) on every platform.
+	 */
+	ptdev->gpu_info.selected_coherency = ptdev->coherency_mode;
+
 	if (ptdev->coherency_mode == PANTHOR_COHERENCY_NONE)
 		return 0;
 
diff --git a/drivers/gpu/drm/panthor/panthor_mmu.c b/drivers/gpu/drm/panthor/panthor_mmu.c
index ced5d4679..ffbf87301 100644
--- a/drivers/gpu/drm/panthor/panthor_mmu.c
+++ b/drivers/gpu/drm/panthor/panthor_mmu.c
@@ -2192,16 +2192,6 @@ static u64 mair_to_memattr(u64 mair, enum panthor_coherency_mode mode,
 			out_attr = AS_MEMATTR_AARCH64_INNER_OUTER_NC |
 				   AS_MEMATTR_AARCH64_SH_MIDGARD_INNER |
 				   AS_MEMATTR_AARCH64_INNER_ALLOC_EXPL(false, false);
-		} else if (mode != PANTHOR_COHERENCY_ACE && !has_iommu) {
-			/* GPU not fully coherent and no IOMMU to override
-			 * memory attributes at the bus level. Even with
-			 * ACE-Lite, GPU L2 may not evict to SLC in time
-			 * for non-snooping masters like the DPU.
-			 * Force NC to guarantee DRAM visibility.
-			 */
-			out_attr = AS_MEMATTR_AARCH64_INNER_OUTER_NC |
-				   AS_MEMATTR_AARCH64_SH_MIDGARD_INNER |
-				   AS_MEMATTR_AARCH64_INNER_ALLOC_EXPL(false, false);
 		} else {
 			out_attr = AS_MEMATTR_AARCH64_INNER_OUTER_WB |
 				   AS_MEMATTR_AARCH64_INNER_ALLOC_EXPL(inner & 1, inner & 2);
@@ -2267,6 +2257,12 @@ panthor_vm_exec_map_op(struct panthor_vm *vm, u32 flags,
 	struct panthor_gem_object *bo = to_panthor_bo(op->gem.obj);
 	int prot = flags_to_prot(flags);
 
+	/* Only foreign imports: our own exported BOs stay cached, so every
+	 * GPU mapping of them agrees on the attributes.
+	 */
+	if (vm->ptdev->uncached_imports && drm_gem_is_imported(&bo->base))
+		prot &= ~IOMMU_CACHE;
+
 	if (flags & DRM_PANTHOR_VM_BIND_OP_MAP_SPARSE)
 		return panthor_vm_map_sparse(vm, op->va.addr, prot,
 					     bo->dmap.sgt, op->va.range);
