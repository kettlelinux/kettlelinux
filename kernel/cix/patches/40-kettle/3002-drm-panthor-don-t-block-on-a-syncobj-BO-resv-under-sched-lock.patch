+/*
+ * Returns 1 if the queue's sync wait is satisfied, 0 if not, -EAGAIN if the
+ * synchronization object's BO was locked, or another negative error code.
+ *
+ * Called with sched->lock held, so the BO reservation lock is only
+ * trylocked. Private BOs share their VM's reservation lock, and its holder
+ * can be waiting for this VM's GPU work: the GEM shrinker, for one, trylocks
+ * a BO then waits on its fences, BO after BO, under memory pressure. Those
+ * fences can't signal while the scheduler is stuck behind sched->lock
+ * waiting for the same lock, so blocking here stalls the whole GPU.
+ */
 static int panthor_queue_eval_syncwait(struct panthor_group *group, u8 queue_idx)
 {
 	struct panthor_queue *queue = group->queues[queue_idx];
+	struct panthor_device *ptdev = group->ptdev;
 	union {
 		struct panthor_syncobj_64b sync64;
 		struct panthor_syncobj_32b sync32;
 	} *syncobj;
+	struct drm_gem_object *obj;
+	struct iosys_map map;
 	bool result;
 	u64 value;
+	int ret;
 
-	syncobj = panthor_queue_get_syncwait_obj(group, queue);
-	if (!syncobj)
-		return -EINVAL;
+	if (!queue->syncwait.obj) {
+		struct panthor_gem_object *bo;
+
+		bo = panthor_vm_get_bo_for_va(group->vm,
+					      queue->syncwait.gpu_va,
+					      &queue->syncwait.offset);
+		if (drm_WARN_ON(&ptdev->base, IS_ERR_OR_NULL(bo)))
+			return -EINVAL;
+
+		queue->syncwait.obj = &bo->base;
+	}
+
+	obj = queue->syncwait.obj;
+	if (!dma_resv_trylock(obj->resv))
+		return -EAGAIN;
+
+	/* drm_gem_vmap_locked() without the DRM-internal header: call the
+	 * object's vmap/vunmap hooks directly, with the reservation held.
+	 */
+	if (!queue->syncwait.kmap) {
+		ret = obj->funcs->vmap(obj, &map);
+		if (drm_WARN_ON(&ptdev->base, ret || iosys_map_is_null(&map)))
+			goto err_unlock;
 
+		queue->syncwait.kmap = map.vaddr;
+	}
+
+	/* Make sure the CPU caches are invalidated before the seqno is read.
+	 * panthor_gem_sync_locked() is a NOP if map_wc=true, so no need to
+	 * check it here.
+	 */
+	panthor_gem_sync_locked(obj,
+				DRM_PANTHOR_BO_SYNC_CPU_CACHE_FLUSH_AND_INVALIDATE,
+				queue->syncwait.offset,
+				queue->syncwait.sync64 ?
+				sizeof(struct panthor_syncobj_64b) :
+				sizeof(struct panthor_syncobj_32b));
+
+	syncobj = queue->syncwait.kmap + queue->syncwait.offset;
 	value = queue->syncwait.sync64 ?
 		syncobj->sync64.seqno :
 		syncobj->sync32.seqno;
@@ -2605,10 +2614,27 @@ static int panthor_queue_eval_syncwait(struct panthor_group *group, u8 queue_idx
 	else
 		result = value <= queue->syncwait.ref;
 
-	if (result)
-		panthor_queue_put_syncwait_obj(queue);
+	if (result) {
+		iosys_map_set_vaddr(&map, queue->syncwait.kmap);
+		obj->funcs->vunmap(obj, &map);
+		queue->syncwait.kmap = NULL;
+	}
+
+	dma_resv_unlock(obj->resv);
+
+	/* Drop the reference outside the reservation lock: it may be the last. */
+	if (result) {
+		drm_gem_object_put(obj);
+		queue->syncwait.obj = NULL;
+	}
 
 	return result;
+
+err_unlock:
+	dma_resv_unlock(obj->resv);
+	drm_gem_object_put(obj);
+	queue->syncwait.obj = NULL;
+	return -EINVAL;
 }
 
 static void sync_upd_work(struct work_struct *work)
@@ -2618,6 +2644,7 @@ static void sync_upd_work(struct work_struct *work)
 						      sync_upd_work);
 	struct panthor_group *group, *tmp;
 	bool immediate_tick = false;
+	bool retry = false;
 
 	mutex_lock(&sched->lock);
 	list_for_each_entry_safe(group, tmp, &sched->groups.waiting, wait_node) {
@@ -2629,9 +2656,14 @@ static void sync_upd_work(struct work_struct *work)
 			int ret;
 
 			ret = panthor_queue_eval_syncwait(group, cs_id);
-			drm_WARN_ON(&group->ptdev->base, ret < 0);
-			if (ret)
-				unblocked_queues |= BIT(cs_id);
+			if (ret == -EAGAIN) {
+				/* Still blocked as far as we know, check again soon. */
+				retry = true;
+			} else {
+				drm_WARN_ON(&group->ptdev->base, ret < 0);
+				if (ret)
+					unblocked_queues |= BIT(cs_id);
+			}
 
 			tested_queues &= ~BIT(cs_id);
 		}
@@ -2654,6 +2686,21 @@ static void sync_upd_work(struct work_struct *work)
 
 	if (immediate_tick)
 		sched_queue_delayed_work(sched, tick, 0);
+
+	/* Sync updates are the only thing that re-evaluates blocked queues, so
+	 * a skipped queue needs an explicit retry.
+	 */
+	if (retry)
+		sched_queue_delayed_work(sched, sync_upd_retry, 1);
+}
+
+static void sync_upd_retry_work(struct work_struct *work)
+{
+	struct panthor_scheduler *sched = container_of(work,
+						      struct panthor_scheduler,
+						      sync_upd_retry_work.work);
+
+	sched_queue_work(sched, sync_upd);
 }
 
