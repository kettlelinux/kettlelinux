-	panthor_gem_sync(&bo->base,
-			 DRM_PANTHOR_BO_SYNC_CPU_CACHE_FLUSH_AND_INVALIDATE,
-			 queue->syncwait.offset,
-			 queue->syncwait.sync64 ?
-			 sizeof(struct panthor_syncobj_64b) :
