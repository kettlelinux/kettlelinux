@@ -2967,6 +3014,7 @@ void panthor_sched_pre_reset(struct panthor_device *ptdev)
 	/* Cancel all scheduler works. Once this is done, these works can't be
 	 * scheduled again until the reset operation is complete.
 	 */
+	cancel_delayed_work_sync(&sched->sync_upd_retry_work);
 	cancel_work_sync(&sched->sync_upd_work);
 	cancel_delayed_work_sync(&sched->tick_work);
 
@@ -4070,6 +4118,7 @@ void panthor_sched_unplug(struct panthor_device *ptdev)
 
 	disable_delayed_work_sync(&sched->tick_work);
 	disable_work_sync(&sched->fw_events_work);
+	disable_delayed_work_sync(&sched->sync_upd_retry_work);
 	disable_work_sync(&sched->sync_upd_work);
 
 	mutex_lock(&sched->lock);
@@ -4154,6 +4203,7 @@ int panthor_sched_init(struct panthor_device *ptdev)
 	sched->tick_period = msecs_to_jiffies(10);
 	INIT_DELAYED_WORK(&sched->tick_work, tick_work);
