-}
-
 static void group_free_queue(struct panthor_group *group, struct panthor_queue *queue)
 {
 	if (IS_ERR_OR_NULL(queue))
@@ -2582,20 +2541,70 @@ static void tick_work(struct work_struct *work)
 	drm_dev_exit(cookie);
