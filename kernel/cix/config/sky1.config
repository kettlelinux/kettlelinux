# CIX P1 (Sky1) additions merged on top of base.config (CIX's own 7.1 defconfig, from
# 06n-arch's config.cix-7.1), before the shared steamos.config.

# CIX builds with -Werror; a newer compiler than theirs shouldn't fail the build.
# CONFIG_WERROR is not set

# Modules uncompressed, as in the qcom kernel (CIX's config compresses them with xz)
# CONFIG_MODULE_COMPRESS is not set

# 7.2 folded the Cadence USB drivers into one cdns.ko and put USB_CDNSP under USB_CDNS3, which
# CIX sets to m. Built in, so keyboards work in the initramfs without extra modules.
CONFIG_USB_CDNS3=y

# The power button is an ACPI0011 Generic Buttons device (GPIO, usage 0x81 System Power Down).
# soc_button_array turns it into KEY_POWER and makes it a wakeup source; without it the button
# did nothing in Linux and nothing could wake the board from s2idle.
CONFIG_INPUT_SOC_BUTTON_ARRAY=m

# CIX's ACPI thermal zones are tuned for IPA: a sustainable power (SSTP) and a switch-on trip
# (SWIT, 60 C for the CPUs) below the 85 C control trip. step_wise treats the switch-on trip as a
# throttle point, and the ACPI processor cooling device throttles every CPU in the package, so all
# 12 cores lost frequency as soon as one cluster reached 60 C. The GPU zone needs 40-kettle/3003
# (GPU Energy Model) to work under IPA.
CONFIG_THERMAL_DEFAULT_GOV_POWER_ALLOCATOR=y

# 40-kettle/3004: the fan's mode (quiet/balanced/performance) as a platform profile
CONFIG_CIX_SKY1_FAN=m

# HID built in, as in the qcom kernel: steamos.config builds HID_STEAM in (CIX: HID=m)
CONFIG_HID=y
CONFIG_USB_HID=y

# 40-kettle/3007: the VPU's V4L2 decoders and encoders (amvx)
CONFIG_VIDEO_LINLON=m
