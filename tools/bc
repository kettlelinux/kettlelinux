#!/usr/bin/env python3
# minimal shim: only implements kernel/time/timeconst.bc for kernel builds on hosts without bc
import sys, math
hz=int(sys.stdin.read().strip())
fmul=lambda b,n,d:(2**b*n+d-1)//d
def fadj(b,n,d):
    d=d//math.gcd(n,d); return 2**b*(d-1)//d
def fmuls(b,n,d):
    s=0
    while True:
        if fmul(s,n,d)>=2**(b-1): return s
        s+=1
o=[]
p=o.append
p("/* Automatically generated by kernel/time/timeconst.bc */\n/* Time conversion constants for HZ == %d */\n\n"%hz)
p("#ifndef KERNEL_TIMECONST_H\n#define KERNEL_TIMECONST_H\n\n#include <linux/param.h>\n#include <linux/types.h>\n\n")
p("#if HZ != %d\n#error \"include/generated/timeconst.h has the wrong HZ value!\"\n#endif\n\n"%hz)
def blk(pfx,n,d):
    s=fmuls(32,n,d)
    p("#define %s_MUL32\tU64_C(0x%X)\n"%(pfx,fmul(s,n,d)))
    p("#define %s_ADJ32\tU64_C(0x%X)\n"%(pfx,fadj(s,n,d)))
    p("#define %s_SHR32\t%d\n"%(pfx,s))
blk("HZ_TO_MSEC",1000,hz); blk("MSEC_TO_HZ",hz,1000)
cd=math.gcd(hz,1000)
p("#define HZ_TO_MSEC_NUM\t\t%d\n#define HZ_TO_MSEC_DEN\t\t%d\n#define MSEC_TO_HZ_NUM\t\t%d\n#define MSEC_TO_HZ_DEN\t\t%d\n\n"%(1000//cd,hz//cd,hz//cd,1000//cd))
blk("HZ_TO_USEC",1000000,hz); blk("USEC_TO_HZ",hz,1000000)
cd=math.gcd(hz,1000000)
p("#define HZ_TO_USEC_NUM\t\t%d\n#define HZ_TO_USEC_DEN\t\t%d\n#define USEC_TO_HZ_NUM\t\t%d\n#define USEC_TO_HZ_DEN\t\t%d\n"%(1000000//cd,hz//cd,hz//cd,1000000//cd))
cd=math.gcd(hz,1000000000)
p("#define HZ_TO_NSEC_NUM\t\t%d\n#define HZ_TO_NSEC_DEN\t\t%d\n#define NSEC_TO_HZ_NUM\t\t%d\n#define NSEC_TO_HZ_DEN\t\t%d\n\n"%(1000000000//cd,hz//cd,hz//cd,1000000000//cd))
p("#endif /* KERNEL_TIMECONST_H */\n")
sys.stdout.write("".join(o))
