# The built-in gamepad (rsinput on the AYN devices, the Retroid MCU driver on the RP5)
# advertises BTN_BACK (0x116), which sits in the mouse-button range, so
# udev's input_id classifies it as an absolute mouse: libinput/KWin then drive the pointer
# from the sticks and Steam/SDL (which only open ID_INPUT_JOYSTICK devices) ignore it.
# Sorted after 60-input-id.rules and before 60-persistent-input / 70-uaccess. The name is the
# device's PAD_NAME, filled in by the image build from device/<device>/device.conf.
ACTION!="remove", SUBSYSTEM=="input", ATTRS{name}=="@PAD_NAME@", \
  ENV{ID_INPUT_MOUSE}="", ENV{ID_INPUT_JOYSTICK}="1"
