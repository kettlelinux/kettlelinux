#!/bin/bash
# Install the running (SD card) Kettle Linux system to the internal UFS, next to Android.
# The kettle-installer wizard (Kettle Installer in the application menu) drives this.
#
# Boot chain this relies on (stock AYN firmware, or the RP5's stock ABL with Kettle's U-Boot,
# packages/u-boot-retroidpocket): ABL starts either Android (boot_a/b) or U-Boot (loader_a/b);
# U-Boot tries the SD card ("mmc 0") first, then the UFS LUNs ("scsi 0".."scsi 7"), loading
# \EFI\BOOT\BOOTAA64.EFI (steamcl) from an ESP.
# So: with an SD card inserted the SD system boots, without one the internal install does.
# The ROCKNIX ABL from v1.1.9 on loads no EFI program: it starts \KERNEL (an Android boot.img,
# kettle-boot-legacy) from the internal ESP instead, which updates then keep on the newest slot.
#
# Layout on /dev/sda (LUN 0) after install, the SD card image's SteamOS A/B layout (see
# docs/UPDATES.md), so the internal install gets system updates the same way:
#   ...Android partitions...   untouched (checked after partitioning; any change is undone)
#   userdata (Android)         shrunk to --android-size (--android-minimal: 16 GiB)
#   kettle-esp  512 MiB  FAT32: steamcl and the slots' boot state
#   efi-A/B      64 MiB  FAT32: each slot's GRUB
#   rootfs-A/B   12 GiB  slot A: a copy of this system image (read-only btrfs); B: empty until
#                        the first update
#   var-A/B     256 MiB  /var and the /etc overlay (copied: Wi-Fi, passwords, settings)
#   home        rest     /home (copied: Steam, games unless --no-games, everything else)
#
# Android's userdata is metadata-encrypted, so it cannot be shrunk in place: Android's apps
# and data are wiped (Android itself stays and sets itself up again). Only a full backup
# (kettle-backup-ufs) brings them back, so one is made first unless a backup matching the
# current internal storage exists: full (Android's data too) or essentials (everything else).
#
# Safety: runs only from the SD card, with the charger or >= 50% battery, blocks sleep and
# shutdown, keeps going on Ctrl-C while partitions are written, saves the partition table,
# and leaves the new ESP empty (slot A's root named rootfs-A.partial) until the copy has been
# verified, so an interrupted install never boots; rerun it with --reinstall to finish.
# Logs go to /var/log/kettle.
#
# Usage: sudo kettle-install-internal [--android-size GB | --android-minimal]
#            [--backup full|essentials|DIR] [--no-games] [--progress --yes]
#        sudo kettle-install-internal --reinstall [--no-games] [--yes]
#            (copy this system into an existing or interrupted internal install again, as a
#            fresh slot A; Android is not touched. Installed systems update themselves.)
#        sudo kettle-install-internal --boot-files
#            (write \KERNEL for the newest installed slot onto an existing internal install's
#            ESP: installs made before it was written there, for the ROCKNIX ABL v1.1.9+)
#        sudo kettle-install-internal --plan    (facts for the wizard, key=value; read only)
set -euo pipefail
. /usr/lib/kettle/ufs-lib.sh

ANDROID_GB=64
REINSTALL=0 NO_GAMES=0 PLAN=0 BOOT_FILES=0 BACKUP=""
ARGS=("$@")
while [ $# -gt 0 ]; do
  case "$1" in
    --android-size) ANDROID_GB="${2:?}"; shift ;;
    --android-minimal) ANDROID_GB=$MIN_ANDROID_GB ;;
    --backup) BACKUP="${2:?}"; shift ;;
    --reinstall) REINSTALL=1 ;;
    --boot-files) BOOT_FILES=1 ;;
    --no-games) NO_GAMES=1 ;;
    --plan) PLAN=1 ;;
    --progress) PROGRESS=1 ;;
    --yes) YES=1 ;;
    -h|--help) sed -n '2,42p' "$0"; exit 0 ;;
    *) die "unknown option $1" ;;
  esac
  shift
done

need_root
need_sd_root
# slot A is a block copy of the running system image: it must not change while it is read
[ "$BOOT_FILES" = 1 ] || holo-readonly status >/dev/null 2>&1 ||
  die "this system's root file system is writable (holo-readonly disable); run 'sudo holo-readonly enable' and reboot first"
need_ufs_disk
SS=$(blockdev --getss "$DISK")
MIB=$((1048576 / SS))                         # sectors per MiB
UD=$(part_by_label userdata)
[ -n "$UD" ] || die "Android userdata partition not found on $DISK"
UD_N=$(partnum "$UD")
STATE=$(install_state)
# the internal Kettle partitions, by name (rootfs-A while being written: rootfs-A.partial)
find_parts() {
  ESP=$(part_by_label $ESP_LABEL) EFIA=$(part_by_label efi-A) EFIB=$(part_by_label efi-B)
  ROOT=$(part_by_label $ROOT_LABEL); [ -n "$ROOT" ] || ROOT=$(part_by_label $PARTIAL_LABEL)
  ROOTB=$(part_by_label rootfs-B) VARA=$(part_by_label var-A) VARB=$(part_by_label var-B)
  HOME_P=$(part_by_label home)
}
pu() { blkid -c /dev/null -s PARTUUID -o value "$1"; }
# \KERNEL on the ESP mounted at $1 for the slot whose root is mounted at $2 and whose efi
# partition is $3, for the ROCKNIX ABL. No extlinux: U-Boot would take it over steamcl's EFI
# boot, which falls back to the other slot when an update does not start.
boot_files() {
  kettle-boot-legacy --root "$2" --esp "$1" --efi-partuuid "$(pu "$3")" --no-extlinux >/dev/null
}

if [ "$BOOT_FILES" = 1 ]; then
  [ "$STATE" = installed ] || die "no finished internal install to write boot files for"
  find_parts
  [ -n "$ESP" ] && [ -n "$EFIA" ] && [ -n "$EFIB" ] && [ -n "$ROOTB" ] ||
    die "the internal install is incomplete; reinstall it from the Kettle Installer"
  inhibit "Writing the internal install's boot files" "${ARGS[@]}"
  start_log install-internal "${ARGS[@]}"
  none_mounted "$DISK" || die "a partition of $DISK is mounted"
  W=/run/kettle-install
  mkdir -p $W/src $W/dst
  cleanup() { umount $W/dst 2>/dev/null || true; umount $W/src 2>/dev/null || true; }
  trap cleanup EXIT
  # the newest installed slot (highest build ID): the one the last update pointed \KERNEL at.
  # rootfs-B is empty until the first update.
  read -r id slot < <(
    for s in A:"$ROOT" B:"$ROOTB"; do
      mount -o ro "${s#*:}" $W/src 2>/dev/null || continue
      b=$(sed -n 's/^BUILD_ID=//p' $W/src/usr/lib/os-release)
      umount $W/src
      [ -z "$b" ] || echo "$b ${s%%:*}"
    done | sort -V | tail -1) || die "no installed system found on the internal storage"
  if [ "$slot" = A ]; then root=$ROOT efi=$EFIA; else root=$ROOTB efi=$EFIB; fi
  say "writing the boot files for slot $slot (build $id)"
  mount -o ro "$root" $W/src
  mount "$ESP" $W/dst
  boot_files $W/dst $W/src "$efi"
  umount $W/dst; umount $W/src
  fsck.fat -n "$ESP" >/dev/null || die "file system check of $ESP failed"
  done_msg "The internal install's boot files now start slot $slot (build $id)"
  exit 0
fi
read -r home_b games_b < <(copy_bytes) || die "could not measure what to copy from /home"

if [ "$PLAN" = 1 ]; then
  echo "state=$STATE"
  echo "disk=$(blockdev --getsize64 "$DISK")"
  echo "userdata=$(part_size_b "$UD")"
  echo "space=$(( $(disk_end_b) - $(part_start_b "$UD") ))"   # userdata start to disk end
  echo "system=$home_b"   # what is copied besides games: /home (the system partitions are fixed)
  echo "games=$games_b"
  echo "free=$(df -B1 --output=avail "$(mkdir -p "$BACKUPS" && echo "$BACKUPS")" | tail -1)"
  # what a backup (kettle-backup-ufs) of the storage as it is now would take
  skip_off=$(part_start_b "$UD") skip_len=$(part_size_b "$UD") ess=0 ud_est=0
  while read -r lun dev; do
    if [ "$dev" = "$DISK" ]; then
      ess=$(( ess + $(estimate_bytes "$dev" "$skip_off" "$skip_len") ))
      ud_est=$(estimate_bytes "$UD")
    else
      ess=$(( ess + $(estimate_bytes "$dev") ))
    fi
  done < <(ufs_luns)
  echo "est_essentials=$ess"
  echo "est_full=$(( ess + ud_est ))"
  matching_backups | sed 's/^/backup=/'
  exit 0
fi

inhibit "Installing Kettle Linux to the internal storage" "${ARGS[@]}"
start_log install-internal "${ARGS[@]}"
need_power
none_mounted "$DISK" || die "a partition of $DISK is mounted"
if pgrep -x steam >/dev/null; then
  ask "Steam is running; its files may change during the copy. Continue anyway?" || exit 1
fi

copy_b=$home_b; [ "$NO_GAMES" = 1 ] || copy_b=$((home_b + games_b))
# slot A is written uncompressed (this mkfs.btrfs can't compress --rootdir): it must fit, with
# a tenth for btrfs metadata
sys_b=$(du -sbx / | cut -f1)
[ $(( sys_b + sys_b / 10 )) -le $(( ROOTFS_MIB * 1024**2 )) ] ||
  die "this system ($(( sys_b / 1024**2 )) MiB of files) does not fit a ${ROOTFS_MIB} MiB slot uncompressed; nothing was changed"
[ "$STATE" != old ] || die "an older Kettle install (from before system updates) is on the internal storage; remove it first (kettle-uninstall-internal) and install again"

if [ "$REINSTALL" = 1 ]; then
  [ "$STATE" != none ] || die "no existing internal install to --reinstall into"
  find_parts
  for p in "$ESP" "$EFIA" "$EFIB" "$ROOT" "$ROOTB" "$VARA" "$VARB" "$HOME_P"; do
    [ -n "$p" ] || die "the internal install is incomplete in a way --reinstall cannot fix; remove it (kettle-uninstall-internal) or restore a backup (kettle-restore-ufs)"
  done
  [ "$(part_size_b "$HOME_P")" -ge $(( $(kettle_min_bytes "$copy_b") - FIXED_MIB * 1024**2 )) ] ||
    die "the internal home partition is too small for this system's /home (try --no-games)"
  echo "Reinstalling into the internal Kettle partitions. Everything on them is erased; Android is untouched."
  ask "Proceed?" || exit 1
else
  [ "$STATE" = none ] || die "Kettle is already (or partly) installed internally; use --reinstall"
  # Kettle goes into the space userdata gives up, so nothing may follow it: typically another
  # system installed next to Android (ROCKNIX, for one) that has to be removed first
  after=$(parts_after "$UD")
  if [ -n "$after" ]; then
    sfdisk -d "$DISK" || true   # into the log
    die "partitions that are not Kettle's follow Android's userdata on $DISK: $(echo $after). Remove that system (or restore a backup of the internal storage from before it was installed) first; nothing was changed"
  fi
  [[ $ANDROID_GB =~ ^[0-9]+$ ]] && [ "$ANDROID_GB" -ge "$MIN_ANDROID_GB" ] || die "--android-size must be >= $MIN_ANDROID_GB"
  ud_start=$(( $(part_start_b "$UD") / SS ))
  ud_size=$(( ANDROID_GB * 1024 * MIB ))
  ud_end=$(( (ud_start + ud_size + MIB - 1) / MIB * MIB ))      # MiB-align what follows
  ud_size=$(( ud_end - ud_start ))
  [ $(( ud_size * SS )) -le "$(part_size_b "$UD")" ] || die "--android-size is larger than userdata is now"
  root_b=$(( $(disk_end_b) - ud_end * SS ))   # everything Kettle gets
  [ "$root_b" -ge "$(kettle_min_bytes "$copy_b")" ] ||
    die "--android-size $ANDROID_GB leaves $(( root_b / 1024**3 )) GiB for Kettle; it needs $(( $(kettle_min_bytes "$copy_b") / 1024**3 )) GiB (try a smaller Android or --no-games)"

  # A backup that matches the internal storage as it is now, made first if needed
  mapfile -t found < <(matching_backups)
  case "$BACKUP" in
    full|essentials) ;;
    "")
      if [ ${#found[@]} -gt 0 ]; then BACKUP=${found[0]% *}
      elif [ "$PROGRESS" = 1 ]; then die "--backup is required with --progress"
      else
        echo
        echo "  No backup of the internal storage as it is now. One is needed before installing:"
        echo "    full        Android's apps and data too; restores Android exactly (large)"
        echo "    essentials  partition tables, firmware, calibration and Android's system (small);"
        echo "                Android's apps and data cannot be brought back"
        read -rp "Which backup? [full/essentials]: " BACKUP
        [[ $BACKUP =~ ^(full|essentials)$ ]] || die "no backup chosen; nothing was changed"
      fi ;;
    *)
      printf '%s\n' "${found[@]}" | grep -q "^$(realpath "$BACKUP") " ||
        die "$BACKUP is not a complete backup of the internal storage as it is now"
      BACKUP=$(realpath "$BACKUP") ;;
  esac

  cat <<EOF

  Internal storage: $DISK ($(( $(blockdev --getsize64 "$DISK") / 1024**3 )) GiB)
    Android userdata  ${ANDROID_GB} GiB     (currently $(( $(part_size_b "$UD") / 1024**3 )) GiB)
    Kettle Linux      $(( root_b / 1024**3 )) GiB  (system $(( FIXED_MIB / 1024 )) GiB with room for updates, then /home: copying $(( copy_b / 1024**3 )) GiB$([ "$NO_GAMES" = 1 ] && echo ", without games"))
    Backup            $BACKUP

  WARNING: this ERASES Android's apps and data on internal storage (Android itself and
  its SD card data are kept; Android sets itself up again on its next boot).

EOF
  ask "Erase Android userdata and install Kettle Linux to internal storage?" || exit 1

  if [[ $BACKUP =~ ^(full|essentials)$ ]]; then
    kind=$BACKUP
    BACKUP=$BACKUPS/$(date +%Y%m%d-%H%M%S)
    bargs=(); [ "$kind" = essentials ] && bargs+=(--essentials)
    [ "$PROGRESS" = 1 ] && bargs+=(--progress --yes)
    tool="$(dirname "$0")/kettle-backup-ufs"; [ -x "$tool" ] || tool=kettle-backup-ufs
    if [ "$PROGRESS" = 1 ]; then "$tool" "${bargs[@]}" "$BACKUP" >&3; else "$tool" "${bargs[@]}" "$BACKUP"; fi ||
      die "backup failed; nothing was changed"
    grep -q "^$BACKUP " <(matching_backups) || die "the new backup does not check out; nothing was changed"
  fi
  note "backup: $BACKUP"
fi

# Partition table backup (restore: sfdisk /dev/sda < file; Android then reformats userdata)
bk=/var/lib/kettle/ufs-partition-table-$(date +%Y%m%d-%H%M%S).sfdisk
mkdir -p /var/lib/kettle
sfdisk -d "$DISK" >"$bk"
ls /esp >/dev/null 2>&1 || true; mountpoint -q /esp && cp "$bk" /esp/ 2>/dev/null || true
say "saved partition table to $bk (also on the SD card's esp)"

relabel() {
  trap '' INT TERM HUP
  sfdisk -q --no-reread --part-label "$DISK" "$(partnum "$1")" "$2"
  trap - INT TERM HUP
  partx -u "$DISK"; udevadm settle
}

if [ "$REINSTALL" = 0 ]; then
  # An interrupted partition table write is the one thing here that can break Android
  trap '' INT TERM HUP
  say "shrinking Android userdata to ${ANDROID_GB} GiB"
  echo ",$ud_size" | sfdisk -q --no-reread -N "$UD_N" "$DISK"
  say "creating Kettle Linux partitions"
  # one after the other from the new end of userdata (never into gaps between Android's
  # partitions), home to the end of the disk
  {
    at=$ud_end
    for p in "$ESP_MIB $ESP_TYPE $ESP_LABEL" "$EFI_MIB $DATA_TYPE efi-A" "$EFI_MIB $DATA_TYPE efi-B" \
             "$ROOTFS_MIB $ROOT_TYPE $PARTIAL_LABEL" "$ROOTFS_MIB $ROOT_TYPE rootfs-B" \
             "$VAR_MIB $LINUX_TYPE var-A" "$VAR_MIB $LINUX_TYPE var-B"; do
      read -r mib type name <<<"$p"
      printf 'start=%s, size=%s, type=%s, name=%s\n' $at $((mib * MIB)) $type $name
      at=$((at + mib * MIB))
    done
    printf 'start=%s, type=%s, name=home\n' $at $HOME_TYPE
  } | sfdisk -q --no-reread --append "$DISK"
  partx -u "$DISK"; partx -a "$DISK" 2>/dev/null || true
  udevadm settle
  find_parts
  excl=(-e "^$UD :"); for p in $(kettle_parts); do excl+=(-e "^$p :"); done
  # userdata must keep its start and have exactly the new size
  ud_now=$(sfdisk -d "$DISK" | awk -F'[ ,=]+' -v p="$UD" '$1 == p {
    for (i = 1; i < NF; i++) { if ($i == "start") s = $(i + 1); if ($i == "size") z = $(i + 1) }
    print s + 0, z + 0 }')
  if [ "$ud_now" != "$ud_start $ud_size" ] ||
     ! diff <(grep -v "^$UD :" "$bk") <(sfdisk -d "$DISK" | grep -v "${excl[@]}"); then
    sfdisk -q --no-reread "$DISK" <"$bk"; partx -u "$DISK" || true
    die "the new partition table changed more than userdata; the old one was put back (nothing else was changed)"
  fi
  # userdata no longer matches its file system: clear it now, before anything else can stop
  # the install (a --reinstall to finish it never touches Android)
  say "clearing Android userdata so Android sets itself up again"
  blkdiscard -f "$UD" 2>/dev/null || true
  dd if=/dev/zero of="$UD" bs=1M count=8 conv=fsync status=none
  request_android_wipe
  for p in "$ESP" "$EFIA" "$EFIB" "$ROOT" "$ROOTB" "$VARA" "$VARB" "$HOME_P"; do
    [ -b "$p" ] || die "new partitions did not appear (reboot and run --reinstall)"
  done
  trap - INT TERM HUP
else
  [ "$(blkid -c /dev/null -s PARTLABEL -o value "$ROOT")" = "$PARTIAL_LABEL" ] || relabel "$ROOT" "$PARTIAL_LABEL"
fi

fsuuid() { cat /proc/sys/kernel/random/uuid; }
ROOT_FSUUID=$(fsuuid) VARA_FSUUID=$(fsuuid)

say "formatting the Kettle partitions"
wipefs -aq "$ESP" "$EFIA" "$EFIB" "$ROOT" "$ROOTB" "$VARA" "$VARB" "$HOME_P"
mkfs.vfat -F 32 -n SPINTERNAL "$ESP" >/dev/null
mkfs.vfat -F 32 -n EFI-A "$EFIA" >/dev/null
mkfs.vfat -F 32 -n EFI-B "$EFIB" >/dev/null
mkfs.ext4 -F -q -L var -U "$VARA_FSUUID" -E discard "$VARA"
mkfs.ext4 -F -q -L var -E discard "$VARB"
mkfs.ext4 -F -q -L home -E discard "$HOME_P"

W=/run/kettle-install
mkdir -p $W/src $W/dst
cleanup() { umount -R $W/dst 2>/dev/null || true; umount $W/src 2>/dev/null || true; }
trap cleanup EXIT

# tar reports every 1000 records (10 KiB each) as "tar: @ckpt <records>"
tar_pct() {
  awk -v t="$1" -v p="$PROGRESS" '
    /^tar: @ckpt / { n = int($3 * 10240 * 100 / t); if (n > 99) n = 99
                     if (p == 1 && n != last) { print "@pct " n > "/dev/fd/3"; fflush("/dev/fd/3"); last = n }
                     else if (p == 0 && n >= last + 5) { print "    " n "%" > "/dev/stderr"; last = n }
                     next }
    { print > "/dev/stderr" }'
}
copy_tree() {  # source dir, destination dir, bytes (for progress), tar excludes...
  local src=$1 dst=$2 bytes=$3 rc=0; shift 3
  ( cd "$src" && tar --one-file-system --xattrs --xattrs-include='*' --acls --warning=no-file-changed \
      --checkpoint=1000 --checkpoint-action='echo=@ckpt %u' -cf - "$@" . \
      2> >(tar_pct "$bytes") ) |
    tar -C "$dst" --xattrs --xattrs-include='*' --acls --numeric-owner -xpf - || rc=$?
  [ "$rc" -le 1 ] || die "copy failed (tar exit $rc); rerun with --reinstall to try again"   # 1 = a file changed while being read
}

# Slot A: this system image (read-only, so consistent), as a new btrfs filesystem with a UUID
# of its own. A block copy would carry the SD card's filesystem UUID, which btrfs (kernel and
# tools) would take for the mounted root itself. The bind mount shows the image as built: /etc
# without its overlay, /var and /home as empty mount points.
say "writing the system image (a copy of this system's)"
mount --bind / $W/src
mkfs.btrfs -f -q -U "$ROOT_FSUUID" -L rootfs --rootdir $W/src "$ROOT" >/dev/null ||
  die "could not write the system image; rerun with --reinstall"
umount $W/src
mount "$ROOT" $W/dst
btrfs property set $W/dst ro true
umount $W/dst
say "checking the system image"
btrfs check --readonly "$ROOT" >/dev/null 2>&1 || die "file system check of $ROOT failed; rerun with --reinstall"

say "copying /var (settings, Wi-Fi, passwords)"
mount --bind /var $W/src
mount "$VARA" $W/dst
copy_tree $W/src $W/dst "$(du -sbx /var | cut -f1)" --exclude=./lib/kettle/ufs-partition-table-\*
# the SD image's first-boot partitioning must never run on the Android disk
up=$W/dst/lib/overlays/etc/upper
rm -rf "$up/repart.d"
mkdir -p "$up/systemd/system"
ln -sfn /dev/null "$up/systemd/system/systemd-repart.service"
rm -rf $W/dst/lib/overlays/etc/work; mkdir -p $W/dst/lib/overlays/etc/work
umount $W/dst; umount $W/src
e2fsck -fn "$VARA" >/dev/null || die "file system check of $VARA failed; rerun with --reinstall"

say "copying /home ($(( copy_b / 1024**3 )) GiB, this takes a while)"
excl=(--exclude=.${BACKUPS#/home})
if [ "$NO_GAMES" = 1 ]; then
  for h in /home/*/.local/share/Steam/steamapps; do
    [ -d "$h" ] && excl+=("--exclude=.${h#/home}/common" "--exclude=.${h#/home}/downloading")
  done
fi
mount --bind /home $W/src
mount "$HOME_P" $W/dst
copy_tree $W/src $W/dst "$copy_b" "${excl[@]}"
umount $W/dst; umount $W/src
e2fsck -fn "$HOME_P" >/dev/null || die "file system check of $HOME_P failed; rerun with --reinstall"

say "installing slot A's bootloader"
mount "$EFIA" $W/dst
HOLO_ROOT_UUID=$ROOT_FSUUID HOLO_VAR_UUID=$VARA_FSUUID \
  /usr/lib/holo/holo-grub-mkimage --format=arm64-efi --output=$W/dst/EFI/steamos/grubaa64.efi
EFI=$W/dst HOLO_ROOT_UUID=$ROOT_FSUUID HOLO_ROOT_PARTUUID=$(pu "$ROOT") HOLO_ROOT_PARTNUM=$(partnum "$ROOT") \
  HOLO_EFI_PARTUUID=$(pu "$EFIA") update-grub >/dev/null
# both slots' partition sets on each efi partition: steamcl knows slot B by efi-B's "B" file,
# which the first update doesn't write (it only fills in all, shared, self and other)
partsets() {  # dir, self, other
  local ps=$1/SteamOS/partsets l; mkdir -p "$ps"
  printf 'esp %s\nhome %s\n' "$(pu "$ESP")" "$(pu "$HOME_P")" >"$ps/shared"
  printf 'efi %s\nrootfs %s\nvar %s\n' "$(pu "$EFIA")" "$(pu "$ROOT")" "$(pu "$VARA")" >"$ps/A"
  printf 'efi %s\nrootfs %s\nvar %s\n' "$(pu "$EFIB")" "$(pu "$ROOTB")" "$(pu "$VARB")" >"$ps/B"
  cp "$ps/$2" "$ps/self"; cp "$ps/$3" "$ps/other"
  for l in esp:"$ESP" efi-A:"$EFIA" efi-B:"$EFIB" rootfs-A:"$ROOT" rootfs-B:"$ROOTB" \
           var-A:"$VARA" var-B:"$VARB" home:"$HOME_P"; do
    printf '%s %s\n' "${l%%:*}" "$(pu "${l#*:}")"
  done >"$ps/all"
}
partsets $W/dst A B
umount $W/dst
fsck.fat -n "$EFIA" >/dev/null || die "file system check of $EFIA failed; rerun with --reinstall"
mount "$EFIB" $W/dst
partsets $W/dst B A
umount $W/dst
fsck.fat -n "$EFIB" >/dev/null || die "file system check of $EFIB failed; rerun with --reinstall"

# The ESP last: until steamcl is on it the internal install cannot be booted half-done.
# steamcl-restricted keeps steamcl to this disk's slots (the SD card's are named A and B too).
say "installing the boot manager"
mount "$ESP" $W/dst
for d in $W/dst/EFI/steamos $W/dst/EFI/BOOT; do
  install -D -m 0644 /usr/share/holo-efi/default.pf2 "$d/fonts/default.pf2"
  : >"$d/steamcl-restricted"
done
install -m 0644 /usr/share/holo-efi/steamcl-version $W/dst/EFI/steamos/
install -m 0644 /usr/lib/holo-efi/aarch64-efi/steamcl.efi $W/dst/EFI/steamos/steamcl.efi
mkdir -p $W/dst/SteamOS/conf
. /etc/os-release
holo-bootconf --conf-dir $W/dst/SteamOS/conf create --image A >/dev/null
holo-bootconf --conf-dir $W/dst/SteamOS/conf config --image A \
  --set title "Kettle Linux-A-${VERSION_ID:-}-${BUILD_ID:-}" --set comment "${BUILD_ID:-}" >/dev/null
# \KERNEL for the ROCKNIX ABL (v1.1.9+ starts no EFI program): slot A is this system's copy
boot_files $W/dst / "$EFIA"
# the fallback path U-Boot loads: written last, it makes the install bootable
install -m 0644 /usr/lib/holo-efi/aarch64-efi/steamcl.efi $W/dst/EFI/BOOT/BOOTAA64.EFI
umount $W/dst
fsck.fat -n "$ESP" >/dev/null || die "file system check of $ESP failed; rerun with --reinstall"

relabel "$ROOT" "$ROOT_LABEL"
sync

done_msg "Kettle Linux is installed to internal storage"
cat <<EOF

  Kettle Linux is installed to internal storage (slot A: $ROOT).
  Boot it by powering off, removing the SD card and starting Linux as usual.
  With the SD card inserted, the SD system boots instead (U-Boot tries the SD first).
  It updates itself like the SD card system (Settings > System in Game Mode).
  Android: boot it as before; its first start resets its data and runs the setup
  (if it shows "Cannot load Android system", choose Factory data reset).

  Undo: sudo kettle-uninstall-internal              (Android gets its space back)
     or sudo kettle-restore-ufs ${BACKUP:-<backup>}   (internal storage back as it was)
EOF
