// Game Mode's Welcome (kettle-decky-welcome) starts and stops the SSH server, where no password
// prompt can be shown. Only start and stop: enabling it at every start-up (manage-unit-files)
// can link any unit file, so that keeps its password prompt, in the desktop's Kettle Welcome.
// Decky runs plugin backends inside its own system service (plugin_loader.service), outside the
// user's login session, so polkit sees them as neither local nor active: match that unit too.
polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        action.lookup("unit") == "sshd.service" &&
        (action.lookup("verb") == "start" || action.lookup("verb") == "stop") &&
        subject.isInGroup("wheel") &&
        ((subject.local && subject.active) || subject.system_unit == "plugin_loader.service")) {
        return polkit.Result.YES;
    }
});
