// Game Mode's Device Settings (kettle-decky-device-settings, System tab) starts and stops the SSH
// server, where no password prompt can be shown. Only start and stop: enabling it at every
// start-up (manage-unit-files) can link any unit file, so that keeps its password prompt, in the
// desktop's Kettle Welcome.
// fromDecky: one of Decky Loader's plugin backends. They run in its own system service, outside
// the user's login session, so polkit sees them as neither local nor active. (All rule files share
// one scope: 50-kettle-*.rules define the same function.) Newer polkit says which unit a
// process is in (subject.system_unit); polkit 124 doesn't, so a helper reads it from /proc.
function fromDecky(subject) {
    if (subject.system_unit == "plugin_loader.service")
        return true;
    try {
        polkit.spawn(["/usr/lib/kettle/polkit-decky-subject", String(subject.pid)]);
        return true;
    } catch (e) {
        return false;
    }
}

// The person at the device (wheel, in the active local session), or Decky's plugin backends,
// which run as that user but without its supplementary groups, so polkit doesn't see wheel there.
polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        action.lookup("unit") == "sshd.service" &&
        (action.lookup("verb") == "start" || action.lookup("verb") == "stop") &&
        ((subject.isInGroup("wheel") && subject.local && subject.active) || fromDecky(subject))) {
        return polkit.Result.YES;
    }
});
