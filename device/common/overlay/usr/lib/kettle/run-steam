#!/bin/bash
# Launch the arm64 Steam client for a handheld: unpack the bootstrap on first run, then
# run Valve's RUNSTEAM.sh with the Steam Deck flags instead of the Steam Frame (VR) ones.
#   run-steam --bootstrap   only unpack + link the client (login unit, steam.service pre-start);
#                           this is also what makes the desktop launcher /usr/bin/steam work
set -euo pipefail
root="$HOME/.local/share/Steam"
# The first unpack (705 MB, a few minutes on an SD card) runs behind the boot splash
# (kettle-steam-unpack.service). The marker is written only once it has finished: an unpack
# cut short (power off) is done again, over the partial one, instead of starting a broken client.
unpacked="$root/.kettle-unpacked"
if [ ! -e "$unpacked" ]; then
  echo "kettle: unpacking Steam bootstrap into $root"
  mkdir -p "$root"
  rm -f "$root/.install-complete"
  tar -xf /usr/lib/steam/steam.tar.zst -C "$root"
  sync -f "$root"
  touch "$unpacked"
fi
# Steam's saved login (local.vdf's ConnectCache) is one session: a second device using the same
# one (an SD card moved to another device, or one device installed from a card used on another)
# makes Steam sign each out ("Session Replaced") whenever the other signs in. So it's kept only
# on the device it was saved on (the SoC's serial: an internal install keeps it); on another,
# Steam asks to sign in again, as a session of its own. Library, settings and games stay.
device=$(cat /sys/devices/soc0/serial_number 2>/dev/null || cat /etc/machine-id 2>/dev/null || true)
if [ -n "$device" ]; then
  device=$(printf '%s' "$device" | sha256sum | cut -c1-32)
  mark="$root/.kettle-device"
  if [ -s "$mark" ] && [ "$(cat "$mark")" != "$device" ] && [ -e "$root/local.vdf" ]; then
    echo "kettle: Steam's saved login is another device's: signing in again on this one"
    python3 - "$root/local.vdf" <<'EOF'
import re, sys
p = sys.argv[1]
s = open(p, encoding="utf-8", errors="surrogateescape").read()
open(p, "w", encoding="utf-8", errors="surrogateescape").write(re.sub(r'\s*"ConnectCache"\s*\{[^{}]*\}', "", s))
EOF
  fi
  echo "$device" >"$mark"
fi
# Valve's steam-health-check (steam.service pre-start) treats a missing sentinel as a broken
# install and re-unpacks the bootstrap over it; the client updates itself from there
touch "$root/.install-complete"
# Decky Loader and the Quick Access button fallback (qam-button) drive Steam's UI through its
# CEF devtools port (localhost only), opened only when this file exists at client start
touch "$root/.cef-enable-remote-debugging"
# The links RUNSTEAM.sh maintains; /usr/bin/steam finds the install through ~/.steam/steam
mkdir -p "$HOME/.steam"
for l in steam:. root:. sdkarm64:linuxarm64 binarm64:steamrtarm64 bin32:ubuntu12_32 bin64:ubuntu12_64; do
  name=${l%%:*}; target=$root/${l#*:}; target=${target%/.}
  [ -d "$HOME/.steam/$name" ] && [ ! -L "$HOME/.steam/$name" ] && rm -rf "${HOME:?}/.steam/$name"
  ln -sTfn "$target" "$HOME/.steam/$name"
done
# Download tuning (read at client start; left alone once it exists so it can be edited):
# HTTP/1.1 with one connection per chunk stream and eager connection scaling is several
# times faster than a single multiplexed HTTP/2 connection on this Wi-Fi.
[ -e "$root/steam_dev.cfg" ] || cat >"$root/steam_dev.cfg" <<'EOF'
@nClientDownloadEnableHTTP2PlatformLinux 0
@fDownloadRateImprovementToAddAnotherConnection 1.0
EOF
# Vulkan shader pre-caching (fossilize_replay) is CPU-bound and Steam gives it only a few
# threads by default; use every core. Added to existing files too, unless already set.
grep -q '^unShaderBackgroundProcessingThreads' "$root/steam_dev.cfg" ||
  echo "unShaderBackgroundProcessingThreads $(nproc)" >>"$root/steam_dev.cfg"
# Kettle's startup movie (kettle-steam-startup). With -steamos3 Steam plays
# steam_os_startup.webm, preferring config/uioverrides/movies/steam_os_startup.webm when that
# exists; a movie picked in Settings > Customization > Startup Movie still comes first.
movie=/usr/share/kettle/steam/startup.webm
if [ -f "$movie" ]; then
  mkdir -p "$root/config/uioverrides/movies"
  cp -u "$movie" "$root/config/uioverrides/movies/steam_os_startup.webm"
fi
[ "${1:-}" = --bootstrap ] && exit 0

cp -u /usr/share/deckard/RUNSTEAM.sh "$root/RUNSTEAM.sh"
sed -e 's/^\([[:space:]]*\)-deckard$/\1-steampal/' \
    -e '/^[[:space:]]*-vrgamepadui$/d' \
    "$root/RUNSTEAM.sh" >"$root/RUNSTEAM-kettle.sh"
chmod +x "$root/RUNSTEAM-kettle.sh"
exec /usr/share/deckard/select_steam.sh RUNSTEAM-kettle.sh
