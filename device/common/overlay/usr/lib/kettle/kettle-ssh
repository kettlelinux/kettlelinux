#!/bin/bash
# Kettle Linux: Game Mode's SSH switch (Device Settings, System tab), run through pkexec
# (org.kettle.ssh, 50-kettle-ssh.rules: no password, which Game Mode can't ask for). Turning it on
# lets other computers log in, so it first waits for the device's Volume Up and Volume Down to be
# held together (confirm-keys), which no program running as the user can do in its place.
# Enabling it at every start-up stays with the desktop's Kettle Welcome, behind a password.
#   kettle-ssh on | off
set -eu
[ "$(id -u)" = 0 ] || { echo "kettle-ssh: run it as root" >&2; exit 1; }
case "${1:-}" in
  on)
    if [ -n "${PKEXEC_UID:-}" ]; then
      /usr/lib/kettle/confirm-keys "Turn on the SSH server" || {
        echo "kettle-ssh: not confirmed: hold Volume Up and Volume Down together for a second, within 30 seconds" >&2
        exit 1
      }
    fi
    exec systemctl start sshd.service ;;
  off) exec systemctl stop sshd.service ;;
  *) echo "usage: kettle-ssh on|off" >&2; exit 2 ;;
esac
