[Unit]
Description=Quick Access menu on the button below the right stick
# Game Mode only: the Plasma desktop controller owns the pad there
PartOf=gamescope-session.target
After=gamescope-session.service kettle-inputplumber.service

[Service]
# Fallback only: InputPlumber maps this button to Quick Access itself
ExecCondition=/bin/sh -c '! systemctl -q is-active inputplumber.service'
ExecStart=/usr/lib/kettle/qam-button
Restart=on-failure
RestartSec=2

[Install]
WantedBy=gamescope-session.target
