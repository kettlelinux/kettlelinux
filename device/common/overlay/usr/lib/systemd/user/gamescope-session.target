[Unit]
Description=Game Mode (gamescope + Steam)
Requires=graphical-session.target
BindsTo=graphical-session.target
After=graphical-session.target
PropagatesStopTo=graphical-session.target
Requires=gamescope-session.service
BindsTo=gamescope-session.service
Wants=steam.service
# The pad as a Steam Deck controller (InputPlumber), started before Steam
Wants=kettle-inputplumber.service
# The power button goes to Steam (sleep / power menu) while Game Mode runs; logind otherwise
Wants=kettle-powerbuttond.service
