#!/bin/bash
# Write a kettle-backup-ufs backup back to the internal UFS.
#
# By default only LUN 0 is restored: Android, its data and the partition table, i.e. everything
# kettle-install-internal changes. --all-luns also rewrites the firmware LUNs (bootloaders,
# modem, calibration); the installer never touches those, and an interrupted write there can
# leave the device unbootable, so only use it if they were damaged.
#
# From an essentials backup Android's userdata was not saved: its space is trimmed and Android's
# recovery resets it on the next start (fresh setup).
#
# Backups hold device-unique calibration and keys and are refused on any other device.
#
# Usage: sudo kettle-restore-ufs [--all-luns] [--progress --yes] BACKUP_DIR
set -euo pipefail
. /usr/lib/kettle/ufs-lib.sh

ALL=0 DIR=""
ARGS=("$@")
while [ $# -gt 0 ]; do
  case "$1" in
    --all-luns) ALL=1 ;;
    --progress) PROGRESS=1 ;;
    --yes) YES=1 ;;
    -h|--help) sed -n '2,14p' "$0"; exit 0 ;;
    -*) die "unknown option $1" ;;
    *) DIR=$1 ;;
  esac
  shift
done
[ -n "$DIR" ] || die "usage: $0 [--all-luns] BACKUP_DIR"
[ -f "$DIR/manifest" ] || die "$DIR is not a kettle-backup-ufs backup"

need_root
need_sd_root
inhibit "Restoring the internal storage" "${ARGS[@]}"
start_log restore-ufs "${ARGS[@]}"
need_power

m() { sed -n "s/^$1=//p" "$DIR/manifest"; }
KIND=$(m kind); KIND=${KIND:-full}   # backups from before "kind" existed are full
bserial=$(m serial)
[ -z "$bserial" ] || [ "$bserial" = "$(device_serial)" ] ||
  die "this backup was made on another device (serial $bserial); it holds that unit's calibration and keys"
IFS=: read -r skip_lun skip_off skip_len <<<"$(m skip)"

if [ "$ALL" = 1 ]; then
  mapfile -t luns < <(ls "$DIR" | sed -n 's/^lun\([0-9]*\)\.img\.zst$/\1/p' | sort -n)
else
  luns=(0)
fi

say "checking the backup"
( cd "$DIR" && sha256sum -c --quiet SHA256SUMS ) || die "checksum mismatch in $DIR"
plan=()
for lun in "${luns[@]}"; do
  img="$DIR/lun$lun.img.zst"; [ -f "$img" ] || die "missing $img"
  dev=$(lun_dev "$lun"); [ -n "$dev" ] || die "LUN $lun not found on this device"
  [ "$(m lun$lun)" = "$(blockdev --getsize64 "$dev")" ] || die "LUN $lun size differs from the backup (different device?)"
  none_mounted "$dev" || die "$dev (or a partition of it) is mounted"
  for f in "$img" "$DIR/lun$lun-tail.img.zst"; do
    [ -f "$f" ] || continue
    zstd -q -t "$f" || die "$(basename "$f") is corrupt"
  done
  plan+=("$lun $dev")
done

if [ "$PROGRESS" = 0 ]; then
  grep -E '^(kind|date|model|machine)=' "$DIR/manifest" | sed 's/^/  /'
  for p in "${plan[@]}"; do echo "  LUN ${p% *} -> ${p#* }  (overwritten)"; done
  echo
  echo "  Everything currently on these LUNs is replaced by the backup, including any"
  echo "  internal Kettle Linux install. Do not power off until this finishes."
  [ "$KIND" = full ] || echo "  This is an essentials backup: Android starts with a fresh setup afterwards."
  if [ "$YES" = 0 ]; then
    read -rp "Type RESTORE to continue: " a
    [ "$a" = RESTORE ] || { echo "Aborted."; exit 1; }
  fi
fi

# From here on an interruption leaves the LUN half-written: keep going on SIGINT/SIGTERM
trap '' INT TERM HUP
for p in "${plan[@]}"; do
  lun=${p% *} dev=${p#* }
  size=$(blockdev --getsize64 "$dev")
  if [ "$lun" = "$skip_lun" ]; then
    end=$((skip_off + skip_len))
    say "writing LUN $lun ($dev), before userdata"
    zstd -q -dc "$DIR/lun$lun.img.zst" |
      dd of="$dev" bs=4M iflag=fullblock oflag=direct conv=fsync status=progress 2> >(dd_pct "$skip_off")
    say "writing LUN $lun ($dev), after userdata"
    zstd -q -dc "$DIR/lun$lun-tail.img.zst" |
      dd of="$dev" bs=4M iflag=fullblock oflag=direct,seek_bytes seek="$end" conv=fsync status=progress 2> >(dd_pct "$((size - end))")
    say "clearing Android's userdata"
    blkdiscard -f -o "$skip_off" -l "$skip_len" "$dev" 2>/dev/null ||
      note "trim not supported; clearing the start of userdata only"
    dd if=/dev/zero of="$dev" bs=1M count=8 oflag=seek_bytes seek="$skip_off" conv=fsync status=none
  else
    say "writing LUN $lun ($dev)"
    zstd -q -dc "$DIR/lun$lun.img.zst" |
      dd of="$dev" bs=4M iflag=fullblock oflag=direct conv=fsync status=progress 2> >(dd_pct "$size")
  fi
  blockdev --rereadpt "$dev" 2>/dev/null || partx -u "$dev" 2>/dev/null || true
done
udevadm settle
[ "$KIND" = full ] || request_android_wipe
sync
done_msg "restore complete; reboot to use it"
