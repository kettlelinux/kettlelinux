#!/bin/bash
# Image the whole internal UFS (every LUN: Android, firmware, partition tables) to the SD card,
# so it can be put back exactly with steamportal-restore-ufs.
#
# Each LUN is saved as lun<N>.img.zst (zstd, with frame checksums). Unused space reads back as
# zeros and compresses to almost nothing, so the backup is roughly the size of the data on it.
# Android's userdata is saved raw (still encrypted, with the device-bound keys that decrypt it),
# which restores Android exactly as it was on this same device.
#
# Usage: sudo steamportal-backup-ufs [DEST_DIR]
#   default DEST_DIR: /var/lib/steamportal/ufs-backup/<date> on the SD card system
set -euo pipefail

BASE=/var/lib/steamportal/ufs-backup
die() { echo "error: $*" >&2; exit 1; }
say() { printf '\033[1;34m==>\033[0m %s\n' "$*"; }

[ "$(id -u)" = 0 ] || die "run as root (sudo $0)"
case "$(findmnt -no SOURCE /)" in /dev/mmcblk*) ;; *) die "run this from the SD card system" ;; esac

# UFS LUNs, as "<lun> <dev>" (LUN number = SCSI device 0:0:0:<lun> under the UFS host)
ufs_luns() {
  local d
  for d in /sys/block/sd*; do
    readlink -f "$d" | grep -q 'ufshc' || continue
    [ "$(cat "$d/size")" -gt 0 ] || continue
    echo "$(basename "$(readlink -f "$d/device")" | awk -F: '{print $4}') /dev/${d##*/}"
  done | sort -n
}
mapfile -t LUNS < <(ufs_luns)
[ ${#LUNS[@]} -gt 0 ] || die "no internal UFS found"
for l in "${LUNS[@]}"; do
  dev=${l#* }
  findmnt -rno SOURCE | grep -q "^$dev" && die "$dev (or a partition of it) is mounted"
done

DEST="${1:-$BASE/$(date +%Y%m%d-%H%M%S)}"
mkdir -p "$DEST"
[ -z "$(ls -A "$DEST")" ] || die "$DEST is not empty"
avail=$(( $(df -B1 --output=avail "$DEST" | tail -1) / 1024**3 ))
[ "$avail" -ge 20 ] || die "only ${avail} GiB free at $DEST"
say "backing up internal storage to $DEST (${avail} GiB free there)"

{
  echo "date=$(date -Is)"
  echo "model=$(cat /sys/block/sda/device/vendor 2>/dev/null | xargs) $(cat /sys/block/sda/device/model 2>/dev/null | xargs)"
  echo "machine=$(tr -d '\0' </sys/firmware/devicetree/base/model 2>/dev/null)"
  for l in "${LUNS[@]}"; do echo "lun${l% *}=$(blockdev --getsize64 "${l#* }")"; done
} >"$DEST/manifest"
for l in "${LUNS[@]}"; do sfdisk -d "${l#* }" >"$DEST/lun${l% *}.sfdisk" 2>/dev/null || true; done

for l in "${LUNS[@]}"; do
  lun=${l% *} dev=${l#* }
  say "LUN $lun ($dev, $(( $(blockdev --getsize64 "$dev") / 1024**2 )) MiB)"
  dd if="$dev" bs=4M iflag=direct status=progress |
    zstd -q -T0 -3 --check -o "$DEST/lun$lun.img.zst"
done

say "verifying the backup"
( cd "$DEST" && for f in lun*.img.zst; do zstd -q -t "$f" || die "$f failed verification"; done
  sha256sum lun*.img.zst >SHA256SUMS )
sync
say "done: $(du -sh "$DEST" | cut -f1) in $DEST"
echo "  Restore with: sudo steamportal-restore-ufs $DEST"
echo "  Copy that folder to another computer too if you want a second copy."
