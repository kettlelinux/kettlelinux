#!/bin/bash
# Install the running (SD card) Steam Portal system to the internal UFS, next to Android.
#
# Boot chain this relies on (stock AYN firmware): ABL starts either Android (boot_a/b) or
# U-Boot (loader_a/b); U-Boot's EFI boot order is the SD card ("mmc 0") first, then the UFS
# LUNs ("scsi 0".."scsi 7"), loading \EFI\BOOT\BOOTAA64.EFI (systemd-boot) from an ESP.
# So: with an SD card inserted the SD system boots, without one the internal install does.
#
# Layout on /dev/sda (LUN 0) after install:
#   ...Android partitions...   untouched
#   userdata (Android)         shrunk to --android-size; Android formats it on next boot
#   steamportal-esp   512 MiB  FAT32: systemd-boot, kernel, dtbs
#   steamportal-ufs-root rest  ext4 root (copy of this system)
#
# Android's userdata is metadata-encrypted, so it cannot be shrunk in place: Android's apps
# and data are wiped (Android itself stays). The original partition table is saved first.
#
# Before changing anything it offers a full image of the internal storage to the SD card
# (steamportal-backup-ufs), unless one exists; restore it with steamportal-restore-ufs.
#
# Usage: sudo steamportal-install-internal [--android-size GB] [--no-games] [--skip-backup] [--yes]
#        sudo steamportal-install-internal --reinstall [--no-games] [--yes]
#            (recopy into an existing internal install; Android is not touched)
set -euo pipefail

DISK=/dev/sda
ESP_LABEL=steamportal-esp
ROOT_LABEL=steamportal-ufs-root   # SD image root is "steamportal-root"
ESP_TYPE=C12A7328-F81F-11D2-BA4B-00A0C93EC93B
ROOT_TYPE=B921B045-1DF0-41C3-AF44-4C6F280D3FAE   # root-arm64
ESP_MIB=512
ANDROID_GB=64
MIN_ANDROID_GB=16
REINSTALL=0 NO_GAMES=0 YES=0 SKIP_BACKUP=0

die() { echo "error: $*" >&2; exit 1; }
say() { printf '\033[1;34m==>\033[0m %s\n' "$*"; }
ask() { [ "$YES" = 1 ] && return 0; local a; read -rp "$1 [y/N]: " a; [[ $a =~ ^[Yy]$ ]]; }

while [ $# -gt 0 ]; do
  case "$1" in
    --android-size) ANDROID_GB="${2:?}"; shift ;;
    --reinstall) REINSTALL=1 ;;
    --no-games) NO_GAMES=1 ;;
    --skip-backup) SKIP_BACKUP=1 ;;
    --yes) YES=1 ;;
    -h|--help) sed -n '2,23p' "$0"; exit 0 ;;
    *) die "unknown option $1" ;;
  esac
  shift
done

[ "$(id -u)" = 0 ] || die "run as root (sudo $0)"
[ -b "$DISK" ] || die "$DISK not found"
src_dev="$(findmnt -no SOURCE /)"
case "$src_dev" in /dev/mmcblk*) ;; *) die "run this from the SD card system (root is $src_dev)" ;; esac
findmnt -rno SOURCE | grep -q "^$DISK" && die "a partition of $DISK is mounted"
if pgrep -x steam >/dev/null && [ "$YES" != 1 ]; then
  ask "Steam is running; its files may change during the copy. Continue anyway?" || exit 1
fi

part_by_label() { blkid -c /dev/null -t PARTLABEL="$1" -o device 2>/dev/null | grep "^$DISK" | head -1; }
partnum() { cat "/sys/class/block/$(basename "$1")/partition"; }
SS=$(blockdev --getss "$DISK")
MIB=$((1048576 / SS))                         # sectors per MiB

UD=$(part_by_label userdata) || true
[ -n "$UD" ] || die "Android userdata partition not found on $DISK"
UD_N=$(partnum "$UD")
ESP=$(part_by_label $ESP_LABEL) || true
ROOT=$(part_by_label $ROOT_LABEL) || true

if [ "$REINSTALL" = 1 ]; then
  [ -n "$ESP" ] && [ -n "$ROOT" ] || die "no existing internal install to --reinstall into"
  echo "Reinstalling into $ESP (boot) and $ROOT (root). Everything on them is erased; Android is untouched."
  ask "Proceed?" || exit 1
else
  last_n=$(sfdisk -d "$DISK" | sed -n "s|^$DISK\([0-9]*\) :.*|\1|p" | sort -n | tail -1)
  [ "$last_n" = "$UD_N" ] || die "partitions already follow userdata on $DISK (existing install? use --reinstall)"
  [[ $ANDROID_GB =~ ^[0-9]+$ ]] && [ "$ANDROID_GB" -ge "$MIN_ANDROID_GB" ] || die "--android-size must be >= $MIN_ANDROID_GB"
  ud_start=$(cat "/sys/class/block/$(basename "$UD")/start")   # 512-byte units
  ud_start=$((ud_start * 512 / SS))
  ud_size=$(( ANDROID_GB * 1024 * MIB ))
  ud_end=$(( (ud_start + ud_size + MIB - 1) / MIB * MIB ))      # MiB-align what follows
  ud_size=$(( ud_end - ud_start ))
  disk_gb=$(( $(blockdev --getsize64 "$DISK") / 1024**3 ))
  linux_gb=$(( disk_gb - ANDROID_GB - 8 ))
  [ "$linux_gb" -ge 32 ] || die "--android-size $ANDROID_GB leaves too little space for Linux"
  cat <<EOF

  Internal storage: $DISK (${disk_gb} GiB)
    Android userdata  ${ANDROID_GB} GiB     (currently $(( $(blockdev --getsize64 "$UD") / 1024**3 )) GiB)
    Steam Portal      ~${linux_gb} GiB

  WARNING: this ERASES Android's apps and data on internal storage (Android itself and
  its SD card data are kept; Android sets itself up again on its next boot).

EOF
  ask "Erase Android userdata and install Steam Portal to internal storage?" || exit 1
fi

# Full image of the internal storage first (the only way to get Android's data back)
BACKUPS=/var/lib/steamportal/ufs-backup
if [ "$REINSTALL" = 0 ] && [ "$SKIP_BACKUP" = 0 ]; then
  last=$(ls -d $BACKUPS/*/SHA256SUMS 2>/dev/null | tail -1 || true)
  if [ -n "$last" ]; then
    say "internal storage backup found: $(dirname "$last")"
  else
    a=y
    [ "$YES" = 1 ] || read -rp "No backup of the internal storage on this SD card yet. Make one now (recommended)? [Y/n]: " a
    if [[ ! $a =~ ^[Nn]$ ]]; then
      tool="$(dirname "$0")/steamportal-backup-ufs"; [ -x "$tool" ] || tool=steamportal-backup-ufs
      "$tool" || die "backup failed; nothing was changed"
    fi
  fi
fi

# Partition table backup (restore: sfdisk /dev/sda < file; Android then reformats userdata)
bk=/var/lib/steamportal/ufs-partition-table-$(date +%Y%m%d-%H%M%S).sfdisk
mkdir -p /var/lib/steamportal
sfdisk -d "$DISK" >"$bk"
mountpoint -q /flash && cp "$bk" /flash/ 2>/dev/null || true
say "saved partition table to $bk (also on the SD boot partition)"

if [ "$REINSTALL" = 0 ]; then
  say "shrinking Android userdata to ${ANDROID_GB} GiB"
  echo ",$ud_size" | sfdisk -q --no-reread -N "$UD_N" "$DISK"
  say "creating Steam Portal partitions"
  printf 'size=%s, type=%s, name=%s\ntype=%s, name=%s\n' \
    "$((ESP_MIB * MIB))" "$ESP_TYPE" "$ESP_LABEL" "$ROOT_TYPE" "$ROOT_LABEL" |
    sfdisk -q --no-reread --append "$DISK"
  partx -u "$DISK"; partx -a "$DISK" 2>/dev/null || true
  udevadm settle
  ESP=$(part_by_label $ESP_LABEL); ROOT=$(part_by_label $ROOT_LABEL)
  [ -b "$ESP" ] && [ -b "$ROOT" ] || die "new partitions did not appear (reboot and run --reinstall)"
  say "clearing the start of Android userdata so Android reformats it"
  dd if=/dev/zero of="$UD" bs=1M count=8 conv=fsync status=none
fi

say "formatting $ESP and $ROOT"
wipefs -aq "$ESP" "$ROOT"
mkfs.vfat -F 32 -n SPINTERNAL "$ESP" >/dev/null
mkfs.ext4 -F -q -L "$ROOT_LABEL" -E discard "$ROOT"
ESP_PU=$(blkid -s PARTUUID -o value "$ESP"); ROOT_PU=$(blkid -s PARTUUID -o value "$ROOT")

W=/run/steamportal-install
mkdir -p $W/src $W/root
mount --bind / $W/src           # plain view of / (no /proc, /flash, ... submounts)
cleanup() { umount -R $W/root 2>/dev/null || true; umount $W/src 2>/dev/null || true; }
trap cleanup EXIT
mount "$ROOT" $W/root
mkdir -p $W/root/flash
mount "$ESP" $W/root/flash

say "copying the system (this takes a while)"
excl=()
if [ "$NO_GAMES" = 1 ]; then
  for h in $W/src/home/*/.local/share/Steam/steamapps; do [ -d "$h" ] && excl+=("${h#$W/src}"); done
fi
rc=0
( cd $W/src && tar --one-file-system --xattrs --xattrs-include='*' --acls --warning=no-file-changed -cf - \
    --exclude=./var/lib/steamportal/ufs-partition-table-\* --exclude=.$BACKUPS \
    $(for e in "${excl[@]}"; do printf -- '--exclude=.%s/common --exclude=.%s/downloading ' "$e" "$e"; done) . ) |
  tar -C $W/root --xattrs --xattrs-include='*' --acls --numeric-owner -xpf - || rc=$?
[ "$rc" -le 1 ] || die "copy failed (tar exit $rc)"   # 1 = a file changed while being read
mkdir -p $W/root/{proc,sys,dev,run,tmp,flash}
chmod 1777 $W/root/tmp

say "copying boot files"
cp -r --no-preserve=ownership /flash/. $W/root/flash/
rm -f $W/root/flash/KERNEL $W/root/flash/KERNEL.md5 $W/root/flash/*.sfdisk   # ABL image carries the SD cmdline
old_pu=$(findmnt -no PARTUUID /)
sed -i "s/root=PARTUUID=$old_pu/root=PARTUUID=$ROOT_PU/" \
  $W/root/flash/loader/entries/*.conf $W/root/flash/extlinux/extlinux.conf
sed -i 's/^title .*/title      Steam Portal (internal)/' $W/root/flash/loader/entries/steamportal.conf
sed -i 's/^\(title .*previous kernel\).*/title      Steam Portal (internal, previous kernel)/' \
  $W/root/flash/loader/entries/steamportal-prev.conf 2>/dev/null || true
grep -q "root=PARTUUID=$ROOT_PU" $W/root/flash/loader/entries/steamportal.conf || die "boot entry not updated"

say "configuring the internal system"
cat >$W/root/etc/fstab <<EOF
# <device>                                    <dir>   <type> <options>                       <dump> <fsck>
PARTUUID=$ROOT_PU  /       ext4   rw,noatime                      0 1
PARTUUID=$ESP_PU  /flash  vfat   rw,noatime,nofail,umask=0077    0 2
EOF
# growing the root is an SD-image first-boot job; never let repart near the Android disk
rm -f $W/root/etc/repart.d/50-root.conf
sync

say "done"
cat <<EOF

  Steam Portal is installed to internal storage ($ROOT).
  Boot it by powering off, removing the SD card and starting Linux as usual.
  With the SD card inserted, the SD system boots instead (U-Boot tries the SD first).
  Android: boot it as before; its first start is a fresh setup.

  Undo: sudo steamportal-restore-ufs <backup under $BACKUPS>   (Android back as it was)
     or restore just the partition table:  sfdisk $DISK < $bk
EOF
