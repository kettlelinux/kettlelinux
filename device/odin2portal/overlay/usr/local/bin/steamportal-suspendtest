#!/bin/bash
# Staged s2idle suspend test for the Odin 2 Portal, to locate a resume hang.
#
#   sudo steamportal-suspendtest            run the next untried stage
#   sudo steamportal-suspendtest status     show results so far (e.g. after a forced reboot)
#   sudo steamportal-suspendtest reset      start over
#   sudo steamportal-suspendtest soak [N]   N unattended systemctl-suspend cycles (RTC wake, default 50)
#
# Each stage is logged and synced to disk *before* suspending, so if the device hard-locks,
# force it off (hold power ~15 s), boot again and run `status`: the stage marked STARTED
# without a result is the one that hung.
[ "$(id -u)" = 0 ] || exec sudo "$0" "$@"

STATE=/var/lib/steamportal-suspendtest
LOG=$STATE/log
mkdir -p "$STATE"

# name | description
STAGES=(
  "freezer|pm_test=freezer: freeze tasks only, auto-resume after 5 s"
  "devices|pm_test=devices: suspend+resume all drivers, auto-resume after 5 s"
  "rtc|real s2idle, woken by RTC alarm after 20 s (don't touch anything)"
  "rtc-no-wifi|real s2idle + RTC wake, with Wi-Fi (ath12k) unloaded"
  "rtc-no-pad|real s2idle + RTC wake, with gamepad + haptics unbound"
  "powerkey|real s2idle, wake with a short power-key press after ~10 s"
  "systemd-rtc|systemctl suspend (systemd-sleep, user-session freeze), RTC wake after 20 s"
  "systemd-powerkey|systemctl suspend, wake with a short power-key press after ~10 s"
  "logind-powerkey|press the power key to suspend, wait ~10 s, press it again to wake"
)

note() { echo "$(date -Is) $*" >>"$LOG"; sync; }

status() {
  echo "Results ($LOG):"
  [ -f "$LOG" ] && cat "$LOG" || echo "  (none yet)"
  echo
  echo "Last wake IRQ: $(cat /sys/power/pm_wakeup_irq 2>/dev/null || echo n/a)"
}

prep() {
  echo none >/sys/power/pm_test
  echo 1 >/sys/power/pm_print_times
  echo 1 >/sys/power/pm_debug_messages
  # keep the console alive through suspend: last messages stay on the panel if it hangs
  echo N >/sys/module/printk/parameters/console_suspend
  dmesg -n 8
}

run_suspend() {           # $1 = stage name
  note "STARTED $1"
  dmesg -C
  local t0; t0=$(date +%s)
  if echo mem >/sys/power/state; then
    note "RESUMED $1 after $(( $(date +%s) - t0 )) s; wake irq: $(cat /sys/power/pm_wakeup_irq 2>/dev/null || echo ?)"
  else
    note "FAILED-TO-ENTER $1 (see dmesg)"
  fi
  dmesg >"$STATE/dmesg-$1.txt"
  sync
}

successes() { cat /sys/power/suspend_stats/success; }

# Suspend through systemd ($2 = "cmd" to call systemctl, "key" to wait for the user's keypress),
# wait for resume, then watch for an unwanted second suspend (e.g. the wake keypress reaching logind).
run_systemd() {           # $1 = stage name, $2 = cmd|key
  local n0 t0 n1 n2 i
  note "STARTED $1"
  dmesg -C; n0=$(successes); t0=$(date +%s)
  journalctl --rotate >/dev/null 2>&1; local since; since=$(date '+%Y-%m-%d %H:%M:%S')
  if [ "$2" = cmd ]; then systemctl suspend; else echo "Press the power key now to suspend."; fi
  for ((i = 0; i < 180; i++)); do [ "$(successes)" -gt "$n0" ] && break; sleep 1; done
  n1=$(successes)
  if [ "$n1" -le "$n0" ]; then
    note "NO-SUSPEND $1 within 180 s"
  else
    note "RESUMED $1 after $(( $(date +%s) - t0 )) s; wake irq: $(cat /sys/power/pm_wakeup_irq 2>/dev/null || echo ?)"
    echo "Resumed; watching 30 s for a second, unwanted suspend..."
    sleep 30; n2=$(successes)
    [ "$n2" -gt "$n1" ] && note "RESUSPENDED $1: $((n2 - n1)) extra suspend(s) right after resume"
  fi
  dmesg >"$STATE/dmesg-$1.txt"
  journalctl -o short-monotonic --since "$since" -u systemd-logind -u systemd-suspend \
    -t systemd-sleep -t kernel --no-pager >"$STATE/journal-$1.txt" 2>&1
  sync
}

rtc_alarm() { echo 0 >/sys/class/rtc/rtc0/wakealarm; echo "+$1" >/sys/class/rtc/rtc0/wakealarm; }

soak() {
  local n=${1:-50} i n0 t0 j
  prep
  note "SOAK start: $n cycles, kernel $(uname -r)"
  for ((i = 1; i <= n; i++)); do
    note "SOAK cycle $i/$n suspending"
    n0=$(successes); t0=$(date +%s)
    rtc_alarm 15
    systemctl suspend
    for ((j = 0; j < 120; j++)); do [ "$(successes)" -gt "$n0" ] && break; sleep 1; done
    if [ "$(successes)" -le "$n0" ]; then note "SOAK cycle $i: no suspend happened"; break; fi
    note "SOAK cycle $i resumed after $(( $(date +%s) - t0 )) s, wake irq $(cat /sys/power/pm_wakeup_irq 2>/dev/null)"
    echo "cycle $i/$n ok"
    sleep 8     # let Wi-Fi/gamepad settle, like real use
  done
  note "SOAK end: $(grep -c 'resumed after' "$LOG") resumes logged"
  dmesg >"$STATE/dmesg-soak.txt"; sync
  tail -3 "$LOG"
}

case "${1:-next}" in
  status) status; exit 0 ;;
  soak) soak "${2:-50}"; exit 0 ;;
  reset) rm -rf "$STATE"; echo "reset"; exit 0 ;;
esac

# pick the first stage without a STARTED entry
for s in "${STAGES[@]}"; do
  name=${s%%|*}; desc=${s#*|}
  grep -q "STARTED $name\$" "$LOG" 2>/dev/null && continue
  echo "Stage: $name — $desc"
  read -rp "Press Enter to start (Ctrl-C to abort) " _
  prep
  grep -qw s2idle /sys/power/mem_sleep && echo s2idle >/sys/power/mem_sleep
  case "$name" in
    freezer|devices)
      echo "$name" >/sys/power/pm_test
      run_suspend "$name"
      echo none >/sys/power/pm_test ;;
    rtc)
      rtc_alarm 20; run_suspend "$name" ;;
    rtc-no-wifi)
      nmcli radio wifi off 2>/dev/null; modprobe -r ath12k_wifi7 ath12k 2>/dev/null
      rtc_alarm 20; run_suspend "$name"
      modprobe ath12k_wifi7 2>/dev/null; nmcli radio wifi on 2>/dev/null ;;
    rtc-no-pad)
      for d in /sys/bus/serial/drivers/rsinput/serial*; do [ -e "$d" ] && echo "${d##*/}" >/sys/bus/serial/drivers/rsinput/unbind; done
      for d in /sys/bus/platform/drivers/qcom-hv-haptics/*; do
        [ -L "$d" ] && [ "${d##*/}" != module ] && echo "${d##*/}" >/sys/bus/platform/drivers/qcom-hv-haptics/unbind
      done
      rtc_alarm 20; run_suspend "$name"
      echo "gamepad/haptics stay unbound until reboot" ;;
    powerkey)
      echo "Suspending — wait ~10 s, then short-press the power key."
      run_suspend "$name" ;;
    systemd-rtc)
      rtc_alarm 20; run_systemd "$name" cmd ;;
    systemd-powerkey)
      echo "Suspending — wait ~10 s, then short-press the power key."
      run_systemd "$name" cmd ;;
    logind-powerkey)
      run_systemd "$name" key ;;
  esac
  echo; status
  exit 0
done
echo "All stages done."; status
