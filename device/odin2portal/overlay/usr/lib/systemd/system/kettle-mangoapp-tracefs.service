[Unit]
Description=Ftrace instance and debugfs access for the gamescope performance overlay (mangoapp)
After=sys-kernel-tracing.mount sys-kernel-debug.mount
ConditionPathIsDirectory=/sys/kernel/tracing/instances

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/kettle/mangoapp-tracefs steamos

[Install]
WantedBy=multi-user.target
