#!/bin/bash
# mangoapp (gamescope's performance overlay) runs as the session user but reads GPU/CPU
# activity through an ftrace instance: libtracefs tracefs_instance_create("mangohud"), and it
# abort()s with "failed to create instance" when it can't. tracefs is root-only (0700), so
# create that instance here, hand it to the user, and open only the paths it needs to reach
# it plus the two ring-buffer header files used to decode it.
# It also reads GPU load from debugfs dri/0/perf_now (kernel patch 1110), so let the user
# traverse the debugfs root (0711: no listing; world-readable files become reachable).
set -eu
user="${1:-kettle}"
t=/sys/kernel/tracing
chmod 755 "$t" "$t/instances" "$t/events"
chmod 644 "$t/events/header_page" "$t/events/header_event"
mkdir -p "$t/instances/mangohud"
chown -R "$user:" "$t/instances/mangohud"
if [ -d /sys/kernel/debug/dri ]; then chmod 711 /sys/kernel/debug; fi
