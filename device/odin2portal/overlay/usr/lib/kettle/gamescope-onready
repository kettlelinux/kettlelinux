#!/bin/bash
# Runs inside gamescope once its Xwayland servers are up: publish the display
# environment to the user manager, tell systemd we're ready (starts steam.service),
# then stay alive for the lifetime of the session.
vars=(DISPLAY GAMESCOPE_WAYLAND_DISPLAY XDG_SESSION_TYPE XCURSOR_THEME XCURSOR_SIZE
      SRT_URLOPEN_PREFER_STEAM STEAM_MULTIPLE_XWAYLANDS STEAM_USE_MANGOAPP
      STEAM_MANGOAPP_PRESETS_SUPPORTED STEAM_MANGOAPP_HORIZONTAL_SUPPORTED
      STEAM_DISABLE_MANGOAPP_ATOM_WORKAROUND STEAM_GAMESCOPE_FANCY_SCALING_SUPPORT
      STEAM_GAMESCOPE_DYNAMIC_FPSLIMITER STEAM_GAMESCOPE_HAS_TEARING_SUPPORT
      STEAM_GAMESCOPE_TEARING_SUPPORTED STEAM_GAMESCOPE_NIS_SUPPORTED
      GAMESCOPE_STATS MANGOHUD_CONFIGFILE vk_xwayland_wait_ready QT_IM_MODULE GTK_IM_MODULE QT_QPA_PLATFORMTHEME)
systemctl --user import-environment "${vars[@]}"
NOTIFY_SOCKET="$GAMESCOPE_READY_NOTIFY_SOCKET" systemd-notify --ready
exec sleep infinity
