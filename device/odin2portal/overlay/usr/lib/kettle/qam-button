#!/usr/bin/python3
"""Game Mode: toggle Steam's Quick Access menu from the button below the right stick.

Fallback for when InputPlumber (which maps the button itself) is not running.
That button reports BTN_BACK, which Steam leaves unmapped, and Steam has no steam:// URL for
Quick Access. Faking the Guide+A chord on the pad works but leaks a plain A press whenever
Steam reads A before Guide, activating whatever has focus. Instead we call the same handler
the Steam Deck's "..." button uses, through the client's CEF DevTools port (opened by
run-steam), so no fake input ever reaches Steam.
"""
import base64
import errno
import json
import os
import socket
import struct
import sys
import time
import urllib.request
from urllib.parse import urlparse

import evdev
from evdev import ecodes as e

PAD_NAME = "AYN Odin2 Gamepad"
QAM_BUTTON = e.BTN_BACK
CEF = "http://127.0.0.1:8080/json"
CEF_TIMEOUT = 2  # s
TOGGLE_QAM = ("(w => w ? (w.OnQuickAccessButtonPressed(), true) : false)"
              "(SteamUIStore?.WindowStore?.GamepadUIMainWindowInstance)")


def log(msg):
    print(msg, file=sys.stderr, flush=True)


def find_pad():
    for path in evdev.list_devices():
        try:
            dev = evdev.InputDevice(path)
        except OSError:
            continue
        if dev.name == PAD_NAME:
            return dev
        dev.close()
    return None


def cef_eval(expr):
    """Evaluate expr in Steam's SharedJSContext over a minimal WebSocket client."""
    with urllib.request.urlopen(CEF, timeout=CEF_TIMEOUT) as resp:
        targets = json.load(resp)
    url = next(t["webSocketDebuggerUrl"] for t in targets if t.get("title") == "SharedJSContext")
    u = urlparse(url)
    with socket.create_connection((u.hostname, u.port), timeout=CEF_TIMEOUT) as sock:
        key = base64.b64encode(os.urandom(16)).decode()
        sock.sendall(f"GET {u.path} HTTP/1.1\r\nHost: {u.netloc}\r\nUpgrade: websocket\r\n"
                     f"Connection: Upgrade\r\nSec-WebSocket-Key: {key}\r\n"
                     "Sec-WebSocket-Version: 13\r\n\r\n".encode())
        f = sock.makefile("rb")
        if b" 101 " not in f.readline():
            raise OSError("CEF refused the WebSocket upgrade")
        while f.readline() not in (b"\r\n", b""):
            pass
        payload = json.dumps({"id": 1, "method": "Runtime.evaluate",
                              "params": {"expression": expr, "returnByValue": True}}).encode()
        n = len(payload)
        header = bytes([0x81, 0x80 | n]) if n < 126 else bytes([0x81, 0xFE]) + struct.pack(">H", n)
        mask = os.urandom(4)
        sock.sendall(header + mask + bytes(b ^ mask[i % 4] for i, b in enumerate(payload)))
        _, b1 = f.read(2)
        n = b1 & 0x7F
        if n == 126:
            n = struct.unpack(">H", f.read(2))[0]
        elif n == 127:
            n = struct.unpack(">Q", f.read(8))[0]
        reply = json.loads(f.read(n))
    return reply.get("result", {}).get("result", {}).get("value")


def toggle_qam():
    try:
        if not cef_eval(TOGGLE_QAM):
            log("Quick Access: Steam's gamepad UI is not up")
    except (OSError, ValueError, StopIteration) as err:
        log(f"Quick Access: {err!r}")


def run():
    waiting = False
    while True:
        pad = find_pad()
        if not pad:
            if not waiting:
                log(f"waiting for '{PAD_NAME}'")
                waiting = True
            time.sleep(2)
            continue
        waiting = False
        log(f"attached {pad.path} ({pad.name})")
        try:
            for ev in pad.read_loop():
                if ev.type == e.EV_KEY and ev.code == QAM_BUTTON and ev.value == 1:
                    toggle_qam()
        except OSError as err:
            if err.errno != errno.ENODEV:
                raise
            log("gamepad went away")
        finally:
            try:
                pad.close()
            except OSError:
                pass


if __name__ == "__main__":
    try:
        run()
    except KeyboardInterrupt:
        pass
