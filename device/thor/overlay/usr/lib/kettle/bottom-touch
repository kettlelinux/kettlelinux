#!/bin/sh
# bottom-touch on|off: turn the Thor's bottom touchscreen on or off (the input device's
# "inhibited" flag, which udev makes writable for the input group: 61-kettle-thor-touch.rules).
# Game Mode runs on the top screen only, and gamescope would map the bottom screen's touches
# onto it.
case "$1" in on) v=0 ;; off) v=1 ;; *) echo "usage: $0 on|off" >&2; exit 2 ;; esac
for n in /sys/class/input/input*/name; do
  [ "$(cat "$n")" = bottom_touchscreen ] && echo $v >"${n%/name}/inhibited"
done
exit 0
