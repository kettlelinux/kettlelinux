#!/bin/bash
# The Thor's bottom-screen shell in Game Mode: Plasma Mobile's shell in a KWin of its own,
# inside the bottom screen's gamescope (bottom-screen), as a window of its Xwayland.
#  - its own config dir: Plasma Mobile sets KWin and Plasma up its own way
#    (plasma-mobile-envmanager: mobile look, maximised windows, its task switcher), which
#    mustn't reach the desktop's. Default apps and folders are the desktop's; its look starts
#    as a copy of the desktop's.
#  - its own session bus: nothing on it answers to Steam's (no powerdevil, no second
#    brightness or suspend handling); the system bus (NetworkManager, BlueZ) is shared.
set -u
[ -n "${DISPLAY:-}" ] || { echo "bottom-shell: no X display from gamescope" >&2; exit 1; }

export XDG_CONFIG_HOME="$HOME/.config/kettle/bottom-shell"
mkdir -p "$XDG_CONFIG_HOME"
for f in mimeapps.list user-dirs.dirs user-dirs.locale; do
  [ -e "$HOME/.config/$f" ] && ln -sfn "../../$f" "$XDG_CONFIG_HOME/$f"
done
[ -e "$XDG_CONFIG_HOME/kdeglobals" ] || cp "$HOME/.config/kdeglobals" "$XDG_CONFIG_HOME/" 2>/dev/null
# links open in Firefox (envmanager would pick Angelfish, which we don't ship)
kwriteconfig6 --file kdeglobals --group General --key BrowserApplication firefox.desktop

export XDG_CURRENT_DESKTOP=KDE XDG_SESSION_DESKTOP=KDE KDE_SESSION_VERSION=6 KDE_FULL_SESSION=true
export QT_QPA_PLATFORMTHEME=kde QT_QUICK_CONTROLS_STYLE=org.kde.breeze QT_QUICK_CONTROLS_MOBILE=1
export PLASMA_PLATFORM=phone:handset
export XCURSOR_THEME=breeze_cursors
# apps started here are the shell's, not gamescope's clients (gamescope's Vulkan layer would
# look for Game Mode's gamescope)
export DISABLE_GAMESCOPE_WSI=1

# Plasma Mobile's settings, before the shell starts (as startplasmamobile does). It makes
# maliit the on-screen keyboard, which deckard's Qt can't run: use the desktop's
# plasma-keyboard instead.
QT_QPA_PLATFORM=offscreen plasma-mobile-envmanager --apply-settings
kwriteconfig6 --file kwinrc --group Wayland --key InputMethod \
  /usr/share/applications/org.kde.plasma.keyboard.desktop

# The shell fills gamescope's 1240x1080 screen (3.9", about 420 dpi): 2x makes it touch-sized
exec dbus-run-session kwin_wayland --x11-display "$DISPLAY" --width 1240 --height 1080 \
  --scale "${BOTTOM_SHELL_SCALE:-2}" --no-lockscreen \
  --exit-with-session "plasmashell -p org.kde.plasma.mobileshell"
