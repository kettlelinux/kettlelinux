#!/bin/bash
# The Thor's bottom screen in Game Mode (kettle-bottom-screen.service). Game Mode's gamescope
# leases the bottom panel's connector (GAMESCOPE_LEASE_OUTPUT, gamescope 0012-0016) and hands
# the lease over GAMESCOPE_LEASE_SOCK; this runs a second gamescope on it, with the bottom
# touchscreen's input forwarded over the same socket, and the touch shell in that
# (bottom-shell). When it's turned off (Quick Access > Screens, or GAMESCOPE_BOTTOM_SCREEN=0) or
# there is no lease (gamescope couldn't make one), the bottom screen stays off: this exits 3,
# which kettle-bottom-screen.service doesn't restart on.
set -u
for f in /usr/lib/kettle/gamescope.conf /etc/kettle/gamescope.conf "$HOME/.config/kettle/gamescope.conf"; do
  [ -r "$f" ] && . "$f"
done
[ "${GAMESCOPE_BOTTOM_SCREEN:-1}" = 0 ] && exit 3
# turned off in Quick Access > Screens
grep -qE '"enabled": *false' "$HOME/.config/kettle/bottom-screen.json" 2>/dev/null && exit 3
[ -n "${GAMESCOPE_LEASE_OUTPUT:-}" ] || exit 3
sock="$XDG_RUNTIME_DIR/gamescope-lease.sock"

# The panel only lists 60 Hz, but runs at 30 with the same timings at half the pixel clock
# (gamescope 0022; a longer vertical blank at the same clock draws black lines on it instead).
# Quick Access > Screens picks the rate ("refresh_hz", 60 by default), live through gamescopectl;
# this is the one the screen starts at. It's a fixed rate (refresh_hz, 0023): ui_refresh_hz
# would never apply here, as gamescope takes the shell's KWin window for a game that's open. It
# also replaces Game Mode's refresh_hz from gamescope.conf above, which is the top screen's.
export GAMESCOPE_GENERATED_REFRESH_RATES=30
refresh=$(sed -n 's/.*"refresh_hz": *\([0-9]*\).*/\1/p' "$HOME/.config/kettle/bottom-screen.json" 2>/dev/null)
export gamescope_refresh_hz=${refresh:-60}
unset gamescope_ui_refresh_hz

# Game Mode's gamescope makes the socket before it reports ready, which this unit starts after;
# allow for a slow start anyway
for _ in $(seq 50); do
  [ -S "$sock" ] && break
  sleep 0.2
done
if [ ! -S "$sock" ]; then
  echo "bottom-screen: Game Mode leased no screen ($sock), the bottom screen stays off" >&2
  exit 3
fi

# Game Mode's environment (gamescope-onready imports it into the user manager) is Steam's, not
# the shell's: its displays, cursor, input method, overlay and gamescope integrations
unset DISPLAY WAYLAND_DISPLAY GAMESCOPE_WAYLAND_DISPLAY GAMESCOPE_STATS GAMESCOPE_LIMITER_FILE \
  GAMESCOPE_INTERNAL_PHYSICAL_SIZE MANGOHUD_CONFIGFILE XCURSOR_THEME XCURSOR_SIZE \
  QT_IM_MODULE GTK_IM_MODULE vk_xwayland_wait_ready SRT_URLOPEN_PREFER_STEAM
unset "${!STEAM_@}"

# The panel is portrait (1080x1240) and mounted like the top one: gamescope turns it to
# 1240x1080, rotating in its compositor rather than on the display (the lease handoff breaks
# with the display's own rotation). Touch mode 4: touches go to the shell as touches.
exec gamescope \
  --backend drm \
  --drm-lease-client "$sock" \
  --force-orientation "${GAMESCOPE_LEASE_ORIENTATION:-right}" \
  --force-composition-rotation \
  --force-windows-fullscreen \
  --xwayland-count 1 \
  --default-touch-mode 4 \
  --hide-cursor-delay 1000 \
  -- /usr/lib/kettle/bottom-shell
